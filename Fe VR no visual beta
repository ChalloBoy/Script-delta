	speed = math.min(MAX_SPEED, speed + SPEED_STEP)
	speedLabel.Text = "Speed: " .. speed
end)

--==================================================
-- OFF / CLEANUP
--==================================================

local function turnOff()
	enabled = false
	flying = false

	stopFly()
	stopNoclip()

	toggle.Text = "OFF"
	toggle.BackgroundColor3 = Color3.fromRGB(45, 150, 255)
end

--==================================================
-- AUTO ROUTE
--==================================================

local function startRoute()
	if flying then
		return
	end

	local root = getRoot()

	if not root then
		turnOff()
		return
	end

	-- Simpan posisi PERSIS ketika ON ditekan
	savedCFrame = root.CFrame

	flying = true

	startNoclip()

	toggle.Text = "ON"
	toggle.BackgroundColor3 = Color3.fromRGB(45, 200, 100)

	-- Titik 1 sampai 10
	for _, position in ipairs(positions) do
		if not enabled then
			break
		end

		if not flyTo(position) then
			break
		end
	end

	-- Setelah titik 10,
	-- kembali ke posisi awal
	if enabled and savedCFrame then
		flyTo(savedCFrame.Position)
	end

	-- Selesai = OFF + noclip mati
	if enabled then
		turnOff()
	end

	flying = false
end

--==================================================
-- ON / OFF
--==================================================

toggle.MouseButton1Click:Connect(function()

	-- ON -> OFF
	if enabled then
		turnOff()
		return
	end

	-- OFF -> ON
	enabled = true

	task.spawn(startRoute)
end)

