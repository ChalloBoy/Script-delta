local function applyRGB(root, hue)
    if not root or not root.Parent then return end
    local rgb = Color3.fromHSV(hue % 1, 0.9, 1)
    local rgbSoft = Color3.fromHSV(hue % 1, 0.65, 1)
    for _, obj in ipairs(root:GetDescendants()) do
        if obj:IsA(string.char(70,114,97,109,101)) or obj:IsA(string.char(84,101,120,116,66,117,116,116,111,110)) or obj:IsA(string.char(73,109,97,103,101,66,117,116,116,111,110)) then
            if obj:GetAttribute(string.char(82,71,66,95,85,73)) then
                obj.BackgroundColor3 = rgb
            end
        elseif obj:IsA(string.char(84,101,120,116,76,97,98,101,108)) or obj:IsA(string.char(84,101,120,116,66,117,116,116,111,110)) then
            if obj:GetAttribute(string.char(82,71,66,95,84,69,88,84)) then
                obj.TextColor3 = rgb
            end
        elseif obj:IsA(string.char(85,73,83,116,114,111,107,101)) then
            if obj:GetAttribute(string.char(82,71,66,95,83,84,82,79,75,69)) then
                obj.Color = rgb
            end
        end
    end
end

