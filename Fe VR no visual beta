--[[
    MOBILE VR CONTROLLER
    Untuk game Roblox milik sendiri.
    
    Fitur:
    - Kamera touch HP
    - Tangan kiri & kanan virtual
    - Joystick kiri untuk bergerak
    - Joystick kanan untuk menggerakkan tangan
    - Tangan mengikuti arah kamera secara terbatas
    - Melihat ke belakang tidak membuat tangan ikut berputar 180°
    - Grip / Release
    - Recenter
    - Sensitivitas dapat diatur

    Pasang sebagai LocalScript:
    StarterPlayer > StarterPlayerScripts
]]

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")

local player = Players.LocalPlayer
local camera = workspace.CurrentCamera

--==================================================
-- SETTINGS
--==================================================

local Settings = {
    CameraSensitivity = 0.008,
    HandSensitivity = 0.012,

    HandDistance = 2.2,
    HandHeight = -0.4,
    HandSide = 1.15,

    MaxHandYaw = math.rad(75),
    MaxHandPitch = math.rad(65),

    HandSmoothness = 0.18,
    CameraSmoothness = 0.15,

    ShowUI = true
}

--==================================================
-- CHARACTER
--==================================================

local character
local humanoid
local root

local function setupCharacter(char)
    character = char
    humanoid = char:WaitForChild("Humanoid")
    root = char:WaitForChild("HumanoidRootPart")
end

setupCharacter(player.Character or player.CharacterAdded:Wait())

player.CharacterAdded:Connect(function(char)
    setupCharacter(char)
end)

--==================================================
-- CAMERA
--==================================================

camera.CameraType = Enum.CameraType.Scriptable

local cameraYaw = 0
local cameraPitch = 0

local targetYaw = 0
local targetPitch = 0

local baseBodyYaw = 0

local function recenter()
    if not root then return end

    local _, bodyYaw, _ = root.CFrame:ToOrientation()

    cameraYaw = bodyYaw
    targetYaw = bodyYaw

    cameraPitch = 0
    targetPitch = 0
end

recenter()

--==================================================
-- VIRTUAL HANDS
--==================================================

local handFolder = Instance.new("Folder")
handFolder.Name = "MobileVRHands"
handFolder.Parent = workspace

local function createHand(name)
    local hand = Instance.new("Part")

    hand.Name = name
    hand.Size = Vector3.new(0.35, 0.35, 0.65)

    hand.Shape = Enum.PartType.Block
    hand.Anchored = true
    hand.CanCollide = false
    hand.CanTouch = false
    hand.CanQuery = false

    hand.Material = Enum.Material.SmoothPlastic

    hand.Parent = handFolder

    return hand
end

local leftHand = createHand("LeftHand")
local rightHand = createHand("RightHand")

local leftGrip = false
local rightGrip = false

--==================================================
-- HAND CONTROL
--==================================================

local leftX = 0
local leftY = 0

local rightX = 0
local rightY = 0

local targetLeftX = 0
local targetLeftY = 0

local targetRightX = 0
local targetRightY = 0

--==================================================
-- TOUCH STATE
--==================================================

local movementTouch = nil
local cameraTouch = nil
local leftHandTouch = nil
local rightHandTouch = nil

local movementStart = nil
local cameraStart = nil
local leftHandStart = nil
local rightHandStart = nil

--==================================================
-- UI
--==================================================

local gui = Instance.new("ScreenGui")
gui.Name = "MobileVRUI"
gui.ResetOnSpawn = false
gui.IgnoreGuiInset = true
gui.Parent = player:WaitForChild("PlayerGui")

local function makeButton(name, text, size, position)
    local button = Instance.new("TextButton")

    button.Name = name
    button.Text = text

    button.Size = size
    button.Position = position

    button.BackgroundTransparency = 0.25
    button.TextScaled = true
    button.TextColor3 = Color3.new(1,1,1)

    button.BackgroundColor3 = Color3.fromRGB(25,25,25)

    button.BorderSizePixel = 0
    button.AutoButtonColor = true

    button.Parent = gui

    local corner = Instance.new("UICorner")
    corner.CornerRadius = UDim.new(0,12)
    corner.Parent = button

    return button
end

local leftZone = makeButton(
    "LeftHandControl",
