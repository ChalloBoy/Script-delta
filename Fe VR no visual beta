--========================================================--
-- MOBILE VR + NORMAL CAMERA CONTROLLER
-- Roblox - LocalScript
-- StarterPlayer > StarterPlayerScripts
--
-- FITUR:
-- 1. Normal Camera
-- 2. VR Camera
-- 3. VR system tetap aktif pada kedua mode
-- 4. Tangan kiri dan kanan bisa digerakkan
-- 5. Tangan bisa digoyangkan/swing
-- 6. VR Camera dibatasi agar tidak melihat ke belakang
-- 7. Recenter
-- 8. Grip / Release
-- 9. UI bisa disembunyikan
--========================================================--

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")

local player = Players.LocalPlayer
local camera = workspace.CurrentCamera

--========================================================--
-- SETTINGS
--========================================================--

local Settings = {

	-- Kamera normal
	NormalSensitivity = 0.008,

	-- Kamera VR
	VRSensitivity = 0.006,

	-- Batas kamera VR
	VRMaxYaw = math.rad(80),
	VRMinPitch = math.rad(-65),
	VRMaxPitch = math.rad(65),

	-- Tangan
	HandSensitivity = 0.012,

	HandSide = 1.15,
	HandHeight = -0.35,
	HandDistance = 2.1,

	-- Batas tangan
	MaxHandYaw = math.rad(75),
	MaxHandPitch = math.rad(60),

	-- Smooth
	CameraSmooth = 0.16,
	HandSmooth = 0.18,

	-- Goyangan tangan
	SwingPower = 0.25,
	SwingSpeed = 8,

	-- Tampilan UI
	ShowUI = true
}

--========================================================--
-- CHARACTER
--========================================================--

local character
local humanoid
local root

local function setupCharacter(char)

	character = char

	humanoid = char:WaitForChild("Humanoid")
	root = char:WaitForChild("HumanoidRootPart")

end

setupCharacter(player.Character or player.CharacterAdded:Wait())

player.CharacterAdded:Connect(function(char)

	setupCharacter(char)

end)

--========================================================--
-- CAMERA STATE
--========================================================--

local CameraMode = "Normal"

local cameraYaw = 0
local cameraPitch = 0

local targetYaw = 0
local targetPitch = 0

local function getBodyYaw()

	if not root then
		return 0
	end

	local _, yaw, _ = root.CFrame:ToOrientation()

	return yaw
end

local function normalizeAngle(angle)

	return math.atan2(
		math.sin(angle),
		math.cos(angle)
	)

end

--========================================================--
-- RECENTER
--========================================================--

local function recenter()

	local bodyYaw = getBodyYaw()

	cameraYaw = bodyYaw
	targetYaw = bodyYaw

	cameraPitch = 0
	targetPitch = 0

end

recenter()

