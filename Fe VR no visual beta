--==================================================
-- JOYSTICK FUNCTION
--==================================================

local function createJoystick(name, position, color)

	local TouchPad = Instance.new("Frame")
	local Thumb = Instance.new("ImageButton")

	TouchPad.Name = name .. "_Pad"
	TouchPad.Size = UDim2.fromOffset(125, 125)
	TouchPad.Position = position
	TouchPad.BackgroundColor3 = Color3.fromRGB(20, 20, 20)
	TouchPad.BackgroundTransparency = 0.6
	TouchPad.BorderSizePixel = 0
	TouchPad.Active = true
	TouchPad.Parent = ScreenGui

	local padCorner = Instance.new("UICorner")
	padCorner.CornerRadius = UDim.new(1, 0)
	padCorner.Parent = TouchPad

	Thumb.Name = "Thumb"
	Thumb.Size = UDim2.fromOffset(50, 50)
	Thumb.Position = UDim2.new(0.5, -25, 0.5, -25)
	Thumb.BackgroundColor3 = color
	Thumb.BackgroundTransparency = 0.2
	Thumb.BorderSizePixel = 0
	Thumb.AutoButtonColor = false
	Thumb.Parent = TouchPad

	local thumbCorner = Instance.new("UICorner")
	thumbCorner.CornerRadius = UDim.new(1, 0)
	thumbCorner.Parent = Thumb

	local dragging = false
	local currentInput = nil
	local startPos = Vector2.zero

	Thumb.InputBegan:Connect(function(input)

		if input.UserInputType == Enum.UserInputType.Touch
			or input.UserInputType == Enum.UserInputType.MouseButton1 then

			if not dragging then

				dragging = true
				currentInput = input
				startPos = input.Position

				if name == "Left" then
					leftLargeDragging = true
				else
					rightLargeDragging = true
				end
			end
		end
	end)

	UserInputService.InputChanged:Connect(function(input)

		if not dragging then
			return
		end

		if input ~= currentInput then
			return
		end

		local delta = input.Position - startPos

		local distance = math.clamp(delta.Magnitude, 0, 45)

		local direction

		if delta.Magnitude > 0 then
			direction = delta.Unit
		else
			direction = Vector2.zero
		end

		Thumb.Position =
			UDim2.new(
				0.5,
				-25 + direction.X * distance,
				0.5,
				-25 + direction.Y * distance
			)

		local strength = distance / 45

		if name == "Left" then

			leftJoyMove =
				Vector2.new(
					direction.X * strength,
					-direction.Y * strength
				)

		else

			rightJoyMove =
				Vector2.new(
					direction.X * strength,
					-direction.Y * strength
				)
		end
	end)

	UserInputService.InputEnded:Connect(function(input)

		if input ~= currentInput then
			return
		end

		dragging = false
		currentInput = nil

		if name == "Left" then
			leftLargeDragging = false
			leftJoyMove = Vector2.zero
		else
			rightLargeDragging = false
			rightJoyMove = Vector2.zero
		end
	end)
end

--==================================================
-- Z JOYSTICK
--==================================================

local function createJoystickZ(name, position, color)

	local TouchPad = Instance.new("Frame")
	local Thumb = Instance.new("ImageButton")

	TouchPad.Name = name .. "_Z_Pad"
	TouchPad.Size = UDim2.fromOffset(75, 75)
	TouchPad.Position = position
	TouchPad.BackgroundColor3 = Color3.fromRGB(20, 20, 20)
	TouchPad.BackgroundTransparency = 0.6
	TouchPad.BorderSizePixel = 0
	TouchPad.Active = true
	TouchPad.Parent = ScreenGui

	local padCorner = Instance.new("UICorner")
	padCorner.CornerRadius = UDim.new(1, 0)
	padCorner.Parent = TouchPad

	Thumb.Name = "Thumb"
	Thumb.Size = UDim2.fromOffset(30, 30)
	Thumb.Position = UDim2.new(0.5, -15, 0.5, -15)
	Thumb.BackgroundColor3 = color
	Thumb.BackgroundTransparency = 0.2
	Thumb.BorderSizePixel = 0
	Thumb.AutoButtonColor = false
	Thumb.Parent = TouchPad

	local thumbCorner = Instance.new("UICorner")
	thumbCorner.CornerRadius = UDim.new(1, 0)
	thumbCorner.Parent = Thumb

	local dragging = false
	local currentInput = nil

	local maxDistance = 25

	local function updateZ(input)

		local centerY =
			TouchPad.AbsolutePosition.Y +
			(TouchPad.AbsoluteSize.Y / 2)

		local relativeY =
			input.Position.Y - centerY

		local clampedY =
			math.clamp(relativeY, -maxDistance, maxDistance)

		Thumb.Position =
			UDim2.new(
				0.5,
				-15,
				0.5,
				-15 + clampedY
			)

		local strength =
			-clampedY / maxDistance

		if name == "Left" then
			leftZMove = strength
		else
			rightZMove = strength
		end
	end

	Thumb.InputBegan:Connect(function(input)

		if input.UserInputType == Enum.UserInputType.Touch
			or input.UserInputType == Enum.UserInputType.MouseButton1 then

			if not dragging then

				dragging = true
				currentInput = input

				updateZ(input)
			end
		end
	end)

	UserInputService.InputChanged:Connect(function(input)

		if dragging and input == currentInput then
			updateZ(input)
		end
	end)

	UserInputService.InputEnded:Connect(function(input)

		if dragging and input == currentInput then

			dragging = false
			currentInput = nil

			if name == "Left" then
				leftZMove = 0
			else
				rightZMove = 0
			end
		end
	end)
end

