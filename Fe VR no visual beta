-- --- HILO 1: ENTRADAS DE USUARIO, LERPS Y RED (RenderStepped) ---
-- Este evento corre a la máxima tasa de refresco de la pantalla para que la respuesta de tus dedos sea instantánea
RunService.RenderStepped:Connect(function()
    
    -- Retorno suave Lerp si soltamos los Joysticks Grandes
    if not leftLargeDragging then
        leftJoyMove = leftJoyMove:Lerp(Vector2.new(0, 0), 0.07)
        local pad = ScreenGui:FindFirstChild(string.char(73,122,113,117,105,101,114,100,111,95,80,97,100))
        local thumb = pad and pad:FindFirstChild(string.char(84,104,117,109,98))
        if thumb then thumb.Position = thumb.Position:Lerp(UDim2.new(0.5, -25, 0.5, -25), 0.07) end
    end
    
    if not rightLargeDragging then
        rightJoyMove = rightJoyMove:Lerp(Vector2.new(0, 0), 0.07)
        local pad = ScreenGui:FindFirstChild(string.char(68,101,114,101,99,104,111,95,80,97,100))
        local thumb = pad and pad:FindFirstChild(string.char(84,104,117,109,98))
        if thumb then thumb.Position = thumb.Position:Lerp(UDim2.new(0.5, -25, 0.5, -25), 0.07) end
    end

    local char = plr.Character
    if char and char:FindFirstChild(string.char(72,117,109,97,110,111,105,100,82,111,111,116,80,97,114,116)) then
        local rootCF = char.HumanoidRootPart.CFrame

        -- HEAD TRACKING VR (AMAN / TANPA MEMINDAHKAN KEPALA)
        -- Hanya rotasi joint leher yang diubah. Posisi kepala tetap milik rig,
        -- sehingga kepala tidak terlempar/hilang saat kamera bergerak.
        local cameraLook = cam.CFrame.LookVector
        local localLook = rootCF:VectorToObjectSpace(cameraLook)

        local rawYaw = math.atan2(-localLook.X, -localLook.Z)
        local HEAD_SIDE_LIMIT = math.rad(85)

        -- Sisi kiri/kanan boleh mengikuti kamera. Saat sudah mengarah belakang,
        -- kepala kembali menghadap depan. Kamera tetap bebas 360 derajat.
        headYaw = rawYaw
        if math.abs(rawYaw) > HEAD_SIDE_LIMIT then
            headYaw = 0
        end

        -- Arah vertikal mengikuti kamera: lihat atas = kepala atas.
        headPitch = math.asin(math.clamp(localLook.Y, -1, 1))

        local neck = char:FindFirstChild(string.char(78,101,99,107), true)
        if neck and neck.Part0 and neck.Part1 then
            -- headCF untuk server memakai posisi/orientasi dasar joint leher.
            local neckWorld = neck.Part0.CFrame * neck.C0
            headCF = neckWorld * CFrame.Angles(headPitch, headYaw, 0)
        else
            headCF = rootCF * CFrame.new(0, 1.5, 0) * CFrame.Angles(headPitch, headYaw, 0)
        end

        local currentZ_Left = math.clamp(-1.2 - (leftZMove * 1.2), -2.2, -0.5)
        local currentZ_Right = math.clamp(-1.2 - (rightZMove * 1.2), -2.2, -0.5)
        
        leftHandCF = rootCF 
            * CFrame.new(-1.2 + math.clamp(leftJoyMove.X * 1.4, -1.4, 1.4), 0.5 + math.clamp(leftJoyMove.Y * 1.4, -1.4, 1.4), currentZ_Left) 
            * CFrame.Angles(math.rad(leftJoyMove.Y * 45 + leftArmPitch * 70), math.rad(-leftJoyMove.X * 30), math.rad(-leftJoyMove.X * 20))
        
        rightHandCF = rootCF 
            * CFrame.new(1.2 + math.clamp(rightJoyMove.X * 1.4, -1.4, 1.4), 0.5 + math.clamp(rightJoyMove.Y * 1.4, -1.4, 1.4), currentZ_Right) 
            * CFrame.Angles(math.rad(rightJoyMove.Y * 45 + rightArmPitch * 70), math.rad(-rightJoyMove.X * 30), math.rad(rightJoyMove.X * 20))

        -- ESPEJO LOCAL IMEDIATO: aplica las manos en RenderStepped para que
        -- el movimiento del cuerpo durante salto/caída no se sienta retrasado.
        -- La posición objetivo sigue calculándose desde el HumanoidRootPart actual.
        local leftShoulder = char:FindFirstChild(string.char(76,101,102,116,32,83,104,111,117,108,100,101,114), true) or char:FindFirstChild(string.char(76,101,102,116,83,104,111,117,108,100,101,114), true)
        local rightShoulder = char:FindFirstChild(string.char(82,105,103,104,116,32,83,104,111,117,108,100,101,114), true) or char:FindFirstChild(string.char(82,105,103,104,116,83,104,111,117,108,100,101,114), true)
        if leftShoulder and leftShoulder.Part0 then
            leftShoulder.Transform = leftShoulder.C0:Inverse() * leftShoulder.Part0.CFrame:Inverse() * leftHandCF * leftShoulder.C1
        end
        if rightShoulder and rightShoulder.Part0 then
            rightShoulder.Transform = rightShoulder.C0:Inverse() * rightShoulder.Part0.CFrame:Inverse() * rightHandCF * rightShoulder.C1
        end
        
        -- Filtro de tiempo para quitar la pesadez de red
        local tActual = os.clock()
        if tActual - tAnterior >= TASA_ENVIO then
            remote:FireServer(headCF, leftHandCF, rightHandCF)
            tAnterior = tActual
        end
    end
end)


-- --- HILO 2: MODIFICACIONES FÍSICAS Y ESPEJO LOCAL INMUNE (Stepped) ---
-- Este evento corre de forma nativa justo antes del motor de física y de las animaciones de Roblox,
-- logrando un No-Clip ultra suave y previniendo que los brazos parpadeen o tiemblen en tu pantalla.
RunService.Stepped:Connect(function()
    
    -- [MEJORA APLICADA]: NO-CLIP OPTIMIZADO (Busca solo BaseParts en el primer nivel del personaje, ahorrando 80% de CPU)
    for _, otroPlr in ipairs(Players:GetPlayers()) do
        if otroPlr ~= plr and otroPlr.Character then
            for _, parte in ipairs(otroPlr.Character:GetChildren()) do
                if parte:IsA(string.char(66,97,115,101,80,97,114,116)) then
                    parte.CanCollide = false
                end
            end
        end
    end
    
    -- [MEJORA APLICADA]: ESPEJO LOCAL ESTABLE (Le gana a las animaciones de Roblox al ejecutarse en Stepped)
    local char = plr.Character
    if char then
        local neck = char:FindFirstChild(string.char(78,101,99,107), true)
        local leftShoulder = char:FindFirstChild(string.char(76,101,102,116,32,83,104,111,117,108,100,101,114), true) or char:FindFirstChild(string.char(76,101,102,116,83,104,111,117,108,100,101,114), true)
        local rightShoulder = char:FindFirstChild(string.char(82,105,103,104,116,32,83,104,111,117,108,100,101,114), true) or char:FindFirstChild(string.char(82,105,103,104,116,83,104,111,117,108,100,101,114), true)
        
        -- Forzar los joints del personaje local a ignorar por completo las animaciones activas en el juego
        if neck and neck.Part0 and neck.Part1 then
            -- PENTING: jangan mengubah posisi Motor6D. Hanya rotasi kepala.
            -- Ini mencegah kepala hilang/terlempar dari badan.
            neck.Transform = CFrame.Angles(headPitch, headYaw, 0)
        end
        if leftShoulder and leftShoulder.Part0 then
            leftShoulder.Transform = leftShoulder.C0:Inverse() * leftShoulder.Part0.CFrame:Inverse() * leftHandCF * leftShoulder.C1
        end
        if rightShoulder and rightShoulder.Part0 then
            rightShoulder.Transform = rightShoulder.C0:Inverse() * rightShoulder.Part0.CFrame:Inverse() * rightHandCF * rightShoulder.C1
        end
    end
end)
