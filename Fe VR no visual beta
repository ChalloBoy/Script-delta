--==================================================
-- LOCAL TRANSPARENCY
--==================================================

local function saveAndHidePart(part)

	if not part or not part:IsA("BasePart") then
		return
	end

	if hiddenLocally[part] == nil then
		hiddenLocally[part] =
			part.LocalTransparencyModifier
	end

	part.LocalTransparencyModifier = 1
end

local function saveAndHideTexture(obj)

	if not obj then
		return
	end

	if hiddenLocally[obj] == nil then
		hiddenLocally[obj] =
			obj.Transparency
	end

	obj.Transparency = 1
end

--==================================================
-- HEAD ACCESSORY DETECTION
--==================================================

local function isHeadAccessory(accessory)

	if not accessory:IsA("Accessory") then
		return false
	end

	local t = accessory.AccessoryType

	if t == Enum.AccessoryType.Hair then
		return true
	end

	if t == Enum.AccessoryType.Hat then
		return true
	end

	if t == Enum.AccessoryType.Face then
		return true
	end

	if t == Enum.AccessoryType.Neck then
		return true
	end

	return false
end

--==================================================
-- VR VISIBILITY
--==================================================

local function updateVRHeadVisibility()

	if not vrCameraEnabled then
		return
	end

	local char = plr.Character

	if not char then
		return
	end

	for _, obj in ipairs(char:GetDescendants()) do

		if obj:IsA("BasePart") then

			local shouldHide = false

			if obj.Name == "Head" then
				shouldHide = true
			end

			local accessory =
				obj:FindFirstAncestorOfClass("Accessory")

			if accessory and isHeadAccessory(accessory) then
				shouldHide = true
			end

			if shouldHide then

				saveAndHidePart(obj)

			else

				-- VERY IMPORTANT
				-- Body / arms / legs remain visible.
				obj.LocalTransparencyModifier = 0
			end

		elseif
			obj:IsA("Decal")
			or
			obj:IsA("Texture")
		then

			local shouldHide = false

			if obj.Parent and obj.Parent.Name == "Head" then
				shouldHide = true
			end

			local accessory =
				obj:FindFirstAncestorOfClass("Accessory")

			if accessory and isHeadAccessory(accessory) then
				shouldHide = true
			end

			if shouldHide then
				saveAndHideTexture(obj)
			end
		end
	end
end

--==================================================
-- RESTORE NORMAL VISIBILITY
--==================================================

local function restoreLocalHeadVisibility()

	for obj, oldValue in pairs(hiddenLocally) do

		if obj and obj.Parent then

			if obj:IsA("BasePart") then

				obj.LocalTransparencyModifier =
					oldValue

			elseif
				obj:IsA("Decal")
				or
				obj:IsA("Texture")
			then

				obj.Transparency =
					oldValue
			end
		end
	end

	table.clear(hiddenLocally)

	local char = plr.Character

	if char then

		for _, obj in ipairs(char:GetDescendants()) do

			if obj:IsA("BasePart") then
				obj.LocalTransparencyModifier = 0
			end
		end
	end
end

--==================================================
-- CALCULATE HEAD OFFSET
--==================================================

local function getHeadCameraOffset(char)

	local root =
		char:FindFirstChild("HumanoidRootPart")

	local head =
		char:FindFirstChild("Head")

	if not root or not head then
		return Vector3.zero
	end

	-- Head position relative to HumanoidRootPart.
	local localHead =
		root.CFrame:PointToObjectSpace(
			head.Position
		)

	return localHead
end

--==================================================
-- CAMERA VR
--==================================================

local function enableVRCamera()

	local char = plr.Character

	local humanoid =
		char and char:FindFirstChildOfClass("Humanoid")

	if not humanoid then
		return
	end

	-- Save normal camera state.
	savedCameraType =
		cam.CameraType

	savedCameraSubject =
		cam.CameraSubject

	savedCameraFOV =
		cam.FieldOfView

	savedMinZoom =
		plr.CameraMinZoomDistance

	savedMaxZoom =
		plr.CameraMaxZoomDistance

	savedCameraOffset =
		humanoid.CameraOffset

	cameraMode = "VR"
	vrCameraEnabled = true

	-- Roblox camera stays Custom.
	cam.CameraType =
		Enum.CameraType.Custom

	cam.CameraSubject =
		humanoid

	-- Roblox controls the camera distance.
	-- We do NOT set cam.CFrame every frame.
	plr.CameraMinZoomDistance = 0.5
	plr.CameraMaxZoomDistance = 0.5

	-- Move the camera toward the avatar's head
	-- using Humanoid.CameraOffset.
	humanoid.CameraOffset =
		getHeadCameraOffset(char)

	updateVRHeadVisibility()

	CameraBtn.Text =
		"Camera: VR"
end

--==================================================
-- CAMERA NORMAL
--==================================================

local function enableNormalCamera()

	local char = plr.Character

	local humanoid =
		char and char:FindFirstChildOfClass("Humanoid")

	cameraMode = "NORMAL"
	vrCameraEnabled = false

	-- Restore head/body.
	restoreLocalHeadVisibility()

	-- Always return to Roblox normal camera.
	cam.CameraType =
		Enum.CameraType.Custom

	if humanoid then

		cam.CameraSubject =
			humanoid

		if savedCameraOffset then

			humanoid.CameraOffset =
				savedCameraOffset

		else

			humanoid.CameraOffset =
				Vector3.zero
		end
	end

	if savedCameraFOV then
		cam.FieldOfView =
			savedCameraFOV
	end

	plr.CameraMinZoomDistance =
		savedMinZoom

	plr.CameraMaxZoomDistance =
		savedMaxZoom

	CameraBtn.Text =
		"Camera: NORMAL"
end

