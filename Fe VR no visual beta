    local Thumb=Instance.new(string.char(70,114,97,109,101),Pad)
    Thumb.Name=string.char(84,104,117,109,98); Thumb.Size=UDim2.new(0,34,0,34); Thumb.Position=UDim2.new(.5,-17,.5,-17)
    Thumb.BackgroundColor3=color; Thumb.BackgroundTransparency=.15; Thumb.BorderSizePixel=0; Thumb.Active=true
    local tc=Instance.new(string.char(85,73,67,111,114,110,101,114),Thumb); tc.CornerRadius=UDim.new(1,0)
    local dragging=false; local currentInput=nil; local maxDistance=32
    local function update(input)
        local centerY=Pad.AbsolutePosition.Y+Pad.AbsoluteSize.Y/2
        local y=math.clamp(input.Position.Y-centerY,-maxDistance,maxDistance)
        Thumb.Position=UDim2.new(.5,-17,.5,-17+y)
        local v=math.clamp(-y/maxDistance,-1,1)
        if nombre==string.char(73,122,113,117,105,101,114,100,111) then leftArmPitch=v else rightArmPitch=v end
    end
    Thumb.InputBegan:Connect(function(input)
        if (input.UserInputType==Enum.UserInputType.Touch or input.UserInputType==Enum.UserInputType.MouseButton1) and not dragging then
            dragging=true; currentInput=input; update(input)
        end
    end)
    UserInputService.InputChanged:Connect(function(input) if dragging and input==currentInput then update(input) end end)
    UserInputService.InputEnded:Connect(function(input) if dragging and input==currentInput then dragging=false; currentInput=nil end end)
end

