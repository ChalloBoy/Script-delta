local speed = 50
local MIN_SPEED = 10
local MAX_SPEED = 200
local SPEED_STEP = 10

local enabled = false
local flying = false

local savedCFrame
local noclipConnection
local flyConnection

--==================================================
-- CHARACTER
--==================================================

local function getCharacter()
	return player.Character or player.CharacterAdded:Wait()
end

local function getRoot()
	local character = getCharacter()
	return character:FindFirstChild("HumanoidRootPart")
end

--==================================================
-- FULL NOCLIP
--==================================================

local function setNoclip(state)
	local character = player.Character

	if character then
		for _, obj in ipairs(character:GetDescendants()) do
			if obj:IsA("BasePart") then
				obj.CanCollide = not state
			end
		end
	end
end

local function startNoclip()
	if noclipConnection then
		noclipConnection:Disconnect()
	end

	noclipConnection = RunService.Stepped:Connect(function()
		if enabled then
			setNoclip(true)
		end
	end)

	setNoclip(true)
end

local function stopNoclip()
	if noclipConnection then
		noclipConnection:Disconnect()
		noclipConnection = nil
	end

	setNoclip(false)
end

--==================================================
-- FLY
--==================================================

local function stopFly()
	if flyConnection then
		flyConnection:Disconnect()
		flyConnection = nil
	end

	local root = getRoot()

	if root then
		root.AssemblyLinearVelocity = Vector3.zero
		root.AssemblyAngularVelocity = Vector3.zero
	end
end

local function flyTo(target)
	local root = getRoot()

	if not root then
		return false
	end

	local reached = false

	flyConnection = RunService.Heartbeat:Connect(function(dt)
		if not enabled then
			reached = true
			return
		end

		if not root.Parent then
			reached = true
			return
		end

		-- Pastikan noclip tetap aktif
		setNoclip(true)

		local current = root.Position
		local offset = target - current
		local distance = offset.Magnitude

		if distance <= 2.5 then
			root.CFrame = CFrame.new(target)
			root.AssemblyLinearVelocity = Vector3.zero
			reached = true
			return
		end

		local direction = offset.Unit

		-- Gerakan 3D langsung:
		-- bisa naik, turun, menembus lantai dan dinding
		local moveDistance = math.min(speed * dt, distance)
		local newPosition = current + direction * moveDistance

		root.CFrame = CFrame.lookAt(
			newPosition,
			newPosition + direction
		)

		root.AssemblyLinearVelocity = Vector3.zero
	end)

	while enabled and not reached do
		RunService.Heartbeat:Wait()
	end

	if flyConnection then
		flyConnection:Disconnect()
		flyConnection = nil
	end

	return enabled
end

