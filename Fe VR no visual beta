--[[
    VR STYLE MOBILE CONTROLLER - UPDATED
    Untuk game Roblox milik sendiri.

    UPDATE:
    • Kepala mengikuti kamera secara halus.
    • Kepala tidak langsung memutar seluruh badan ketika melihat belakang.
    • Badan menyusul arah kamera dengan delay/lerp (deadzone).
    • Tangan kiri/kanan bergerak halus seperti controller VR.
    • Idle hand motion ringan.
    • UI RGB halus.
    • UI bisa disembunyikan.
    • Tidak mengubah collision pemain lain.
]]

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")

local player = Players.LocalPlayer
local camera = workspace.CurrentCamera
local playerGui = player:WaitForChild("PlayerGui")

-- ================= SETTINGS =================
local BODY_FOLLOW_SPEED = 6
local HEAD_SMOOTH_SPEED = 16
local HAND_SMOOTH_SPEED = 18

local HEAD_MAX_YAW = math.rad(80)
local HEAD_MAX_PITCH = math.rad(55)
local BODY_DEADZONE = math.rad(20)

local HAND_X = 1.15
local HAND_Y = 0.35
local HAND_Z = -1.0

-- ================= STATE =================
local leftJoy = Vector2.zero
local rightJoy = Vector2.zero
local leftZ = 0
local rightZ = 0

local headCF = CFrame.new()
local leftHandCF = CFrame.new()
local rightHandCF = CFrame.new()

local bodyYaw = 0
local initialized = false

local function shortestAngle(a)
    return math.atan2(math.sin(a), math.cos(a))
end

local function smoothCF(current, target, speed, dt)
    local alpha = 1 - math.exp(-speed * dt)
    return current:Lerp(target, alpha)
end

local function hsv(t, offset)
    return Color3.fromHSV((t * 0.10 + offset) % 1, 0.85, 1)
end

-- ================= UI =================
local old = playerGui:FindFirstChild("VRStyleMobileUI")
if old then old:Destroy() end

local gui = Instance.new("ScreenGui")
gui.Name = "VRStyleMobileUI"
gui.ResetOnSpawn = false
gui.IgnoreGuiInset = true
gui.DisplayOrder = 100
gui.Parent = playerGui

local pads = {}

local function makeJoystick(name, position, size, thumbSize, isZ, rgbOffset)
    local pad = Instance.new("Frame")
    pad.Name = name
    pad.Size = size
    pad.Position = position
    pad.BackgroundColor3 = Color3.fromRGB(18,18,22)
    pad.BackgroundTransparency = 0.25
    pad.BorderSizePixel = 0
    pad.Active = true
    pad.Parent = gui

    local corner = Instance.new("UICorner")
    corner.CornerRadius = UDim.new(1,0)
    corner.Parent = pad

    local stroke = Instance.new("UIStroke")
    stroke.Thickness = 2
    stroke.Transparency = 0.05
    stroke.Parent = pad

    local thumb = Instance.new("ImageButton")
    thumb.Name = "Thumb"
    thumb.Size = thumbSize
    thumb.AnchorPoint = Vector2.new(0.5,0.5)
    thumb.Position = UDim2.fromScale(0.5,0.5)
    thumb.BackgroundColor3 = Color3.new(1,1,1)
    thumb.BackgroundTransparency = 0.05
    thumb.BorderSizePixel = 0
    thumb.AutoButtonColor = false
    thumb.Parent = pad

    local tc = Instance.new("UICorner")
    tc.CornerRadius = UDim.new(1,0)
    tc.Parent = thumb

    pads[name] = {
        pad = pad,
        thumb = thumb,
        stroke = stroke,
        isZ = isZ,
        rgbOffset = rgbOffset,
        dragging = false,
        input = nil,
    }
end

makeJoystick("LeftJoystick", UDim2.new(0,35,1,-175),
