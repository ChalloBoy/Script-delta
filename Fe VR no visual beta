local handFolder = Instance.new("Folder")

handFolder.Name = "MobileVRHands"
handFolder.Parent = workspace

local function createHand(name)

	local hand = Instance.new("Part")

	hand.Name = name

	hand.Size = Vector3.new(
		0.35,
		0.35,
		0.65
	)

	hand.Anchored = true
	hand.CanCollide = false
	hand.CanTouch = false
	hand.CanQuery = false

	hand.Material = Enum.Material.SmoothPlastic

	hand.Parent = handFolder

	return hand

end

local leftHand = createHand("LeftHand")
local rightHand = createHand("RightHand")

--========================================================--
-- HAND VARIABLES
--========================================================--

local leftX = 0
local leftY = 0

local rightX = 0
local rightY = 0

local targetLeftX = 0
local targetLeftY = 0

local targetRightX = 0
local targetRightY = 0

local leftGrip = false
local rightGrip = false

--========================================================--
-- SWING SYSTEM
--========================================================--

local leftSwing = 0
local rightSwing = 0

local lastLeftX = 0
local lastLeftY = 0

local lastRightX = 0
local lastRightY = 0

local function updateSwing()

	local leftMovement =
		math.abs(leftX - lastLeftX) +
		math.abs(leftY - lastLeftY)

	local rightMovement =
		math.abs(rightX - lastRightX) +
		math.abs(rightY - lastRightY)

	leftSwing = math.clamp(
		leftMovement * 12,
		0,
		1
	)

	rightSwing = math.clamp(
		rightMovement * 12,
		0,
		1
	)

	lastLeftX = leftX
	lastLeftY = leftY

	lastRightX = rightX
	lastRightY = rightY

end

