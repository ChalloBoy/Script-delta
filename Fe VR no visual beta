--========================================================--
-- MAIN UPDATE
--========================================================--

RunService.RenderStepped:Connect(function(dt)

	if not character
		or not root then
		return
	end

	--================================================--
	-- CAMERA SMOOTH
	--================================================--

	cameraYaw +=
		(targetYaw - cameraYaw) *
		Settings.CameraSmooth

	cameraPitch +=
		(targetPitch - cameraPitch) *
		Settings.CameraSmooth

	--================================================--
	-- VR FINAL LIMIT
	--================================================--

	if CameraMode == "VR" then

		local bodyYaw =
			getBodyYaw()

		local relative =
			normalizeAngle(
				cameraYaw - bodyYaw
			)

		relative =
			math.clamp(

				relative,

				-Settings.VRMaxYaw,

				Settings.VRMaxYaw

			)

		cameraYaw =
			bodyYaw + relative

	end

	--================================================--
	-- CAMERA
	--================================================--

	local cameraPosition =
		root.Position +
		Vector3.new(0,1.6,0)

	local rotation =

		CFrame.Angles(
			0,
			cameraYaw,
			0
		) *

		CFrame.Angles(
			cameraPitch,
			0,
			0
		)

	camera.CFrame =
		CFrame.new(cameraPosition) *
		rotation

	camera.CameraType =
		Enum.CameraType.Scriptable

	--================================================--
	-- HAND SMOOTH
	--================================================--

	leftX +=
		(targetLeftX - leftX) *
		Settings.HandSmooth

	leftY +=
		(targetLeftY - leftY) *
		Settings.HandSmooth

	rightX +=
		(targetRightX - rightX) *
		Settings.HandSmooth

	rightY +=
		(targetRightY - rightY) *
		Settings.HandSmooth

	updateSwing()

	--================================================--
	-- HAND DIRECTION
	--================================================--

	local bodyYaw =
		getBodyYaw()

	local cameraRelative =
		normalizeAngle(
			cameraYaw - bodyYaw
		)

	-- Tangan tidak mengikuti kamera
	-- sampai ke belakang.
	local handBaseYaw =
		math.clamp(

			cameraRelative,

			-Settings.MaxHandYaw,

			Settings.MaxHandYaw

		)

	--================================================--
	-- LEFT HAND
	--================================================--

	local leftYaw =
		handBaseYaw + leftX

	local leftPitch =
		math.clamp(

			leftY,

			-Settings.MaxHandPitch,

			Settings.MaxHandPitch

		)

	-- Swing
	local leftSwingOffset =
		math.sin(
			os.clock() *
			Settings.SwingSpeed
		) *
		leftSwing *
		Settings.SwingPower

	local leftRotation =

		CFrame.Angles(
			0,
			leftYaw,
			0
		) *

		CFrame.Angles(
			leftPitch +
			leftSwingOffset,
			0,
			0
		)

	local leftOffset =
		leftRotation:VectorToWorldSpace(

			Vector3.new(

				-Settings.HandSide,

				Settings.HandHeight,

				-Settings.HandDistance

			)

		)

	local leftPosition =
		root.Position +
		leftOffset

	leftHand.CFrame =
		CFrame.lookAt(

			leftPosition,

			leftPosition +
			leftRotation.LookVector

		)

	--================================================--
	-- RIGHT HAND
	--================================================--

	local rightYaw =
		handBaseYaw + rightX

	local rightPitch =
		math.clamp(

			rightY,

			-Settings.MaxHandPitch,

			Settings.MaxHandPitch

		)

	local rightSwingOffset =
		math.sin(
			os.clock() *
			Settings.SwingSpeed +
			math.pi
		) *
		rightSwing *
		Settings.SwingPower

	local rightRotation =

		CFrame.Angles(
			0,
			rightYaw,
			0
		) *

		CFrame.Angles(
			rightPitch +
			rightSwingOffset,
			0,
			0
		)

	local rightOffset =
		rightRotation:VectorToWorldSpace(

			Vector3.new(

				Settings.HandSide,

				Settings.HandHeight,

				-Settings.HandDistance

			)

		)

	local rightPosition =
		root.Position +
		rightOffset

	rightHand.CFrame =
		CFrame.lookAt(

			rightPosition,

			rightPosition +
			rightRotation.LookVector

		)

	--================================================--
	-- GRIP SIZE
	--================================================--

	if leftGrip then

		leftHand.Size =
			Vector3.new(
				0.28,
				0.28,
				0.48
			)

	else

		leftHand.Size =
			Vector3.new(
				0.35,
				0.35,
				0.65
			)

	end

	if rightGrip then

		rightHand.Size =
			Vector3.new(
				0.28,
				0.28,
				0.48
			)

	else

		rightHand.Size =
			Vector3.new(
				0.35,
				0.35,
				0.65
			)

	end

	--================================================--
	-- MOVEMENT
	--================================================--

	if humanoid then

		local forward =
			Vector3.new(

				math.sin(cameraYaw),
				0,
				math.cos(cameraYaw)

			)

		local right =
			Vector3.new(

				math.cos(cameraYaw),
				0,
				-math.sin(cameraYaw)

			)

		local direction =

			right * moveVector.X +

			forward * (-moveVector.Y)

		if direction.Magnitude > 0.05 then

			humanoid:Move(
				direction.Unit,
				false
			)

		else

			humanoid:Move(
				Vector3.zero,
				false
			)

		end

	end

end)

