--==================================================
-- JOYSTICK X/Y
--==================================================

local function crearJoystick(nombre, posicion, color)

	local TouchPad = Instance.new("Frame")
	local Thumb = Instance.new("ImageButton")

	TouchPad.Name = nombre .. "_Pad"
	TouchPad.Size = UDim2.new(0,125,0,125)
	TouchPad.Position = posicion

	TouchPad.BackgroundColor3 =
		Color3.fromRGB(20,20,20)

	TouchPad.BackgroundTransparency = 0.6
	TouchPad.BorderSizePixel = 0
	TouchPad.Active = true

	TouchPad.Parent = ScreenGui

	local uiCorner = Instance.new("UICorner")

	uiCorner.CornerRadius =
		UDim.new(1,0)

	uiCorner.Parent = TouchPad

	Thumb.Name = "Thumb"

	Thumb.Size =
		UDim2.new(0,50,0,50)

	Thumb.Position =
		UDim2.new(0.5,-25,0.5,-25)

	Thumb.BackgroundColor3 = color
	Thumb.BackgroundTransparency = 0.2
	Thumb.BorderSizePixel = 0

	Thumb.Parent = TouchPad

	local thumbCorner = Instance.new("UICorner")

	thumbCorner.CornerRadius =
		UDim.new(1,0)

	thumbCorner.Parent = Thumb

	local dragging = false
	local startPos = Vector2.zero
	local currentInput = nil

	Thumb.InputBegan:Connect(function(input)

		if
			input.UserInputType == Enum.UserInputType.Touch
			or
			input.UserInputType == Enum.UserInputType.MouseButton1
		then

			if not dragging then

				dragging = true
				startPos = input.Position
				currentInput = input

				if nombre == "Derecho" then
					rightLargeDragging = true
				else
					leftLargeDragging = true
				end
			end
		end
	end)

	UserInputService.InputChanged:Connect(function(input)

		if not dragging then
			return
		end

		if input ~= currentInput then
			return
		end

		local delta =
			input.Position - startPos

		local distance =
			math.clamp(
				delta.Magnitude,
				0,
				45
			)

		local direction =
			delta.Magnitude > 0
			and delta.Unit
			or Vector2.zero

		Thumb.Position =
			UDim2.new(
				0.5,
				-25 + direction.X * distance,
				0.5,
				-25 + direction.Y * distance
			)

		local intensidad =
			distance / 45

		if nombre == "Derecho" then

			rightJoyMove =
				Vector2.new(
					direction.X * intensidad,
					-direction.Y * intensidad
				)

		else

			leftJoyMove =
				Vector2.new(
					direction.X * intensidad,
					-direction.Y * intensidad
				)
		end
	end)

	UserInputService.InputEnded:Connect(function(input)

		if input ~= currentInput then
			return
		end

		dragging = false
		currentInput = nil

		if nombre == "Derecho" then

			rightLargeDragging = false
			rightJoyMove = Vector2.zero

		else

			leftLargeDragging = false
			leftJoyMove = Vector2.zero
		end
	end)
end

