--==================================================
-- RENDER STEPPED
--==================================================

RunService.RenderStepped:Connect(function(deltaTime)

	--==============================================
	-- SMOOTH JOYSTICKS
	--==============================================

	if not leftLargeDragging then

		leftJoyMove =
			leftJoyMove:Lerp(
				Vector2.zero,
				0.07
			)

		local pad =
			ScreenGui:FindFirstChild(
				"Izquierdo_Pad"
			)

		local thumb =
			pad and pad:FindFirstChild("Thumb")

		if thumb then

			thumb.Position =
				thumb.Position:Lerp(
					UDim2.new(
						0.5,-25,
						0.5,-25
					),
					0.07
				)
		end
	end

	if not rightLargeDragging then

		rightJoyMove =
			rightJoyMove:Lerp(
				Vector2.zero,
				0.07
			)

		local pad =
			ScreenGui:FindFirstChild(
				"Derecho_Pad"
			)

		local thumb =
			pad and pad:FindFirstChild("Thumb")

		if thumb then

			thumb.Position =
				thumb.Position:Lerp(
					UDim2.new(
						0.5,-25,
						0.5,-25
					),
					0.07
				)
		end
	end

	--==============================================
	-- CHARACTER
	--==============================================

	local char = plr.Character

	if not char then
		return
	end

	local root =
		char:FindFirstChild("HumanoidRootPart")

	if not root then
		return
	end

	--==============================================
	-- VR CAMERA OFFSET
	--==============================================

	if vrCameraEnabled then

		local humanoid =
			char:FindFirstChildOfClass("Humanoid")

		if humanoid then

			humanoid.CameraOffset =
				getHeadCameraOffset(char)
		end

		-- Re-apply ONLY head hiding.
		-- Body remains visible.
		updateVRHeadVisibility()
	end

	local rootCF =
		root.CFrame

	--==============================================
	-- HEAD ROTATION
	--==============================================

	local lookX, lookY, lookZ =
		cam.CFrame:ToEulerAnglesXYZ()

	headCF =
		CFrame.new(
			rootCF.Position
			+
			Vector3.new(0,2,0)
		)
		*
		CFrame.Angles(
			lookX,
			lookY,
			lookZ
		)

	--==============================================
	-- LEFT HAND
	--==============================================

	local currentZ_Left =
		math.clamp(
			-1.2 -
			(leftZMove * 1.2),
			-2.2,
			-0.5
		)

	leftHandCF =
		rootCF
		*
		CFrame.new(
			-1.2
			+
			math.clamp(
				leftJoyMove.X * 1.4,
				-1.4,
				1.4
			),

			0.5
			+
			math.clamp(
				leftJoyMove.Y * 1.4,
				-1.4,
				1.4
			),

			currentZ_Left
		)
		*
		CFrame.Angles(
			math.rad(
				leftJoyMove.Y * 45
			),

			math.rad(
				-leftJoyMove.X * 30
			),

			math.rad(
				-leftJoyMove.X * 20
			)
		)

	--==============================================
	-- RIGHT HAND
	--==============================================

	local currentZ_Right =
		math.clamp(
			-1.2 -
			(rightZMove * 1.2),
			-2.2,
			-0.5
		)

	rightHandCF =
		rootCF
		*
		CFrame.new(
			1.2
			+
			math.clamp(
				rightJoyMove.X * 1.4,
				-1.4,
				1.4
			),

			0.5
			+
			math.clamp(
				rightJoyMove.Y * 1.4,
				-1.4,
				1.4
			),

			currentZ_Right
		)
		*
		CFrame.Angles(
			math.rad(
				rightJoyMove.Y * 45
			),

			math.rad(
				-rightJoyMove.X * 30
			),

			math.rad(
				rightJoyMove.X * 20
			)
		)

	--==============================================
	-- SEND VR DATA
	--==============================================

	local tActual =
		os.clock()

	if tActual - tAnterior >=
		TASA_ENVIO
	then

		pcall(function()

			remote:FireServer(
				headCF,
				leftHandCF,
				rightHandCF
			)

		end)

		tAnterior =
			tActual
	end
end)

--==================================================
-- STEPPED
--==================================================

RunService.Stepped:Connect(function()

	--==============================================
	-- OTHER PLAYERS NO COLLISION
	--==============================================

	for _, otroPlr in ipairs(
		Players:GetPlayers()
	) do

		if
			otroPlr ~= plr
			and
			otroPlr.Character
		then

			for _, parte in ipairs(
				otroPlr.Character:GetChildren()
			) do

				if parte:IsA("BasePart") then
					parte.CanCollide = false
				end
			end
		end
	end

	--==============================================
	-- LOCAL BODY MIRROR
	--==============================================

	local char =
		plr.Character

	if not char then
		return
	end

	local neck =
		char:FindFirstChild(
			"Neck",
			true
		)

	local leftShoulder =
		char:FindFirstChild(
			"Left Shoulder",
			true
		)
		or
		char:FindFirstChild(
			"LeftShoulder",
			true
		)

	local rightShoulder =
		char:FindFirstChild(
			"Right Shoulder",
			true
		)
		or
		char:FindFirstChild(
			"RightShoulder",
			true
		)

	--==============================================
	-- NECK
	--==============================================

	if
		neck
		and
		neck.Part0
	then

		pcall(function()

			neck.Transform =
				neck.C0:Inverse()
				*
				neck.Part0.CFrame:Inverse()
				*
				headCF
				*
				neck.C1

		end)
	end

	--==============================================
	-- LEFT SHOULDER
	--==============================================

	if
		leftShoulder
		and
		leftShoulder.Part0
	then

		pcall(function()

			leftShoulder.Transform =
				leftShoulder.C0:Inverse()
				*
				leftShoulder.Part0.CFrame:Inverse()
				*
				leftHandCF
				*
				leftShoulder.C1

		end)
	end

	--==============================================
	-- RIGHT SHOULDER
	--==============================================

	if
		rightShoulder
		and
		rightShoulder.Part0
	then

		pcall(function()

			rightShoulder.Transform =
				rightShoulder.C0:Inverse()
				*
