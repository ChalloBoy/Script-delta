local function crearJoystickZ(nombre, posicion, color)

	local TouchPad = Instance.new("Frame")
	local Thumb = Instance.new("ImageButton")

	TouchPad.Name = nombre .. "_Z_Pad"

	TouchPad.Size =
		UDim2.new(0,75,0,75)

	TouchPad.Position = posicion

	TouchPad.BackgroundColor3 =
		Color3.fromRGB(20,20,20)

	TouchPad.BackgroundTransparency = 0.6
	TouchPad.BorderSizePixel = 0
	TouchPad.Active = true

	TouchPad.Parent = ScreenGui

	local uiCorner = Instance.new("UICorner")

	uiCorner.CornerRadius =
		UDim.new(1,0)

	uiCorner.Parent = TouchPad

	Thumb.Name = "Thumb"

	Thumb.Size =
		UDim2.new(0,30,0,30)

	Thumb.Position =
		UDim2.new(0.5,-15,0.5,-15)

	Thumb.BackgroundColor3 = color
	Thumb.BackgroundTransparency = 0.2
	Thumb.BorderSizePixel = 0

	Thumb.Parent = TouchPad

	local thumbCorner = Instance.new("UICorner")

	thumbCorner.CornerRadius =
		UDim.new(1,0)

	thumbCorner.Parent = Thumb

	local dragging = false
	local currentInput = nil

	local maxDistance = 25

	local function actualizarExtensionZ(input)

		local centerY =
			TouchPad.AbsolutePosition.Y
			+
			(TouchPad.AbsoluteSize.Y / 2)

		local relativeY =
			input.Position.Y - centerY

		local clampedY =
			math.clamp(
				relativeY,
				-maxDistance,
				maxDistance
			)

		Thumb.Position =
			UDim2.new(
				0.5,
				-15,
				0.5,
				-15 + clampedY
			)

		local intensidad =
			-clampedY / maxDistance

		if nombre == "Derecho" then
			rightZMove = intensidad
		else
			leftZMove = intensidad
		end
	end

	Thumb.InputBegan:Connect(function(input)

		if
			input.UserInputType == Enum.UserInputType.Touch
			or
			input.UserInputType == Enum.UserInputType.MouseButton1
		then

			dragging = true
			currentInput = input

			actualizarExtensionZ(input)
		end
	end)

	UserInputService.InputChanged:Connect(function(input)

		if dragging and input == currentInput then
			actualizarExtensionZ(input)
		end
	end)

	UserInputService.InputEnded:Connect(function(input)

		if dragging and input == currentInput then

			dragging = false
			currentInput = nil

			if nombre == "Derecho" then
				rightZMove = 0
			else
				leftZMove = 0
			end
		end
	end)
end

