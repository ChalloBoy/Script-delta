-- GRIP
--==================================================

gripLeft.Activated:Connect(function()
    leftGrip = not leftGrip

    if leftGrip then
        gripLeft.Text = "RELEASE"
    else
        gripLeft.Text = "GRIP"
    end
end)

gripRight.Activated:Connect(function()
    rightGrip = not rightGrip

    if rightGrip then
        gripRight.Text = "RELEASE"
    else
        gripRight.Text = "GRIP"
    end
end)

--==================================================
-- RECENTER
--==================================================

recenterButton.Activated:Connect(function()
    recenter()

    targetLeftX = 0
    targetLeftY = 0

    targetRightX = 0
    targetRightY = 0
end)

--==================================================
-- HIDE UI
--==================================================

local uiVisible = true

hideButton.Activated:Connect(function()

    uiVisible = not uiVisible

    for _, object in ipairs(gui:GetChildren()) do
        if object ~= hideButton then
            if object:IsA("GuiObject") then
                object.Visible = uiVisible
            end
        end
    end

    if uiVisible then
        hideButton.Text = "UI"
    else
        hideButton.Text = "☰"
    end
end)

--==================================================
-- CAMERA + HAND UPDATE
--==================================================

RunService.RenderStepped:Connect(function(dt)

    if not character or not root then
        return
    end

    -- Smooth camera
    cameraYaw += (targetYaw - cameraYaw) * Settings.CameraSmoothness
    cameraPitch += (targetPitch - cameraPitch) * Settings.CameraSmoothness

    -- Camera CFrame
    local bodyPosition = root.Position + Vector3.new(
        0,
        1.6,
        0
    )

    local cameraRotation =
        CFrame.Angles(0,cameraYaw,0) *
        CFrame.Angles(cameraPitch,0,0)

    camera.CFrame =
        CFrame.new(bodyPosition) *
        cameraRotation

    --==================================================
    -- BODY DIRECTION
    --==================================================

    local _, bodyYaw, _ = root.CFrame:ToOrientation()

    -- Difference between camera and body
    local relativeYaw = cameraYaw - bodyYaw

    -- Normalize to -pi .. pi
    relativeYaw = math.atan2(
        math.sin(relativeYaw),
        math.cos(relativeYaw)
    )

    -- IMPORTANT:
    -- Camera can look behind,
    -- but hands DON'T rotate all the way behind.
    local limitedYaw = math.clamp(
        relativeYaw,
        -Settings.MaxHandYaw,
        Settings.MaxHandYaw
    )

    --==================================================
    -- HAND SMOOTHING
    --==================================================

    leftX += (targetLeftX - leftX) * Settings.HandSmoothness
    leftY += (targetLeftY - leftY) * Settings.HandSmoothness

    rightX += (targetRightX - rightX) * Settings.HandSmoothness
    rightY += (targetRightY - rightY) * Settings.HandSmoothness

    --==================================================
    -- LEFT HAND
    --==================================================

    local leftYaw =
        limitedYaw + leftX

    local leftPitch =
        math.clamp(
            leftY,
            -Settings.MaxHandPitch,
            Settings.MaxHandPitch
        )

    local leftRotation =
        CFrame.Angles(0,leftYaw,0) *
        CFrame.Angles(leftPitch,0,0)

    local leftOffset =
        leftRotation:VectorToWorldSpace(
            Vector3.new(
                -Settings.HandSide,
                Settings.HandHeight,
                -Settings.HandDistance
            )
        )

    local leftPosition =
        root.Position + leftOffset

    leftHand.CFrame =
        CFrame.lookAt(
            leftPosition,
            leftPosition + leftRotation.LookVector
        )

    --==================================================
    -- RIGHT HAND
    --==================================================

    local rightYaw =
        limitedYaw + rightX

    local rightPitch =
        math.clamp(
            rightY,
            -Settings.MaxHandPitch,
            Settings.MaxHandPitch
        )

    local rightRotation =
        CFrame.Angles(0,rightYaw,0) *
        CFrame.Angles(rightPitch,0,0)

    local rightOffset =
        rightRotation:VectorToWorldSpace(
            Vector3.new(
                Settings.HandSide,
                Settings.HandHeight,
                -Settings.HandDistance
            )
        )

    local rightPosition =
        root.Position + rightOffset

    rightHand.CFrame =
        CFrame.lookAt(
            rightPosition,
            rightPosition + rightRotation.LookVector
        )

    --==================================================
    -- MOVEMENT
    --==================================================

    if humanoid then

        local forward =
            Vector3.new(
                math.sin(cameraYaw),
                0,
                math.cos(cameraYaw)
            )

        local right =
            Vector3.new(
                math.cos(cameraYaw),
                0,
                -math.sin(cameraYaw)
            )

        local moveDirection =
            right * moveVector.X +
            forward * (-moveVector.Y)

        if moveDirection.Magnitude > 0.05 then
            humanoid:Move(
                moveDirection.Unit,
                false
            )
        else
            humanoid:Move(Vector3.zero,false)
        end
    end

    --==================================================
    -- GRIP VISUAL STATE
    --==================================================

    if leftGrip then
        leftHand.Size =
            Vector3.new(0.28,0.28,0.48)
    else
        leftHand.Size =
            Vector3.new(0.35,0.35,0.65)
    end

    if rightGrip then
        rightHand.Size =
            Vector3.new(0.28,0.28,0.48)
    else
        rightHand.Size =
            Vector3.new(0.35,0.35,0.65)
    end
end)

--==================================================
-- CLEANUP
--==================================================

script.Destroying:Connect(function()

    if camera then
        camera.CameraType = Enum.CameraType.Custom
    end

    if handFolder then
        handFolder:Destroy()
    end

    if gui then
        gui:Destroy()
    end
end)
