-- --- FUNCIÓN 1: JOYSTICKS PRINCIPALES (X, Y) ---
local function crearJoystick(nombre, posicion, color)
    local TouchPad = Instance.new("Frame")
    local Thumb = Instance.new("ImageButton")
    
    TouchPad.Name = nombre.."_Pad"
    TouchPad.Size = UDim2.new(0, 125, 0, 125)
    TouchPad.Position = posicion
    TouchPad.BackgroundColor3 = Color3.fromRGB(20, 20, 20)
    TouchPad.BackgroundTransparency = 0.6
    TouchPad.BorderSizePixel = 0
    TouchPad.Active = true
    TouchPad.Visible = false -- Oculto al inicio por la intro
    TouchPad.Parent = ScreenGui
    
    local uiCorner = Instance.new("UICorner")
    uiCorner.CornerRadius = UDim.new(1, 0)
    uiCorner.Parent = TouchPad
    
    Thumb.Name = "Thumb"
    Thumb.Size = UDim2.new(0, 50, 0, 50)
    Thumb.Position = UDim2.new(0.5, -25, 0.5, -25)
    Thumb.BackgroundColor3 = color
    Thumb.BackgroundTransparency = 0.2
    Thumb.BorderSizePixel = 0
    Thumb.Parent = TouchPad
    
    local thumbCorner = Instance.new("UICorner")
    thumbCorner.CornerRadius = UDim.new(1, 0)
    thumbCorner.Parent = Thumb

    local dragging = false
    local startPos = Vector2.new()
    local currentInput = nil
    
    Thumb.InputBegan:Connect(function(input)
        if (input.UserInputType == Enum.UserInputType.Touch or input.UserInputType == Enum.UserInputType.MouseButton1) and not dragging then
            dragging = true
            startPos = input.Position
            currentInput = input
            if nombre == "Derecho" then rightLargeDragging = true else leftLargeDragging = true end
        end
    end)
    
    UserInputService.InputChanged:Connect(function(input)
        if dragging and input == currentInput then
            local delta = input.Position - startPos
            local distance = math.clamp(delta.Magnitude, 0, 45)
            local direction = delta.Magnitude > 0 and delta.Unit or Vector2.new(0, 0)
            
            Thumb.Position = UDim2.new(0.5, -25 + (direction.X * distance), 0.5, -25 + (direction.Y * distance))
            
            local intensidad = distance / 45
            if nombre == "Derecho" then
                rightJoyMove = Vector2.new(direction.X * intensidad, -direction.Y * intensidad)
            else
                leftJoyMove = Vector2.new(direction.X * intensidad, -direction.Y * intensidad)
            end
        end
    end)
    
    local function endDrag(input)
        if dragging and input == currentInput then
            dragging = false
            currentInput = nil
            if nombre == "Derecho" then rightLargeDragging = false else leftLargeDragging = false end
        end
    end
    
    UserInputService.InputEnded:Connect(endDrag)
end

-- --- FUNCIÓN 2: JOYSTICKS PEQUEÑOS (EJE Z - MEMORIA) ---
local function crearJoystickZ(nombre, posicion, color)
    local TouchPad = Instance.new("Frame")
    local Thumb = Instance.new("ImageButton")
    
    TouchPad.Name = nombre.."_Z_Pad"
    TouchPad.Size = UDim2.new(0, 75, 0, 75)
    TouchPad.Position = posicion
    TouchPad.BackgroundColor3 = Color3.fromRGB(20, 20, 20)
    TouchPad.BackgroundTransparency = 0.6
    TouchPad.BorderSizePixel = 0
    TouchPad.Active = true
    TouchPad.Visible = false -- Oculto al inicio por la intro
    TouchPad.Parent = ScreenGui
    
    local uiCorner = Instance.new("UICorner")
    uiCorner.CornerRadius = UDim.new(1, 0)
    uiCorner.Parent = TouchPad
    
    Thumb.Name = "Thumb"
    Thumb.Size = UDim2.new(0, 30, 0, 30)
    Thumb.Position = UDim2.new(0.5, -15, 0.5, -15)
    Thumb.BackgroundColor3 = color
    Thumb.BackgroundTransparency = 0.2
    Thumb.BorderSizePixel = 0
    Thumb.Parent = TouchPad
    
    local thumbCorner = Instance.new("UICorner")
    thumbCorner.CornerRadius = UDim.new(1, 0)
    thumbCorner.Parent = Thumb

    local dragging = false
    local currentInput = nil
    local maxDistance = 25
    
    local function actualizarExtensionZ(input)
        local padCenterY = TouchPad.AbsolutePosition.Y + (TouchPad.AbsoluteSize.Y / 2)
        local relativeY = input.Position.Y - padCenterY
        local clampedY = math.clamp(relativeY, -maxDistance, maxDistance)
        
        Thumb.Position = UDim2.new(0.5, -15, 0.5, -15 + clampedY)
        
        local intensidad = -clampedY / maxDistance
        if nombre == "Derecho" then rightZMove = intensidad else leftZMove = intensidad end
    end
    
    Thumb.InputBegan:Connect(function(input)
        if (input.UserInputType == Enum.UserInputType.Touch or input.UserInputType == Enum.UserInputType.MouseButton1) and not dragging then
            dragging = true
            currentInput = input
            actualizarExtensionZ(input)
        end
    end)
    
    UserInputService.InputChanged:Connect(function(input)
        if dragging and input == currentInput then
            actualizarExtensionZ(input)
        end
    end)
    
    UserInputService.InputEnded:Connect(function(input)
        if dragging and input == currentInput then
            dragging = false
            currentInput = nil
        end
    end)
end

-- --- FUNCIÓN 3: CONTROL VERTICAL DE BRAZOS (ARRIBA / ABAJO) ---
-- Este control NO cambia la posición del hombro. Solo añade una rotación
-- vertical al brazo, permitiendo que la mano apunte hacia arriba o abajo.
local function crearControlVerticalBrazo(nombre, posicion, color)
    local Pad = Instance.new("Frame")
    local Thumb = Instance.new("Frame")

    Pad.Name = nombre.."_ArmPitch_Pad"
    Pad.Size = UDim2.new(0, 55, 0, 105)
    Pad.Position = posicion
    Pad.BackgroundColor3 = Color3.fromRGB(20, 20, 20)
    Pad.BackgroundTransparency = 0.6
    Pad.BorderSizePixel = 0
    Pad.Active = true
    Pad.Visible = false
    Pad.Parent = ScreenGui

    local corner = Instance.new("UICorner")
    corner.CornerRadius = UDim.new(0, 14)
    corner.Parent = Pad

    local label = Instance.new("TextLabel")
    label.Name = "Arrow"
    label.Size = UDim2.new(1, 0, 1, 0)
    label.BackgroundTransparency = 1
    label.Text = "↕"
    label.TextColor3 = Color3.fromRGB(255, 255, 255)
    label.TextTransparency = 0.25
    label.TextSize = 24
    label.Font = Enum.Font.GothamBold
    label.Parent = Pad

    Thumb.Name = "Thumb"
    Thumb.Size = UDim2.new(0, 34, 0, 34)
    Thumb.Position = UDim2.new(0.5, -17, 0.5, -17)
    Thumb.BackgroundColor3 = color
    Thumb.BackgroundTransparency = 0.15
    Thumb.BorderSizePixel = 0
    Thumb.Active = true
    Thumb.Parent = Pad

    local thumbCorner = Instance.new("UICorner")
    thumbCorner.CornerRadius = UDim.new(1, 0)
    thumbCorner.Parent = Thumb

    local dragging = false
    local currentInput = nil
    local maxDistance = 32

    local function update(input)
        local centerY = Pad.AbsolutePosition.Y + Pad.AbsoluteSize.Y / 2
        local relativeY = input.Position.Y - centerY
        local clampedY = math.clamp(relativeY, -maxDistance, maxDistance)

        Thumb.Position = UDim2.new(0.5, -17, 0.5, -17 + clampedY)

        -- Arriba = brazo arriba, abajo = brazo abajo.
        local value = math.clamp(-clampedY / maxDistance, -1, 1)
        if nombre == "Izquierdo" then
            leftArmPitch = value
        else
            rightArmPitch = value
        end
    end

    Thumb.InputBegan:Connect(function(input)
        if (input.UserInputType == Enum.UserInputType.Touch
            or input.UserInputType == Enum.UserInputType.MouseButton1)
            and not dragging then
            dragging = true
            currentInput = input
            update(input)
        end
    end)

    UserInputService.InputChanged:Connect(function(input)
        if dragging and input == currentInput then
            update(input)
        end
    end)

    UserInputService.InputEnded:Connect(function(input)
        if dragging and input == currentInput then
            dragging = false
            currentInput = nil
        end
    end)
end

