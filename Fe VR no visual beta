-- Update speed
local function updateSpeed()
	speedLabel.Text = "Speed: " .. walkSpeed
end

minus.MouseButton1Click:Connect(function()
	if running then return end

	walkSpeed = math.max(minSpeed, walkSpeed - 1)
	updateSpeed()
end)

plus.MouseButton1Click:Connect(function()
	if running then return end

	walkSpeed = math.min(maxSpeed, walkSpeed + 1)
	updateSpeed()
end)

-- Auto walk
local function walkTo(position)
	local character = player.Character or player.CharacterAdded:Wait()
	local humanoid = character:FindFirstChildOfClass("Humanoid")

	if not humanoid then
		return
	end

	humanoid.WalkSpeed = walkSpeed
	humanoid:MoveTo(position)

	local reached = false
	local connection

	connection = humanoid.MoveToFinished:Connect(function(success)
		reached = true
		connection:Disconnect()
	end)

	-- Tunggu sampai tujuan tercapai
	while not reached and running do
		humanoid.WalkSpeed = walkSpeed
		task.wait(0.1)
	end
end

startButton.MouseButton1Click:Connect(function()
	if running then return end

	running = true

	local character = player.Character or player.CharacterAdded:Wait()
	local root = character:FindFirstChild("HumanoidRootPart")

	if not root then
		running = false
		return
	end

	-- Simpan posisi awal
	local originalPosition = root.Position

	startButton.Text = "WALKING..."
	startButton.BackgroundColor3 = Color3.fromRGB(100, 100, 100)

	-- Jalan ke posisi 1 sampai 10
	for i, position in ipairs(positions) do
		if not running then
			break
		end

		walkTo(position)
	end

	-- Kembali ke posisi awal dengan berjalan
	if running then
		walkTo(originalPosition)
	end

	running = false

	startButton.Text = "START WALK"
	startButton.BackgroundColor3 = Color3.fromRGB(45, 150, 255)
end)
