--==================================================
-- SPEED
--==================================================

local function updateSpeed()
	speedLabel.Text = "Speed: " .. flySpeed
end

minus.MouseButton1Click:Connect(function()
	flySpeed = math.max(minSpeed, flySpeed - 10)
	updateSpeed()
end)

plus.MouseButton1Click:Connect(function()
	flySpeed = math.min(maxSpeed, flySpeed + 10)
	updateSpeed()
end)

--==================================================
-- NOCLIP
--==================================================

local function enableNoclip()
	if noclipConnection then
		noclipConnection:Disconnect()
	end

	noclipConnection = RunService.Stepped:Connect(function()
		if not running then
			return
		end

		local character = player.Character

		if character then
			for _, part in ipairs(character:GetDescendants()) do
				if part:IsA("BasePart") then
					part.CanCollide = false
				end
			end
		end
	end)
end

local function disableNoclip()
	if noclipConnection then
		noclipConnection:Disconnect()
		noclipConnection = nil
	end

	local character = player.Character

	if character then
		for _, part in ipairs(character:GetDescendants()) do
			if part:IsA("BasePart") then
				part.CanCollide = true
			end
		end
	end
end

--==================================================
-- FLY
--==================================================

local function stopFlying()
	if flyConnection then
		flyConnection:Disconnect()
		flyConnection = nil
	end

	local character = player.Character
	if character then
		local root = character:FindFirstChild("HumanoidRootPart")

		if root then
			root.AssemblyLinearVelocity = Vector3.zero
		end
	end
end

local function flyTo(targetPosition)
	local character = player.Character or player.CharacterAdded:Wait()
	local root = character:FindFirstChild("HumanoidRootPart")

	if not root then
		return false
	end

	local reached = false

	flyConnection = RunService.Heartbeat:Connect(function()
		if not running then
			reached = true
			return
		end

		if not root.Parent then
			reached = true
			return
		end

		local offset = targetPosition - root.Position
		local distance = offset.Magnitude

		if distance <= 3 then
			root.AssemblyLinearVelocity = Vector3.zero
			reached = true
			return
		end

		root.AssemblyLinearVelocity =
			offset.Unit * flySpeed
	end)

	while running and not reached do
		task.wait()
	end

	if flyConnection then
		flyConnection:Disconnect()
		flyConnection = nil
	end

	if root and root.Parent then
		root.AssemblyLinearVelocity = Vector3.zero
	end

	return running
end

--==================================================
-- STOP / CLEANUP
--==================================================

local function finish()
	running = false

	stopFlying()
	disableNoclip()

	toggleButton.Text = "OFF"
	toggleButton.BackgroundColor3 =
		Color3.fromRGB(45, 150, 255)
end

--==================================================
-- AUTO FLY
--==================================================

local function startAutoFly()
	local character = player.Character or player.CharacterAdded:Wait()
	local root = character:FindFirstChild("HumanoidRootPart")

	if not root then
		finish()
		return
	end

	-- Simpan posisi saat ON ditekan
	originalCFrame = root.CFrame

	running = true

	toggleButton.Text = "ON"
	toggleButton.BackgroundColor3 =
		Color3.fromRGB(45, 200, 100)

	enableNoclip()

	-- Posisi 1 sampai 10
	for _, position in ipairs(positions) do
		if not running then
			return
		end

		if not flyTo(position) then
			return
		end
	end

	-- Setelah posisi 10,
	-- kembali ke posisi saat ON ditekan
	if running and originalCFrame then
		flyTo(originalCFrame.Position)
	end

	-- Selesai -> normal lagi
	finish()
end

--==================================================
-- ON / OFF
--==================================================

toggleButton.MouseButton1Click:Connect(function()

	-- Kalau sedang ON -> OFF
	if running then
		finish()
		return
	end

	-- Kalau OFF -> ON
	task.spawn(startAutoFly)
end)
