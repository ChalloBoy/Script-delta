-- ================= INPUT =================
local function begin(data, input)
    if data.dragging then return end
    if input.UserInputType ~= Enum.UserInputType.Touch
        and input.UserInputType ~= Enum.UserInputType.MouseButton1 then
        return
    end

    data.dragging = true
    data.input = input
end

for _, data in pairs(pads) do
    data.thumb.InputBegan:Connect(function(input)
        begin(data, input)
    end)
end

local function updateXY(data, input)
    if not data.dragging or data.input ~= input then return end

    local center = data.pad.AbsolutePosition + data.pad.AbsoluteSize / 2
    local delta = Vector2.new(input.Position.X,input.Position.Y) - center
    local radius = math.min(data.pad.AbsoluteSize.X,data.pad.AbsoluteSize.Y) * 0.36

    local mag = math.clamp(delta.Magnitude,0,radius)
    local dir = delta.Magnitude > 0 and delta.Unit or Vector2.zero
    local v = dir * (mag/radius)

    data.thumb.Position = UDim2.fromScale(
        0.5 + v.X * 0.34,
        0.5 + v.Y * 0.34
    )

    if data == pads.LeftJoystick then
        leftJoy = Vector2.new(v.X,-v.Y)
    elseif data == pads.RightJoystick then
        rightJoy = Vector2.new(v.X,-v.Y)
    end
end

local function updateZ(data,input)
    if not data.dragging or data.input ~= input then return end

    local centerY = data.pad.AbsolutePosition.Y + data.pad.AbsoluteSize.Y/2
    local maxDist = data.pad.AbsoluteSize.Y * 0.34
    local dy = math.clamp(input.Position.Y-centerY,-maxDist,maxDist)
    local value = -dy/maxDist

    data.thumb.Position = UDim2.fromScale(
        0.5,
        0.5 + dy/data.pad.AbsoluteSize.Y
    )

    if data == pads.LeftZ then
        leftZ = value
    elseif data == pads.RightZ then
        rightZ = value
    end
end

UserInputService.InputChanged:Connect(function(input)
    for _,data in pairs(pads) do
        if data.isZ then
            updateZ(data,input)
        else
            updateXY(data,input)
        end
    end
end)

UserInputService.InputEnded:Connect(function(input)
    for _,data in pairs(pads) do
        if data.dragging and data.input == input then
            data.dragging = false
            data.input = nil
        end
    end
end)

-- ================= CHARACTER =================
local function findJoints(character)
    local neck = character:FindFirstChild("Neck",true)

    local leftShoulder =
        character:FindFirstChild("Left Shoulder",true)
        or character:FindFirstChild("LeftShoulder",true)

    local rightShoulder =
        character:FindFirstChild("Right Shoulder",true)
        or character:FindFirstChild("RightShoulder",true)

    return neck,leftShoulder,rightShoulder
end

local function applyJoint(motor,target)
    if motor and motor.Part0 then
        motor.Transform =
            motor.C0:Inverse()
            * motor.Part0.CFrame:Inverse()
            * target
            * motor.C1
    end
end

-- ================= VR LOOP =================
RunService.RenderStepped:Connect(function(dt)
    local character = player.Character
    if not character then return end

    local humanoid = character:FindFirstChildOfClass("Humanoid")
    local root = character:FindFirstChild("HumanoidRootPart")
    if not humanoid or not root then return end

    local neck,leftShoulder,rightShoulder = findJoints(character)

    if not initialized then
        bodyYaw = math.atan2(-root.CFrame.LookVector.X,-root.CFrame.LookVector.Z)
        headCF = root.CFrame * CFrame.new(0,2,0)
        leftHandCF = root.CFrame * CFrame.new(-HAND_X,HAND_Y,HAND_Z)
        rightHandCF = root.CFrame * CFrame.new(HAND_X,HAND_Y,HAND_Z)
        initialized = true
    end

    -- HEAD TRACKING:
    -- Kamera boleh melihat ke belakang.
    -- Kepala mengikuti pandangan, tetapi badan tidak langsung dipaksa berputar.
    local localLook = root.CFrame:VectorToObjectSpace(camera.CFrame.LookVector)

    local headYaw = math.atan2(-localLook.X,-localLook.Z)
    local headPitch = math.asin(math.clamp(localLook.Y,-1,1))

    headYaw = math.clamp(shortestAngle(headYaw),-HEAD_MAX_YAW,HEAD_MAX_YAW)
    headPitch = math.clamp(headPitch,-HEAD_MAX_PITCH,HEAD_MAX_PITCH)

    local targetHead =
        root.CFrame
        * CFrame.new(0,2,0)
        * CFrame.Angles(headPitch,headYaw,0)

    headCF = smoothCF(headCF,targetHead,HEAD_SMOOTH_SPEED,dt)

    -- BODY FOLLOW:
    -- Badan menyusul arah kamera setelah kepala cukup jauh menoleh.
    local cameraYaw = math.atan2(-camera.CFrame.LookVector.X,-camera.CFrame.LookVector.Z)
    local yawDelta = shortestAngle(cameraYaw-bodyYaw)

    if math.abs(yawDelta) > BODY_DEADZONE then
        local alpha = 1-math.exp(-BODY_FOLLOW_SPEED*dt)
        bodyYaw = bodyYaw + yawDelta*alpha

        -- Hanya rotasi lokal badan secara halus.
        -- Posisi dan physics karakter tetap dikendalikan Humanoid.
        if humanoid.AutoRotate then
            local desired = CFrame.new(root.Position) * CFrame.Angles(0,bodyYaw,0)
            root.CFrame = root.CFrame:Lerp(desired,math.clamp(alpha*0.35,0,1))
        end
    end

    -- HAND TRACKING:
    local time = os.clock()

    local leftIdle = Vector3.new(0,math.sin(time*2)*0.025,0)
    local rightIdle = Vector3.new(0,math.sin(time*2+0.7)*0.025,0)

    local leftOffset = Vector3.new(
        -HAND_X + leftJoy.X*1.35,
        HAND_Y + leftJoy.Y*1.35,
        HAND_Z - leftZ*1.25
    )

    local rightOffset = Vector3.new(
        HAND_X + rightJoy.X*1.35,
        HAND_Y + rightJoy.Y*1.35,
        HAND_Z - rightZ*1.25
    )

    local targetLeft =
        root.CFrame
        * CFrame.new(leftOffset+leftIdle)
        * CFrame.Angles(
            math.rad(leftJoy.Y*35),
            math.rad(-leftJoy.X*25),
            math.rad(-leftJoy.X*18)
        )

    local targetRight =
        root.CFrame
        * CFrame.new(rightOffset+rightIdle)
        * CFrame.Angles(
            math.rad(rightJoy.Y*35),
            math.rad(-rightJoy.X*25),
            math.rad(rightJoy.X*18)
        )

    leftHandCF = smoothCF(leftHandCF,targetLeft,HAND_SMOOTH_SPEED,dt)
    rightHandCF = smoothCF(rightHandCF,targetRight,HAND_SMOOTH_SPEED,dt)

    -- LOCAL MIRROR
    applyJoint(neck,headCF)
    applyJoint(leftShoulder,leftHandCF)
    applyJoint(rightShoulder,rightHandCF)

    -- RGB UI
    local rgbTime = os.clock()
    for _,data in pairs(pads) do
        local c = hsv(rgbTime,data.rgbOffset)
        data.stroke.Color = c
        data.thumb.BackgroundColor3 = c
    end

    toggleStroke.Color = hsv(rgbTime,0.30)
end)

player.CharacterAdded:Connect(function()
    initialized = false
    leftJoy = Vector2.zero
    rightJoy = Vector2.zero
    leftZ = 0
    rightZ = 0

    for _,data in pairs(pads) do
        data.thumb.Position = UDim2.fromScale(0.5,0.5)
    end
end)
