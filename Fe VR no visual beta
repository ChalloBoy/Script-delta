--========================================================--
-- MOVEMENT
--========================================================--

local movementTouch
local moveVector = Vector2.zero

local function updateMovement(position)

	local center =
		moveBase.AbsolutePosition +
		moveBase.AbsoluteSize / 2

	local delta =
		position - center

	local radius =
		moveBase.AbsoluteSize.X / 2

	if delta.Magnitude > radius then

		delta =
			delta.Unit * radius

	end

	moveVector = Vector2.new(

		delta.X / radius,

		delta.Y / radius

	)

	moveStick.Position =
		UDim2.new(

			0.5,

			delta.X - 27,

			0.5,

			delta.Y - 27

		)

end

moveBase.InputBegan:Connect(function(input)

	if input.UserInputType ==
		Enum.UserInputType.Touch then

		movementTouch = input

		updateMovement(input.Position)

	end

end)

UserInputService.InputChanged:Connect(function(input)

	if input == movementTouch then

		updateMovement(input.Position)

	end

end)

UserInputService.InputEnded:Connect(function(input)

	if input == movementTouch then

		movementTouch = nil

		moveVector = Vector2.zero

		moveStick.Position =
			UDim2.new(
				0.5,-27,
				0.5,-27
			)

	end

end)

--========================================================--
-- CAMERA TOUCH
--========================================================--

local cameraTouch
local lastCameraPosition

UserInputService.TouchStarted:Connect(function(input)

	if input.UserInputType ~=
		Enum.UserInputType.Touch then
		return
	end

	local viewport =
		camera.ViewportSize

	local x = input.Position.X
	local y = input.Position.Y

	-- Area tengah untuk kamera
	if x > viewport.X * 0.30
		and x < viewport.X * 0.78
		and y < viewport.Y * 0.78 then

		if not cameraTouch then

			cameraTouch = input

			lastCameraPosition =
				input.Position

		end

	end

end)

UserInputService.TouchMoved:Connect(function(input)

	if input ~= cameraTouch then
		return
	end

	if not lastCameraPosition then
		return
	end

	local delta =
		input.Position -
		lastCameraPosition

	local sensitivity

	if CameraMode == "VR" then

		sensitivity =
			Settings.VRSensitivity

	else

		sensitivity =
			Settings.NormalSensitivity

	end

	targetYaw -=
		delta.X * sensitivity

	targetPitch -=
		delta.Y * sensitivity

	--================================================--
	-- NORMAL CAMERA
	--================================================--

	if CameraMode == "Normal" then

		targetPitch =
			math.clamp(

				targetPitch,

				math.rad(-80),

				math.rad(80)

			)

	--================================================--
	-- VR CAMERA
	--================================================--

	else

		local bodyYaw =
			getBodyYaw()

		local relativeYaw =
			normalizeAngle(
				targetYaw - bodyYaw
			)

		-- Batasi pandangan kiri kanan.
		relativeYaw =
			math.clamp(

				relativeYaw,

				-Settings.VRMaxYaw,

				Settings.VRMaxYaw

			)

		targetYaw =
			bodyYaw + relativeYaw

		targetPitch =
			math.clamp(

				targetPitch,

				Settings.VRMinPitch,

				Settings.VRMaxPitch

			)

	end

	lastCameraPosition =
		input.Position

end)

UserInputService.TouchEnded:Connect(function(input)

	if input == cameraTouch then

		cameraTouch = nil
		lastCameraPosition = nil

	end

end)

--========================================================--
-- HAND TOUCH
--========================================================--

local leftTouch
local rightTouch

local leftStart
local rightStart

leftHandButton.InputBegan:Connect(function(input)

	if input.UserInputType ==
		Enum.UserInputType.Touch then

		leftTouch = input
		leftStart = input.Position

	end

end)

rightHandButton.InputBegan:Connect(function(input)

	if input.UserInputType ==
		Enum.UserInputType.Touch then

		rightTouch = input
		rightStart = input.Position

	end

end)

UserInputService.TouchMoved:Connect(function(input)

	-- LEFT HAND
	if input == leftTouch then

		if leftStart then

			local delta =
				input.Position - leftStart

			targetLeftX +=
				delta.X *
				Settings.HandSensitivity

			targetLeftY -=
				delta.Y *
				Settings.HandSensitivity

			targetLeftX =
				math.clamp(

					targetLeftX,

					-math.rad(70),

					math.rad(70)

				)

			targetLeftY =
				math.clamp(

					targetLeftY,

					-math.rad(55),

					math.rad(55)

				)

			leftStart =
				input.Position

		end

	end

	-- RIGHT HAND
	if input == rightTouch then

		if rightStart then

			local delta =
				input.Position - rightStart

			targetRightX +=
				delta.X *
				Settings.HandSensitivity

			targetRightY -=
				delta.Y *
				Settings.HandSensitivity

			targetRightX =
				math.clamp(

					targetRightX,

					-math.rad(70),

					math.rad(70)

				)

			targetRightY =
				math.clamp(

					targetRightY,

					-math.rad(55),

					math.rad(55)

				)

			rightStart =
				input.Position

		end

	end

end)

UserInputService.TouchEnded:Connect(function(input)

	if input == leftTouch then

		leftTouch = nil
		leftStart = nil

	end

	if input == rightTouch then

		rightTouch = nil
		rightStart = nil

	end

end)

--========================================================--
-- CAMERA MODE SWITCH
--========================================================--

cameraButton.Activated:Connect(function()

	if CameraMode == "Normal" then

		CameraMode = "VR"

		cameraButton.Text =
			"CAM: VR"

		-- Saat masuk VR,
		-- arah kamera disesuaikan dengan badan
		local bodyYaw =
			getBodyYaw()

		local relativeYaw =
			normalizeAngle(
				targetYaw - bodyYaw
			)

		relativeYaw =
			math.clamp(

				relativeYaw,

				-Settings.VRMaxYaw,

				Settings.VRMaxYaw

			)

		targetYaw =
			bodyYaw + relativeYaw

	else

		CameraMode = "Normal"

		cameraButton.Text =
			"CAM: NORMAL"

	end

end)

