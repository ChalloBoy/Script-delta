--==================================================
-- MOVEMENT JOYSTICK
--==================================================

local moveBase = Instance.new("Frame")
moveBase.Name = "MovementBase"

moveBase.Size = UDim2.fromOffset(130,130)
moveBase.Position = UDim2.new(0,20,1,-290)

moveBase.BackgroundTransparency = 0.45
moveBase.BackgroundColor3 = Color3.fromRGB(20,20,20)

moveBase.BorderSizePixel = 0
moveBase.Parent = gui

local moveCorner = Instance.new("UICorner")
moveCorner.CornerRadius = UDim.new(1,0)
moveCorner.Parent = moveBase

local moveStick = Instance.new("Frame")
moveStick.Name = "Stick"

moveStick.Size = UDim2.fromOffset(55,55)
moveStick.Position = UDim2.new(0.5,-27,0.5,-27)

moveStick.BackgroundTransparency = 0.1
moveStick.BackgroundColor3 = Color3.fromRGB(80,80,80)

moveStick.BorderSizePixel = 0
moveStick.Parent = moveBase

local stickCorner = Instance.new("UICorner")
stickCorner.CornerRadius = UDim.new(1,0)
stickCorner.Parent = moveStick

--==================================================
-- MOVEMENT
--==================================================

local moveVector = Vector2.zero

local function updateMove(pos)
    local center = moveBase.AbsolutePosition + moveBase.AbsoluteSize/2
    local delta = pos - center

    local radius = moveBase.AbsoluteSize.X/2

    if delta.Magnitude > radius then
        delta = delta.Unit * radius
    end

    moveVector = Vector2.new(
        delta.X/radius,
        delta.Y/radius
    )

    moveStick.Position = UDim2.new(
        0.5,
        delta.X - moveStick.AbsoluteSize.X/2,
        0.5,
        delta.Y - moveStick.AbsoluteSize.Y/2
    )
end

moveBase.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.Touch then
        movementTouch = input
        updateMove(input.Position)
    end
end)

UserInputService.InputChanged:Connect(function(input)
    if input == movementTouch then
        updateMove(input.Position)
    end
end)

UserInputService.InputEnded:Connect(function(input)
    if input == movementTouch then
        movementTouch = nil
        moveVector = Vector2.zero

        moveStick.Position = UDim2.new(
            0.5,-27,
            0.5,-27
        )
    end
end)

--==================================================
-- CAMERA TOUCH
--==================================================

UserInputService.TouchStarted:Connect(function(input)
    local pos = input.Position

    if pos.X > workspace.CurrentCamera.ViewportSize.X * 0.35
        and pos.X < workspace.CurrentCamera.ViewportSize.X * 0.75
        and pos.Y < workspace.CurrentCamera.ViewportSize.Y * 0.8 then

        if not cameraTouch then
            cameraTouch = input
            cameraStart = pos
        end
    end
end)

UserInputService.TouchMoved:Connect(function(input)
    if input == cameraTouch and cameraStart then

        local delta = input.Position - cameraStart

        targetYaw -= delta.X * Settings.CameraSensitivity
        targetPitch -= delta.Y * Settings.CameraSensitivity

        targetPitch = math.clamp(
            targetPitch,
            math.rad(-75),
            math.rad(75)
        )

        cameraStart = input.Position
    end
end)

UserInputService.TouchEnded:Connect(function(input)
    if input == cameraTouch then
        cameraTouch = nil
        cameraStart = nil
    end
end)

--==================================================
-- HAND TOUCH
--==================================================

leftZone.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.Touch then
        leftHandTouch = input
        leftHandStart = input.Position
    end
end)

rightZone.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.Touch then
        rightHandTouch = input
        rightHandStart = input.Position
    end
end)

UserInputService.TouchMoved:Connect(function(input)

    if input == leftHandTouch and leftHandStart then

        local delta = input.Position - leftHandStart

        targetLeftX += delta.X * Settings.HandSensitivity
        targetLeftY -= delta.Y * Settings.HandSensitivity

        targetLeftX = math.clamp(
            targetLeftX,
            -math.rad(70),
            math.rad(70)
        )

        targetLeftY = math.clamp(
            targetLeftY,
            -math.rad(55),
            math.rad(55)
        )

        leftHandStart = input.Position
    end

    if input == rightHandTouch and rightHandStart then

        local delta = input.Position - rightHandStart

        targetRightX += delta.X * Settings.HandSensitivity
        targetRightY -= delta.Y * Settings.HandSensitivity

        targetRightX = math.clamp(
            targetRightX,
            -math.rad(70),
            math.rad(70)
        )

        targetRightY = math.clamp(
            targetRightY,
            -math.rad(55),
            math.rad(55)
        )

        rightHandStart = input.Position
    end
end)

UserInputService.TouchEnded:Connect(function(input)

    if input == leftHandTouch then
        leftHandTouch = nil
        leftHandStart = nil
    end

    if input == rightHandTouch then
        rightHandTouch = nil
        rightHandStart = nil
    end
end)

