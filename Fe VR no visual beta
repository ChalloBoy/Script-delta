--==================================================
-- CHARACTER RESPAWN
--==================================================

plr.CharacterAdded:Connect(function(char)

	-- New character = old transparency data is no longer valid
	table.clear(hiddenObjects)

	task.wait(0.5)

	local humanoid =
		char:FindFirstChildOfClass("Humanoid")

	if not humanoid then
		return
	end

	if vrCameraEnabled then

		-- Keep VR camera functional
		cam.CameraType = Enum.CameraType.Custom
		cam.CameraSubject = humanoid

		-- DO NOT force first-person
		plr.CameraMinZoomDistance = savedMinZoom
		plr.CameraMaxZoomDistance = savedMaxZoom

		-- Hide ONLY head/accessories
		updateVRHeadVisibility()

		CameraBtn.Text = "Camera: VR"

	else

		-- Normal Roblox camera
		cam.CameraType = Enum.CameraType.Custom
		cam.CameraSubject = humanoid

		restoreHiddenObjects()

		CameraBtn.Text = "Camera: NORMAL"
	end
end)

--==================================================
-- RENDER STEPPED
--==================================================

RunService.RenderStepped:Connect(function(deltaTime)

	-- Smooth left joystick
	if not leftLargeDragging then

		leftJoyMove =
			leftJoyMove:Lerp(
				Vector2.zero,
				0.07
			)

		local pad =
			ScreenGui:FindFirstChild("Left_Pad")

		local thumb =
			pad and pad:FindFirstChild("Thumb")

		if thumb then

			thumb.Position =
				thumb.Position:Lerp(
					UDim2.new(
						0.5,
						-25,
						0.5,
						-25
					),
					0.07
				)
		end
	end

	-- Smooth right joystick
	if not rightLargeDragging then

		rightJoyMove =
			rightJoyMove:Lerp(
				Vector2.zero,
				0.07
			)

		local pad =
			ScreenGui:FindFirstChild("Right_Pad")

		local thumb =
			pad and pad:FindFirstChild("Thumb")

		if thumb then

			thumb.Position =
				thumb.Position:Lerp(
					UDim2.new(
						0.5,
						-25,
						0.5,
						-25
					),
					0.07
				)
		end
	end

	-- Keep head hidden only while VR is active
	if vrCameraEnabled then
		updateVRHeadVisibility()
	end

	local char = plr.Character

	if not char then
		return
	end

	local root =
		char:FindFirstChild("HumanoidRootPart")

	if not root then
		return
	end

	local rootCF = root.CFrame

	--==================================================
	-- HEAD
	--==================================================

	local lookX, lookY, lookZ =
		cam.CFrame:ToEulerAnglesXYZ()

	headCF =
		CFrame.new(
			rootCF.Position +
			Vector3.new(0, 2, 0)
		)
		*
		CFrame.Angles(
			lookX,
			lookY,
			lookZ
		)

	--==================================================
	-- LEFT HAND
	--==================================================

	local currentZ_Left =
		math.clamp(
			-1.2 -
			(leftZMove * 1.2),
			-2.2,
			-0.5
		)

	leftHandCF =
		rootCF
		*
		CFrame.new(
			-1.2 +
			math.clamp(
				leftJoyMove.X * 1.4,
				-1.4,
				1.4
			),

			0.5 +
			math.clamp(
				leftJoyMove.Y * 1.4,
				-1.4,
				1.4
			),

			currentZ_Left
		)
		*
		CFrame.Angles(
			math.rad(leftJoyMove.Y * 45),
			math.rad(-leftJoyMove.X * 30),
			math.rad(-leftJoyMove.X * 20)
		)

	--==================================================
	-- RIGHT HAND
	--==================================================

	local currentZ_Right =
		math.clamp(
			-1.2 -
			(rightZMove * 1.2),
			-2.2,
			-0.5
		)

	rightHandCF =
		rootCF
		*
		CFrame.new(
			1.2 +
			math.clamp(
				rightJoyMove.X * 1.4,
				-1.4,
				1.4
			),

			0.5 +
			math.clamp(
				rightJoyMove.Y * 1.4,
				-1.4,
				1.4
			),

			currentZ_Right
		)
		*
		CFrame.Angles(
			math.rad(rightJoyMove.Y * 45),
			math.rad(-rightJoyMove.X * 30),
			math.rad(rightJoyMove.X * 20)
		)

	--==================================================
	-- SEND TO NEXUS VR
	--==================================================

	sendTimer += deltaTime

	if sendTimer >= SEND_RATE then

		sendTimer = 0

		pcall(function()
			remote:FireServer(
				headCF,
				leftHandCF,
				rightHandCF
			)
		end)
	end
end)

--==================================================
-- STEPPED
--==================================================

RunService.Stepped:Connect(function()

	-- No collision with other players
	for _, otherPlayer in ipairs(Players:GetPlayers()) do

		if otherPlayer ~= plr
			and otherPlayer.Character then

			for _, part in ipairs(otherPlayer.Character:GetChildren()) do

				if part:IsA("BasePart") then
					part.CanCollide = false
				end
			end
		end
	end

	--==================================================
	-- LOCAL BODY JOINTS
	--==================================================

	local char = plr.Character

	if not char then
		return
	end

	local neck =
		char:FindFirstChild("Neck", true)

	local leftShoulder =
		char:FindFirstChild("Left Shoulder", true)
		or
		char:FindFirstChild("LeftShoulder", true)

	local rightShoulder =
		char:FindFirstChild("Right Shoulder", true)
		or
		char:FindFirstChild("RightShoulder", true)

	-- Head
	if neck and neck.Part0 then

		pcall(function()

			neck.Transform =
				neck.C0:Inverse()
				*
				neck.Part0.CFrame:Inverse()
				*
				headCF
				*
				neck.C1

		end)
	end

	-- Left hand
	if leftShoulder and leftShoulder.Part0 then

		pcall(function()

			leftShoulder.Transform =
				leftShoulder.C0:Inverse()
				*
				leftShoulder.Part0.CFrame:Inverse()
				*
				leftHandCF
				*
				leftShoulder.C1

		end)
	end

	-- Right hand
	if rightShoulder and rightShoulder.Part0 then

		pcall(function()

			rightShoulder.Transform =
				rightShoulder.C0:Inverse()
				*
				rightShoulder.Part0.CFrame:Inverse()
				*
				rightHandCF
				*
				rightShoulder.C1

		end)
	end
end)
