-- --- CAMERA VR / NORMAL ---
-- Pseudo-VR para móvil: la cámara Roblox sigue siendo Custom para que el
-- toque/arrastre de cámara continúe funcionando. En VR se fuerza primera persona
-- y se oculta localmente únicamente cabeza/cara/accesorios de cabeza.
local cameraMode = "Normal"
local vrCameraEnabled = false
local savedCameraType = cam.CameraType
local savedCameraSubject = cam.CameraSubject
local savedCameraFOV = cam.FieldOfView
local savedMinZoom = plr.CameraMinZoomDistance
local savedMaxZoom = plr.CameraMaxZoomDistance

local hiddenLocally = {}

local function setLocalHidden(obj, hidden)
    if not obj or not obj:IsA("BasePart") then return end
    if hidden then
        if hiddenLocally[obj] == nil then
            hiddenLocally[obj] = obj.LocalTransparencyModifier
        end
        obj.LocalTransparencyModifier = 1
    elseif hiddenLocally[obj] ~= nil then
        obj.LocalTransparencyModifier = hiddenLocally[obj]
        hiddenLocally[obj] = nil
    end
end

local function setLocalHiddenTexture(obj, hidden)
    if not obj then return end
    if hidden then
        if hiddenLocally[obj] == nil then
            hiddenLocally[obj] = obj.Transparency
        end
        obj.Transparency = 1
    elseif hiddenLocally[obj] ~= nil then
        obj.Transparency = hiddenLocally[obj]
        hiddenLocally[obj] = nil
    end
end

local function isHeadAccessory(accessory)
    if not accessory:IsA("Accessory") then return false end
    local t = accessory.AccessoryType
    return t == Enum.AccessoryType.Hair
        or t == Enum.AccessoryType.Hat
        or t == Enum.AccessoryType.Face
        or t == Enum.AccessoryType.Neck
end

local function updateVRHeadVisibility()
    local char = plr.Character
    if not char then return end

    local head = char:FindFirstChild("Head")
    if head then
        setLocalHidden(head, true)
        for _, obj in ipairs(head:GetDescendants()) do
            if obj:IsA("Decal") or obj:IsA("Texture") then
                setLocalHiddenTexture(obj, true)
            end
        end
    end

    for _, accessory in ipairs(char:GetChildren()) do
        if isHeadAccessory(accessory) then
            for _, obj in ipairs(accessory:GetDescendants()) do
                if obj:IsA("BasePart") then
                    setLocalHidden(obj, true)
                elseif obj:IsA("Decal") or obj:IsA("Texture") then
                    setLocalHiddenTexture(obj, true)
                end
            end
        end
    end
end

local function restoreLocalHeadVisibility()
    -- Restore exactly what existed before VR was enabled.
    for obj, oldValue in pairs(hiddenLocally) do
        if obj and obj.Parent then
            if obj:IsA("BasePart") then
                obj.LocalTransparencyModifier = oldValue
            elseif obj:IsA("Decal") or obj:IsA("Texture") then
                obj.Transparency = oldValue
            end
        end
    end
    table.clear(hiddenLocally)
end

local function applyCameraMode()
    local char = plr.Character
    local humanoid = char and char:FindFirstChildOfClass("Humanoid")

    if vrCameraEnabled then
        -- Save camera/player zoom only once when entering VR.
        cam.CameraType = Enum.CameraType.Custom
        if humanoid then
            cam.CameraSubject = humanoid
        end

        -- First-person pseudo-VR. Roblox's normal mobile camera controls remain active.
        plr.CameraMinZoomDistance = 0.5
        plr.CameraMaxZoomDistance = 0.5

        updateVRHeadVisibility()
        CameraBtn.Text = "Camera: VR"
    else
        restoreLocalHeadVisibility()

        cam.CameraType = savedCameraType or Enum.CameraType.Custom
        if humanoid then
            cam.CameraSubject = humanoid
        elseif savedCameraSubject then
            cam.CameraSubject = savedCameraSubject
        end
        if savedCameraFOV then
            cam.FieldOfView = savedCameraFOV
        end

        plr.CameraMinZoomDistance = savedMinZoom
        plr.CameraMaxZoomDistance = savedMaxZoom
        CameraBtn.Text = "Camera: NORMAL"
    end
end

