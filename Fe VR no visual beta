local savedMaxZoom = plr.CameraMaxZoomDistance

--==================================================
-- LOCAL HEAD VISIBILITY
--==================================================

local hiddenObjects = {}

local function hideBasePart(part)
	if not part or not part:IsA("BasePart") then
		return
	end

	if hiddenObjects[part] == nil then
		hiddenObjects[part] = {
			type = "BasePart",
			value = part.LocalTransparencyModifier
		}
	end

	part.LocalTransparencyModifier = 1
end

local function hideTexture(texture)
	if not texture then
		return
	end

	if hiddenObjects[texture] == nil then
		hiddenObjects[texture] = {
			type = "Texture",
			value = texture.Transparency
		}
	end

	texture.Transparency = 1
end

local function restoreHiddenObjects()
	for object, data in pairs(hiddenObjects) do
		if object and object.Parent then

			if data.type == "BasePart" then
				object.LocalTransparencyModifier = data.value

			elseif data.type == "Texture" then
				object.Transparency = data.value
			end
		end
	end

	table.clear(hiddenObjects)
end

--==================================================
-- DETECT HEAD ACCESSORIES
--==================================================

local function isHeadAccessory(accessory)

	if not accessory:IsA("Accessory") then
		return false
	end

	-- Roblox AccessoryType
	local accessoryType = accessory.AccessoryType

	if accessoryType == Enum.AccessoryType.Hair then
		return true
	end

	if accessoryType == Enum.AccessoryType.Hat then
		return true
	end

	if accessoryType == Enum.AccessoryType.Face then
		return true
	end

	if accessoryType == Enum.AccessoryType.Neck then
		return true
	end

	-- Extra detection for accessories with unusual AccessoryType
	local handle = accessory:FindFirstChild("Handle")

	if handle and handle:IsA("BasePart") then

		for _, attachment in ipairs(handle:GetChildren()) do

			if attachment:IsA("Attachment") then

				local name = attachment.Name

				if string.find(name, "HatAttachment") then
					return true
				end

				if string.find(name, "HairAttachment") then
					return true
				end

				if string.find(name, "FaceFrontAttachment") then
					return true
				end

				if string.find(name, "FaceCenterAttachment") then
					return true
				end

				if string.find(name, "NeckAttachment") then
					return true
				end

			end
		end
	end

	return false
end

--==================================================
-- HIDE ONLY HEAD
--==================================================

local function updateVRHeadVisibility()

	if not vrCameraEnabled then
		return
	end

	local char = plr.Character

	if not char then
		return
	end

	-- ONLY HEAD
	local head = char:FindFirstChild("Head")

	if head then

		hideBasePart(head)

		for _, object in ipairs(head:GetDescendants()) do

			if object:IsA("Decal") then
				hideTexture(object)

			elseif object:IsA("Texture") then
				hideTexture(object)

			end
		end
	end

	-- ONLY HEAD ACCESSORIES
	for _, object in ipairs(char:GetChildren()) do

		if object:IsA("Accessory") and isHeadAccessory(object) then

			for _, child in ipairs(object:GetDescendants()) do

				if child:IsA("BasePart") then
					hideBasePart(child)

				elseif child:IsA("Decal") then
					hideTexture(child)

				elseif child:IsA("Texture") then
					hideTexture(child)

				end
			end
		end
	end
end

--==================================================
-- CAMERA NORMAL
--==================================================

local function restoreNormalCamera()

	local char = plr.Character
	local humanoid = char and char:FindFirstChildOfClass("Humanoid")

	vrCameraEnabled = false
	cameraMode = "NORMAL"

	-- Restore camera
	cam.CameraType = Enum.CameraType.Custom

	if humanoid then
		cam.CameraSubject = humanoid
	elseif savedCameraSubject then
		cam.CameraSubject = savedCameraSubject
	end

	if savedCameraFOV then
		cam.FieldOfView = savedCameraFOV
	end

	-- Restore player's normal zoom
	plr.CameraMinZoomDistance = savedMinZoom
	plr.CameraMaxZoomDistance = savedMaxZoom

	-- IMPORTANT:
	-- Restore head + hair + face + hats
	restoreHiddenObjects()

	if CameraBtn then
		CameraBtn.Text = "Camera: NORMAL"
	end
end

--==================================================
-- CAMERA VR
--==================================================

local function enableVRCamera()

	local char = plr.Character
	local humanoid = char and char:FindFirstChildOfClass("Humanoid")

	-- Save CURRENT normal camera state
	savedCameraType = cam.CameraType
	savedCameraSubject = cam.CameraSubject
	savedCameraFOV = cam.FieldOfView

	savedMinZoom = plr.CameraMinZoomDistance
	savedMaxZoom = plr.CameraMaxZoomDistance

	cameraMode = "VR"
	vrCameraEnabled = true

	-- IMPORTANT:
	-- Do NOT use Scriptable.
	-- Do NOT force CameraMinZoomDistance to 0.5.
	-- Roblox mobile camera remains usable.
	cam.CameraType = Enum.CameraType.Custom

	if humanoid then
		cam.CameraSubject = humanoid
	end

	-- KEEP NORMAL ZOOM
	-- This prevents Roblox first-person transparency
	-- from hiding the body / hands / legs.
	plr.CameraMinZoomDistance = savedMinZoom
	plr.CameraMaxZoomDistance = savedMaxZoom

	-- Hide ONLY head and head accessories
	updateVRHeadVisibility()

	if CameraBtn then
		CameraBtn.Text = "Camera: VR"
	end
end

--==================================================
-- CAMERA TOGGLE
--==================================================

local function toggleCameraMode()

	if cameraMode == "NORMAL" then
		enableVRCamera()
	else
		restoreNormalCamera()
	end
end

