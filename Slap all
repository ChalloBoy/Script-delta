--------------------------------------------------
-- SETTINGS
--------------------------------------------------

local HitboxValues = {
	"Normal",
	100,
	500,
	1000,
	5000,
	10000
}

local SpeedValues = {
	0.1,
	0.2,
	0.5,
	1.0
}

local HitboxIndex = 1
local SpeedIndex = 1
local AutoHit = false

--------------------------------------------------
-- HITBOX
--------------------------------------------------

local function UpdateHitbox()

	local value = HitboxValues[HitboxIndex]

	HitboxButton.Text = "Hitbox: " .. tostring(value)

	local serverValue = value

	if value == "Normal" then
		serverValue = 10
	end

	Remote:FireServer("Hitbox", serverValue)
end

--------------------------------------------------
-- SPEED
--------------------------------------------------

local function UpdateSpeed()

	local value = SpeedValues[SpeedIndex]

	SpeedButton.Text =
		"Attack Speed: " ..
		string.format("%.1f", value) ..
		"s"

	Remote:FireServer("AttackInterval", value)
end

--------------------------------------------------
-- AUTO HIT
--------------------------------------------------

AutoButton.Activated:Connect(function()

	AutoHit = not AutoHit

	if AutoHit then

		AutoButton.Text = "Auto Hit: ON"

		AutoButton.BackgroundColor3 =
			Color3.fromRGB(40, 125, 65)

	else

		AutoButton.Text = "Auto Hit: OFF"

		AutoButton.BackgroundColor3 =
			Color3.fromRGB(45, 45, 52)
	end

	Remote:FireServer("Enabled", AutoHit)
end)

--------------------------------------------------
-- CHANGE HITBOX
--------------------------------------------------

HitboxButton.Activated:Connect(function()

	HitboxIndex += 1

	if HitboxIndex > #HitboxValues then
		HitboxIndex = 1
	end

	UpdateHitbox()
end)

--------------------------------------------------
-- CHANGE SPEED
--------------------------------------------------

SpeedButton.Activated:Connect(function()

	SpeedIndex += 1

	if SpeedIndex > #SpeedValues then
		SpeedIndex = 1
	end

	UpdateSpeed()
end)

--------------------------------------------------
-- INITIAL SETTINGS
--------------------------------------------------

UpdateHitbox()
UpdateSpeed()

Remote:FireServer("Enabled", false)
Remote:FireServer("AllTargets", true)
