--[[
    PLAYER AUTO HIT UI
    LocalScript
    Untuk game Roblox milik sendiri

    Fitur:
    • Script Aktif ☑️
    • Auto Hit ON/OFF
    • Player Target
    • Hitbox: Normal → 100 → 500 → 1.000 → 5.000 → 10.000
    • Attack Speed: 0.1s → 0.2s → 0.5s → 1.0s
    • UI kecil untuk HP
    • UI tidak draggable
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local LocalPlayer = Players.LocalPlayer
local PlayerGui = LocalPlayer:WaitForChild("PlayerGui")

--------------------------------------------------
-- REMOTE
--------------------------------------------------

local Remote = ReplicatedStorage:FindFirstChild("AutoHitRemote")

if not Remote then
	Remote = Instance.new("RemoteEvent")
	Remote.Name = "AutoHitRemote"
	Remote.Parent = ReplicatedStorage
end

