			teleportSpeed * 10
		) / 10

	updateSpeedDisplay()

end)

--========================================================
-- STOP AUTO TELEPORT
--========================================================

local function stopAutoTeleport()

	autoTeleport = false

	autoButton.Text =
		"AUTO TELEPORT : OFF"

	autoButton.BackgroundColor3 =
		RED
end

--========================================================
-- START AUTO TELEPORT
--========================================================

local function startAutoTeleport()

	if #savedPositions == 0 then

		autoButton.Text =
			"SAVE POSITION DULU"

		task.delay(1.5, function()

			if not autoTeleport then
				autoButton.Text =
					"AUTO TELEPORT : OFF"
			end

		end)

		return
	end

	autoTeleport = true

	autoButton.Text =
		"AUTO TELEPORT : ON"

	autoButton.BackgroundColor3 =
		GREEN

	if autoThread then
		return
	end

	autoThread = task.spawn(function()

		local currentIndex = 1

		while autoTeleport do

			if #savedPositions == 0 then

				stopAutoTeleport()
				break

			end

			if currentIndex > #savedPositions then
				currentIndex = 1
			end

			local data =
				savedPositions[currentIndex]

			if data
				and humanoidRootPart
				and humanoidRootPart.Parent then

				humanoidRootPart.CFrame =
					CFrame.new(
						data.X,
						data.Y,
						data.Z
					)
			end

			-- Tunggu sesuai speed yang dipilih
			local waited = 0

			while waited < teleportSpeed
				and autoTeleport do

				local step =
					math.min(
						0.05,
						teleportSpeed - waited
					)

				task.wait(step)

				waited += step
			end

			currentIndex += 1

			-- Setelah posisi terakhir,
			-- kembali lagi ke posisi 1.
			if currentIndex > #savedPositions then
				currentIndex = 1
			end

		end

		autoThread = nil

	end)
end

autoButton.MouseButton1Click:Connect(function()

	if autoTeleport then
		stopAutoTeleport()
	else
		startAutoTeleport()
	end

end)

