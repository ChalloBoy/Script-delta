local function refreshList()
	for _, child in ipairs(scroll:GetChildren()) do
		if child:IsA("Frame") then
			child:Destroy()
		end
	end

	for index, data in ipairs(savedPositions) do
		local item = Instance.new("Frame")
		item.Size = UDim2.new(1, -4, 0, 72)
		item.BackgroundColor3 = PANEL2
		item.Parent = scroll
		corner(item, 12)

		local nameLabel = createText(
			item,
			"Teleport " .. index,
			13,
			WHITE,
			Enum.Font.GothamBold
		)
		nameLabel.Position = UDim2.fromOffset(12, 8)
		nameLabel.Size = UDim2.new(1, -150, 0, 20)
		nameLabel.TextXAlignment = Enum.TextXAlignment.Left

		local posLabel = createText(
			item,
			string.format(
				"%.1f, %.1f, %.1f",
				data.X,
				data.Y,
				data.Z
			),
			10,
			GREY,
			Enum.Font.Code
		)
		posLabel.Position = UDim2.fromOffset(12, 31)
		posLabel.Size = UDim2.new(1, -150, 0, 18)
		posLabel.TextXAlignment = Enum.TextXAlignment.Left

		local tpButton = createButton(item, "TP")
		tpButton.Size = UDim2.fromOffset(52, 32)
		tpButton.Position = UDim2.new(1, -112, 0.5, -16)
		tpButton.BackgroundColor3 = GREEN

		local delButton = createButton(item, "DEL")
		delButton.Size = UDim2.fromOffset(52, 32)
		delButton.Position = UDim2.new(1, -56, 0.5, -16)
		delButton.BackgroundColor3 = RED

		tpButton.MouseButton1Click:Connect(function()
			if humanoidRootPart and humanoidRootPart.Parent then
				humanoidRootPart.CFrame =
					CFrame.new(data.X, data.Y, data.Z)
			end
		end)

		delButton.MouseButton1Click:Connect(function()
			table.remove(savedPositions, index)
			refreshList()
			countLabel.Text = "Saved: " .. #savedPositions .. " / " .. MAX_POSITIONS
		end)
	end

	task.wait()
	scroll.CanvasSize = UDim2.new(
		0,
		0,
		0,
		listLayout.AbsoluteContentSize.Y + 16
	)
end

--==================================================
-- SAVE POSITION
--==================================================

saveButton.MouseButton1Click:Connect(function()
	if #savedPositions >= MAX_POSITIONS then
		saveButton.Text = "MAXIMUM 50 POSITIONS"
		task.delay(1.5, function()
			saveButton.Text = "＋  SAVE CURRENT POSITION"
		end)
		return
	end

	if not humanoidRootPart or not humanoidRootPart.Parent then
		return
	end

	local p = humanoidRootPart.Position

	table.insert(savedPositions, {
		X = p.X,
		Y = p.Y,
		Z = p.Z
	})

	countLabel.Text = "Saved: " .. #savedPositions .. " / " .. MAX_POSITIONS

	saveButton.Text = "✓  POSITION SAVED"

	TweenService:Create(
		saveButton,
		TweenInfo.new(0.2),
		{BackgroundColor3 = GREEN}
	):Play()

	task.delay(0.8, function()
		saveButton.Text = "＋  SAVE CURRENT POSITION"

		TweenService:Create(
			saveButton,
			TweenInfo.new(0.2),
			{BackgroundColor3 = BLUE}
		):Play()
	end)

	refreshList()
end)

--==================================================
-- AUTO TELEPORT
--==================================================

local function stopAutoTeleport()
	autoTeleport = false

	autoButton.Text = "AUTO TELEPORT : OFF"
	autoButton.BackgroundColor3 = RED
end

local function startAutoTeleport()
	if #savedPositions == 0 then
		autoButton.Text = "SAVE POSITION DULU"

		task.delay(1.5, function()
			if not autoTeleport then
				autoButton.Text = "AUTO TELEPORT : OFF"
			end
		end)

		return
	end

	autoTeleport = true
	autoButton.Text = "AUTO TELEPORT : ON"
	autoButton.BackgroundColor3 = GREEN

	if autoThread then
		return
	end

	autoThread = task.spawn(function()
		while autoTeleport do
			for index, data in ipairs(savedPositions) do
				if not autoTeleport then
					break
				end

				if humanoidRootPart and humanoidRootPart.Parent then
					humanoidRootPart.CFrame =
						CFrame.new(data.X, data.Y, data.Z)
				end

				task.wait(AUTO_TELEPORT_DELAY)
			end

			-- Setelah posisi terakhir, berhenti.
			-- Jika ingin mengulang terus, bagian ini bisa diubah.
			break
		end

		autoThread = nil

		if autoTeleport then
			stopAutoTeleport()
		end
	end)
end

autoButton.MouseButton1Click:Connect(function()
	if autoTeleport then
		stopAutoTeleport()
	else
		startAutoTeleport()
	end
end)

