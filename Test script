--------------------------------------------------
-- TARGET
--------------------------------------------------

local function findTarget(text)

	if not text or text == "" or text:lower() == "me" then
		return Player
	end

	text = text:lower()

	local matches = {}

	for _,p in ipairs(Players:GetPlayers()) do

		if p.Name:lower() == text
		or p.DisplayName:lower() == text then
			return p
		end

		if p.Name:lower():sub(1,#text) == text
		or p.DisplayName:lower():sub(1,#text) == text then
			table.insert(matches,p)
		end
	end

	if #matches == 1 then
		return matches[1]
	end
end

--------------------------------------------------
-- COMMAND
--------------------------------------------------

local function command(message)

	local prefix = message:sub(1,1)

	if prefix ~= ";" and prefix ~= "/" then
		return
	end

	local args = message:sub(2):split(" ")
	local cmd = (args[1] or ""):lower()

	table.remove(args,1)

	local target = findTarget(args[1])

	-- FLY
	if cmd == "fly" then

		FlyFrame.Visible = true
		StartFly()

	elseif cmd == "unfly" then

		StopFly()

	-- SPEED SELF ONLY
	elseif cmd == "speed" then

		local n = tonumber(args[1])
		local hum = getHumanoid()

		if n and hum then
			hum.WalkSpeed = math.clamp(n,0,500)
		end

	-- JUMP SELF ONLY
	elseif cmd == "jump" then

		local n = tonumber(args[1])
		local hum = getHumanoid()

		if n and hum then
			hum.UseJumpPower = true
			hum.JumpPower = math.clamp(n,0,500)
		end

	-- RESPAWN
	elseif cmd == "respawn" then
		Player:LoadCharacter()

	-- NOCLIP
	elseif cmd == "noclip" then
		noclip = true

	elseif cmd == "unoclip" then
		noclip = false

	-- INVISIBLE SELF
	elseif cmd == "invisible" then

		invisible = true

		local c = getChar()

		if c then
			for _,v in ipairs(c:GetDescendants()) do
				if v:IsA("BasePart") then
					v.LocalTransparencyModifier = 1
				elseif v:IsA("Decal") then
					v.Transparency = 1
				end
			end
		end

	elseif cmd == "visible" then

		invisible = false

		local c = getChar()

		if c then
			for _,v in ipairs(c:GetDescendants()) do
				if v:IsA("BasePart") then
					v.LocalTransparencyModifier = 0
				elseif v:IsA("Decal") then
					v.Transparency = 0
				end
			end
		end

	-- SPIN
	elseif cmd == "spin" then

		if target then
			if target == Player then
				spinning = not spinning
			else
				local r = target.Character
				and target.Character:FindFirstChild("HumanoidRootPart")

				if r then
					r.AssemblyAngularVelocity =
						Vector3.new(0,10,0)
				end
			end
		end

	-- BANG / GAMEPLAY EFFECT
	elseif cmd == "bang" then

		if target and target ~= Player then

			local r =
				target.Character
				and target.Character:FindFirstChild("HumanoidRootPart")

			if r then
				r.AssemblyLinearVelocity =
					r.CFrame.LookVector * 35
					+ Vector3.new(0,15,0)
			end
		end

	-- SIT
	elseif cmd == "sit" then

		if target then
			local h = target.Character
			and target.Character:FindFirstChildOfClass("Humanoid")

			if h then
				h.Sit = true
			end
		end

	-- LAY
	elseif cmd == "lay" then

		if target then

			local c = target.Character
			local r = c and c:FindFirstChild("HumanoidRootPart")
			local h = c and c:FindFirstChildOfClass("Humanoid")

			if r and h then
				h.Sit = true
				r.CFrame =
					r.CFrame * CFrame.Angles(math.rad(90),0,0)
			end
		end

	-- ANTIFLING SELF
	elseif cmd == "antifling" then

		antiFling = not antiFling

		local c = getChar()

		if c then
			for _,v in ipairs(c:GetDescendants()) do
				if v:IsA("BasePart") then
					v.Massless = antiFling
				end
			end
		end

	-- ORBIT
	elseif cmd == "orbit" then

		if target and target ~= Player then
			orbitTarget = target
			orbiting = true
		end

	elseif cmd == "unorbit" then

		orbiting = false
		orbitTarget = nil
	end
end

