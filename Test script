--------------------------------------------------
-- DRAG UI
--------------------------------------------------

local function makeDraggable(obj, handle)

	local dragging = false
	local dragStart
	local startPos

	handle = handle or obj

	handle.InputBegan:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1
		or input.UserInputType == Enum.UserInputType.Touch then

			dragging = true
			dragStart = input.Position
			startPos = obj.Position

			input.Changed:Connect(function()
				if input.UserInputState == Enum.UserInputState.End then
					dragging = false
				end
			end)
		end
	end)

	UIS.InputChanged:Connect(function(input)
		if not dragging then return end

		if input.UserInputType == Enum.UserInputType.MouseMovement
		or input.UserInputType == Enum.UserInputType.Touch then

			local delta = input.Position - dragStart

			obj.Position = UDim2.new(
				startPos.X.Scale,
				startPos.X.Offset + delta.X,
				startPos.Y.Scale,
				startPos.Y.Offset + delta.Y
			)
		end
	end)
end

makeDraggable(ListFrame,ListTitle)
makeDraggable(FlyFrame,FlyTitle)

--------------------------------------------------
-- CHARACTER
--------------------------------------------------

local function getChar()
	return Player.Character
end

local function getHumanoid()
	local c = getChar()
	return c and c:FindFirstChildOfClass("Humanoid")
end

local function getRoot()
	local c = getChar()
	return c and c:FindFirstChild("HumanoidRootPart")
end

--------------------------------------------------
-- FLY
--------------------------------------------------

local function StopFly()
	flying = false

	local root = getRoot()
	local hum = getHumanoid()

	if root then
		root.AssemblyLinearVelocity = Vector3.zero
	end

	if hum then
		hum.PlatformStand = false
		hum.AutoRotate = true
	end
end

local function StartFly()
	local root = getRoot()
	local hum = getHumanoid()

	if not root or not hum then return end

	flying = true
	hum.PlatformStand = true
	hum.AutoRotate = false
end

RunService.RenderStepped:Connect(function()

	if flying then

		local root = getRoot()

		if root then

			local look = Camera.CFrame.LookVector

			-- arah camera menentukan gerakan
			root.AssemblyLinearVelocity = look * flySpeed

			-- badan tetap tegak
			local flat = Vector3.new(look.X,0,look.Z)

			if flat.Magnitude > 0 then
				root.CFrame = CFrame.lookAt(
					root.Position,
					root.Position + flat
				)
			end
		end
	end

	if noclip then
		local c = getChar()

		if c then
			for _,v in ipairs(c:GetDescendants()) do
				if v:IsA("BasePart") then
					v.CanCollide = false
				end
			end
		end
	end

	if spinning then
		local root = getRoot()

		if root then
			root.CFrame =
				root.CFrame * CFrame.Angles(0,math.rad(8),0)
		end
	end

	if orbiting and orbitTarget then

		local targetRoot =
			orbitTarget.Character
			and orbitTarget.Character:FindFirstChild("HumanoidRootPart")

		local root = getRoot()

		if targetRoot and root then

			local t = os.clock() * orbitSpeed

			local offset = Vector3.new(
				math.cos(t) * orbitDistance,
				2,
				math.sin(t) * orbitDistance
			)

			root.CFrame = CFrame.lookAt(
				targetRoot.Position + offset,
				targetRoot.Position
			)
		end
	end
end)

