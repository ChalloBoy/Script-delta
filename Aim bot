--========================================================
-- PAGE SWITCH
--========================================================

local function ShowPage(pageName, menuName)

	for _,p in pairs(Pages) do
		p.Visible = false
	end

	Pages[pageName].Visible = true

	for name,b in pairs(MenuButtons) do

		if name == menuName then
			b.BackgroundColor3 = Accent
			b.TextColor3 = Color3.new(1,1,1)
		else
			b.BackgroundColor3 = Color3.fromRGB(17,20,27)
			b.TextColor3 = Color3.fromRGB(165,170,180)
		end

	end
end

