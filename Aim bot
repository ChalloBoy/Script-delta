local function createTab(text, page)
	local button = Instance.new("TextButton")
	button.Size = UDim2.new(1, -20, 0, 42)
	button.BackgroundColor3 = Color3.fromRGB(22, 25, 33)
	button.Text = text
	button.TextColor3 = Color3.fromRGB(170, 175, 190)
	button.TextSize = 14
	button.Font = Enum.Font.GothamMedium
	button.AutoButtonColor = false
	button.Parent = Sidebar

	local corner = Instance.new("UICorner")
	corner.CornerRadius = UDim.new(0, 8)
	corner.Parent = button

	button.MouseButton1Click:Connect(function()

		for _, p in pairs(Pages) do
			p.Visible = false
		end

		page.Visible = true

		if CurrentButton then
			CurrentButton.BackgroundColor3 =
				Color3.fromRGB(22, 25, 33)

			CurrentButton.TextColor3 =
				Color3.fromRGB(170, 175, 190)
		end

		button.BackgroundColor3 =
			Color3.fromRGB(35, 100, 190)

		button.TextColor3 =
			Color3.fromRGB(255, 255, 255)

		CurrentButton = button

		page.Position = UDim2.new(0, 15, 0, 0)

		TweenService:Create(
			page,
			TweenInfo.new(0.2, Enum.EasingStyle.Quad),
			{Position = UDim2.new(0, 0, 0, 0)}
		):Play()
	end)

	return button
end

