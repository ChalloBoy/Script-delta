	-- FOV
	FOVVisual.Visible = S.FOV

	if S.FOV then
		FOVVisual.Size = UDim2.fromOffset(
			S.FOVSize*2,
			S.FOVSize*2
		)

		FOVVisual.Position = UDim2.fromOffset(
			Camera.ViewportSize.X/2,
			Camera.ViewportSize.Y/2
		)

		FOVStroke.Thickness = S.FOVThickness
		FOVStroke.Transparency = S.FOVTransparency/100

		if S.FOVShape == "Circle" then
			FOVCorner.CornerRadius = UDim.new(1,0)
		else
			FOVCorner.CornerRadius = UDim.new(0,7)
		end
	end

	-- AIM
	if S.Aim then

		local target = GetTarget()

		if target and S.Strength > 0 then

			local desired =
				CFrame.lookAt(
					Camera.CFrame.Position,
					target.Position
				)

			Camera.CFrame =
				Camera.CFrame:Lerp(
					desired,
					math.clamp(
						(S.Strength/100)*.35,
						0,
						1
					)
				)
		end
	end

	-- ESP
	for player,data in pairs(ESPData) do

		local char = player.Character

		if char and data.Highlight and data.Billboard then

			data.Highlight.Enabled =
				S.ESP and S.BoxESP

			data.Highlight.OutlineColor = accent

			data.Billboard.Enabled =
				S.ESP and (
					S.NameESP or
					S.DistanceESP or
					S.HealthESP
				)

			local hum =
				char:FindFirstChildOfClass("Humanoid")

			local root =
				char:FindFirstChild("HumanoidRootPart")

			if hum and data.Text then

				local text = ""

				if S.NameESP then
					text = player.DisplayName
				end

				if S.DistanceESP and root then

					local d = math.floor(
						(root.Position-
						Camera.CFrame.Position).Magnitude
					)

					if text ~= "" then
						text = text.."  "
					end

					text = text..d.."m"
				end

				if S.HealthESP then

					if text ~= "" then
						text = text.."  "
					end

					text = text..
						"HP: "..math.floor(hum.Health)
				end

				data.Text.Text = text
				data.Text.TextColor3 = accent
			end
		end
	end

	-- RGB
	if S.RGB then
		Logo.TextColor3 = accent
		Title.TextColor3 = accent
	else
		Logo.TextColor3 = Color3.new(1,1,1)
		Title.TextColor3 = Color3.new(1,1,1)
	end
end)

