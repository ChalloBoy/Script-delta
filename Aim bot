local Hue = 0

RunService.RenderStepped:Connect(function(dt)

	if S.RGB then
		Hue = (Hue + dt*.15)%1
		Accent = Color3.fromHSV(Hue,.8,1)
	else
		Accent = Themes[S.Theme]
	end

	-- Accent UI
	Stroke(Window,Accent,1,.35).Color = Accent

	SaveButton.BackgroundColor3 = Accent
	Yes.BackgroundColor3 = Accent

	-- FOV
	UpdateFOV()

	-- Aim
	if S.Aim and S.Strength > 0 then
		local target = GetTarget()

		if target then
			local desired = CFrame.lookAt(
				Camera.CFrame.Position,
				target.Position
			)

			local alpha = AimAlpha(S.Strength)

			Camera.CFrame =
				Camera.CFrame:Lerp(
					desired,
					alpha
				)
		end
	end

	-- ESP color
	for _, highlight in pairs(Highlights) do
		highlight.OutlineColor = Accent
	end

	-- FOV color
	for _, obj in ipairs(FOVCircle:GetChildren()) do
		if obj:IsA("UIStroke") then
			obj.Color = Accent
		end
	end
end)

