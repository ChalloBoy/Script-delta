local ESP = {}

local function MakeESP(p)
	if p == LP then return end

	local function Setup(char)
		if ESP[p] then
			for _,v in pairs(ESP[p]) do
				if typeof(v) == "Instance" then
					v:Destroy()
				end
			end
		end

		ESP[p] = {}

		local hum = char:FindFirstChildOfClass("Humanoid")
		if not hum then return end

		local highlight = Instance.new("Highlight")
		highlight.Name = "CHALLO_ESP"
		highlight.Adornee = char
		highlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
		highlight.FillTransparency = 1
		highlight.OutlineTransparency = 0
		highlight.Enabled = false
		highlight.Parent = char

		ESP[p].Highlight = highlight

		local billboard = Instance.new("BillboardGui")
		billboard.Name = "CHALLO_INFO"
		billboard.Size = UDim2.fromOffset(170,40)
		billboard.StudsOffset = Vector3.new(0,3.5,0)
		billboard.AlwaysOnTop = true
		billboard.Enabled = false
		billboard.Parent = char

		local text = Instance.new("TextLabel")
		text.Size = UDim2.fromScale(1,1)
		text.BackgroundTransparency = 1
		text.TextColor3 = Color3.new(1,1,1)
		text.TextStrokeTransparency = 0
		text.TextSize = 10
		text.Font = Enum.Font.GothamBold
		text.Parent = billboard

		ESP[p].Billboard = billboard
		ESP[p].Text = text
	end

	if p.Character then
		Setup(p.Character)
	end

	p.CharacterAdded:Connect(function(char)
		task.wait(.4)
		Setup(char)
	end)
end

for _,p in ipairs(Players:GetPlayers()) do
	MakeESP(p)
end

Players.PlayerAdded:Connect(MakeESP)

--========================================================
-- MAIN LOOP
--========================================================

RunService.RenderStepped:Connect(function()

	local accent = Accent()

	WindowStroke.Color = accent
	FOVStroke.Color = accent

	-- FOV
	FOVVisual.Visible = S.FOV

	if S.FOV then
		FOVVisual.Size = UDim2.fromOffset(
			S.FOVSize*2,
			S.FOVSize*2
		)

		FOVVisual.Position = UDim2.fromOffset(
			Camera.ViewportSize.X/2,
			Camera.ViewportSize.Y/2
		)

		FOVStroke.Color = accent
		FOVStroke.Thickness = S.FOVThickness
		FOVStroke.Transparency = S.FOVTransparency/100

		if S.FOVShape == "Circle" then
			FOVCorner.CornerRadius = UDim.new(1,0)
		else
			FOVCorner.CornerRadius = UDim.new(0,8)
		end
	end

	-- AIM
	if S.Aim then
		local target = GetTarget()

		if target and S.Strength > 0 then
			local desired =
				CFrame.lookAt(Camera.CFrame.Position,target.Position)

			Camera.CFrame =
				Camera.CFrame:Lerp(
					desired,
					math.clamp((S.Strength/100)*.35,0,1)
				)
		end
	end

	-- ESP
	for p,data in pairs(ESP) do
		local char = p.Character

		if char and data.Highlight and data.Billboard then
			data.Highlight.Enabled = S.ESP and S.Box
			data.Highlight.OutlineColor = accent

			local showText =
				S.ESP and (
					S.Name or
					S.DistanceESP or
					S.Health
				)

			data.Billboard.Enabled = showText

			local hum = char:FindFirstChildOfClass("Humanoid")
			local root = char:FindFirstChild("HumanoidRootPart")

			if hum and data.Text then
				local text = ""

				if S.Name then
					text = p.DisplayName
				end

				if S.DistanceESP and root then
					local d = math.floor(
						(root.Position-Camera.CFrame.Position).Magnitude
					)

					if text ~= "" then
						text = text.."  "
					end

					text = text..d.."m"
				end

				if S.Health then
					if text ~= "" then
						text = text.."  "
					end

					text = text.."HP: "..math.floor(hum.Health)
				end

				data.Text.Text = text
				data.Text.TextColor3 = accent
			end
		end
	end

	if S.RGB then
		Logo.TextColor3 = accent
		PageTitle.TextColor3 = accent
	else
		Logo.TextColor3 = Color3.new(1,1,1)
		PageTitle.TextColor3 = Color3.new(1,1,1)
	end
end)

