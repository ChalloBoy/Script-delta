-- ESP UPDATE LOOP
--========================================================

local ESPTimer = 0

RunService.RenderStepped:Connect(function(dt)

ESPTimer += dt

if ESPTimer < .10 then
	return
end

ESPTimer = 0

for _,player in ipairs(
	Players:GetPlayers()
) do

	if player ~= LP then
		UpdateESP(player)
	end

end

end)

--========================================================
-- THEME
--========================================================

local function GetThemeColor()

if Theme == "Blue" then
	return Color3.fromRGB(50,140,255)

elseif Theme == "Purple" then
	return Color3.fromRGB(175,80,255)

elseif Theme == "Green" then
	return Color3.fromRGB(50,220,120)

elseif Theme == "Dark" then
	return Color3.fromRGB(170,170,175)

end

return Color3.fromHSV(
	RGBHue,
	1,
	1
)

end

--========================================================
-- RGB / THEME LOOP
--========================================================

RunService.RenderStepped:Connect(function(dt)

RGBHue =
	(RGBHue + dt*.12)%1

local ThemeColor =
	GetThemeColor()

MainStroke.Color =
	ThemeColor

MiniStroke.Color =
	ThemeColor

FOVStroke.Color =
	ThemeColor

Logo.TextColor3 =
	ThemeColor

for _,player in ipairs(
	Players:GetPlayers()
) do

	if player ~= LP
		and player.Character then

		local H =
			player.Character:FindFirstChild(
				"ChalloBoy_ESP"
			)

		if H then

			H.Enabled =
				ESPEnabled
				and BoxESP

			H.OutlineColor =
				ThemeColor

		end

	end

end

end)

