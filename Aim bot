			0,
			130,
			0,
			32
		)

	Button.Position =
		UDim2.new(
			1,
			-140,
			0.5,
			-16
		)

	Button.BackgroundColor3 =
		Color3.fromRGB(
			45,
			45,
			58
		)

	Button.TextColor3 =
		Color3.new(
			1,
			1,
			1
		)

	Button.Font =
		Enum.Font.Gotham

	Button.TextSize =
		12

	Button.Parent =
		Holder

	local BCorner =
		Instance.new("UICorner")

	BCorner.CornerRadius =
		UDim.new(
			0,
			8
		)

	BCorner.Parent =
		Button

	local current =
		default

	local function Update(v)

		current = v

		Button.Text =
			tostring(v)

		callback(v)

	end

	Update(default)

	local Popup =
		Instance.new("ScrollingFrame")

	Popup.Size =
		UDim2.new(
			0,
			130,
			0,
			math.min(
				#values * 34,
				170
			)
		)

	Popup.BackgroundColor3 =
		Color3.fromRGB(
			25,
			25,
			33
		)

	Popup.BorderSizePixel =
		0

	Popup.ScrollBarThickness =
		3

	Popup.Visible =
		false

	Popup.ZIndex =
		500

	Popup.Parent =
		DropdownGui

	local PLayout =
		Instance.new("UIListLayout")

	PLayout.Parent =
		Popup

	for _, v in ipairs(values) do

		local Option =
			Instance.new("TextButton")

		Option.Size =
			UDim2.new(
				1,
				0,
				0,
				32
			)

		Option.BackgroundTransparency =
			1

		Option.Text =
			tostring(v)

		Option.TextColor3 =
			Color3.new(
				1,
				1,
				1
			)

		Option.Font =
			Enum.Font.Gotham

		Option.TextSize =
			12

		Option.ZIndex =
			501

		Option.Parent =
			Popup

		Option.MouseButton1Click:Connect(function()

			Update(v)

			Popup.Visible =
				false

		end)

	end

	Button.MouseButton1Click:Connect(function()

		Popup.Visible =
			not Popup.Visible

		local pos =
			Button.AbsolutePosition

		local size =
			Button.AbsoluteSize

		local popupHeight =
			Popup.AbsoluteSize.Y

		local screenHeight =
			Camera.ViewportSize.Y

		local x =
			pos.X

		local y =
			pos.Y + size.Y + 4

		if y + popupHeight >
			screenHeight then

			y =
				pos.Y - popupHeight - 4

		end

		Popup.Position =
			UDim2.fromOffset(
				x,
				y
			)

	end)

	DropdownSetters[text] =
		Update

	return Holder
end

