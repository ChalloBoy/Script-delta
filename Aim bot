-- Data visual per target
local targetVisuals = {}

local function makeLine(parent)
    local line = Instance.new("Frame")
    line.AnchorPoint = Vector2.new(0, 0.5)
    line.BorderSizePixel = 0
    line.Visible = false
    line.Parent = parent
    return line
end

local function makeTargetVisual(model)
    local folder = Instance.new("Folder")
    folder.Name = "TargetVisual"
    folder.Parent = overlay

    local boxLines = {}
    for i = 1, 4 do
        boxLines[i] = makeLine(folder)
    end

    local tracer = makeLine(folder)

    local label = Instance.new("TextLabel")
    label.BackgroundTransparency = 1
    label.Size = UDim2.fromOffset(180, 20)
    label.AnchorPoint = Vector2.new(0.5, 1)
    label.Font = Enum.Font.GothamBold
    label.TextSize = 13
    label.TextStrokeTransparency = 0.35
    label.Visible = false
    label.Parent = folder

    local healthBack = Instance.new("Frame")
    healthBack.BorderSizePixel = 0
    healthBack.BackgroundColor3 = Color3.fromRGB(35, 35, 35)
    healthBack.Visible = false
    healthBack.Parent = folder

    local healthFill = Instance.new("Frame")
    healthFill.BorderSizePixel = 0
    healthFill.BackgroundColor3 = settings.colors.Health
    healthFill.Size = UDim2.fromScale(1, 1)
    healthFill.Parent = healthBack

    local highlight = Instance.new("Highlight")
    highlight.Enabled = false
    highlight.DepthMode = Enum.HighlightDepthMode.Occluded
    highlight.Adornee = model
    highlight.Parent = model

    targetVisuals[model] = {
        folder = folder,
        box = boxLines,
        tracer = tracer,
        label = label,
        healthBack = healthBack,
        healthFill = healthFill,
        highlight = highlight,
    }
end

local function removeTargetVisual(model)
    local visual = targetVisuals[model]
    if not visual then return end
    if visual.folder then visual.folder:Destroy() end
    if visual.highlight then visual.highlight:Destroy() end
    targetVisuals[model] = nil
end

local function getTargetPart(model)
    return model:FindFirstChild("Head")
        or model:FindFirstChild("HumanoidRootPart")
        or model.PrimaryPart
end

local function hasLineOfSight(model, part)
    if not camera then return false end
    local params = RaycastParams.new()
    params.FilterType = Enum.RaycastFilterType.Exclude
    params.FilterDescendantsInstances = {player.Character}

    local origin = camera.CFrame.Position
    local direction = part.Position - origin
    local result = workspace:Raycast(origin, direction, params)

    return result == nil or result.Instance:IsDescendantOf(model)
end

local function setLine(line, p1, p2, color, thickness)
    local delta = p2 - p1
    line.Position = UDim2.fromOffset(p1.X, p1.Y)
    line.Size = UDim2.fromOffset(delta.Magnitude, thickness)
    line.Rotation = math.deg(math.atan2(delta.Y, delta.X))
    line.BackgroundColor3 = color
    line.Visible = true
end

local function hideVisual(visual)
    for _, line in ipairs(visual.box) do line.Visible = false end
    visual.tracer.Visible = false
    visual.label.Visible = false
    visual.healthBack.Visible = false
    visual.highlight.Enabled = false
end

local function updateTarget(model, visual, rgbColor)
    if not model.Parent then
        removeTargetVisual(model)
        return
    end

    local part = getTargetPart(model)
    if not part then
        hideVisual(visual)
        return
    end

    local screen, onScreen = camera:WorldToViewportPoint(part.Position)
    local visible = onScreen and screen.Z > 0
    local colorFor = function(key)
        return settings.rgb and rgbColor or settings.colors[key]
    end

    if not visible then
        hideVisual(visual)
        return
    end

    local humanoid = model:FindFirstChildOfClass("Humanoid")
    local distance = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
        and (player.Character.HumanoidRootPart.Position - part.Position).Magnitude or 0

    -- Box ESP
    if settings.esp.Box then
        local _, size = model:GetBoundingBox()
        local top = camera:WorldToViewportPoint(part.Position + Vector3.new(0, size.Y / 2, 0))
        local bottom = camera:WorldToViewportPoint(part.Position - Vector3.new(0, size.Y / 2, 0))
        local height = math.abs(bottom.Y - top.Y)
        local width = math.max(12, height * 0.55)
        local x1, y1 = screen.X - width / 2, top.Y
        local x2, y2 = screen.X + width / 2, bottom.Y
        setLine(visual.box[1], Vector2.new(x1, y1), Vector2.new(x2, y1), colorFor("Box"), 2)
        setLine(visual.box[2], Vector2.new(x2, y1), Vector2.new(x2, y2), colorFor("Box"), 2)
        setLine(visual.box[3], Vector2.new(x2, y2), Vector2.new(x1, y2), colorFor("Box"), 2)
        setLine(visual.box[4], Vector2.new(x1, y2), Vector2.new(x1, y1), colorFor("Box"), 2)
    else
        for _, line in ipairs(visual.box) do line.Visible = false end
    end

    -- Tracer ESP
    if settings.esp.Tracer then
        setLine(
            visual.tracer,
            Vector2.new(camera.ViewportSize.X / 2, camera.ViewportSize.Y - 8),
            Vector2.new(screen.X, screen.Y),
            colorFor("Tracer"),
            2
        )
    else
        visual.tracer.Visible = false
    end

    -- Name dan Distance ESP
    local labelText = ""
    if settings.esp.Name then
        labelText = model.Name
    end
    if settings.esp.Distance then
        labelText = labelText .. (labelText ~= "" and "  •  " or "")
            .. tostring(math.floor(distance)) .. " studs"
    end

    visual.label.Visible = labelText ~= ""
    visual.label.Text = labelText
    visual.label.TextColor3 = settings.esp.Distance and colorFor("Distance")
        or colorFor("Name")
    visual.label.Position = UDim2.fromOffset(screen.X, screen.Y - 24)

    -- Health ESP
    if settings.esp.Health and humanoid then
        local percent = math.clamp(humanoid.Health / math.max(humanoid.MaxHealth, 1), 0, 1)
        visual.healthBack.Visible = true
        visual.healthBack.Position = UDim2.fromOffset(screen.X - 35, screen.Y + 12)
        visual.healthBack.Size = UDim2.fromOffset(70, 6)
        visual.healthFill.Size = UDim2.fromScale(percent, 1)
        visual.healthFill.BackgroundColor3 = colorFor("Health")
    else
        visual.healthBack.Visible = false
    end

    -- Highlight ESP hanya saat target terlihat, tidak menembus tembok
    visual.highlight.Enabled = settings.esp.Highlight and hasLineOfSight(model, part)
    visual.highlight.FillColor = colorFor("Highlight")
    visual.highlight.OutlineColor = colorFor("Highlight")
    visual.highlight.FillTransparency = 0.65
    visual.highlight.OutlineTransparency = 0
end

-- Sinkronkan daftar target bertag AimTarget
for _, model in ipairs(CollectionService:GetTagged("AimTarget")) do
    if model:IsA("Model") then makeTargetVisual(model) end
end

CollectionService:GetInstanceAddedSignal("AimTarget"):Connect(function(model)
