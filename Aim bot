local function createInput(parent, y, titleText, defaultText, suffix, minValue, maxValue, callback)

	local Label = Instance.new("TextLabel")
	Label.Size = UDim2.new(1, -150, 0, 35)
	Label.Position = UDim2.fromOffset(0, y)
	Label.BackgroundTransparency = 1
	Label.Text = titleText
	Label.TextColor3 = Color3.fromRGB(225, 228, 235)
	Label.TextSize = 15
	Label.Font = Enum.Font.GothamSemibold
	Label.TextXAlignment = Enum.TextXAlignment.Left
	Label.Parent = parent

	local Box = Instance.new("TextBox")
	Box.Size = UDim2.fromOffset(115, 36)
	Box.Position = UDim2.new(1, -115, 0, y)
	Box.BackgroundColor3 = Color3.fromRGB(31, 34, 41)
	Box.TextColor3 = Color3.fromRGB(245, 245, 250)
	Box.PlaceholderColor3 = Color3.fromRGB(120, 125, 135)
	Box.Text = tostring(defaultText)
	Box.TextSize = 14
	Box.Font = Enum.Font.GothamSemibold
	Box.ClearTextOnFocus = false
	Box.BorderSizePixel = 0
	Box.Parent = parent

	local Corner = Instance.new("UICorner")
	Corner.CornerRadius = UDim.new(0, 8)
	Corner.Parent = Box

	local Stroke = Instance.new("UIStroke")
	Stroke.Color = Color3.fromRGB(60, 65, 75)
	Stroke.Parent = Box

	Box.FocusLost:Connect(function()

		local clean = string.gsub(
			Box.Text,
			"[^%d%.%-]",
			""
		)

		local value = tonumber(clean)

		if not value then
			value = defaultText
		end

		value = math.clamp(
			value,
			minValue,
			maxValue
		)

		Box.Text = tostring(value) .. suffix

		callback(value)
	end)

	return Box
end

