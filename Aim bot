local ToggleControls = {}
local DropdownControls = {}

local function CreateToggle(page,label,default,callback)

	local holder =
		Instance.new("Frame")

	holder.Size =
		UDim2.new(1,-5,0,52)

	holder.BackgroundColor3 = PANEL
	holder.BorderSizePixel = 0
	holder.Parent = page

	corner(holder,6)

	local text =
		Instance.new("TextLabel")

	text.Size =
		UDim2.new(1,-90,1,0)

	text.Position =
		UDim2.new(0,15,0,0)

	text.BackgroundTransparency = 1
	text.Text = label
	text.TextColor3 = WHITE
	text.TextSize = 14
	text.Font =
		Enum.Font.GothamMedium

	text.TextXAlignment =
		Enum.TextXAlignment.Left
	text.Parent = holder

	local button =
		Instance.new("TextButton")

	button.Size =
		UDim2.new(0,58,0,30)

	button.Position =
		UDim2.new(1,-70,0.5,-15)

	button.AutoButtonColor = false
	button.TextSize = 11
	button.Font =
		Enum.Font.GothamBold
	button.Parent = holder

	corner(button,7)

	local value = default

	local function Set(v)

		value = v

		if value then

			button.Text = "ON"

			tween(
				button,
				FastTween,
				{
					BackgroundColor3 = GREEN
				}
			)

		else

			button.Text = "OFF"

			tween(
				button,
				FastTween,
				{
					BackgroundColor3 = RED
				}
			)

		end

		callback(value)
	end

	button.MouseEnter:Connect(function()
		tween(
			button,
			FastTween,
			{
				Size =
					UDim2.new(0,62,0,32)
			}
		)
	end)

	button.MouseLeave:Connect(function()
		tween(
			button,
			FastTween,
			{
				Size =
					UDim2.new(0,58,0,30)
			}
		)
	end)

	button.MouseButton1Click:Connect(function()
		Set(not value)
	end)

	Set(default)

	ToggleControls[label] = {
		Set = Set,
		Get = function()
			return value
		end
	}

	return holder
end

