end)

CollectionService:GetInstanceRemovedSignal("AimTarget"):Connect(removeTargetVisual)

-- Aim assist: target terdekat di dalam lingkaran dan tidak terhalang
local function getBestTarget()
    if not camera then return nil end

    local bestPart = nil
    local bestDistance = settings.aimFov

    for model in pairs(targetVisuals) do
        local part = model.Parent and getTargetPart(model)
        if part then
            local point, onScreen = camera:WorldToViewportPoint(part.Position)
            if onScreen and point.Z > 0 and hasLineOfSight(model, part) then
                local center = Vector2.new(camera.ViewportSize.X / 2, camera.ViewportSize.Y / 2)
                local screenPos = Vector2.new(point.X, point.Y)
                local distance = (screenPos - center).Magnitude

                if distance < bestDistance then
                    bestDistance = distance
                    bestPart = part
                end
            end
        end
    end

    return bestPart
end

RunService.RenderStepped:Connect(function(dt)
    camera = workspace.CurrentCamera
    if not camera then return end

    local rgbColor = Color3.fromHSV((os.clock() * 0.15) % 1, 1, 1)
    fovCircle.Visible = settings.aim
    refreshFov()

    for model, visual in pairs(targetVisuals) do
        updateTarget(model, visual, rgbColor)
    end

    if settings.aim and settings.aimStrength > 0 then
        local targetPart = getBestTarget()
        if targetPart then
            local origin = camera.CFrame.Position
            local desired = CFrame.lookAt(origin, targetPart.Position)
            local alpha = math.clamp((settings.aimStrength / 100) * dt * 12, 0, 1)
            camera.CFrame = camera.CFrame:Lerp(desired, alpha)
        end
    end
end)
