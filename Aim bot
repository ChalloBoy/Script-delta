local draggingSlider = false

local function SetStrength(x)

    local percent = math.clamp(
        (x - Slider.AbsolutePosition.X) /
        Slider.AbsoluteSize.X,
        0,
        1
    )

    AimStrength = math.floor(percent * 100)

    Fill.Size = UDim2.new(percent,0,1,0)

    StrengthLabel.Text =
        "Aim Strength: " .. AimStrength .. "%"
end

Slider.InputBegan:Connect(function(input)

    if input.UserInputType == Enum.UserInputType.Touch
    or input.UserInputType == Enum.UserInputType.MouseButton1 then

        draggingSlider = true
        SetStrength(input.Position.X)

    end

end)

Slider.InputEnded:Connect(function(input)

    if input.UserInputType == Enum.UserInputType.Touch
    or input.UserInputType == Enum.UserInputType.MouseButton1 then

        draggingSlider = false

    end

end)

UserInputService.InputChanged:Connect(function(input)

    if draggingSlider then

        if input.UserInputType == Enum.UserInputType.Touch
        or input.UserInputType == Enum.UserInputType.MouseMovement then

            SetStrength(input.Position.X)

        end

    end

end)

--==================================================
-- AIM ASSIST
--==================================================

local function GetClosestTarget()

    local closest = nil
    local shortest = math.huge

    if not LocalPlayer.Character then
        return nil
    end

    local root =
        LocalPlayer.Character:FindFirstChild("HumanoidRootPart")

    if not root then
        return nil
    end

    for _,player in ipairs(Players:GetPlayers()) do

        if player ~= LocalPlayer
        and player.Character then

            local humanoid =
                player.Character:FindFirstChildOfClass("Humanoid")

            local head =
                player.Character:FindFirstChild("Head")

            if humanoid
            and humanoid.Health > 0
            and head then

                local screenPos, visible =
                    Camera:WorldToViewportPoint(head.Position)

                if visible then

                    local distance =
                        (Vector2.new(screenPos.X,screenPos.Y)
                        -
                        Vector2.new(
                            Camera.ViewportSize.X/2,
                            Camera.ViewportSize.Y/2
                        )).Magnitude

                    if distance < shortest then

                        shortest = distance
                        closest = head

                    end

                end

            end

        end

    end

    return closest
end

CreateToggle("Aim Assist",function(state)
    AimEnabled = state
end)

--==================================================
-- ESP
--==================================================

local function SetupESP(player)

    if player == LocalPlayer then
        return
    end

    local function CharacterAdded(character)

        local old = character:FindFirstChild("RGB_ESP")

        if old then
            old:Destroy()
        end

        local highlight = Instance.new("Highlight")
        highlight.Name = "RGB_ESP"
        highlight.Parent = character

        highlight.FillTransparency = 0.75
        highlight.OutlineTransparency = 0
        highlight.Enabled = EspEnabled

        task.spawn(function()

            while highlight.Parent do

                highlight.OutlineColor = RGBColor()
                highlight.FillColor = RGBColor()

                task.wait()

            end

        end)

    end

    if player.Character then
        CharacterAdded(player.Character)
    end

    player.CharacterAdded:Connect(CharacterAdded)

end

for _,player in ipairs(Players:GetPlayers()) do
    SetupESP(player)
end

Players.PlayerAdded:Connect(SetupESP)

CreateToggle("ESP",function(state)

    EspEnabled = state

    for _,player in ipairs(Players:GetPlayers()) do

        if player.Character then

            local esp =
                player.Character:FindFirstChild("RGB_ESP")

            if esp then
                esp.Enabled = state
            end

        end

    end

end)

--==================================================
-- TOUCH DETECTION
--==================================================

UserInputService.InputBegan:Connect(function(input,processed)

    if processed then
        return
    end

    if input.UserInputType == Enum.UserInputType.Touch
    or input.UserInputType == Enum.UserInputType.MouseButton1 then

        IsTouching = true

    end

end)

UserInputService.InputEnded:Connect(function(input)

    if input.UserInputType == Enum.UserInputType.Touch
    or input.UserInputType == Enum.UserInputType.MouseButton1 then

        IsTouching = false

    end

end)

--==================================================
-- AIM LOOP
--==================================================

RunService.RenderStepped:Connect(function()

    if AimEnabled and IsTouching then

        local target = GetClosestTarget()

        if target then

            local strength = AimStrength / 100

            if strength > 0 then

                local cameraPosition =
                    Camera.CFrame.Position

                local targetCFrame =
                    CFrame.new(
                        cameraPosition,
                        target.Position
                    )

                Camera.CFrame =
                    Camera.CFrame:Lerp(
                        targetCFrame,
                        strength
                    )

            end

        end

    end

end)

