		Font = Enum.Font.GothamMedium,
		TextSize = 10,
		AutoButtonColor = false
	}, frame)

	Corner(button, 6)

	DropdownRefs[key] = {
		Frame = frame,
		Button = button,
		Values = values,
		Getter = getter,
		Setter = setter
	}

	button.Activated:Connect(function()
		OpenDropdown(key)
	end)

	return frame
end

--==================================================
-- DROPDOWN SYSTEM
--==================================================

local CurrentDropdown = nil

function OpenDropdown(key)
	local data = DropdownRefs[key]
	if not data then return end

	if CurrentDropdown then
		CurrentDropdown:Destroy()
		CurrentDropdown = nil
	end

	local popup = New("Frame", {
		BackgroundColor3 = Color3.fromRGB(13,16,22),
		BorderSizePixel = 0,
		Size = UDim2.fromOffset(180,150),
		ZIndex = 500
	}, DropGui)

	Corner(popup, 8)
	Stroke(popup, Accent, 1, .25)

	local list = New("ScrollingFrame", {
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		Position = UDim2.fromOffset(4,4),
		Size = UDim2.new(1,-8,1,-8),
		CanvasSize = UDim2.new(),
		AutomaticCanvasSize = Enum.AutomaticSize.Y,
		ScrollBarThickness = 3,
		ScrollBarImageColor3 = Accent,
		ZIndex = 501
	}, popup)

	New("UIListLayout", {
		Padding = UDim.new(0,3),
		SortOrder = Enum.SortOrder.LayoutOrder
	}, list)

	for _, value in ipairs(data.Values) do
		local item = New("TextButton", {
			BackgroundColor3 = Color3.fromRGB(22,25,33),
			BorderSizePixel = 0,
			Size = UDim2.new(1,-2,0,30),
			Text = tostring(value).."%",
			TextColor3 = Color3.fromRGB(220,225,235),
			Font = Enum.Font.GothamMedium,
			TextSize = 10,
			AutoButtonColor = false,
			ZIndex = 502
		}, list)

		Corner(item, 5)

		item.Activated:Connect(function()
			data.Setter(value)
			data.Button.Text = tostring(data.Getter()).."% ▼"

			popup:Destroy()
			CurrentDropdown = nil
		end)

		item.MouseEnter:Connect(function()
			item.BackgroundColor3 = Accent
		end)

		item.MouseLeave:Connect(function()
			item.BackgroundColor3 = Color3.fromRGB(22,25,33)
		end)
	end

	CurrentDropdown = popup

	local absPos = data.Button.AbsolutePosition
	local absSize = data.Button.AbsoluteSize
	local viewport = Camera.ViewportSize

	local x = math.clamp(absPos.X, 5, viewport.X - 185)
	local y = absPos.Y + absSize.Y + 5

	if y + 150 > viewport.Y then
		y = absPos.Y - 155
	end

	popup.Position = UDim2.fromOffset(x,y)
end

UIS.InputBegan:Connect(function(input)
	if CurrentDropdown then
		if input.UserInputType == Enum.UserInputType.MouseButton1
			or input.UserInputType == Enum.UserInputType.Touch then

			local mousePos = input.Position
			local p = CurrentDropdown.AbsolutePosition
			local s = CurrentDropdown.AbsoluteSize

			if mousePos.X < p.X
				or mousePos.X > p.X+s.X
				or mousePos.Y < p.Y
				or mousePos.Y > p.Y+s.Y then

				CurrentDropdown:Destroy()
				CurrentDropdown = nil
			end
		end
	end
end)

