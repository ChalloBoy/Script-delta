--========================================================
-- HIGHLIGHT
--========================================================

local function RemoveHighlight()

	if TargetHighlight then
		TargetHighlight:Destroy()
		TargetHighlight = nil
	end

end

local function ApplyHighlight()

	RemoveHighlight()

	if not Target then
		return
	end

	if not S.Highlight then
		return
	end

	local char = Target.Character

	if not char then
		return
	end

	TargetHighlight = Instance.new("Highlight")
	TargetHighlight.Name = "CHALLO_BOY_Target"
	TargetHighlight.Adornee = char
	TargetHighlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
	TargetHighlight.FillTransparency = .82
	TargetHighlight.OutlineTransparency = 0
	TargetHighlight.Parent = char

end

local function SelectPlayer(player)

	if player == LP then
		return
	end

	Target = player
	ApplyHighlight()

end

--========================================================
-- CHECK PLAYER IN POV
--========================================================

local function InPOV(player)

	if player == LP then
		return false
	end

	local char = player.Character

	if not char then
		return false
	end

	local root = char:FindFirstChild("HumanoidRootPart")

	if not root then
		return false
	end

	local pos, visible =
		Camera:WorldToViewportPoint(root.Position)

	if not visible or pos.Z <= 0 then
		return false
	end

	local viewport = Camera.ViewportSize

	local cx = viewport.X/2
	local cy = viewport.Y/2

	local dx = pos.X-cx
	local dy = pos.Y-cy

	return math.sqrt(dx*dx+dy*dy) <= S.POV/2

end

