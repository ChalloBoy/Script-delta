-- RGB color preview cycle for the UI accent.
local hue = 0
RunService.RenderStepped:Connect(function(dt)
    if not gui.Parent then return end
    if state.colorMode == "RGB" then
        hue = (hue + dt * 0.12) % 1
        local color = Color3.fromHSV(hue, 0.75, 1)
        top.BackgroundColor3 = color
        reopen.BackgroundColor3 = color
    else
        top.BackgroundColor3 = state.customColor
        reopen.BackgroundColor3 = state.customColor
    end
end)

showPage("Aim Bot")
