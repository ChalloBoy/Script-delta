local ActiveDrop = nil

local function Dropdown(Page,Text,Values,Get,Set)

	local Box = Instance.new("Frame")
	Box.BackgroundColor3 = Color3.fromRGB(18,21,29)
	Box.BorderSizePixel = 0
	Box.Size = UDim2.new(1,0,0,45)
	Box.Parent = Page

	local Corner = Instance.new("UICorner")
	Corner.CornerRadius = UDim.new(0,13)
	Corner.Parent = Box

	local Label = Instance.new("TextLabel")
	Label.BackgroundTransparency = 1
	Label.Position = UDim2.fromOffset(10,0)
	Label.Size = UDim2.new(.43,0,1,0)
	Label.Text = Text
	Label.TextColor3 = Color3.fromRGB(225,228,235)
	Label.Font = Enum.Font.GothamMedium
	Label.TextSize = 9
	Label.TextXAlignment = Enum.TextXAlignment.Left
	Label.Parent = Box

	local Button = Instance.new("TextButton")
	Button.BackgroundColor3 = Color3.fromRGB(27,30,38)
	Button.BorderSizePixel = 0
	Button.Position = UDim2.new(.43,0,0,6)
	Button.Size = UDim2.new(.55,0,0,33)
	Button.Text = tostring(Get()).."%  ▼"
	Button.TextColor3 = Color3.fromRGB(220,225,235)
	Button.Font = Enum.Font.GothamMedium
	Button.TextSize = 8
	Button.AutoButtonColor = false
	Button.Parent = Box

	local ButtonCorner = Instance.new("UICorner")
	ButtonCorner.CornerRadius = UDim.new(0,11)
	ButtonCorner.Parent = Button

	Button.Activated:Connect(function()

		if ActiveDrop then
			ActiveDrop:Destroy()
			ActiveDrop = nil
		end

		local Drop = Instance.new("Frame")
		Drop.BackgroundColor3 = Color3.fromRGB(12,15,21)
		Drop.BorderSizePixel = 0
		Drop.Size = UDim2.fromOffset(165,145)
		Drop.ZIndex = 100
		Drop.Parent = Gui

		local DropCorner = Instance.new("UICorner")
		DropCorner.CornerRadius = UDim.new(0,15)
		DropCorner.Parent = Drop

		local DropStroke = Instance.new("UIStroke")
		DropStroke.Color = Accent
		DropStroke.Transparency = .2
		DropStroke.Parent = Drop

		local Scroll = Instance.new("ScrollingFrame")
		Scroll.BackgroundTransparency = 1
		Scroll.BorderSizePixel = 0
		Scroll.Position = UDim2.fromOffset(5,5)
		Scroll.Size = UDim2.new(1,-10,1,-10)
		Scroll.CanvasSize = UDim2.new()
		Scroll.AutomaticCanvasSize = Enum.AutomaticSize.Y
		Scroll.ScrollBarThickness = 3
		Scroll.ScrollBarImageColor3 = Accent
		Scroll.ZIndex = 101
		Scroll.Parent = Drop

		local List = Instance.new("UIListLayout")
		List.Padding = UDim.new(0,4)
		List.Parent = Scroll

		for _,Value in ipairs(Values) do

			local Item = Instance.new("TextButton")
			Item.BackgroundColor3 = Color3.fromRGB(23,26,34)
			Item.BorderSizePixel = 0
			Item.Size = UDim2.new(1,-2,0,29)
			Item.Text = tostring(Value).."%"
			Item.TextColor3 = Color3.fromRGB(225,228,235)
			Item.Font = Enum.Font.GothamMedium
			Item.TextSize = 9
			Item.AutoButtonColor = false
			Item.ZIndex = 102
			Item.Parent = Scroll

			local ItemCorner = Instance.new("UICorner")
			ItemCorner.CornerRadius = UDim.new(0,9)
			ItemCorner.Parent = Item

			Item.Activated:Connect(function()

				Set(Value)
				Button.Text = tostring(Get()).."%  ▼"

				Drop:Destroy()
				ActiveDrop = nil
			end)
		end

		ActiveDrop = Drop

		local ButtonPos = Button.AbsolutePosition
		local ButtonSize = Button.AbsoluteSize
		local ScreenSize = Camera.ViewportSize

		local X = math.clamp(
			ButtonPos.X,
			5,
			ScreenSize.X-170
		)

		local Y = ButtonPos.Y+ButtonSize.Y+5

		if Y+145 > ScreenSize.Y then
			Y = ButtonPos.Y-150
		end

		Drop.Position = UDim2.fromOffset(X,Y)
	end)
end

