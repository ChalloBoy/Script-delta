local function UpdateESP(player)

if player == LP then
	return
end

local Character = player.Character

if not Character then
	return
end

local Root =
	Character:FindFirstChild("HumanoidRootPart")

if not Root then
	return
end

-- HIGHLIGHT
local H =
	Character:FindFirstChild("ChalloBoy_ESP")

if not H then

	H = Instance.new("Highlight")
	H.Name = "ChalloBoy_ESP"
	H.Adornee = Character
	H.DepthMode =
		Enum.HighlightDepthMode.AlwaysOnTop
	H.FillTransparency = 1
	H.OutlineTransparency = 0
	H.Parent = Character

end

H.Enabled = ESPEnabled

-- BILLBOARD
local Billboard =
	Root:FindFirstChild("ChalloBoy_ESP_Info")

if not Billboard then

	Billboard =
		Instance.new("BillboardGui")

	Billboard.Name =
		"ChalloBoy_ESP_Info"

	Billboard.Adornee = Root
	Billboard.Size =
		UDim2.fromOffset(120,65)

	Billboard.StudsOffset =
		Vector3.new(0,3.5,0)

	Billboard.AlwaysOnTop = true
	Billboard.Parent = Root

	local Holder =
		Instance.new("Frame")

	Holder.Name = "Holder"
	Holder.Size =
		UDim2.fromScale(1,1)

	Holder.BackgroundTransparency = 1
	Holder.Parent = Billboard

	local Name =
		Instance.new("TextLabel")

	Name.Name = "Name"
	Name.Size =
		UDim2.new(1,0,0,18)

	Name.BackgroundTransparency = 1
	Name.Font = Enum.Font.GothamBold
	Name.TextSize = 11
	Name.TextStrokeTransparency = .5
	Name.TextColor3 =
		Color3.fromRGB(255,255,255)

	Name.Parent = Holder

	local Distance =
		Instance.new("TextLabel")

	Distance.Name = "Distance"
	Distance.Size =
		UDim2.new(1,0,0,16)

	Distance.Position =
		UDim2.fromOffset(0,17)

	Distance.BackgroundTransparency = 1
	Distance.Font = Enum.Font.Gotham
	Distance.TextSize = 9
	Distance.TextStrokeTransparency = .5
	Distance.TextColor3 =
		Color3.fromRGB(220,220,220)

	Distance.Parent = Holder

	local HealthBack =
		Instance.new("Frame")

	HealthBack.Name = "HealthBack"
	HealthBack.Size =
		UDim2.new(1,-20,0,5)

	HealthBack.Position =
		UDim2.fromOffset(10,36)

	HealthBack.BackgroundColor3 =
		Color3.fromRGB(50,50,50)

	HealthBack.BorderSizePixel = 0
	HealthBack.Parent = Holder

	local HC =
		Instance.new("UICorner")

	HC.CornerRadius =
		UDim.new(1,0)

	HC.Parent = HealthBack

	local Health =
		Instance.new("Frame")

	Health.Name = "Health"
	Health.Size =
		UDim2.fromScale(1,1)

	Health.BackgroundColor3 =
		Color3.fromRGB(50,220,100)

	Health.BorderSizePixel = 0
	Health.Parent = HealthBack

	local HHC =
		Instance.new("UICorner")

	HHC.CornerRadius =
		UDim.new(1,0)

	HHC.Parent = Health

end

local Holder =
	Billboard:FindFirstChild("Holder")

if Holder then

	local Name =
		Holder:FindFirstChild("Name")

	local Distance =
		Holder:FindFirstChild("Distance")

	local HealthBack =
		Holder:FindFirstChild("HealthBack")

	if Name then
		Name.Visible = NameESP
		Name.Text = player.Name
	end

	local Dist =
		(Root.Position -
		Camera.CFrame.Position).Magnitude

	if Distance then
		Distance.Visible = DistanceESP
		Distance.Text =
			math.floor(Dist).." studs"
	end

	if HealthBack then

		HealthBack.Visible =
			HealthESP

		local Health =
			HealthBack:FindFirstChild("Health")

		local Humanoid =
			Character:FindFirstChildOfClass(
				"Humanoid"
			)

		if Health and Humanoid then

			Health.Size =
				UDim2.new(
					math.clamp(
						Humanoid.Health /
						math.max(
							Humanoid.MaxHealth,
							1
						),
						0,
						1
					),
					0,
					1,
					0
				)

		end

	end

end

end

