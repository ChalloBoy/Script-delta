	OpenCircle.Visible = true

end

local function RestoreUI()

	OpenCircle.Visible = false
	Main.Visible = true

	Main.Size = UDim2.fromOffset(0, 0)

	TweenService:Create(
		Main,
		TweenInfo.new(
			0.3,
			Enum.EasingStyle.Back,
			Enum.EasingDirection.Out
		),
		{
			Size = UDim2.fromOffset(570, 370)
		}
	):Play()

end

