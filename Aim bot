--==================================================
-- RGB ENGINE
--==================================================

local RGBObjects = {
    MenuOpenButton,
    MainFrame,
    TopBar,
    Title
}

local RGBButtons = {}

local function AddRGB(obj)
    table.insert(RGBButtons,obj)
end

AddRGB(MenuOpenButton)

local function RGBColor()
    return Color3.fromHSV((tick() * 0.15) % 1, 1, 1)
end

RunService.RenderStepped:Connect(function()
    local color = RGBColor()

    for _,obj in ipairs(RGBObjects) do
        if obj and obj.Parent then
            if obj == Title then
                obj.TextColor3 = color
            elseif obj == MainFrame then
                obj.BackgroundColor3 = Color3.fromRGB(20,20,25)
            else
                obj.BackgroundColor3 = color
            end
        end
    end

    for _,button in ipairs(RGBButtons) do
        if button and button.Parent then
            button.BackgroundColor3 = color
        end
    end
end)

--==================================================
-- TOGGLE CREATOR
--==================================================

local function CreateToggle(name, callback)

    local Button = Instance.new("TextButton")
    Button.Parent = Content
    Button.Size = UDim2.new(0,230,0,45)
    Button.Font = Enum.Font.SourceSansBold
    Button.TextSize = 18
    Button.TextColor3 = Color3.new(1,1,1)

    local Corner = Instance.new("UICorner")
    Corner.CornerRadius = UDim.new(0,7)
    Corner.Parent = Button

    AddRGB(Button)

    local state = false

    local function Update()
        Button.Text = name .. ": " .. (state and "ON" or "OFF")
    end

    Update()

    Button.MouseButton1Click:Connect(function()
        state = not state
        Update()
        callback(state)
    end)

    return Button
end

