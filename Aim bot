--==================================================
-- TARGET HIGHLIGHT
--==================================================

local function RemoveHighlight()
    if HighlightObject then
        HighlightObject:Destroy()
        HighlightObject = nil
    end
end

local function HighlightTarget(player)
    RemoveHighlight()

    if not player then
        return
    end

    local character = player.Character

    if not character then
        return
    end

    if not Settings.TargetHighlight then
        return
    end

    HighlightObject = Instance.new("Highlight")
    HighlightObject.Name = "SelectedTargetHighlight"
    HighlightObject.Adornee = character
    HighlightObject.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
    HighlightObject.FillTransparency = 0.8
    HighlightObject.OutlineTransparency = 0
    HighlightObject.FillColor = Accent()
    HighlightObject.OutlineColor = Accent()
    HighlightObject.Parent = character
end

local function SelectTarget(player)
    if player == LocalPlayer then
        return
    end

    SelectedTarget = player

    HighlightTarget(player)
end

--==================================================
-- PLAYER IN POV
--==================================================

local function IsPlayerInsidePOV(player)
    if player == LocalPlayer then
        return false
    end

    local character = player.Character

    if not character then
        return false
    end

    local root = character:FindFirstChild("HumanoidRootPart")

    if not root then
        return false
    end

    local screenPos, visible = Camera:WorldToViewportPoint(root.Position)

    if not visible or screenPos.Z <= 0 then
        return false
    end

    local viewport = Camera.ViewportSize

    local centerX = viewport.X / 2
    local centerY = viewport.Y / 2

    local dx = screenPos.X - centerX
    local dy = screenPos.Y - centerY

    local distance = math.sqrt(dx * dx + dy * dy)

    return distance <= Settings.POVSize / 2
end

local function GetPlayersInPOV()
    local result = {}

    for _, player in ipairs(Players:GetPlayers()) do
        if IsPlayerInsidePOV(player) then
            table.insert(result, player)
        end
    end

    return result
end

