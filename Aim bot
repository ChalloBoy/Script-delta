--==================================================
-- RESPONSIVE SIZE
--==================================================

local function Resize()
	local vp = Camera.ViewportSize

	local w = math.clamp(vp.X - 18, 300, 720)
	local h = math.clamp(vp.Y - 70, 330, 430)

	if w > vp.X - 10 then
		w = vp.X - 10
	end

	if h > vp.Y - 20 then
		h = vp.Y - 20
	end

	Window.Size = UDim2.fromOffset(w,h)

	Window.Position = UDim2.fromOffset(
		math.floor((vp.X-w)/2),
		math.floor((vp.Y-h)/2)
	)

	local sideW = math.clamp(math.floor(w*.205), 92, 145)

	Sidebar.Size = UDim2.new(0,sideW,1,0)

	Header.Position = UDim2.new(0,sideW,0,0)
	Header.Size = UDim2.new(1,-sideW,0,48)

	Content.Position = UDim2.new(0,sideW,0,48)
	Content.Size = UDim2.new(1,-sideW,1,-48)

	SidebarTitle.Position = UDim2.fromOffset(12,13)
	SidebarTitle.Size = UDim2.new(1,-20,0,18)

	NavHolder.Position = UDim2.fromOffset(7,40)
	NavHolder.Size = UDim2.new(1,-14,0,180)

	Title.Position = UDim2.fromOffset(12,5)
	Title.Size = UDim2.new(1,-55,0,22)

	Subtitle.Position = UDim2.fromOffset(12,27)
	Subtitle.Size = UDim2.new(1,-55,0,14)

	Minimize.Position = UDim2.new(1,-39,0,8)
	Minimize.Size = UDim2.fromOffset(29,29)

	Confirm.Size = UDim2.fromOffset(
		math.min(280, vp.X-30),
		155
	)

	Confirm.Position = UDim2.fromOffset(
		math.floor((vp.X-Confirm.AbsoluteSize.X)/2),
		math.floor((vp.Y-155)/2)
	)

	UpdateFOV()
end

Camera:GetPropertyChangedSignal("ViewportSize"):Connect(Resize)

