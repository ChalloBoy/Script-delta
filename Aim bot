	b.AutoButtonColor = false
	b.Parent = parent

	corner(b,6)

	b.MouseEnter:Connect(function()

		tween(
			b,
			FastTween,
			{
				BackgroundColor3 =
					color:Lerp(
						Color3.new(1,1,1),
						0.12
					)
			}
		)

	end)

	b.MouseLeave:Connect(function()

		tween(
			b,
			FastTween,
			{
				BackgroundColor3 = color
			}
		)

	end)

	return b
end

