	local viewport = Camera.ViewportSize

	local width =
		math.min(
			330,
			viewport.X-16
		)

	local height =
		math.min(
			390,
			viewport.Y-35
		)

	Main.Size =
		UDim2.fromOffset(
			width,
			height
		)

	if width < 300 then

		Menu.Size =
			UDim2.fromOffset(
				88,
				height-68
			)

		Content.Position =
			UDim2.fromOffset(
				101,
				60
			)

		Content.Size =
			UDim2.new(
				1,
				-109,
				1,
				-68
			)

	else

		Menu.Size =
			UDim2.fromOffset(
				96,
				height-68
			)

		Content.Position =
			UDim2.fromOffset(
				113,
				60
			)

		Content.Size =
			UDim2.new(
				1,
				-121,
				1,
				-68
			)
