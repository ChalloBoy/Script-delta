local RGBColor = Color3.fromRGB(50, 150, 255)

local function GetRGB()
    local t = os.clock() * 0.8

    return Color3.fromHSV(
        (t % 1),
        0.85,
        1
    )
end

local function Accent()
    if Settings.RGB then
        return GetRGB()
    end

    return RGBColor
end

