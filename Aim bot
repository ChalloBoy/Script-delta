local function NewESP(player)

	if ESPObjects[player] then
		return
	end

	local data = {
		Lines = {},
		Labels = {}
	}

	for i = 1, #Connections do
		data.Lines[i] = NewLine()
	end

	-- Name
	local name = Instance.new("TextLabel")
	name.AnchorPoint = Vector2.new(0.5, 1)
	name.BackgroundTransparency = 1
	name.Text = player.Name
	name.Font = Enum.Font.GothamBold
	name.TextStrokeTransparency = 0.3
	name.Visible = false
	name.Parent = ESPGui

	data.Name = name

	ESPObjects[player] = data
end

local function RemoveESP(player)

	local data = ESPObjects[player]

	if not data then
		return
	end

	for _, line in ipairs(data.Lines) do
		line:Destroy()
	end

	if data.Name then
		data.Name:Destroy()
	end

	ESPObjects[player] = nil
end

local function GetPart(character, name)

	return character:FindFirstChild(name)
end

local function DrawLine(line, a, b, color)

	local diff = b - a
	local length = diff.Magnitude

	line.Position = UDim2.fromOffset(
		(a.X + b.X) / 2,
		(a.Y + b.Y) / 2
	)

	line.Size = UDim2.fromOffset(
		length,
		2
	)

	line.Rotation = math.deg(
		math.atan2(diff.Y, diff.X)
	)

	line.BackgroundColor3 = color
	line.Visible = true
end

local function UpdateESP(player, data, color)

	local character = player.Character

	if not character then
		for _, line in ipairs(data.Lines) do
			line.Visible = false
		end

		data.Name.Visible = false
		return
	end

	local humanoid =
		character:FindFirstChildOfClass("Humanoid")

	if not humanoid or humanoid.Health <= 0 then

		for _, line in ipairs(data.Lines) do
			line.Visible = false
		end

		data.Name.Visible = false
		return
	end

	local positions = {}

	local anyVisible = false

	for _, connection in ipairs(Connections) do

		for _, partName in ipairs(connection) do

			if not positions[partName] then

				local part =
					GetPart(character, partName)

				if part then

					local pos, visible =
						Camera:WorldToViewportPoint(
							part.Position
						)

					positions[partName] = {
						Position = Vector2.new(
							pos.X,
							pos.Y
						),
						Visible = visible and pos.Z > 0
					}

					if visible and pos.Z > 0 then
						anyVisible = true
					end
				end
			end
		end
	end

	if not anyVisible then

		for _, line in ipairs(data.Lines) do
			line.Visible = false
		end

		data.Name.Visible = false
		return
	end

	-- Draw skeleton
	for i, connection in ipairs(Connections) do

		local a = positions[connection[1]]
		local b = positions[connection[2]]

		if a and b and a.Visible and b.Visible then

			DrawLine(
				data.Lines[i],
				a.Position,
				b.Position,
				color
			)

		else
			data.Lines[i].Visible = false
		end
	end

	-- Name
	local head = positions["Head"]

	if head and head.Visible then

		data.Name.Position =
			UDim2.fromOffset(
				head.Position.X,
				head.Position.Y - 8
			)

		data.Name.TextSize =
			math.clamp(
				15 * (NameSize / 100),
				7,
				25
			)

		data.Name.TextColor3 = color
		data.Name.Visible = true

	else
		data.Name.Visible = false
	end
end

