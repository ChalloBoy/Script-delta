	hc.Parent = holder

	local label = Instance.new("TextLabel")
	label.Size = UDim2.new(.48,0,1,0)
	label.Position = UDim2.fromOffset(13,0)
	label.BackgroundTransparency = 1
	label.Text = text
	label.TextXAlignment = Enum.TextXAlignment.Left
	label.TextColor3 = Color3.new(1,1,1)
	label.TextSize = 11
	label.Font = Enum.Font.GothamMedium
	label.ZIndex = 6
	label.Parent = holder

	local button = Instance.new("TextButton")
	button.Size = UDim2.new(.45,-4,0,34)
	button.Position = UDim2.new(.52,0,0,8)
	button.BackgroundColor3 = Color3.fromRGB(40,40,47)
	button.Text = tostring(current).."  ▼"
	button.TextColor3 = Color3.new(1,1,1)
	button.TextSize = 10
	button.Font = Enum.Font.GothamMedium
	button.AutoButtonColor = false
	button.ZIndex = 7
	button.Parent = holder

	local bc = Instance.new("UICorner")
	bc.CornerRadius = UDim.new(0,7)
	bc.Parent = button

	button.MouseButton1Click:Connect(function()

		ClosePopup()

		local popup = Instance.new("Frame")
		popup.Name = "DropdownPopup"
		popup.BackgroundColor3 = Color3.fromRGB(19,19,24)
		popup.BorderSizePixel = 0
		popup.ZIndex = 500
		popup.Parent = DropdownLayer

		local pc = Instance.new("UICorner")
		pc.CornerRadius = UDim.new(0,9)
		pc.Parent = popup

		local ps = Instance.new("UIStroke")
		ps.Thickness = 1.5
		ps.Color = Accent()
		ps.Parent = popup

		local maxHeight = 155
		local height = math.min(maxHeight,#values*30+8)

		popup.Size = UDim2.fromOffset(195,height)

		-- Posisi berdasarkan posisi tombol sebenarnya
		local pos = button.AbsolutePosition
		local size = button.AbsoluteSize

		local x = pos.X
		local y = pos.Y + size.Y + 5

		-- Jangan keluar sisi kanan
		if x + 195 > Camera.ViewportSize.X then
			x = Camera.ViewportSize.X - 200
		end

		-- Kalau tidak cukup ruang di bawah,
		-- popup muncul di atas tombol.
		if y + height > Camera.ViewportSize.Y then
			y = pos.Y - height - 5
		end

		popup.Position = UDim2.fromOffset(x,y)

		local scroll = Instance.new("ScrollingFrame")
		scroll.Size = UDim2.new(1,-8,1,-8)
		scroll.Position = UDim2.fromOffset(4,4)
		scroll.BackgroundTransparency = 1
		scroll.BorderSizePixel = 0
		scroll.ScrollBarThickness = 4
		scroll.ScrollBarImageTransparency = .15
		scroll.CanvasSize = UDim2.fromOffset(0,#values*30)
		scroll.ScrollingDirection = Enum.ScrollingDirection.Y
		scroll.Active = true
		scroll.ZIndex = 501
		scroll.Parent = popup

		local layout = Instance.new("UIListLayout")
		layout.Padding = UDim.new(0,2)
		layout.Parent = scroll

		for _,v in ipairs(values) do
			local option = Instance.new("TextButton")
			option.Size = UDim2.new(1,-5,0,27)
			option.BackgroundColor3 = Color3.fromRGB(35,35,42)
			option.Text = tostring(v)
			option.TextColor3 = Color3.new(1,1,1)
			option.TextSize = 10
			option.Font = Enum.Font.GothamMedium
			option.AutoButtonColor = false
			option.ZIndex = 502
			option.Parent = scroll

			local oc = Instance.new("UICorner")
			oc.CornerRadius = UDim.new(0,5)
			oc.Parent = option

			option.MouseEnter:Connect(function()
				option.BackgroundColor3 = Accent()
			end)

			option.MouseLeave:Connect(function()
				option.BackgroundColor3 = Color3.fromRGB(35,35,42)
			end)

			option.MouseButton1Click:Connect(function()
				current = v
				button.Text = tostring(v).."  ▼"
				callback(v)
				ClosePopup()
			end)
		end

		CurrentPopup = popup
	end)

	return holder
end

