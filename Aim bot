--========================================================

local function ShowPage(page,name)

	for _,p in pairs(Pages) do
		p.Visible = false
	end

	page.Visible = true

	for navName,b in pairs(NavButtons) do

		if navName == name then

			tween(
				b,
				SmoothTween,
				{
					BackgroundColor3 = BLUE
				}
			)

		else

			tween(
				b,
				SmoothTween,
				{
					BackgroundColor3 =
						Color3.fromRGB(27,27,27)
				}
			)

		end
	end
end

