		Size = UDim2.fromOffset(45,22),
		Text = "",
		AutoButtonColor = false
	}, box)

	Round(toggle,15)

	local dot = New("Frame", {
		BackgroundColor3 = Color3.fromRGB(180,185,195),
		BorderSizePixel = 0,
		Position = UDim2.fromOffset(3,3),
		Size = UDim2.fromOffset(16,16)
	}, toggle)

	Round(dot,20)

	local function Refresh()

		if getter() then
			toggle.BackgroundColor3 = Accent
			dot.Position = UDim2.new(1,-19,0,3)
		else
			toggle.BackgroundColor3 = Color3.fromRGB(42,45,53)
			dot.Position = UDim2.fromOffset(3,3)
		end
	end

	toggle.Activated:Connect(function()
		setter(not getter())
		Refresh()
	end)

	Refresh()

	return box
end

--========================================================
-- DROPDOWN
--========================================================

local CurrentDrop

local function OpenDropdown(id)

	local data = Dropdowns[id]
	if not data then return end

	if CurrentDrop then
		CurrentDrop:Destroy()
	end

	local popup = New("Frame", {
		BackgroundColor3 = Color3.fromRGB(12,15,21),
		BorderSizePixel = 0,
		Size = UDim2.fromOffset(175,150)
	}, DropGui)

	Round(popup,14)
	AddStroke(popup,Accent,1,.25)

	local scroll = New("ScrollingFrame", {
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		Position = UDim2.fromOffset(5,5),
		Size = UDim2.new(1,-10,1,-10),
		ScrollBarThickness = 3,
		ScrollBarImageColor3 = Accent,
		AutomaticCanvasSize = Enum.AutomaticSize.Y,
		CanvasSize = UDim2.new()
	}, popup)

	New("UIListLayout", {
		Padding = UDim.new(0,3)
	}, scroll)

	for _,value in ipairs(data.Values) do

		local item = New("TextButton", {
			BackgroundColor3 = Color3.fromRGB(22,25,33),
			BorderSizePixel = 0,
			Size = UDim2.new(1,-2,0,29),
			Text = tostring(value) .. (id == "Theme" and "" or "%"),
			TextColor3 = Color3.fromRGB(220,225,235),
			Font = Enum.Font.GothamMedium,
			TextSize = 10,
			AutoButtonColor = false
		}, scroll)

		Round(item,9)

		item.Activated:Connect(function()

			data.Setter(value)

			if id == "Theme" then
				data.Button.Text = tostring(value).."  ▼"
			else
				data.Button.Text = tostring(value).."%  ▼"
			end

			popup:Destroy()
			CurrentDrop = nil
		end)

		item.MouseEnter:Connect(function()
			item.BackgroundColor3 = Accent
		end)

		item.MouseLeave:Connect(function()
			item.BackgroundColor3 = Color3.fromRGB(22,25,33)
		end)
	end

	CurrentDrop = popup

	local pos = data.Button.AbsolutePosition
	local size = data.Button.AbsoluteSize
	local vp = Camera.ViewportSize

	local x = math.clamp(pos.X,5,vp.X-180)
	local y = pos.Y+size.Y+4

	if y+150 > vp.Y then
		y = pos.Y-154
	end

	popup.Position = UDim2.fromOffset(x,y)
end

local function MakeDropdown(parent,text,values,getter,setter,id)

	local box = New("Frame", {
		BackgroundColor3 = Color3.fromRGB(18,21,29),
		BorderSizePixel = 0,
		Size = UDim2.new(1,0,0,43)
	}, parent)

	Round(box,12)

	New("TextLabel", {
		BackgroundTransparency = 1,
		Position = UDim2.fromOffset(12,0),
		Size = UDim2.new(.43,0,1,0),
		Text = text,
		TextColor3 = Color3.fromRGB(225,228,235),
		Font = Enum.Font.GothamMedium,
		TextSize = 10,
		TextXAlignment = Enum.TextXAlignment.Left
	}, box)

	local b = New("TextButton", {
		BackgroundColor3 = Color3.fromRGB(26,29,37),
		BorderSizePixel = 0,
		Position = UDim2.new(.47,0,0,6),
		Size = UDim2.new(.50,0,0,31),
		Text = tostring(getter()).."%  ▼",
		TextColor3 = Color3.fromRGB(220,225,235),
		Font = Enum.Font.GothamMedium,
		TextSize = 9,
		AutoButtonColor = false
	}, box)

	Round(b,10)

	Dropdowns[id] = {
		Button = b,
		Values = values,
		Getter = getter,
		Setter = setter
	}

	b.Activated:Connect(function()
		OpenDropdown(id)
	end)

	return box
end

