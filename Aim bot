local Highlights = {}

local function RemoveESP()

	for player, highlight in pairs(
		Highlights
	) do

		if highlight then
			highlight:Destroy()
		end

		Highlights[player] =
			nil

	end

end

local function UpdateESP()

	if not S.ESP then

		RemoveESP()

		return

	end

	for _, player in ipairs(
		Players:GetPlayers()
	) do

		if player ~= LP then

			local char =
				player.Character

			if char then

				local highlight =
					Highlights[player]

				if not highlight then

					highlight =
						Instance.new(
							"Highlight"
						)

					highlight.Name =
						"CHALLO_BOY_ESP"

					highlight.DepthMode =
						Enum.HighlightDepthMode.AlwaysOnTop

					highlight.FillTransparency =
						1

					highlight.OutlineTransparency =
						0

					highlight.Parent =
						char

					Highlights[player] =
						highlight

				end

			end

		end

	end

end

