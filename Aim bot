--========================================================
-- DROPDOWN
--========================================================

local function Dropdown(P,text,values,get,set)

	local B = Instance.new("TextButton")
	B.Size = UDim2.new(1,0,0,31)
	B.BackgroundColor3 = Color3.fromRGB(18,21,29)
	B.BorderSizePixel = 0
	B.Text = text.." : "..tostring(get()).." ▼"
	B.TextColor3 = Color3.fromRGB(225,228,235)
	B.Font = Enum.Font.GothamMedium
	B.TextSize = 8
	B.AutoButtonColor = false
	B.Parent = P

	local C = Instance.new("UICorner")
	C.CornerRadius = UDim.new(0,10)
	C.Parent = B

	B.Activated:Connect(function()

		local old = B:FindFirstChild("Drop")

		if old then
			old:Destroy()
			return
		end

		local D = Instance.new("ScrollingFrame")
		D.Name = "Drop"
		D.Position = UDim2.new(0,0,1,4)
		D.Size = UDim2.new(1,0,0,90)
		D.BackgroundColor3 = Color3.fromRGB(11,14,20)
		D.BorderSizePixel = 0
		D.ZIndex = 20
		D.ScrollBarThickness = 2
		D.ScrollBarImageColor3 = Accent
		D.AutomaticCanvasSize = Enum.AutomaticSize.Y
		D.Parent = B

		local DL = Instance.new("UIListLayout")
		DL.Padding = UDim.new(0,3)
		DL.Parent = D

		for _,v in ipairs(values) do

			local Item = Instance.new("TextButton")
			Item.Size = UDim2.new(1,-4,0,25)
			Item.BackgroundColor3 = Color3.fromRGB(23,26,34)
			Item.BorderSizePixel = 0
			Item.Text = tostring(v)
			Item.TextColor3 = Color3.new(1,1,1)
			Item.Font = Enum.Font.GothamMedium
			Item.TextSize = 8
			Item.ZIndex = 21
			Item.Parent = D

			local IC = Instance.new("UICorner")
			IC.CornerRadius = UDim.new(0,8)
			IC.Parent = Item

			Item.Activated:Connect(function()

				set(v)
				B.Text = text.." : "..tostring(get()).." ▼"
				D:Destroy()
			end)
		end
	end)
end

