local openDropdown = nil

local function createDropdown(titleText, y, values, currentValue, callback)

	local Button = Instance.new("TextButton")
	Button.Size = UDim2.new(1, -20, 0, 40)
	Button.Position = UDim2.fromOffset(10, y)
	Button.BackgroundColor3 = Color3.fromRGB(30, 30, 37)
	Button.Text = titleText .. " : " .. tostring(currentValue) .. " ▼"
	Button.TextColor3 = Color3.new(1, 1, 1)
	Button.TextSize = 13
	Button.Font = Enum.Font.GothamBold
	Button.Parent = Content

	local ButtonCorner = Instance.new("UICorner")
	ButtonCorner.CornerRadius = UDim.new(0, 9)
	ButtonCorner.Parent = Button

	local List = Instance.new("Frame")
	List.Size = UDim2.new(1, -20, 0, 0)
	List.Position = UDim2.fromOffset(10, y + 44)
	List.BackgroundColor3 = Color3.fromRGB(24, 24, 31)
	List.BorderSizePixel = 0
	List.Visible = false
	List.ZIndex = 10
	List.Parent = Content

	local ListCorner = Instance.new("UICorner")
	ListCorner.CornerRadius = UDim.new(0, 9)
	ListCorner.Parent = List

	local Layout = Instance.new("UIListLayout")
	Layout.Padding = UDim.new(0, 2)
	Layout.Parent = List

	local open = false

	for _, value in ipairs(values) do

		local Option = Instance.new("TextButton")
		Option.Size = UDim2.new(1, 0, 0, 30)
		Option.BackgroundColor3 = Color3.fromRGB(38, 38, 46)
		Option.Text = tostring(value)
		Option.TextColor3 = Color3.new(1, 1, 1)
		Option.TextSize = 12
		Option.Font = Enum.Font.Gotham
		Option.ZIndex = 11
		Option.Parent = List

		local OptionCorner = Instance.new("UICorner")
		OptionCorner.CornerRadius = UDim.new(0, 6)
		OptionCorner.Parent = Option

		Option.MouseButton1Click:Connect(function()

			currentValue = value

			Button.Text =
				titleText ..
				" : " ..
				tostring(value) ..
				" ▼"

			List.Visible = false
			open = false
			openDropdown = nil

			callback(value)
		end)
	end

	local listHeight = #values * 32

	Button.MouseButton1Click:Connect(function()

		if openDropdown and openDropdown ~= List then
			openDropdown.Visible = false
		end

		open = not open

		if open then

			List.Size =
				UDim2.new(1, -20, 0, listHeight)

			List.Visible = true
			openDropdown = List

		else

			List.Visible = false
			openDropdown = nil
		end
	end)

	return Button
end

