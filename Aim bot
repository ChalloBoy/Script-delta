	Instance.new("UICorner",button).CornerRadius = UDim.new(0,9)

	local label = Instance.new("TextLabel")
	label.Size = UDim2.new(1,-80,1,0)
	label.Position = UDim2.fromOffset(14,0)
	label.BackgroundTransparency = 1
	label.Text = text
	label.TextXAlignment = Enum.TextXAlignment.Left
	label.TextColor3 = Color3.new(1,1,1)
	label.TextSize = 12
	label.Font = Enum.Font.GothamMedium
	label.Parent = button

	local switch = Instance.new("Frame")
	switch.Size = UDim2.fromOffset(43,23)
	switch.Position = UDim2.new(1,-57,.5,-11)
	switch.BackgroundColor3 = Color3.fromRGB(55,55,63)
	switch.BorderSizePixel = 0
	switch.Parent = button

	Instance.new("UICorner",switch).CornerRadius = UDim.new(1,0)

	local knob = Instance.new("Frame")
	knob.Size = UDim2.fromOffset(17,17)
	knob.Position = UDim2.fromOffset(3,3)
	knob.BackgroundColor3 = Color3.fromRGB(225,225,225)
	knob.BorderSizePixel = 0
	knob.Parent = switch

	Instance.new("UICorner",knob).CornerRadius = UDim.new(1,0)

	local value = default

	local function Refresh()
		if value then
			switch.BackgroundColor3 = Accent()
			knob.Position = UDim2.new(1,-20,0,3)
		else
			switch.BackgroundColor3 = Color3.fromRGB(55,55,63)
			knob.Position = UDim2.fromOffset(3,3)
		end
	end

	button.MouseButton1Click:Connect(function()
		value = not value
		callback(value)
		Refresh()
	end)

	Refresh()
end

--========================================================
-- DROPDOWN
--========================================================

local function Dropdown(parent,text,current,values,callback)

	local holder = Instance.new("Frame")
	holder.Size = UDim2.new(1,-5,0,50)
	holder.BackgroundColor3 = Color3.fromRGB(27,27,33)
	holder.BorderSizePixel = 0
	holder.Parent = parent

	Instance.new("UICorner",holder).CornerRadius = UDim.new(0,9)

	local label = Instance.new("TextLabel")
	label.Size = UDim2.new(.48,0,1,0)
	label.Position = UDim2.fromOffset(13,0)
	label.BackgroundTransparency = 1
	label.Text = text
	label.TextXAlignment = Enum.TextXAlignment.Left
	label.TextColor3 = Color3.new(1,1,1)
	label.TextSize = 11
	label.Font = Enum.Font.GothamMedium
	label.Parent = holder

	local button = Instance.new("TextButton")
	button.Size = UDim2.new(.45,-4,0,34)
	button.Position = UDim2.new(.52,0,0,8)
	button.BackgroundColor3 = Color3.fromRGB(40,40,47)
	button.Text = tostring(current).."  ▼"
	button.TextColor3 = Color3.new(1,1,1)
	button.TextSize = 10
	button.Font = Enum.Font.GothamMedium
	button.AutoButtonColor = false
	button.Parent = holder

	Instance.new("UICorner",button).CornerRadius = UDim.new(0,7)

	button.MouseButton1Click:Connect(function()

		CloseDropdown()

		local popup = Instance.new("Frame")
		popup.Size = UDim2.fromOffset(205,math.min(180,#values*30+8))
		popup.BackgroundColor3 = Color3.fromRGB(19,19,24)
		popup.BorderSizePixel = 0
		popup.ZIndex = 500
		popup.Parent = DropdownGui

		Instance.new("UICorner",popup).CornerRadius = UDim.new(0,9)

		local stroke = Instance.new("UIStroke")
		stroke.Thickness = 1.5
		stroke.Parent = popup

		local pos = button.AbsolutePosition
		local size = button.AbsoluteSize
		local height = popup.AbsoluteSize.Y

		local x = pos.X
		local y = pos.Y + size.Y + 5

		local viewport = workspace.CurrentCamera.ViewportSize

		if x + 205 > viewport.X then
			x = viewport.X - 210
		end

		if y + height > viewport.Y then
			y = pos.Y - height - 5
		end

		x = math.max(5,x)
		y = math.max(5,y)

		popup.Position = UDim2.fromOffset(x,y)

		local scroll = Instance.new("ScrollingFrame")
		scroll.Size = UDim2.new(1,-8,1,-8)
		scroll.Position = UDim2.fromOffset(4,4)
		scroll.BackgroundTransparency = 1
		scroll.BorderSizePixel = 0
		scroll.ScrollBarThickness = 4
		scroll.CanvasSize = UDim2.fromOffset(0,#values*30)
		scroll.Active = true
		scroll.ZIndex = 501
		scroll.Parent = popup

		local layout = Instance.new("UIListLayout")
		layout.Padding = UDim.new(0,2)
		layout.Parent = scroll

		for _,v in ipairs(values) do

			local option = Instance.new("TextButton")
			option.Size = UDim2.new(1,-5,0,27)
			option.BackgroundColor3 = Color3.fromRGB(35,35,42)
			option.Text = tostring(v)
			option.TextColor3 = Color3.new(1,1,1)
			option.TextSize = 10
			option.Font = Enum.Font.GothamMedium
			option.AutoButtonColor = false
			option.ZIndex = 502
			option.Parent = scroll

			Instance.new("UICorner",option).CornerRadius = UDim.new(0,5)

			option.MouseButton1Click:Connect(function()
				current = v
				button.Text = tostring(v).."  ▼"
				callback(v)
				CloseDropdown()
			end)
		end
	end)
end

