	page.ScrollBarImageColor3 = BLUE

	page.CanvasSize =
		UDim2.new(0,0,0,0)

	page.Visible = false
	page.ZIndex = 4
	page.Parent = Content

	local layout =
		Instance.new("UIListLayout")

	layout.Padding =
		UDim.new(0,10)

	layout.SortOrder =
		Enum.SortOrder.LayoutOrder

	layout.Parent = page

	layout:GetPropertyChangedSignal(
		"AbsoluteContentSize"
	):Connect(function()

		page.CanvasSize =
			UDim2.new(
				0,0,
				0,
				layout.AbsoluteContentSize.Y + 20
			)
	end)

	Pages[name] = page

	return page
end

