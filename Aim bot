end)

--========================================================
-- RGB REFRESH
--========================================================

RunService.RenderStepped:Connect(function()

	if Settings.RGB then

		local c = Accent()

		WindowStroke.Color = c
		KeyStroke.Color = c
		FOVStroke.Color = c

		for _,b in ipairs({
			AimTab,
			FOVTab,
			LimitTab,
			SettingTab
		}) do

			if b.BackgroundColor3 ~= Color3.fromRGB(25,25,30) then
				b.BackgroundColor3 = c
			end
		end
	end
end)

