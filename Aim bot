local Hue = 0

RunService.RenderStepped:Connect(function(dt)

	-- RGB
	if Settings.RGB then

		Hue =
			(Hue+dt*.15)%1

		Accent =
			Color3.fromHSV(
				Hue,
				.8,
				1
			)

	else

		Accent =
			Color3.fromRGB(
				45,
				130,
				255
			)
	end

	MainStroke.Color = Accent
	FOVStroke.Color = Accent
	Save.BackgroundColor3 = Accent
	Yes.BackgroundColor3 = Accent
	Title.TextColor3 = Color3.fromRGB(240,240,245)

	UpdateFOV()

	-- AIM
	if Settings.Aim
		and Settings.Strength > 0 then

		local target =
			GetTarget()

		if target then

			local desired =
				CFrame.lookAt(
					Camera.CFrame.Position,
					target.Position
				)

			Camera.CFrame =
				Camera.CFrame:Lerp(
					desired,
					GetAimAlpha(
						Settings.Strength
					)
				)
		end
	end

	-- ESP
	for player,highlight in pairs(ESP) do
		if highlight then
			highlight.OutlineColor = Accent
		end
	end
end)

task.spawn(function()

	while task.wait(.4) do

		for _,player in ipairs(
			Players:GetPlayers()
		) do

			if player ~= LocalPlayer then

				if Settings.ESP then
					AddESP(player)
				else
					RemoveESP(player)
				end
			end
		end
	end
end)

