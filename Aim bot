local function addToggle(name, key)
    local button
    local function update()
        button.Text = name .. ": " .. (settings.esp[key] and "ON" or "OFF")
        button.BackgroundColor3 = settings.esp[key]
            and Color3.fromRGB(35, 105, 75)
            or Color3.fromRGB(48, 52, 66)
    end
    button = makeButton("", function()
        settings.esp[key] = not settings.esp[key]
        update()
    end)
    update()
end

