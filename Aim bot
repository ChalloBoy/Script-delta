--==================================================
-- ANTI-WALL RAYCAST
--==================================================

local function IsVisible(character)
	local head = character:FindFirstChild("Head")

	if not head then
		return false
	end

	local origin = Camera.CFrame.Position
	local direction = head.Position - origin

	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Exclude

	local ignore = {}

	if LocalPlayer.Character then
		table.insert(ignore, LocalPlayer.Character)
	end

	table.insert(ignore, Camera)

	params.FilterDescendantsInstances = ignore

	local result = workspace:Raycast(
		origin,
		direction,
		params
	)

	-- Tidak ada benda yang menghalangi
	if not result then
		return true
	end

	-- Benda pertama adalah bagian tubuh target
	if result.Instance:IsDescendantOf(character) then
		return true
	end

	-- Tembok/objek menghalangi
	return false
end

--==================================================
-- FIND TARGET
--==================================================

local function GetTarget()
	local closestPlayer = nil
	local closestDistance = FOV

	local viewport = Camera.ViewportSize
	local center = Vector2.new(
		viewport.X / 2,
		viewport.Y / 2
	)

	for _, player in ipairs(Players:GetPlayers()) do

		if player ~= LocalPlayer then

			local character = player.Character

			if character then

				local humanoid =
					character:FindFirstChildOfClass("Humanoid")

				local head =
					character:FindFirstChild("Head")

				if humanoid
					and humanoid.Health > 0
					and head then

					local screenPosition, onScreen =
						Camera:WorldToViewportPoint(
							head.Position
						)

					if onScreen then

						local screenDistance =
							(Vector2.new(
								screenPosition.X,
								screenPosition.Y
							) - center).Magnitude

						if screenDistance <= closestDistance then

							-- ANTI TEMBOK
							if IsVisible(character) then

								closestDistance =
									screenDistance

								closestPlayer = player
							end
						end
					end
				end
			end
		end
	end

	return closestPlayer
end

--==================================================
-- ESP SYSTEM
--==================================================

local ESPObjects = {}

local ESPGui = Instance.new("ScreenGui")
ESPGui.Name = "ESP_Overlay"
ESPGui.ResetOnSpawn = false
ESPGui.IgnoreGuiInset = true
ESPGui.Parent = LocalPlayer.PlayerGui

local function removeESP(player)

	local data = ESPObjects[player]

	if data then

		if data.Billboard then
			data.Billboard:Destroy()
		end

		if data.Tracer then
			data.Tracer:Destroy()
		end

		ESPObjects[player] = nil
	end
end

local function createESP(player)

	if player == LocalPlayer then
		return
	end

	if ESPObjects[player] then
		return
	end

	local tracer = Instance.new("Frame")
	tracer.Name = "RGB_Tracer"
	tracer.AnchorPoint = Vector2.new(0.5, 0)
	tracer.BorderSizePixel = 0
	tracer.Visible = false
	tracer.Parent = ESPGui

	local tracerCorner = Instance.new("UICorner")
	tracerCorner.CornerRadius = UDim.new(1, 0)
	tracerCorner.Parent = tracer

	ESPObjects[player] = {
		Tracer = tracer,
		Billboard = nil
	}
end

local function setupBillboard(player, character)

	local data = ESPObjects[player]

	if not data then
		return
	end

	if data.Billboard then
		data.Billboard:Destroy()
	end

	local head = character:FindFirstChild("Head")

	if not head then
		return
	end

	local billboard = Instance.new("BillboardGui")
	billboard.Name = "ESP_Hologram"
	billboard.Adornee = head
	billboard.Size = UDim2.fromOffset(170, 55)
	billboard.StudsOffset = Vector3.new(0, 3, 0)

	-- MENEMBUS TEMBOK
	billboard.AlwaysOnTop = true

	billboard.MaxDistance = math.huge
	billboard.Parent = head

	local label = Instance.new("TextLabel")
	label.Size = UDim2.fromScale(1, 1)
	label.BackgroundTransparency = 1
	label.Text = player.Name
	label.TextSize = 15
	label.Font = Enum.Font.GothamBold
	label.TextStrokeTransparency = 0.25
	label.Parent = billboard

	data.Billboard = billboard
	data.Label = label
end

local function updateESP(player, data)

	local character = player.Character

	if not character then
		if data.Tracer then
			data.Tracer.Visible = false
		end
		return
	end

	local humanoid =
		character:FindFirstChildOfClass("Humanoid")

	local head = character:FindFirstChild("Head")

	if not humanoid
		or humanoid.Health <= 0
		or not head then

		data.Tracer.Visible = false
		return
	end

	if not data.Billboard
		or data.Billboard.Adornee ~= head then

		setupBillboard(player, character)
	end

	--==============================
	-- RGB HOLOGRAM
	--==============================

	if data.Label then
		local hue =
			((os.clock() * RGB_SPEED) % 1)

		data.Label.TextColor3 =
			Color3.fromHSV(hue, 1, 1)
	end

	--==============================
	-- RGB SCREEN TRACER
	--==============================

	local screenPos, onScreen =
		Camera:WorldToViewportPoint(head.Position)

	if not onScreen or screenPos.Z <= 0 then
		data.Tracer.Visible = false
		return
	end

	local viewport = Camera.ViewportSize

	local startPos = Vector2.new(
		viewport.X / 2,
		viewport.Y
	)

	local endPos = Vector2.new(
		screenPos.X,
		screenPos.Y
	)

	local difference = endPos - startPos
	local length = difference.Magnitude

	if length < 2 then
		data.Tracer.Visible = false
		return
	end

	local angle =
		math.deg(
			math.atan2(
				difference.Y,
				difference.X
			)
		)

	data.Tracer.Visible = ESPEnabled

	data.Tracer.Position =
		UDim2.fromOffset(
			startPos.X,
			startPos.Y
		)

	data.Tracer.Size =
		UDim2.fromOffset(
			length,
			2
		)

	data.Tracer.Rotation = angle

	local hue =
		((os.clock() * RGB_SPEED) % 1)

	data.Tracer.BackgroundColor3 =
		Color3.fromHSV(hue, 1, 1)
end

--==================================================
-- PLAYER CONNECTIONS
--==================================================

local function setupPlayer(player)

	if player == LocalPlayer then
		return
	end

	createESP(player)

	player.CharacterAdded:Connect(function(character)

		task.wait(0.2)

		if ESPObjects[player] then
			setupBillboard(player, character)
		end
	end)
end

for _, player in ipairs(Players:GetPlayers()) do
	setupPlayer(player)
end

Players.PlayerAdded:Connect(setupPlayer)

Players.PlayerRemoving:Connect(function(player)
	removeESP(player)
end)

--==================================================
-- MAIN LOOP
--==================================================

RunService.RenderStepped:Connect(function()

	--==============================================
	-- FOV
	--==============================================

	FOVCircle.Size =
		UDim2.fromOffset(
			FOV * 2,
			FOV * 2
		)

	FOVCircle.Visible = AimEnabled

	--==============================================
	-- AIM
	--==============================================

	if AimEnabled then

		local target = GetTarget()

		if target
			and target.Character then

			local head =
				target.Character:FindFirstChild("Head")

			if head then

				-- CEK ULANG ANTI-TEMBOK
				if IsVisible(target.Character) then

					local strength =
						math.clamp(
							AimStrength / 100,
							0.01,
							1
						)

					Camera.CFrame =
						Camera.CFrame:Lerp(
							CFrame.lookAt(
								Camera.CFrame.Position,
								head.Position
							),
							strength
						)
				end
			end
		end
	end

	--==============================================
	-- ESP
	--==============================================

	for player, data in pairs(ESPObjects) do

		if ESPEnabled then
			updateESP(player, data)
		else
			data.Tracer.Visible = false
		end
	end
end)

