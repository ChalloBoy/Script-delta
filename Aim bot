local ESPObjects = {}

local function RemoveESP(player)
	local obj = ESPObjects[player]

	if obj then
		if obj.Highlight then
			obj.Highlight:Destroy()
		end

		if obj.Billboard then
			obj.Billboard:Destroy()
		end

		ESPObjects[player] = nil
	end
end

local function CreateESP(player)
	if player == LocalPlayer then
		return
	end

	if ESPObjects[player] then
		return
	end

	local data = {}
	ESPObjects[player] = data

	local function Setup(character)
		RemoveESP(player)

		if not character then
			return
		end

		local humanoid = character:FindFirstChildOfClass("Humanoid")
		if not humanoid then
			return
		end

		local highlight = Instance.new("Highlight")
		highlight.Name = "CHALLO_ESP"
		highlight.Adornee = character
		highlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
		highlight.FillTransparency = 1
		highlight.OutlineTransparency = 0
		highlight.OutlineColor = GetAccent()
		highlight.Enabled = false
		highlight.Parent = character

		data.Highlight = highlight

		local billboard = Instance.new("BillboardGui")
		billboard.Name = "CHALLO_INFO"
		billboard.Size = UDim2.fromOffset(160, 45)
		billboard.StudsOffset = Vector3.new(0, 3.5, 0)
		billboard.AlwaysOnTop = true
		billboard.Enabled = false
		billboard.Parent = character

		local info = Instance.new("TextLabel")
		info.Size = UDim2.fromScale(1, 1)
		info.BackgroundTransparency = 1
		info.TextColor3 = Color3.new(1, 1, 1)
		info.TextStrokeTransparency = 0
		info.TextSize = 11
		info.Font = Enum.Font.GothamBold
		info.Parent = billboard

		data.Billboard = billboard
		data.Info = info
	end

	if player.Character then
		Setup(player.Character)
	end

	player.CharacterAdded:Connect(function(character)
		task.wait(0.5)
		Setup(character)
	end)
end

for _, player in ipairs(Players:GetPlayers()) do
	CreateESP(player)
end

Players.PlayerAdded:Connect(CreateESP)
Players.PlayerRemoving:Connect(RemoveESP)

--==================================================
-- TARGET
--==================================================

local function IsVisible(character, part)
	local origin = Camera.CFrame.Position
	local direction = part.Position - origin

	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Exclude
	params.FilterDescendantsInstances = {
		LocalPlayer.Character,
		character
	}

	local result = workspace:Raycast(origin, direction, params)

	return result == nil
end

local function GetTarget()
	local bestTarget = nil
	local bestDistance = Settings.FOVSize

	local center = Vector2.new(
		Camera.ViewportSize.X / 2,
		Camera.ViewportSize.Y / 2
	)

	for _, player in ipairs(Players:GetPlayers()) do
		if player ~= LocalPlayer then
			local character = player.Character
			local humanoid = character and character:FindFirstChildOfClass("Humanoid")
			local part = character and character:FindFirstChild(Settings.TargetPart)

			if humanoid and humanoid.Health > 0 and part then

				if Settings.TeamCheck and player.Team == LocalPlayer.Team then
					continue
				end

				local distance = (part.Position - Camera.CFrame.Position).Magnitude

				if distance <= Settings.MaxDistance then
					local screenPos, onScreen =
						Camera:WorldToViewportPoint(part.Position)

					if onScreen then
						local screenDistance =
							(Vector2.new(screenPos.X, screenPos.Y) - center).Magnitude

						if screenDistance <= bestDistance then

							if Settings.VisibilityCheck then
								if not IsVisible(character, part) then
									continue
								end
							end

							bestDistance = screenDistance
							bestTarget = part
						end
					end
				end
			end
		end
	end

	return bestTarget
end

--==================================================
-- MAIN LOOP
--==================================================

RunService.RenderStepped:Connect(function()

	-- FOV
	FOVCircle.Visible = Settings.FOVEnabled

	if Settings.FOVEnabled then
		FOVCircle.Size = UDim2.fromOffset(
			Settings.FOVSize * 2,
			Settings.FOVSize * 2
		)

		FOVCircle.Position = UDim2.fromOffset(
			Camera.ViewportSize.X / 2,
			Camera.ViewportSize.Y / 2
		)

		FOVStroke.Thickness = Settings.FOVThickness
		FOVStroke.Transparency = Settings.FOVTransparency / 100

		if Settings.FOVShape == "Circle" then
			FOVCorner.CornerRadius = UDim.new(1, 0)
		else
			FOVCorner.CornerRadius = UDim.new(0, 8)
		end
	end

	-- AIM
	if Settings.AimEnabled then
		local target = GetTarget()

		if target then
			local strength = math.clamp(Settings.AimStrength / 100, 0, 1)

			if strength > 0 then
				local cameraPosition = Camera.CFrame.Position
				local desired = CFrame.lookAt(cameraPosition, target.Position)

				Camera.CFrame = Camera.CFrame:Lerp(
					desired,
					math.clamp(strength * 0.35, 0, 1)
				)
			end
		end
	end

	-- ESP
	for player, data in pairs(ESPObjects) do
		local character = player.Character

		if character and data.Highlight and data.Billboard then
			local humanoid = character:FindFirstChildOfClass("Humanoid")

			local enabled = Settings.ESPEnabled

			data.Highlight.Enabled = enabled and Settings.BoxESP
			data.Billboard.Enabled =
				enabled and (
					Settings.NameESP
					or Settings.DistanceESP
					or Settings.HealthESP
				)

			data.Highlight.OutlineColor = GetAccent()

			if humanoid and data.Info then
				local text = ""

				if Settings.NameESP then
					text = player.DisplayName
				end

				if Settings.DistanceESP then
					local root = character:FindFirstChild("HumanoidRootPart")

					if root then
						local distance =
							math.floor(
								(root.Position - Camera.CFrame.Position).Magnitude
							)

						if text ~= "" then
							text = text .. "  "
						end

						text = text .. distance .. "m"
					end
				end

				if Settings.HealthESP then
					local hp = math.floor(humanoid.Health)

					if text ~= "" then
						text = text .. "  "
					end

					text = text .. "HP: " .. hp
				end

				data.Info.Text = text
				data.Info.TextColor3 = GetAccent()
			end
		end
	end

	-- RGB / UI ACCENT
	local accent = GetAccent()

	MainStroke.Color = accent
	FOVStroke.Color = accent

	if Settings.RGBEnabled then
		Logo.TextColor3 = accent
		Title.TextColor3 = accent
	else
		Logo.TextColor3 = Color3.new(1, 1, 1)
		Title.TextColor3 = Color3.new(1, 1, 1)
	end
end)

