    RestoreStroke.Color = RGB

    Knob.BackgroundColor3 = RGB
    StrengthKnob.BackgroundColor3 = RGB

    Credit.TextColor3 = RGB
    MiniCredit.TextColor3 = RGB

    -- Marker
    for _, Marker in pairs(Markers) do
        if Marker then
            Marker.Enabled = MarkerEnabled
        end
    end

    --==================================================
    -- AIM ASSIST
    --==================================================

    if AimEnabled and AimStrength > 0 then

        local Target = GetTarget()

        if Target and Target.Character then

            local Root =
                Target.Character:FindFirstChild(
                    "HumanoidRootPart"
                )

            if Root then

                local TargetCFrame =
                    CFrame.lookAt(
                        Camera.CFrame.Position,
                        Root.Position
                    )

                Camera.CFrame =
                    Camera.CFrame:Lerp(
                        TargetCFrame,
                        AimStrength
                    )
            end
        end
    end
end)
