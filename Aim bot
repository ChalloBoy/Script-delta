	local Popup = Instance.new("ScrollingFrame")
	Popup.Name = "DropdownScroll"
	Popup.Size = UDim2.new(0, 190, 0, math.min(145, #values * 30))
	Popup.Position = UDim2.new(1, -195, 1, 5)
	Popup.BackgroundColor3 = Color3.fromRGB(23, 23, 28)
	Popup.BorderSizePixel = 0
	Popup.ScrollBarThickness = 4
	Popup.ScrollBarImageTransparency = 0.15
	Popup.CanvasSize = UDim2.fromOffset(0, #values * 30)
	Popup.ScrollingDirection = Enum.ScrollingDirection.Y
	Popup.Active = true
	Popup.Visible = false
	Popup.ZIndex = 50
	Popup.Parent = Holder

	local PopupCorner = Instance.new("UICorner")
	PopupCorner.CornerRadius = UDim.new(0, 8)
	PopupCorner.Parent = Popup

	local PopupStroke = Instance.new("UIStroke")
	PopupStroke.Thickness = 1
	PopupStroke.Color = Color3.fromRGB(70, 70, 80)
	PopupStroke.Parent = Popup

	local PopupList = Instance.new("UIListLayout")
	PopupList.Padding = UDim.new(0, 2)
	PopupList.Parent = Popup

	local PopupPadding = Instance.new("UIPadding")
	PopupPadding.PaddingTop = UDim.new(0, 3)
	PopupPadding.PaddingBottom = UDim.new(0, 3)
	PopupPadding.PaddingLeft = UDim.new(0, 3)
	PopupPadding.PaddingRight = UDim.new(0, 3)
	PopupPadding.Parent = Popup

	for _, option in ipairs(values) do
		local Option = Instance.new("TextButton")
		Option.Size = UDim2.new(1, -6, 0, 27)
		Option.BackgroundColor3 = Color3.fromRGB(35, 35, 42)
		Option.Text = tostring(option)
		Option.TextColor3 = Color3.new(1, 1, 1)
		Option.TextSize = 10
		Option.Font = Enum.Font.GothamMedium
		Option.AutoButtonColor = false
		Option.ZIndex = 51
		Option.Parent = Popup

		local OptionCorner = Instance.new("UICorner")
		OptionCorner.CornerRadius = UDim.new(0, 5)
		OptionCorner.Parent = Option

		Option.MouseButton1Click:Connect(function()
			current = option
			Drop.Text = tostring(option) .. "  ▼"
			callback(option)

			Popup.Visible = false
			OpenDropdown = nil
		end)
	end

	Drop.MouseButton1Click:Connect(function()
		if OpenDropdown and OpenDropdown ~= Popup then
			OpenDropdown.Visible = false
		end

		Popup.Visible = not Popup.Visible

		if Popup.Visible then
			OpenDropdown = Popup

			-- Pastikan popup tetap bisa dilihat dengan menggeser
			-- Scroll utama sedikit bila dropdown berada di bagian bawah.
			task.defer(function()
				local bottom = Holder.AbsolutePosition.Y + Holder.AbsoluteSize.Y + Popup.AbsoluteSize.Y
				local viewportBottom = Scroll.AbsolutePosition.Y + Scroll.AbsoluteSize.Y

				if bottom > viewportBottom then
					local difference = bottom - viewportBottom + 15
					Scroll.CanvasPosition = Vector2.new(
						Scroll.CanvasPosition.X,
						Scroll.CanvasPosition.Y + difference
					)
				end
			end)
		else
			OpenDropdown = nil
		end
	end)

	return Holder
end

