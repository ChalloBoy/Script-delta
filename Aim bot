local Hue = 0

RunService.RenderStepped:Connect(function()

    -- RGB
    Hue = (Hue + 0.0012) % 1

    local RGB =
        Color3.fromHSV(
            Hue,
            0.85,
            1
        )

    FOVStroke.Color = RGB
