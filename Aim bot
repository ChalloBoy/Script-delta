-- ESP NPC saja; buat Folder Workspace.NPCs
local espEnabled = false
local highlights = {}

local espToggle = button(
	espPage, "NPC ESP: OFF",
	UDim2.new(1, -20, 0, 34), UDim2.fromOffset(10, 14)
)
label(espPage, "Menandai NPC dalam Workspace.NPCs.", 58)

local function clearHighlights()
	for _, h in ipairs(highlights) do
		if h then h:Destroy() end
	end
	table.clear(highlights)
end

local function refreshNPCs()
	clearHighlights()
	if not espEnabled then return end

	local folder = workspace:FindFirstChild("NPCs")
	if not folder then return end

	for _, npc in ipairs(folder:GetChildren()) do
		if npc:IsA("Model") and npc:FindFirstChildOfClass("Humanoid") then
			local h = Instance.new("Highlight")
			h.Name = "ChalloNPCHighlight"
			h.Adornee = npc
			h.DepthMode = Enum.HighlightDepthMode.Occluded
			h.FillColor = Color3.fromRGB(90, 150, 255)
			h.OutlineColor = Color3.fromRGB(210, 225, 255)
			h.Parent = npc
			table.insert(highlights, h)
		end
	end
end

espToggle.Activated:Connect(function()
	espEnabled = not espEnabled
	espToggle.Text = espEnabled and "NPC ESP: ON" or "NPC ESP: OFF"
	refreshNPCs()
end)

local refreshButton = button(
