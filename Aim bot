local function GetAccent()
	if Settings.RGBEnabled then
		return Color3.fromHSV((os.clock() * 0.12) % 1, 0.85, 1)
	end

	if Settings.Theme == "Blue" then
		return Color3.fromRGB(60, 140, 255)
	elseif Settings.Theme == "Purple" then
		return Color3.fromRGB(170, 90, 255)
	elseif Settings.Theme == "Green" then
		return Color3.fromRGB(60, 220, 130)
	elseif Settings.Theme == "Dark" then
		return Color3.fromRGB(100, 100, 110)
	end

	return Color3.fromRGB(100, 100, 110)
end

