local function UpdateFOV()

	FOV.Visible = Settings.FOVEnabled
	FOV.Size = UDim2.fromOffset(
		Settings.FOVSize * 2,
		Settings.FOVSize * 2
	)

	FOV.Position = UDim2.fromScale(.5,.5)

	FOVStroke.Thickness = Settings.FOVThickness
	FOVStroke.Transparency = Settings.FOVTransparency / 100
