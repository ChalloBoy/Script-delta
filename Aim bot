local C = Instance.new("UICorner")
C.CornerRadius = UDim.new(0,7)
C.Parent = Box

local Label = Instance.new("TextLabel")
Label.Size = UDim2.new(.5,0,1,0)
Label.Position = UDim2.fromOffset(12,0)
Label.BackgroundTransparency = 1
Label.Text = title
Label.TextColor3 = Color3.fromRGB(235,235,238)
Label.Font = Enum.Font.GothamBold
Label.TextSize = 11
Label.TextXAlignment = Enum.TextXAlignment.Left
Label.ZIndex = 14
Label.Parent = Box

local Button = Instance.new("TextButton")
Button.Size = UDim2.fromOffset(100,30)
Button.Position = UDim2.new(1,-112,.5,-15)
Button.BackgroundColor3 = Color3.fromRGB(45,45,48)
Button.Text = tostring(current).."  ▼"
Button.TextColor3 = Color3.fromRGB(225,225,228)
Button.Font = Enum.Font.GothamBold
Button.TextSize = 9
Button.AutoButtonColor = false
Button.ZIndex = 15
Button.Parent = Box

local BC = Instance.new("UICorner")
BC.CornerRadius = UDim.new(0,6)
BC.Parent = Button

local Open = false

Button.MouseButton1Click:Connect(function()

	if Open then

		if OpenDropdown then
			OpenDropdown:Destroy()
			OpenDropdown = nil
		end

		Open = false
		return
	end

	if OpenDropdown then
		OpenDropdown:Destroy()
		OpenDropdown = nil
	end

	Open = true

	local List = Instance.new("Frame")
	List.Size = UDim2.new(0,100,0,#values*25)
	List.Position = UDim2.new(1,-112,1,4)
	List.BackgroundColor3 = Color3.fromRGB(40,40,43)
	List.BorderSizePixel = 0
	List.ZIndex = 50
	List.Parent = Box

	OpenDropdown = List

	local LC = Instance.new("UICorner")
	LC.CornerRadius = UDim.new(0,6)
	LC.Parent = List

	for i,value in ipairs(values) do

		local Option = Instance.new("TextButton")
		Option.Size = UDim2.new(1,0,0,25)
		Option.Position = UDim2.fromOffset(0,(i-1)*25)
		Option.BackgroundTransparency = 1
		Option.Text = tostring(value)
		Option.TextColor3 = Color3.fromRGB(230,230,233)
		Option.Font = Enum.Font.Gotham
		Option.TextSize = 9
		Option.ZIndex = 51
		Option.Parent = List

		Option.MouseButton1Click:Connect(function()

			Button.Text =
				tostring(value).."  ▼"

			callback(value)

			List:Destroy()
			OpenDropdown = nil
			Open = false

		end)

	end

end)

return Box

end

