local hue =
	0

local function RGBColor()

	return Color3.fromHSV(
		hue,
		0.8,
		1
	)
end

--==================================================
-- MAIN LOOP
--==================================================

RunService.RenderStepped:Connect(function(dt)

	-- FOV
	if S.FOVEnabled then

		local viewport =
			Camera.ViewportSize

		FOVCircle.Position =
			UDim2.fromOffset(
				viewport.X / 2,
				viewport.Y / 2
			)

		FOVCircle.Size =
			UDim2.fromOffset(
				S.FOV * 2,
				S.FOV * 2
			)

		FOVCircle.Visible =
			true

	else
		FOVCircle.Visible =
			false
	end

	-- AIM
	if S.Aim
		and S.Strength > 0 then

		local target =
			GetTarget()

		if target then

			local desired =
				CFrame.lookAt(
					Camera.CFrame.Position,
					target.Position
				)

			local alpha =
				GetAimAlpha(
					S.Strength
				)

			Camera.CFrame =
				Camera.CFrame:Lerp(
					desired,
					alpha
				)
		end
	end

	-- ESP
	UpdateESP()

	-- RGB
	if S.RGB then

		hue =
			(hue + dt * 0.35)
			% 1

		local color =
			RGBColor()

		Stroke.Color =
			color

		CircleStroke.Color =
			color

		MiniStroke.Color =
			color

	else

		Stroke.Color =
			ACCENT

		CircleStroke.Color =
			ACCENT

		MiniStroke.Color =
			ACCENT
	end
end)
