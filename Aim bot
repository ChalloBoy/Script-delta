	Button.TextSize = 14
	Button.Font = Enum.Font.GothamBold
	Button.Parent = Main

	Instance.new("UICorner", Button).CornerRadius = UDim.new(0,9)

	local state = true

	Button.MouseButton1Click:Connect(function()
		state = not state
		callback(state)
	end)

	return Button
end

