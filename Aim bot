--==================================================
-- DROPDOWN CREATOR
--==================================================

local function createDropdown(titleText,y,values,currentValue,callback)

	local Button = Instance.new("TextButton")
	Button.Size = UDim2.new(1,-30,0,38)
	Button.Position = UDim2.fromOffset(15,y)
	Button.BackgroundColor3 = Color3.fromRGB(30,30,37)
	Button.Text = titleText .. " : " .. tostring(currentValue) .. " ▼"
	Button.TextColor3 = Color3.new(1,1,1)
	Button.TextSize = 13
	Button.Font = Enum.Font.GothamBold
	Button.Parent = Main

	local corner = Instance.new("UICorner")
	corner.CornerRadius = UDim.new(0,9)
	corner.Parent = Button

	addContent(Button)

	local List = Instance.new("Frame")
	List.Size = UDim2.new(1,-30,0,0)
	List.Position = UDim2.fromOffset(15,y+42)
	List.BackgroundColor3 = Color3.fromRGB(25,25,32)
	List.BorderSizePixel = 0
	List.Visible = false
	List.ZIndex = 20
	List.Parent = Main

	local listCorner = Instance.new("UICorner")
	listCorner.CornerRadius = UDim.new(0,9)
	listCorner.Parent = List

	local layout = Instance.new("UIListLayout")
	layout.Padding = UDim.new(0,2)
	layout.Parent = List

	local open = false

	for _,value in ipairs(values) do

		local Option = Instance.new("TextButton")
		Option.Size = UDim2.new(1,0,0,30)
		Option.BackgroundColor3 = Color3.fromRGB(35,35,43)
		Option.Text = tostring(value)
		Option.TextColor3 = Color3.new(1,1,1)
		Option.TextSize = 12
		Option.Font = Enum.Font.Gotham
		Option.ZIndex = 21
		Option.Parent = List

		Option.MouseButton1Click:Connect(function()

			currentValue = value

			Button.Text =
				titleText ..
				" : " ..
				tostring(value) ..
				" ▼"

			List.Visible = false
			open = false

			callback(value)
		end)
	end

	local listHeight =
		#values * 32

	Button.MouseButton1Click:Connect(function()

		open = not open

		if open then
			List.Size =
				UDim2.new(1,-30,0,listHeight)

			List.Visible = true
		else
			List.Visible = false
		end
	end)

	return Button,List
end

