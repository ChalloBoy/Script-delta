-- RENDER LOOP
--------------------------------------------------------

RunService.RenderStepped:Connect(function(dt)

	----------------------------------------------------
	-- FOV
	----------------------------------------------------

	FOVCircle.Visible =
		S.ShowFOV

	FOVCircle.Size =
		UDim2.fromOffset(
			S.FOV * 2,
			S.FOV * 2
		)

	----------------------------------------------------
	-- AIM
	----------------------------------------------------

	if S.Aim
		and S.Strength > 0 then

		local target =
			GetTarget()

		if target then

			local desired =
				CFrame.lookAt(
					Camera.CFrame.Position,
					target.Position
				)

			local alpha =
				GetAimAlpha(
					S.Strength
				)

			Camera.CFrame =
				Camera.CFrame:Lerp(
					desired,
					alpha
				)

		end

	end

	----------------------------------------------------
	-- ESP
	----------------------------------------------------

	UpdateESP()

	----------------------------------------------------
	-- RGB
	----------------------------------------------------

	if S.RGB then

		hue =
			(hue + dt * 0.15)
			% 1

		local rgb =
			Color3.fromHSV(
				hue,
				0.8,
				1
			)

		Logo.TextColor3 =
			rgb

		Stroke.Color =
			rgb

	else

		Logo.TextColor3 =
			Color3.new(
				1,
				1,
				1
			)

		Stroke.Color =
			Color3.new(
				1,
				1,
				1
			)

	end

	----------------------------------------------------
	-- UI SIZE
	----------------------------------------------------

	Window.Size =
		UDim2.new(
			0,
			390 * S.UISize,
			0,
			500 * S.UISize
		)

end)

