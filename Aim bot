-- AIM TARGET
--==================================================

local function IsVisible(character, part)
	if not S.WallCheck then
		return true
	end

	if not character or not part then
		return false
	end

	local origin = Camera.CFrame.Position
	local direction = part.Position-origin

	if direction.Magnitude <= 0 then
		return true
	end

	local params = RaycastParams.new()

	params.FilterType = Enum.RaycastFilterType.Exclude
	params.FilterDescendantsInstances = {
		LP.Character
	}

	params.IgnoreWater = false

	local result = workspace:Raycast(
		origin,
		direction,
		params
	)

	if not result then
		return true
	end

	return result.Instance:IsDescendantOf(character)
end

local function GetTarget()
	local best = nil
	local bestDistance = math.huge

	local viewport = Camera.ViewportSize
	local center = Vector2.new(
		viewport.X/2,
		viewport.Y/2
	)

	for _, player in ipairs(Players:GetPlayers()) do
		if player ~= LP then

			local char = player.Character
			local humanoid = char and char:FindFirstChildOfClass("Humanoid")
			local head = char and char:FindFirstChild("Head")

			if char and humanoid and humanoid.Health > 0 and head then

				local screenPos, onScreen =
					Camera:WorldToViewportPoint(head.Position)

				if onScreen then

					local pos = Vector2.new(
						screenPos.X,
						screenPos.Y
					)

					local distance =
						(pos-center).Magnitude

					if distance <= S.FOV
						and distance < bestDistance
						and IsVisible(char,head) then

						best = head
						bestDistance = distance
					end
				end
			end
		end
	end

	return best
end

local function AimAlpha(strength)
	if strength <= 0 then
		return 0
	end

	if strength >= 100 then
		return 1
	end

	local normalized =
		math.clamp(strength/100,0,1)

	local alpha =
		1-math.pow(1-normalized,2.2)

	return math.clamp(alpha*.42,0,.98)
end

--==================================================
-- ESP
--==================================================

local Highlights = {}

local function RemoveESP(player)
	local h = Highlights[player]

	if h then
		h:Destroy()
		Highlights[player] = nil
	end
end

local function AddESP(player)
	if player == LP then return end
	if not S.ESP then return end

	local char = player.Character
	if not char then return end

	RemoveESP(player)

	local h = Instance.new("Highlight")
	h.Name = "CHALLO_BOY_ESP"
	h.Adornee = char
	h.FillTransparency = 1
	h.OutlineTransparency = 0
	h.OutlineColor = Accent
	h.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
	h.Parent = Gui

	Highlights[player] = h
end

local function UpdateESP()
	for _, player in ipairs(Players:GetPlayers()) do
		if player ~= LP then
			if S.ESP then
				AddESP(player)
			else
				RemoveESP(player)
			end
		end
	end
end

Players.PlayerAdded:Connect(function(player)
	player.CharacterAdded:Connect(function()
		task.wait(.5)

		if S.ESP then
			AddESP(player)
		end
	end)
end)

Players.PlayerRemoving:Connect(RemoveESP)

task.spawn(function()
	while task.wait(.35) do
		UpdateESP()
	end
end)

