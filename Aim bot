TargetButton.MouseButton1Click:Connect(ShowTarget)
SettingButton.MouseButton1Click:Connect(ShowSetting)

--==================================================
-- MINIMIZE
--==================================================

local minimized = false

MinButton.MouseButton1Click:Connect(function()

    minimized = not minimized

    if minimized then

        Sidebar.Visible = false
        Content.Visible = false

        TweenService:Create(
            Main,
            TweenInfo.new(
                0.25,
                Enum.EasingStyle.Quart,
                Enum.EasingDirection.Out
            ),
            {
                Size = UDim2.fromOffset(180, 38)
            }
        ):Play()

        MinButton.Text = "+"

    else

        TweenService:Create(
            Main,
            TweenInfo.new(
                0.25,
                Enum.EasingStyle.Quart,
                Enum.EasingDirection.Out
            ),
            {
                Size = UDim2.fromOffset(360, 202)
            }
        ):Play()

        task.wait(0.2)

        Sidebar.Visible = true
        Content.Visible = true

        MinButton.Text = "—"
    end
end)

--==================================================
-- RGB UPDATE
--==================================================

RunService.RenderStepped:Connect(function()

    if Settings.RGB then

        local color = GetRGB()

        MainStroke.Color = color
        POVStroke.Color = color
        AimPoint.TextColor3 = color

        if HighlightObject then
            HighlightObject.FillColor = color
            HighlightObject.OutlineColor = color
        end
    end
end)

--==================================================
-- PLAYER LEAVING
--==================================================

Players.PlayerRemoving:Connect(function(player)

    if SelectedTarget == player then
        SelectedTarget = nil
        RemoveHighlight()
    end
end)

--==================================================
-- TARGET CHARACTER RESPAWN
--==================================================

Players.PlayerAdded:Connect(function(player)

    player.CharacterAdded:Connect(function()

        if SelectedTarget == player then
            task.wait(0.5)
            HighlightTarget(player)
        end
    end)
end)

