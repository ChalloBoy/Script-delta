    return frame
end

local function toggle(parent, title, initial, callback)
    local frame = card(parent, 48)

    text(frame, title, 12, C.white,
        UDim2.fromOffset(10, 10),
        UDim2.new(1, -85, 0, 28))

    local button = make("TextButton", {
        Size = UDim2.fromOffset(52, 27),
        Position = UDim2.new(1, -62, 0.5, -13),
        Text = initial and "ON" or "OFF",
        TextSize = 10,
        Font = Enum.Font.GothamBold,
        TextColor3 = C.white,
        BackgroundColor3 = initial and C.accent or C.bg,
        BorderSizePixel = 0,
    }, frame)

    round(button, 8)

    local enabled = initial

    button.Activated:Connect(function()
        enabled = not enabled
        button.Text = enabled and "ON" or "OFF"
        button.BackgroundColor3 = enabled and C.accent or C.bg
        callback(enabled)
    end)

    return button
end

local function slider(parent, title, min, max, initial, suffix, callback)
    local frame = card(parent, 68)

    local value = initial

    local name = text(frame, title, 12, C.white,
        UDim2.fromOffset(10, 7),
        UDim2.new(1, -80, 0, 20))

    local number = text(frame, tostring(value)..suffix, 11, C.cyan,
        UDim2.new(1, -65, 0, 7),
        UDim2.fromOffset(55, 20))

    number.TextXAlignment = Enum.TextXAlignment.Right

    local track = make("TextButton", {
        Position = UDim2.fromOffset(10, 39),
        Size = UDim2.new(1, -20, 0, 10),
        BackgroundColor3 = C.bg,
        Text = "",
        AutoButtonColor = false,
        BorderSizePixel = 0,
    }, frame)

    round(track, 5)

    local fill = make("Frame", {
        Size = UDim2.new((value-min)/(max-min), 0, 1, 0),
        BackgroundColor3 = C.accent,
        BorderSizePixel = 0,
    }, track)

    round(fill, 5)

    local function setValue(x)
        local ratio = math.clamp(
            (x-track.AbsolutePosition.X)/track.AbsoluteSize.X,
            0, 1
        )

        value = math.floor(min + ratio*(max-min) + 0.5)
        fill.Size = UDim2.new(ratio, 0, 1, 0)
        number.Text = tostring(value)..suffix
        callback(value)
    end

    track.Activated:Connect(function()
        setValue(UIS:GetMouseLocation().X)
    end)

    return frame
end

local function addNav(name, symbol)
