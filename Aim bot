-- RGB
--========================================================

local hue = 0

--========================================================
-- MAIN LOOP
--========================================================

RunService.RenderStepped:Connect(function(dt)

	-- FOV
	if S.FOVEnabled then

		local viewport =
			Camera.ViewportSize

		FOVCircle.Position =
			UDim2.fromOffset(
				viewport.X/2,
				viewport.Y/2
			)

		FOVCircle.Size =
			UDim2.fromOffset(
				S.FOV*2,
				S.FOV*2
			)

		FOVCircle.Visible = true

	else

		FOVCircle.Visible = false

	end

	-- AIM
	if S.Aim
		and S.Strength > 0 then

		local target =
			GetTarget()

		if target then

			local desired =
				CFrame.lookAt(
					Camera.CFrame.Position,
					target.Position
				)

			local alpha =
				GetAimAlpha(
					S.Strength
				)

			Camera.CFrame =
				Camera.CFrame:Lerp(
					desired,
					alpha
				)
		end
	end

	-- ESP
	for _,player in ipairs(Players:GetPlayers()) do

		if player ~= LP then

			if S.ESP then

				if player.Character
					and not Highlights[player] then

					AddESP(player)

				end

			elseif Highlights[player] then

				RemoveESP(player)

			end
		end
	end

	-- RGB
	if S.RGB then

		hue =
			(hue + dt*0.35)%1

		local c =
			Color3.fromHSV(
				hue,
				0.8,
				1
			)

		stroke(Window,c,1,0.1).Color = c
		FOVStroke.Color = c

	else

		-- Keep normal blue accent.
		for _,obj in ipairs(Window:GetChildren()) do

			if obj:IsA("UIStroke") then
				obj.Color = BLUE
			end

		end

		FOVStroke.Color = BLUE2
	end
end)
