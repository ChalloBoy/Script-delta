			0,0
		)

	text.BackgroundTransparency =
		1

	text.Text =
		label

	text.TextColor3 =
		WHITE

	text.TextSize =
		14

	text.Font =
		Enum.Font.GothamMedium

	text.TextXAlignment =
		Enum.TextXAlignment.Left

	text.Parent =
		holder

	local button =
		Instance.new("TextButton")

	button.Size =
		UDim2.new(
			0,54,
			0,28
		)

	button.Position =
		UDim2.new(
			1,-64,
			0.5,-14
		)

	button.TextSize =
		11

	button.Font =
		Enum.Font.GothamBold

	button.Parent =
		holder

	Instance.new("UICorner",
		button
	).CornerRadius =
		UDim.new(1,0)

	local value =
		default

	local function Update(v)

		value = v

		if value then
			button.Text = "ON"
			button.BackgroundColor3 = GREEN
			button.TextColor3 = Color3.new(0,0,0)
		else
			button.Text = "OFF"
			button.BackgroundColor3 = RED
			button.TextColor3 = WHITE
		end

		callback(value)
	end

	button.MouseButton1Click:Connect(function()
		Update(not value)
	end)

	Update(default)

	local control = {
		Set = Update,
		Get = function()
			return value
		end,
	}

	table.insert(
		Controls,
		control
	)

	return control
end

