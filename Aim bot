end

local function rowButton(text, callback)
    local b = make("TextButton", {
        Size = UDim2.new(1, -4, 0, 34),
        BackgroundColor3 = Color3.fromRGB(35, 43, 59),
        Text = text,
        TextColor3 = Color3.fromRGB(240, 244, 248),
        TextSize = 13,
        Font = Enum.Font.GothamMedium,
        BorderSizePixel = 0,
    }, content)
    make("UICorner", {CornerRadius = UDim.new(0, 7)}, b)
    b.Activated:Connect(callback)
    return b
end

local function label(text)
    make("TextLabel", {
        Size = UDim2.new(1, -4, 0, 23),
        BackgroundTransparency = 1,
        Text = text,
        TextColor3 = Color3.fromRGB(203, 213, 225),
        TextSize = 12,
        Font = Enum.Font.Gotham,
        TextXAlignment = Enum.TextXAlignment.Left,
    }, content)
end

local function sliderRow(title, minVal, maxVal, initial, callback)
    label(title .. ": " .. tostring(initial))
    local slider = make("TextButton", {
        Size = UDim2.new(1, -4, 0, 24),
        BackgroundColor3 = Color3.fromRGB(51, 65, 85),
        Text = "Tap to adjust",
        TextColor3 = Color3.new(1, 1, 1),
        TextSize = 11,
        Font = Enum.Font.Gotham,
        BorderSizePixel = 0,
    }, content)
    make("UICorner", {CornerRadius = UDim.new(0, 6)}, slider)

    local value = initial
    slider.Activated:Connect(function()
        value = value + math.max(1, math.floor((maxVal - minVal) / 10))
        if value > maxVal then value = minVal end
        slider.Text = title .. ": " .. tostring(value)
        callback(value)
    end)
end

local function showPage(name)
    activePage = name
    clearContent()

    if name == "Aim Bot" then
        section("AIM BOT  •  DEMO SETTINGS")
        rowButton("Aim Bot: " .. (state.aimEnabled and "ON" or "OFF"), function()
            state.aimEnabled = not state.aimEnabled
            showPage(name)
        end)
        rowButton("Target Part: " .. state.targetPart, function()
            state.targetPart = state.targetPart == "Head" and "Body" or "Head"
            showPage(name)
        end)
        label("Aim settings are UI-only in this demo.")
    elseif name == "Aim Power" then
        section("AIM POWER")
        sliderRow("Aim Strength (%)", 0, 100, state.aimStrength, function(v)
            state.aimStrength = v
        end)
        sliderRow("POV Size", 60, 360, state.povSize, function(v)
            state.povSize = v
        end)
        sliderRow("POV Transparency (%)", 0, 100,
            math.floor(state.povTransparency * 100), function(v)
                state.povTransparency = v / 100
            end)
    elseif name == "ESP" then
        section("ESP OPTIONS  •  TOGGLE SEPARATELY")
        for espName, enabled in pairs(state.esp) do
            rowButton(espName .. " ESP: " .. (enabled and "ON" or "OFF"), function()
                state.esp[espName] = not state.esp[espName]
                showPage(name)
            end)
        end
        section("ESP COLOR")
        rowButton("Color Mode: " .. state.colorMode, function()
            state.colorMode = state.colorMode == "RGB" and "Custom" or "RGB"
            showPage(name)
        end)
        rowButton("Custom Color: Sky Blue", function()
            state.customColor = state.customColor == Color3.fromRGB(56, 189, 248)
                and Color3.fromRGB(244, 114, 182)
                or Color3.fromRGB(56, 189, 248)
        end)
        label("Color settings are stored for your own-game implementation.")
    else
        section("SOCIAL MEDIA")
        label("TikTok: @challo_boy")
        label("YouTube: @challo_boy")
        label("Thank you for using my script, enjoy 👍")
    end
end

