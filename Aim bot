local function Accent()
	if S.RGB then
		return Color3.fromHSV((os.clock()*0.12)%1,0.85,1)
	end

	if S.Theme == "Blue" then
		return Color3.fromRGB(70,140,255)
	elseif S.Theme == "Purple" then
		return Color3.fromRGB(175,90,255)
	elseif S.Theme == "Green" then
		return Color3.fromRGB(65,220,130)
	end

	return Color3.fromRGB(100,100,110)
end

