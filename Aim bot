	for n, page in pairs(Pages) do
		page.Visible = n == name
	end

	for n, button in pairs(NavButtons) do
		if string.find(name, n:gsub(" / ","")) then
			button.BackgroundColor3 = Accent
			button.TextColor3 = Color3.new(1,1,1)
		else
			button.BackgroundColor3 = Color3.fromRGB(17,20,27)
			button.TextColor3 = Color3.fromRGB(175,180,190)
		end
	end
end

