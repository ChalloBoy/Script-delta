local OpenDropdown

local function Dropdown(title,current,values,callback)

local Box = Instance.new("Frame")
Box.Size = UDim2.new(1,-5,0,54)
Box.BackgroundColor3 = Color3.fromRGB(31,31,34)
Box.BorderSizePixel = 0
Box.ZIndex = 13
