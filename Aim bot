local function ShowTarget()

	Clear()
	Active(TargetTab)

	TitleText("PLAYER TARGET")

	Label(
		"Players currently inside the POV",
		39
	)

	local list = Instance.new("ScrollingFrame")
	list.Size = UDim2.new(1,-20,1,-70)
	list.Position = UDim2.fromOffset(10,65)
	list.BackgroundTransparency = 1
	list.BorderSizePixel = 0
	list.ScrollBarThickness = 3
	list.AutomaticCanvasSize = Enum.AutomaticSize.Y
	list.CanvasSize = UDim2.new()
	list.Parent = Content

	local layout = Instance.new("UIListLayout")
	layout.Padding = UDim.new(0,5)
	layout.Parent = list

	local found = false

	for _,player in ipairs(Players:GetPlayers()) do

		if InPOV(player) then

			found = true

			local b = Instance.new("TextButton")

			b.Size = UDim2.new(1,0,0,37)
			b.BackgroundColor3 =
				Color3.fromRGB(31,34,43)

			b.Text =
				"👤  "..player.DisplayName

			b.TextColor3 =
				Color3.new(1,1,1)

			b.TextSize = 11
			b.Font = Enum.Font.GothamMedium
			b.AutoButtonColor = false
			b.Parent = list

			local c = Instance.new("UICorner")
			c.CornerRadius = UDim.new(0,9)
			c.Parent = b

			b.MouseButton1Click:Connect(function()

				SelectPlayer(player)

				b.BackgroundColor3 = Accent()

				task.delay(.2,function()

					if b.Parent then
						b.BackgroundColor3 =
							Color3.fromRGB(31,34,43)
					end

				end)

			end)

		end

	end

	if not found then

		local none = Instance.new("TextLabel")

		none.Size = UDim2.new(1,0,0,40)
		none.BackgroundTransparency = 1
		none.Text = "No players inside POV"
		none.TextColor3 =
			Color3.fromRGB(145,150,160)
		none.TextSize = 11
		none.Font = Enum.Font.Gotham
		none.Parent = list

	end

end

