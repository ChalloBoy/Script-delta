	end

	button.MouseButton1Click:Connect(function()
		if ActivePopup and ActivePopup ~= popup then
			ActivePopup.Visible = false
		end

		popup.Visible = not popup.Visible

		if popup.Visible then
			ActivePopup = popup
		else
			ActivePopup = nil
		end
	end)

	return holder
end

