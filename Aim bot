		Enum.Font.GothamMedium

	button.AutoButtonColor = false
	button.Parent = holder

	corner(button,6)

	local value = default

	button.Text =
		tostring(value).."  ▼"

	local popup =
		Instance.new("ScrollingFrame")

	popup.Size =
		UDim2.new(0,180,0,145)

	popup.BackgroundColor3 =
		Color3.fromRGB(30,30,30)

	popup.BorderSizePixel = 0

	popup.ScrollBarThickness = 5
	popup.ScrollBarImageColor3 = BLUE

	popup.Visible = false
	popup.ZIndex = 1000
	popup.Parent = DropdownGui

	corner(popup,6)
	stroke(popup,BLUE,1,0.35)

	local layout =
		Instance.new("UIListLayout")

	layout.Padding =
		UDim.new(0,3)

	layout.Parent = popup

	local function Set(v)

		value = v

		button.Text =
			tostring(value).."  ▼"

		callback(value)
	end

	for _,item in ipairs(values) do

		local option =
			Instance.new("TextButton")

		option.Size =
			UDim2.new(1,-8,0,32)

		option.BackgroundColor3 = ITEM
		option.Text =
			tostring(item)

		option.TextColor3 = WHITE
		option.TextSize = 12
		option.Font =
			Enum.Font.GothamMedium

		option.AutoButtonColor = false
		option.ZIndex = 1001
		option.Parent = popup

		corner(option,5)

		option.MouseEnter:Connect(function()
			tween(
				option,
				FastTween,
				{
					BackgroundColor3 = BLUE
				}
			)
		end)

		option.MouseLeave:Connect(function()
			tween(
				option,
				FastTween,
				{
					BackgroundColor3 = ITEM
				}
			)
		end)

		option.MouseButton1Click:Connect(function()

			Set(item)

			popup.Visible = false
			OpenDropdown = nil
		end)
	end

	layout:GetPropertyChangedSignal(
		"AbsoluteContentSize"
	):Connect(function()

		popup.CanvasSize =
			UDim2.new(
				0,0,
				0,
				layout.AbsoluteContentSize.Y + 8
			)
	end)

	button.MouseEnter:Connect(function()
		tween(
			button,
			FastTween,
			{
				BackgroundColor3 = HOVER
			}
		)
	end)

	button.MouseLeave:Connect(function()
		if OpenDropdown ~= popup then
			tween(
				button,
				FastTween,
				{
					BackgroundColor3 = ITEM
				}
			)
		end
	end)

	button.MouseButton1Click:Connect(function()

		if OpenDropdown
			and OpenDropdown ~= popup then

			OpenDropdown.Visible = false
		end

		if popup.Visible then

			popup.Visible = false
			OpenDropdown = nil

			return
		end

		local p =
			button.AbsolutePosition

		local s =
			button.AbsoluteSize

		popup.Position =
			UDim2.fromOffset(
				p.X,
				p.Y+s.Y+4
			)

		popup.Visible = true
		OpenDropdown = popup
	end)

	DropdownControls[label] = {
		Set = Set,
		Get = function()
			return value
		end
	}

	return holder
end

