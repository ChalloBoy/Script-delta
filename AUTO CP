--==================================================
-- DRAG SYSTEM
--==================================================

local dragging = false
local dragStart
local startPosition
local dragInput

local function updateDrag(input)
	local delta = input.Position - dragStart

	Main.Position = UDim2.new(
		startPosition.X.Scale,
		startPosition.X.Offset + delta.X,
		startPosition.Y.Scale,
		startPosition.Y.Offset + delta.Y
	)
end

local function beginDrag(input)
	dragging = true
	dragStart = input.Position
	startPosition = Main.Position

	input.Changed:Connect(function()
		if input.UserInputState == Enum.UserInputState.End then
			dragging = false
		end
	end)
end

local function handleInput(input)
	if input.UserInputType == Enum.UserInputType.MouseButton1
		or input.UserInputType == Enum.UserInputType.Touch then

		beginDrag(input)
	end
end

Main.InputBegan:Connect(handleInput)

Main.InputChanged:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.MouseMovement
		or input.UserInputType == Enum.UserInputType.Touch then

		dragInput = input
	end
end)

UserInputService.InputChanged:Connect(function(input)
	if input == dragInput and dragging then
		updateDrag(input)
	end
end)

--==================================================
-- BUTTONS
--==================================================

local function refreshUI()
	if Enabled then
		Status.Text = "Status: ON"
		Status.TextColor3 = Color3.fromRGB(90, 255, 130)
		Toggle.Text = "ON"
		Toggle.BackgroundColor3 = Color3.fromRGB(45, 145, 75)
	else
		Status.Text = "Status: OFF"
		Status.TextColor3 = Color3.fromRGB(220, 220, 220)
		Toggle.Text = "OFF"
		Toggle.BackgroundColor3 = Color3.fromRGB(55, 55, 60)
	end

	SpeedLabel.Text = "Speed: " .. tostring(Speed)
end

Toggle.Activated:Connect(function()
	if Enabled then
		stopFly()
	else
		task.spawn(startFly)
	end

	refreshUI()
end)

SpeedBox.FocusLost:Connect(function()
	local value = tonumber(SpeedBox.Text)

	if value then
		Speed = math.clamp(value, 10, 500)
	end

	SpeedBox.Text = tostring(Speed)
	refreshUI()
end)

refreshUI()
