--==================================================
-- SETTINGS
--==================================================

local Speed = 100
local ArrivalDistance = 5
local Enabled = false

--==================================================
-- CHECKPOINTS
--==================================================

local CheckpointFolder = workspace:FindFirstChild("Checkpoints")

local function getPart(object)
	if not object then
		return nil
	end

	if object:IsA("BasePart") then
		return object
	end

	if object:IsA("Model") then
		return object.PrimaryPart
			or object:FindFirstChildWhichIsA("BasePart", true)
	end

	return nil
end

local function getCheckpoints()
	local list = {}

	if not CheckpointFolder then
		warn("Fly CP: Workspace.Checkpoints tidak ditemukan.")
		return list
	end

	for _, object in ipairs(CheckpointFolder:GetChildren()) do
		local number = tonumber(object.Name:match("^CP(%d+)$"))

		if number then
			local part = getPart(object)

			if part then
				table.insert(list, {
					number = number,
					part = part
				})
			end
		end
	end

	table.sort(list, function(a, b)
		return a.number < b.number
	end)

	local finish = CheckpointFolder:FindFirstChild("Finish")

	if finish then
		local part = getPart(finish)

		if part then
			table.insert(list, {
				number = math.huge,
				part = part
			})
		end
	end

	return list
end

--==================================================
-- NOCLIP
--==================================================

local function setNoclip(character, state)
	for _, object in ipairs(character:GetDescendants()) do
		if object:IsA("BasePart") then
			object.CanCollide = not state
			object.CanTouch = not state
			object.CanQuery = true
		end
	end
end

--==================================================
-- FLY
--==================================================

local function flyTo(character, target)
	local root = character:FindFirstChild("HumanoidRootPart")

	if not root or not target then
		return false
	end

	while Enabled and character.Parent and root.Parent do
		local offset = target.Position - root.Position
		local distance = offset.Magnitude

		if distance <= ArrivalDistance then
			return true
		end

		local dt = RunService.Heartbeat:Wait()
		local step = math.min(Speed * dt, distance)

		if offset.Magnitude > 0 then
			local direction = offset.Unit
			local nextPosition = root.Position + direction * step

			root.CFrame = CFrame.lookAt(
				nextPosition,
				target.Position
			)
		end
	end

	return false
end

local function startFly()
	if Enabled then
		return
	end

	Enabled = true

	local character = Player.Character

	if not character then
		Enabled = false
		return
	end

	local humanoid = character:FindFirstChildOfClass("Humanoid")
	local root = character:FindFirstChild("HumanoidRootPart")

	if not humanoid or not root then
		Enabled = false
		return
	end

	local checkpoints = getCheckpoints()

	if #checkpoints == 0 then
		Enabled = false
		return
	end

	local noclipConnection

	noclipConnection = RunService.Stepped:Connect(function()
		if Enabled and character.Parent then
			-- Continuous noclip: bawah, atas, depan, belakang,
			-- kiri, kanan, dan menembus objek.
			setNoclip(character, true)
		end
	end)

	for _, checkpoint in ipairs(checkpoints) do
		if not Enabled or not character.Parent then
			break
		end

		flyTo(character, checkpoint.part)
	end

	Enabled = false

	if noclipConnection then
		noclipConnection:Disconnect()
	end

	if character.Parent then
		setNoclip(character, false)
	end
end

local function stopFly()
	Enabled = false

	local character = Player.Character

	if character then
		setNoclip(character, false)
	end
end

Player.CharacterAdded:Connect(function()
	Enabled = false
end)

