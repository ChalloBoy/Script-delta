--------------------------------------------------
-- FPS BOOST
--------------------------------------------------

local function BoostFPS()

	-- Simpan karakter supaya tidak disentuh
	local Character = Player.Character

	--------------------------------------------------
	-- LIGHTING
	--------------------------------------------------

	pcall(function()

		Lighting.GlobalShadows = false
		Lighting.EnvironmentDiffuseScale = 0
		Lighting.EnvironmentSpecularScale = 0

	end)

	--------------------------------------------------
	-- POST PROCESSING
	--------------------------------------------------

	for _, object in ipairs(Lighting:GetChildren()) do

		if object:IsA("BloomEffect")
			or object:IsA("BlurEffect")
			or object:IsA("ColorCorrectionEffect")
			or object:IsA("DepthOfFieldEffect")
			or object:IsA("SunRaysEffect") then

			pcall(function()
				object.Enabled = false
			end)

		end
	end

	--------------------------------------------------
	-- MAP
	--------------------------------------------------

	for _, object in ipairs(Workspace:GetDescendants()) do

		-- CHARACTER TIDAK DISENTUH
		if Character and object:IsDescendantOf(Character) then
			continue
		end

		--------------------------------------------------
		-- VISUAL EFFECT
		--------------------------------------------------

		if object:IsA("ParticleEmitter")
			or object:IsA("Trail")
			or object:IsA("Beam")
			or object:IsA("Smoke")
			or object:IsA("Fire")
			or object:IsA("Sparkles") then

			pcall(function()
				object.Enabled = false
			end)

		--------------------------------------------------
		-- LIGHT
		--------------------------------------------------

		elseif object:IsA("PointLight")
			or object:IsA("SpotLight")
			or object:IsA("SurfaceLight") then

			pcall(function()
				object.Enabled = false
			end)

		--------------------------------------------------
		-- MAP PART
		--------------------------------------------------

		elseif object:IsA("BasePart") then

			pcall(function()

				object.CastShadow = false
				object.Material = Enum.Material.Plastic
				object.Reflectance = 0

			end)

		--------------------------------------------------
		-- TEXTURE
		--------------------------------------------------

		elseif object:IsA("Decal")
			or object:IsA("Texture") then

			pcall(function()
				object.Transparency = 1
			end)

		--------------------------------------------------
		-- SPECIAL MESH
		--------------------------------------------------

		elseif object:IsA("SpecialMesh") then

			pcall(function()
				object.TextureId = ""
			end)

		end
	end

	--------------------------------------------------
	-- TERRAIN
	--------------------------------------------------

	pcall(function()

		Workspace.Terrain.WaterWaveSize = 0
		Workspace.Terrain.WaterWaveSpeed = 0
		Workspace.Terrain.WaterReflectance = 0
		Workspace.Terrain.Decoration = false

	end)
end

--------------------------------------------------
