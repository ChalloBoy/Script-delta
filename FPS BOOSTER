local RGBObjects = {}

local function addRGB(object, property)
	table.insert(RGBObjects, {
		Object = object,
		Property = property
	})
end

RunService.RenderStepped:Connect(function()
	local hue = (os.clock() * 0.15) % 1
	local color = Color3.fromHSV(hue, 0.9, 1)

	for _, data in ipairs(RGBObjects) do
		if data.Object and data.Object.Parent then
			pcall(function()
				data.Object[data.Property] = color
			end)
		end
	end
end)

--==================================================
-- DRAG FUNCTION
--==================================================

local function makeDraggable(frame)
	local dragging = false
	local dragStart
	local startPos

	frame.InputBegan:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1
			or input.UserInputType == Enum.UserInputType.Touch then

			dragging = true
			dragStart = input.Position
			startPos = frame.Position

			input.Changed:Connect(function()
				if input.UserInputState == Enum.UserInputState.End then
					dragging = false
				end
			end)
		end
	end)

	frame.InputChanged:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseMovement
			or input.UserInputType == Enum.UserInputType.Touch then
			dragStart = dragStart or input.Position
		end
	end)

	game:GetService("UserInputService").InputChanged:Connect(function(input)
		if not dragging then
			return
		end

		if input.UserInputType == Enum.UserInputType.MouseMovement
			or input.UserInputType == Enum.UserInputType.Touch then

			local delta = input.Position - dragStart

			frame.Position = UDim2.new(
				startPos.X.Scale,
				startPos.X.Offset + delta.X,
				startPos.Y.Scale,
				startPos.Y.Offset + delta.Y
			)
		end
	end)
end

