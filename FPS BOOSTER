--==================================================
-- DRAG FPS COUNTER
--==================================================

local dragging = false
local dragStart
local startPos

FPSFrame.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1
        or input.UserInputType == Enum.UserInputType.Touch then

        dragging = true
        dragStart = input.Position
        startPos = FPSFrame.Position

        input.Changed:Connect(function()
            if input.UserInputState == Enum.UserInputState.End then
                dragging = false
            end
        end)
    end
end)

FPSFrame.InputChanged:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseMovement
        or input.UserInputType == Enum.UserInputType.Touch then

        dragInput = input
    end
end)

RunService.RenderStepped:Connect(function()
    if dragging and dragInput then
        local delta = dragInput.Position - dragStart

        FPSFrame.Position = UDim2.new(
            startPos.X.Scale,
            startPos.X.Offset + delta.X,
            startPos.Y.Scale,
            startPos.Y.Offset + delta.Y
        )
    end
end)

--==================================================
-- FPS CALCULATION
--==================================================

local frames = 0
local lastTime = tick()

RunService.RenderStepped:Connect(function()
    frames += 1

    local now = tick()

    if now - lastTime >= FPS_UPDATE_RATE then
        local fps = math.floor(frames / (now - lastTime))

        FPSLabel.Text = "FPS: " .. tostring(fps)

        frames = 0
        lastTime = now
    end
end)

--==================================================
-- BOOST PROCESS
--==================================================

local boosting = false

local function startBoost()
    if boosting then
        return
    end

    boosting = true

    -- Remove initial UI immediately
    Main:Destroy()

    -- Loading notification
    local loading = createNotification("Loading FPS Booster", 999)

    local loadingLabel = loading:FindFirstChildOfClass("TextLabel")

    task.spawn(function()
        local dots = 0

        for i = 1, 30 do
            if not loading or not loading.Parent then
                break
            end

            dots += 1

            if dots > 3 then
                dots = 0
            end

            local text = "Loading FPS Booster" .. string.rep(".", dots)

            if loadingLabel then
                loadingLabel.Text = text
            end

            task.wait(0.08)
        end
    end)

    -- Heavy optimization
    optimizeMap()

    -- Ultra low graphics
    ultraLowGraphics()

    -- FPS unlock if supported
    unlockFPS()

    -- Repeat optimization
    task.wait(0.2)
    optimizeMap()

    task.wait(0.2)
    optimizeTerrain()

    -- Remove loading notification
    if loading and loading.Parent then
        loading:Destroy()
    end

    -- Success
    createNotification("Success ☑️ SUPER LOW", 3)

    -- Show FPS counter
    task.wait(0.5)

    FPSFrame.Visible = true

    -- Follow notification after 20 seconds
    task.delay(FOLLOW_DELAY, function()
        createNotification(
            "Jangan lupa follow: @challo_boy",
            4
        )
    end)
end

