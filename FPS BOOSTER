--==================================================
-- REAL FPS CALCULATOR
--==================================================

local frames = 0
local lastTime = os.clock()
local currentFPSValue = 0

RunService.RenderStepped:Connect(function()
	frames += 1

	local now = os.clock()
	local elapsed = now - lastTime

	if elapsed >= FPS_UPDATE_RATE then

		currentFPSValue = math.floor(frames / elapsed + 0.5)

		if CurrentFPS.Parent then
			CurrentFPS.Text =
				"FPS: " .. tostring(currentFPSValue)
		end

		frames = 0
		lastTime = now
	end
end)

