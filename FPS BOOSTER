		FollowText.Position = UDim2.new(0, 10, 0, 0)
		FollowText.BackgroundTransparency = 1
		FollowText.Text = "Jangan lupa follow: @challo_boy"
		FollowText.TextColor3 = Color3.new(1, 1, 1)
		FollowText.TextScaled = true
		FollowText.Font = Enum.Font.GothamBold
		FollowText.Parent = Follow

		TweenService:Create(
			Follow,
			TweenInfo.new(
				0.45,
				Enum.EasingStyle.Back,
				Enum.EasingDirection.Out
			),
			{
				Position = UDim2.new(0.5, -165, 0, 25)
			}
		):Play()

		task.wait(4)

		TweenService:Create(
			Follow,
			TweenInfo.new(0.35),
			{
				Position = UDim2.new(0.5, -165, 0, -90)
			}
		):Play()

		task.wait(0.4)

		Follow:Destroy()
	end)
end)

