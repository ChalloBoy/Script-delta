local function CreateFPSCounter()

	local FPSGui = Instance.new("ScreenGui")
	FPSGui.Name = "FPSCounter"
	FPSGui.ResetOnSpawn = false
	FPSGui.IgnoreGuiInset = true
	FPSGui.Parent = PlayerGui

	local Frame = Instance.new("Frame")
	Frame.Size = UDim2.fromOffset(125, 43)
	Frame.Position = UDim2.fromOffset(20, 100)
	Frame.BackgroundColor3 = Color3.fromRGB(10, 10, 16)
	Frame.BackgroundTransparency = 0.1
	Frame.Parent = FPSGui

	makeCorner(Frame, 12)

	local Stroke = makeStroke(Frame, 2)
	startRGB(Stroke)

	local Label = Instance.new("TextLabel")
	Label.Size = UDim2.new(1, -10, 1, 0)
	Label.Position = UDim2.fromOffset(5, 0)
	Label.BackgroundTransparency = 1
	Label.Text = "FPS: --"
	Label.TextColor3 = Color3.new(1, 1, 1)
	Label.TextSize = 17
	Label.Font = Enum.Font.GothamBold
	Label.Parent = Frame

	--------------------------------------------------
	-- DRAG
	--------------------------------------------------

	local dragging = false
	local dragStart
	local startPosition

	Frame.InputBegan:Connect(function(input)

		if input.UserInputType == Enum.UserInputType.MouseButton1
			or input.UserInputType == Enum.UserInputType.Touch then

			dragging = true
			dragStart = input.Position
			startPosition = Frame.Position

			input.Changed:Connect(function()

				if input.UserInputState == Enum.UserInputState.End then
					dragging = false
				end

			end)
		end
	end)

	UserInputService.InputChanged:Connect(function(input)

		if not dragging then
			return
		end

		if input.UserInputType == Enum.UserInputType.MouseMovement
			or input.UserInputType == Enum.UserInputType.Touch then

			local delta = input.Position - dragStart

			Frame.Position = UDim2.new(
				startPosition.X.Scale,
				startPosition.X.Offset + delta.X,
				startPosition.Y.Scale,
				startPosition.Y.Offset + delta.Y
			)

		end
	end)

	--------------------------------------------------
	-- FPS
	--------------------------------------------------

	local frames = 0
	local lastTime = os.clock()

	RunService.RenderStepped:Connect(function()

		frames += 1

		local now = os.clock()
		local elapsed = now - lastTime

		if elapsed >= 0.5 then

			local fps = math.floor(frames / elapsed + 0.5)

			Label.Text = "FPS: " .. fps

			frames = 0
			lastTime = now

		end
	end)
end

