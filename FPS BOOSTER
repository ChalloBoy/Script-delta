--==================================================
-- CHARACTER PROTECTION
--==================================================

local function IsCharacter(Model)
	if not Model or not Model:IsA("Model") then
		return false
	end

	-- Player/NPC dengan Humanoid dilindungi
	if Model:FindFirstChildOfClass("Humanoid") then
		return true
	end

	return false
end

local function IsInsideCharacter(Object)
	local Current = Object

	while Current and Current ~= Workspace do
		if Current:IsA("Model") and IsCharacter(Current) then
			return true
		end

		Current = Current.Parent
	end

	return false
end

--==================================================
-- SUPER LOW OPTIMIZER
--==================================================

local function OptimizeObject(Object)

	-- Jangan sentuh character / NPC
	if IsInsideCharacter(Object) then
		return
	end

	-- PARTICLES
	if Object:IsA("ParticleEmitter") then
		pcall(function()
			Object.Enabled = false
		end)
		return
	end

	-- TRAIL
	if Object:IsA("Trail") then
		pcall(function()
			Object.Enabled = false
		end)
		return
	end

	-- BEAM
	if Object:IsA("Beam") then
		pcall(function()
			Object.Enabled = false
		end)
		return
	end

	-- SMOKE
	if Object:IsA("Smoke") then
		pcall(function()
			Object.Enabled = false
		end)
		return
	end

	-- FIRE
	if Object:IsA("Fire") then
		pcall(function()
			Object.Enabled = false
		end)
		return
	end

	-- SPARKLES
	if Object:IsA("Sparkles") then
		pcall(function()
			Object.Enabled = false
		end)
		return
	end

	-- LIGHTS
	if Object:IsA("PointLight")
		or Object:IsA("SpotLight")
		or Object:IsA("SurfaceLight") then

		pcall(function()
			Object.Enabled = false
			Object.Shadows = false
		end)

		return
	end

	-- DECAL
	if Object:IsA("Decal") then
		pcall(function()
			Object.Transparency = 1
		end)

		return
	end

	-- TEXTURE
	if Object:IsA("Texture") then
		pcall(function()
			Object.Transparency = 1
		end)

		return
	end

	-- PBR SURFACE APPEARANCE
	if Object:IsA("SurfaceAppearance") then
		pcall(function()
			Object:Destroy()
		end)

		return
	end

	-- MAP PART
	if Object:IsA("BasePart") then

		pcall(function()
			Object.Material = Enum.Material.Plastic
		end)

		pcall(function()
			Object.CastShadow = false
		end)

		pcall(function()
			Object.Reflectance = 0
		end)

		-- Kurangi efek permukaan
		pcall(function()
			Object.MaterialVariant = ""
		end)

		return
	end
end

--==================================================
-- LIGHTING OPTIMIZATION
--==================================================

local function OptimizeLighting()

	pcall(function()
		Lighting.GlobalShadows = false
	end)

	pcall(function()
		Lighting.EnvironmentDiffuseScale = 0
	end)

	pcall(function()
		Lighting.EnvironmentSpecularScale = 0
	end)

	-- Matikan semua post-processing
	for _, Object in ipairs(Lighting:GetChildren()) do

		if Object:IsA("BloomEffect")
			or Object:IsA("BlurEffect")
			or Object:IsA("ColorCorrectionEffect")
			or Object:IsA("DepthOfFieldEffect")
			or Object:IsA("SunRaysEffect") then

			pcall(function()
				Object.Enabled = false
			end)
		end
	end
end

--==================================================
-- TERRAIN OPTIMIZATION
--==================================================

local function OptimizeTerrain()

	local Terrain = Workspace:FindFirstChildOfClass("Terrain")

	if not Terrain then
		return
	end

	pcall(function()
		Terrain.Decoration = false
	end)

	pcall(function()
		Terrain.WaterWaveSize = 0
	end)

	pcall(function()
		Terrain.WaterWaveSpeed = 0
	end)

	pcall(function()
		Terrain.WaterReflectance = 0
	end)

	pcall(function()
		Terrain.WaterTransparency = 1
	end)
end

--==================================================
-- RUN SUPER LOW
--==================================================

local function SuperLow()

	OptimizeLighting()
	OptimizeTerrain()

	local Objects = Workspace:GetDescendants()

	for i, Object in ipairs(Objects) do

		OptimizeObject(Object)

		-- beri kesempatan engine supaya tidak freeze
		if i % 300 == 0 then
			task.wait()
		end
	end

	-- Optimasi object baru yang muncul
	Workspace.DescendantAdded:Connect(function(Object)

		task.defer(function()

			if Object and Object.Parent then
				OptimizeObject(Object)
			end

		end)

	end)
end

--==================================================
-- FPS COUNTER
--==================================================

local function CreateFPSCounter()

	local FPSFrame = Instance.new("Frame")
	FPSFrame.Size = UDim2.new(0, 145, 0, 48)
	FPSFrame.Position = UDim2.new(0, 20, 0, 100)
	FPSFrame.BackgroundColor3 = Color3.fromRGB(8,8,8)
	FPSFrame.BorderSizePixel = 0
	FPSFrame.Active = true
	FPSFrame.Parent = ScreenGui

	local Corner = Instance.new("UICorner")
	Corner.CornerRadius = UDim.new(0, 12)
	Corner.Parent = FPSFrame

	local FPSStroke = Instance.new("UIStroke")
	FPSStroke.Thickness = 2
	FPSStroke.Parent = FPSFrame

	local FPSLabel = Instance.new("TextLabel")
	FPSLabel.Size = UDim2.new(1, -10, 1, -5)
	FPSLabel.Position = UDim2.new(0, 5, 0, 2)
	FPSLabel.BackgroundTransparency = 1
	FPSLabel.Text = "FPS: --"
	FPSLabel.TextColor3 = Color3.new(1,1,1)
	FPSLabel.TextScaled = true
	FPSLabel.Font = Enum.Font.GothamBold
	FPSLabel.Parent = FPSFrame

	--==================================================
	-- DRAG SYSTEM
	--==================================================

	local dragging = false
	local dragStart
	local startPos

	FPSFrame.InputBegan:Connect(function(Input)

		if Input.UserInputType == Enum.UserInputType.MouseButton1
			or Input.UserInputType == Enum.UserInputType.Touch then

			dragging = true
			dragStart = Input.Position
			startPos = FPSFrame.Position

			Input.Changed:Connect(function()

				if Input.UserInputState == Enum.UserInputState.End then
					dragging = false
				end

			end)

		end

	end)

	game:GetService("UserInputService").InputChanged:Connect(function(Input)

		if not dragging then
			return
		end

		if Input.UserInputType == Enum.UserInputType.MouseMovement
			or Input.UserInputType == Enum.UserInputType.Touch then

			local Delta = Input.Position - dragStart

			FPSFrame.Position = UDim2.new(
				startPos.X.Scale,
				startPos.X.Offset + Delta.X,
				startPos.Y.Scale,
				startPos.Y.Offset + Delta.Y
			)

		end

	end)

	--==================================================
	-- FPS CALCULATION
	--==================================================

	local Frames = 0
	local LastTime = tick()

	RunService.RenderStepped:Connect(function()

		Frames += 1

		local Now = tick()

		if Now - LastTime >= FPS_UPDATE then

			local FPS = math.floor(
				Frames / (Now - LastTime)
			)

			FPSLabel.Text = "FPS: " .. FPS

			Frames = 0
			LastTime = Now

		end

		FPSStroke.Color = RGB()

	end)
end

