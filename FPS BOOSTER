--==================================================
-- HONEST FPS MEASUREMENT
--==================================================

local currentFPSValue = 0

local function startTrueFPS(label)
	local frames = 0
	local elapsed = 0

	return RunService.RenderStepped:Connect(function(deltaTime)
		if not label or not label.Parent then
			return
		end

		frames += 1
		elapsed += deltaTime

		if elapsed >= 1 then
			local realFPS = frames / elapsed

			-- NO FAKE NUMBER
			currentFPSValue = realFPS

			label.Text = string.format(
				"Current FPS: %.0f",
				realFPS
			)

			frames = 0
			elapsed = 0
		end
	end)
end

local MainFPSConnection = startTrueFPS(CurrentFPS)

--==================================================
-- CHARACTER PROTECTION
--==================================================

local function isCharacterObject(instance)
	for _, plr in ipairs(Players:GetPlayers()) do
		if plr.Character and instance:IsDescendantOf(plr.Character) then
			return true
		end
	end

	return false
end

local function isPlayerCharacterModel(instance)
	if not instance:IsA("Model") then
		return false
	end

	return instance:FindFirstChildOfClass("Humanoid") ~= nil
end

--==================================================
-- MAP OPTIMIZER
--==================================================

local function optimizeObject(instance)
	if not instance or not instance.Parent then
		return
	end

	-- NEVER TOUCH CHARACTER
	if isCharacterObject(instance) then
		return
	end

	-- Particle effects
	if instance:IsA("ParticleEmitter")
		or instance:IsA("Trail")
		or instance:IsA("Beam")
		or instance:IsA("Smoke")
		or instance:IsA("Fire")
		or instance:IsA("Sparkles") then

		pcall(function()
			instance.Enabled = false
		end)

		return
	end

	-- Lights
	if instance:IsA("PointLight")
		or instance:IsA("SpotLight")
		or instance:IsA("SurfaceLight") then

		pcall(function()
			instance.Enabled = false
			instance.Shadows = false
		end)

		return
	end

	-- Post processing
	if instance:IsA("BloomEffect")
		or instance:IsA("BlurEffect")
		or instance:IsA("ColorCorrectionEffect")
		or instance:IsA("DepthOfFieldEffect")
		or instance:IsA("SunRaysEffect") then

		pcall(function()
			instance.Enabled = false
		end)

		return
	end

	-- SurfaceAppearance
	if instance:IsA("SurfaceAppearance") then
		pcall(function()
			instance:Destroy()
		end)

		return
	end

	-- Map decals/textures
	if instance:IsA("Decal") or instance:IsA("Texture") then
		pcall(function()
			instance.Transparency = 1
		end)

		return
	end

	-- Base parts
	if instance:IsA("BasePart") then
		pcall(function()
			instance.Material = Enum.Material.Plastic
			instance.MaterialVariant = ""
			instance.Reflectance = 0
			instance.CastShadow = false
		end)
	end

	-- MeshParts
	if instance:IsA("MeshPart") then
		pcall(function()
			instance.RenderFidelity = Enum.RenderFidelity.Performance
			instance.Material = Enum.Material.Plastic
			instance.MaterialVariant = ""
			instance.Reflectance = 0
			instance.CastShadow = false
		end)

		return
	end

	-- Models
	if instance:IsA("Model") then
		if isPlayerCharacterModel(instance) then
			return
		end

		pcall(function()
			instance.LevelOfDetail = Enum.ModelLevelOfDetail.Streaming
		end)

		return
	end
end

--==================================================
-- TERRAIN OPTIMIZATION
--==================================================

local function optimizeTerrain()
	local terrain = Workspace:FindFirstChildOfClass("Terrain")

	if not terrain then
		return
	end

	pcall(function()
		terrain.Decoration = false
	end)

	pcall(function()
		terrain.WaterWaveSize = 0
		terrain.WaterWaveSpeed = 0
		terrain.WaterReflectance = 0
		terrain.WaterTransparency = 0
	end)
end

--==================================================
-- LIGHTING OPTIMIZATION
--==================================================

local function optimizeLighting()
	pcall(function()
		Lighting.GlobalShadows = false
	end)

	pcall(function()
		Lighting.ShadowSoftness = 0
	end)

	pcall(function()
		Lighting.FogEnd = 100000
	end)

	pcall(function()
		Lighting.Brightness = 1
	end)

	pcall(function()
		Lighting.EnvironmentDiffuseScale = 0
	end)

	pcall(function()
		Lighting.EnvironmentSpecularScale = 0
	end)

	for _, child in ipairs(Lighting:GetChildren()) do
		if child:IsA("PostEffect") then
			pcall(function()
				child.Enabled = false
			end)
		end
	end
end

--==================================================
-- MATERIAL OPTIMIZATION
--==================================================

local function optimizeMaterials()
	for _, object in ipairs(MaterialService:GetChildren()) do
		pcall(function()
			object:Destroy()
		end)
	end

	pcall(function()
		MaterialService.Use2022Materials = false
	end)
end

--==================================================
-- LOW GRAPHICS SETTINGS
--==================================================

local function tryLowGraphics()
	-- These are optional and may not be available
	-- in a normal Roblox LocalScript.

	pcall(function()
		settings().Rendering.QualityLevel = Enum.QualityLevel.Level01
	end)

	pcall(function()
		settings().Rendering.QualityLevel = 1
	end)

	pcall(function()
		settings().Rendering.MeshPartDetailLevel =
			Enum.MeshPartDetailLevel.Level04
	end)
end

--==================================================
-- OPTIMIZE ALL
--==================================================

local function optimizeEverything()
	Status.Text = "Optimizing map..."

	optimizeLighting()
	optimizeTerrain()
	optimizeMaterials()
	tryLowGraphics()

	local descendants = Workspace:GetDescendants()

	for i, instance in ipairs(descendants) do
		optimizeObject(instance)

		-- Prevent one giant frame spike while scanning huge maps
		if i % 250 == 0 then
			task.wait()
		end
	end

	Status.Text = "Optimization complete"
end

