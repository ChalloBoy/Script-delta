local function hasLineOfSight(character, part)
	local origin=Cam.CFrame.Position
	local direction=part.Position-origin
	local rp=RaycastParams.new()
	rp.FilterType=Enum.RaycastFilterType.Exclude
	rp.FilterDescendantsInstances={LP.Character}
	rp.IgnoreWater=true

	-- Raycast may hit an accessory/tool belonging to the target first.
	-- Keep stepping through target-owned descendants until a real obstruction is found.
	local ignore={LP.Character}
	local safety=0
	while safety<12 do
		safety+=1
		rp.FilterDescendantsInstances=ignore
		local hit=workspace:Raycast(origin,direction,rp)
		if not hit then
			return true
		end
		if hit.Instance:IsDescendantOf(character) then
			return true
		end

		local parent=hit.Instance.Parent
		if parent and (parent:IsA("Accessory") or parent:IsA("Tool")) then
			table.insert(ignore,parent)
			continue
		end
		return false
	end
	return false
end

local function target()
	-- Player-only target selection. No NPCs.
	local center=Vector2.new(Cam.ViewportSize.X/2,Cam.ViewportSize.Y/2)
	local radius=math.max(povSize,1)/2
	local best=nil
	local bestScore=math.huge

	for _,pl in ipairs(Players:GetPlayers()) do
		if pl~=LP then
			local character=pl.Character
			local h=character and character:FindFirstChildOfClass("Humanoid")
			local head=character and character:FindFirstChild("Head")
			local root=character and character:FindFirstChild("HumanoidRootPart")
			local torso=character and (character:FindFirstChild("UpperTorso") or character:FindFirstChild("Torso") or root)
			local targetPart=aimPart=="Head" and head or (aimPart=="Torso" and torso or root)

			if h and h.Health>0
				and head and head:IsA("BasePart")
				and root and root:IsA("BasePart")
				and targetPart and targetPart:IsA("BasePart") then

				local p,onScreen=Cam:WorldToViewportPoint(targetPart.Position)
				if onScreen and p.Z>0 then
					local screenPos=Vector2.new(p.X,p.Y)
					local screenDistance=(screenPos-center).Magnitude

					if screenDistance<=radius and screenDistance<bestScore then
						local distance3D=(Cam.CFrame.Position-targetPart.Position).Magnitude
						if distance3D<=2000 and hasLineOfSight(character,targetPart) then
							best=targetPart
							bestScore=screenDistance
						end
					end
				end
			end
		end
	end

	return best
end

