local currentLanguage="EN"
local function L(key)
	local lang=languageText[currentLanguage] or languageText.ID
	return lang[key] or languageText.EN[key] or key
end
local function markLocalized(inst,key)
	if not inst then return end
	inst:SetAttribute("LocKey",key)
	if inst:IsA("TextLabel") or inst:IsA("TextButton") then
		inst:SetAttribute("BaseTextSize",inst.TextSize)
		inst.Text=L(key)
	end
end

