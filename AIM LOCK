local function build(n)
	local p=page(n);tx(p,n,22,true);tx(p,
		({AIM="Targeting and visibility",ESP="Player visual information",MOVEMENT="Movement controls",
		PLAYER="Player utilities",WORLD="World and match",HUD="Compact HUD",SETTINGS="Interface and camera"})[n],11).TextColor3=Color3.fromRGB(135,165,195)
	if n=="AIM" then
		toggle(p,"Aim Lock","Follow a valid visible target.","AimLock");toggle(p,"Aim Assist","Gentler camera assistance.","AimAssist")
		targetPicker(p);dropdown(p,"Target Priority","Priority",{"Nearest","Crosshair"})
		slider(p,"Aim Strength","AimStrength",0,100);slider(p,"Smoothness","Smoothness",0,100);slider(p,"FOV","FOV",20,360)
		toggle(p,"Team Check","Ignore teammates.","TeamCheck");toggle(p,"NPC Check","Allow NPC targets.","NPCCheck")
		toggle(p,"Wall Check","Ignore targets behind geometry.","WallCheck");toggle(p,"Prediction","Lead moving targets.","Prediction")
		toggle(p,"Auto Fire","Request your own weapon system to fire.","AutoFire")
	elseif n=="ESP" then
		toggle(p,"ESP","Show player information.","ESP");toggle(p,"Names","Display names.","ESPNames")
		toggle(p,"Health","Display health.","ESPHealth");toggle(p,"Distance","Display distance.","ESPDistance")
	elseif n=="MOVEMENT" then
		toggle(p,"Sprint","Hold LeftShift to sprint.","Sprint");toggle(p,"Infinite Jump","Repeated jumping.","InfiniteJump");toggle(p,"Dash","Adds an on-screen Dash button.","Dash")
		slider(p,"WalkSpeed","WalkSpeed",8,100);slider(p,"JumpPower","JumpPower",20,120);slider(p,"Dash Distance","DashDistance",10,100)
	elseif n=="PLAYER" then
		card(p,"Player List","Use the buttons below to spectate players.",120)
		for _,pl in ipairs(Players:GetPlayers())do local b=bt(p,pl.DisplayName.."  @"..pl.Name);b.Size=UDim2.new(1,0,0,36);b.MouseButton1Click:Connect(function()local c=pl.Character;local h=c and c:FindFirstChildOfClass("Humanoid");if h then Cam.CameraSubject=h end end)end
	elseif n=="WORLD" then card(p,"Server","Players: "..#Players:GetPlayers(),"64")
	elseif n=="HUD" then toggle(p,"FPS / Ping","HUD status display.","ESP")
	elseif n=="SETTINGS" then slider(p,"Camera FOV","CameraFOV",50,120) end
	return p
end

