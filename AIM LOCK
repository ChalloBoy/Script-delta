UIS.InputBegan:Connect(function(input,gameProcessed)
	if gameProcessed then return end
	if input.UserInputType==Enum.UserInputType.MouseButton1 or input.UserInputType==Enum.UserInputType.Touch then
		if not languageMenu.Visible then return end
		local pos=input.Position
		local a=languageMenu.AbsolutePosition;local z=languageMenu.AbsoluteSize
		local b=languageBtn.AbsolutePosition;local bz=languageBtn.AbsoluteSize
		local inMenu=pos.X>=a.X and pos.X<=a.X+z.X and pos.Y>=a.Y and pos.Y<=a.Y+z.Y
		local inButton=pos.X>=b.X and pos.X<=b.X+bz.X and pos.Y>=b.Y and pos.Y<=b.Y+bz.Y
		if not inMenu and not inButton then languageMenu.Visible=false end
	end
end)

