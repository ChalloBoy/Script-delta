local fire=RS:FindFirstChild("FPSFireRequest")
if not fire then fire=Instance.new("BindableEvent");fire.Name="FPSFireRequest";fire.Parent=RS end
local lastFire=0
local function target()
	local best,bscore=nil,math.huge;local center=Cam.ViewportSize/2
	for _,p in ipairs(Players:GetPlayers())do
		if p~=LP and(not C.TeamCheck or p.Team~=LP.Team)then
			local c=p.Character;local hum=c and c:FindFirstChildOfClass("Humanoid")
			local part=c and c:FindFirstChild(C.TargetPart=="Body" and "HumanoidRootPart" or "Head")
			if hum and hum.Health>0 and part then
				local sp,on=Cam:WorldToViewportPoint(part.Position)
				if on and sp.Z>0 then
					local ok=true
					if C.WallCheck then local rp=RaycastParams.new();rp.FilterType=Enum.RaycastFilterType.Exclude;rp.FilterDescendantsInstances={LP.Character}
						local hit=WS:Raycast(Cam.CFrame.Position,part.Position-Cam.CFrame.Position,rp);if hit and not hit.Instance:IsDescendantOf(c)then ok=false end end
					if ok then local score=(C.Priority=="Crosshair")and(Vector2.new(sp.X,sp.Y)-center).Magnitude or(Cam.CFrame.Position-part.Position).Magnitude
						if C.Priority=="Crosshair" and score>C.FOV then score=math.huge end
						if score<bscore then bscore=score;best={p,part}end end
				end
			end
		end
	end
	return best
end

Run.RenderStepped:Connect(function(dt)
	Cam.FieldOfView=C.CameraFOV;fov.Size=UDim2.fromOffset(C.FOV*2,C.FOV*2);fov.Visible=C.AimLock or C.AimAssist;dash.Visible=C.Dash
	local c=LP.Character;local h=c and c:FindFirstChildOfClass("Humanoid")
	if h then h.WalkSpeed=C.Sprint and C.WalkSpeed*1.5 or C.WalkSpeed;h.JumpPower=C.JumpPower end
	if C.ESP then for _,p in ipairs(Players:GetPlayers())do make(p)end else for p in pairs(esp)do remove(p)end end
	if C.AimLock or C.AimAssist then local t=target();if t then
		local part=t[2];local goal=CFrame.lookAt(Cam.CFrame.Position,part.Position)
		local a=math.clamp(C.AimStrength/100*(1-C.Smoothness/110)*dt*12,0,1);Cam.CFrame=Cam.CFrame:Lerp(goal,a)
		if C.AutoFire and os.clock()-lastFire>.12 then lastFire=os.clock();fire:Fire(t[1],part,Cam.CFrame.Position,(part.Position-Cam.CFrame.Position).Unit)end
	end end
end)
