local function slider(par,t,y,min,max,get,set)
	local r=new("Frame",{Position=UDim2.fromOffset(5,y),Size=UDim2.new(1,-10,0,62),BackgroundColor3=Color3.fromRGB(15,17,23),BorderSizePixel=0,ZIndex=12},par);round(r,9)
	local txt=new("TextLabel",{Position=UDim2.fromOffset(12,5),Size=UDim2.new(1,-24,0,20),BackgroundTransparency=1,TextColor3=Color3.fromRGB(220,222,228),Font=Enum.Font.GothamMedium,TextSize=11,TextXAlignment=Enum.TextXAlignment.Left,ZIndex=13},r)
	markLocalized(txt,t)
	local bar=new("Frame",{Position=UDim2.fromOffset(12,35),Size=UDim2.new(1,-24,0,8),BackgroundColor3=Color3.fromRGB(44,46,54),BorderSizePixel=0,ZIndex=13},r);round(bar,5)
	local fill=new("Frame",{Size=UDim2.new(),BackgroundColor3=Color3.fromRGB(230,42,48),BorderSizePixel=0,ZIndex=14},bar);round(fill,5)
	local moving=false
	local function setx(x) local width=math.max(bar.AbsoluteSize.X,1);local a=math.clamp((x-bar.AbsolutePosition.X)/width,0,1);set(min+(max-min)*a) end
	local function refresh() local v=get();local a=math.clamp((v-min)/(max-min),0,1);fill.Size=UDim2.new(a,0,1,0);txt.Text=L(t).."   "..math.round(v) end
	bar.InputBegan:Connect(function(i) if i.UserInputType==Enum.UserInputType.MouseButton1 or i.UserInputType==Enum.UserInputType.Touch then moving=true;setx(i.Position.X);refresh() end end)
	UIS.InputChanged:Connect(function(i) if moving and (i.UserInputType==Enum.UserInputType.MouseMovement or i.UserInputType==Enum.UserInputType.Touch) then setx(i.Position.X);refresh() end end)
	UIS.InputEnded:Connect(function(i) if i.UserInputType==Enum.UserInputType.MouseButton1 or i.UserInputType==Enum.UserInputType.Touch then moving=false end end)
	refresh()
end

