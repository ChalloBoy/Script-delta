	refreshRevengeList()
end)

local pulseClock=0
RunService:BindToRenderStep("AimESPPovRender",Enum.RenderPriority.Camera.Value+1,function(dt)
	pulseClock+=dt
	local pulse=(math.sin(pulseClock*3.2)+1)/2
	if uiAnimation then
		topGrad.Offset=Vector2.new(((pulseClock*0.45)%2)-1,0)
	else
		topGrad.Offset=Vector2.new(0,0)
	end
	statusDot.BackgroundTransparency=.05+(pulse*.45)
	statusStroke.Transparency=.10+(pulse*.45)
	if mainStroke then mainStroke.Transparency=.12+(pulse*.28) end
	applyVisualSettings()
	Cam=workspace.CurrentCamera
	local viewport=Cam.ViewportSize
pov.Position=UDim2.fromScale(.5,.5)
pov.Size=UDim2.fromOffset(math.max(4,povSize),math.max(4,povSize))
pov.Visible=povOn
ps.Transparency=povOn and 0 or 1
if povCorner then povCorner.CornerRadius=UDim.new(.5,0) end
	if espRGB then
		espColor=Color3.fromHSV((pulseClock*rgbSpeed)%1,0.92,1)
	else
		espColor=Color3.fromRGB(espR,espG,espB)
	end
	if povRGB then
		povColor=Color3.fromHSV((pulseClock*rgbSpeed)%1,0.92,1)
	else
		povColor=Color3.fromRGB(povR,povG,povB)
	end
	local themeColor=themeRGB and Color3.fromHSV((pulseClock*themeSpeed)%1,0.92,1) or Color3.fromRGB(themeR,themeG,themeB)
	if renderTitle then renderTitle.TextColor3=themeColor end
	settingsTitle.TextColor3=themeColor
	topGlow.BackgroundColor3=themeColor
	settingsPanel.BackgroundColor3=Color3.fromRGB(9,11,15)
	ps.Color=povColor
	local lockedTarget=nil
	if aim then
		lockedTarget=target()
		if lockedTarget and lockedTarget.Parent then
			local current=Cam.CFrame
			local wanted=CFrame.lookAt(current.Position,lockedTarget.Position)
			local alpha=math.clamp((strength/100)*18*dt,0,1)
			Cam.CFrame=current:Lerp(wanted,alpha)
		end
	end

	-- Auto Fire hanya aktif setelah Aim Lock benar-benar mendapatkan
	-- target Player yang terlihat. Tidak menembak saat target terhalang.
	if autoFire and aim and lockedTarget then
		fireClock += dt
		if fireClock >= autoFireRate then
			fireClock = 0
			local fireEvent=game:GetService("ReplicatedStorage"):FindFirstChild("FPSFireRequest")
			if fireEvent and fireEvent:IsA("BindableEvent") then
				fireEvent:Fire()
			end
		end
	else
		fireClock = 0
	end
	if lockedTarget then
		statusText.Text=L("LOCKED").."  •  "..(lockedTarget.Parent and lockedTarget.Parent.Name or L("TARGET"))
		statusText.TextColor3=themeColor
	else
		statusText.Text=aim and L("SEARCHING") or L("SYSTEM_READY")
		statusText.TextColor3=Color3.fromRGB(190,195,205)
	end
	fpsFrames+=1
	fpsAccumulator+=dt
	statsClock+=dt
	if fpsAccumulator>=0.5 then
		fpsDisplay=math.clamp(math.round(fpsFrames/math.max(fpsAccumulator,.001)),0,999)
		fpsFrames=0
		fpsAccumulator=0
	end
	if statsClock>=0.25 then
		statsClock=0
		if performanceDevice then
			local ping=getPingMs()
			local frameFps=nil
			pcall(function()
				local frameTime=Stats.FrameTime
				if frameTime and frameTime>0 then frameFps=math.clamp(math.round(1/frameTime),0,999) end
			end)
			local shownFps=frameFps or fpsDisplay
			fpsValue.Text=string.format("%s       %d",L("FPS"),shownFps)
			if ping then
				pingValue.Text=string.format("%s      %d ms",L("Ping"),math.round(ping))
				local bars=(ping<=50 and 8) or (ping<=90 and 7) or (ping<=130 and 6) or (ping<=180 and 5) or (ping<=250 and 4) or (ping<=350 and 3) or (ping<=500 and 2) or 1
				signalValue.Text=L("Signal").."    "..string.rep("█",bars)..string.rep("░",8-bars)
			else
				pingValue.Text=L("Ping").."      --- ms"
				signalValue.Text=L("Signal").."    ░░░░░░░░"
			end
			deviceValue.Text=L("Device").."    "..deviceText()
			platformValue.Text=L("Platform").."  "..platformText()
			playersValue.Text=L("Players").."   "..tostring(#Players:GetPlayers())
		else
			fpsValue.Text=L("FPS").."       ---"
			pingValue.Text=L("Ping").."      --- ms"
			signalValue.Text=L("Signal").."    ░░░░░░░░"
			deviceValue.Text=L("Device").."    ---------"
			platformValue.Text=L("Platform").."  --------"
			playersValue.Text=L("Players").."   --"
		end
	end
	for m,o in pairs(objects) do if m.Parent then update(m,o) else remove(m) end end
	for _,pl in ipairs(Players:GetPlayers()) do if pl.Character and pl.Character~=LP.Character then create(pl.Character) end end

end)
