	for _,child in ipairs(revengeList:GetChildren()) do
		if child:IsA("TextButton") or child.Name=="NoPlayers" then child:Destroy() end
	end
	local playerList={}
	for _,pl in ipairs(Players:GetPlayers()) do
		if pl~=LP then table.insert(playerList,pl) end
