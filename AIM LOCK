local function target()
	-- Hanya Player, bukan NPC.
	local ch=LP.Character
	local rr=ch and ch:FindFirstChild("HumanoidRootPart")
	if not rr or not rr:IsA("BasePart") then return nil end

	local center=Vector2.new(Cam.ViewportSize.X/2,Cam.ViewportSize.Y/2)
	local radius=povSize/2
	local best=nil
	local score=math.huge

	for _,pl in ipairs(Players:GetPlayers()) do
		if pl~=LP and (LP.Team==nil or pl.Team~=LP.Team) then
			local x=pl.Character
			local h=x and x:FindFirstChildOfClass("Humanoid")
			local hd=x and x:FindFirstChild("Head")
			local rt=x and x:FindFirstChild("HumanoidRootPart")

			if h and h.Health>0 and hd and hd:IsA("BasePart")
				and rt and rt:IsA("BasePart")
				and (rr.Position-rt.Position).Magnitude<=2000 then

				local p,on=Cam:WorldToViewportPoint(hd.Position)
				if on and p.Z>0 then
					local q=Vector2.new(p.X,p.Y)
					local screenDistance=(q-center).Magnitude

					if screenDistance<=radius and screenDistance<score then
						-- Target hanya valid jika tidak ada tembok/objek
						-- di antara kamera dan Head player.
						local rp=RaycastParams.new()
						rp.FilterType=Enum.RaycastFilterType.Exclude
						rp.FilterDescendantsInstances={ch}

						local direction=hd.Position-Cam.CFrame.Position
						local hit=workspace:Raycast(Cam.CFrame.Position,direction,rp)

						if hit and hit.Instance:IsDescendantOf(x) then
							score=screenDistance
							best=hd
						end
					end
				end
			end
		end
	end

	return best
end

