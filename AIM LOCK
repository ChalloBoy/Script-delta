local function select(n)
	local chosen=pg[n] and n or nil
	if not chosen then return end
	for id,b in pairs(tabs) do
		local active=(id==chosen)
		b:SetAttribute("Active",active)
		local ind=b:FindFirstChild("ActiveIndicator")
		b.BackgroundColor3=active and Color3.fromRGB(72,22,26) or Color3.fromRGB(18,20,27)
		b.TextColor3=active and Color3.fromRGB(255,90,90) or Color3.fromRGB(180,185,195)
		if ind then ind.Visible=active end
	end
	for id,x in pairs(pg) do
		if id==chosen then
			x.Visible=true
			for _,child in ipairs(x:GetChildren()) do
				if child:IsA("GuiObject") then
					local oldPos=child.Position
					child.Position=UDim2.new(oldPos.X.Scale,oldPos.X.Offset+6,oldPos.Y.Scale,oldPos.Y.Offset)
					tween(child,{Position=oldPos},.18,Enum.EasingStyle.Quint,Enum.EasingDirection.Out)
				end
			end
		else
			x.Visible=false
		end
	end
end
