-- Play the loading video once, then reveal the toolkit. A timeout prevents a failed/unavailable video asset from blocking the UI.
task.spawn(function()
	local started=os.clock()
	loadingVideo.TimePosition=0
	loadingVideo.Playing=true
	local loaded=false
	while os.clock()-started<10 do
		local isLoaded=false
		pcall(function() isLoaded=loadingVideo.IsLoaded end)
		if isLoaded then loaded=true end
		local length=0
		pcall(function() length=loadingVideo.TimeLength end)
		local position=0
		pcall(function() position=loadingVideo.TimePosition end)
		if length>0 then
			local progress=math.clamp(position/math.max(length,.01),0,1)
			loadingBar.Size=UDim2.new(progress,0,1,0)
			if progress>=.985 then break end
		elseif loaded then
			loadingBar.Size=UDim2.new(math.clamp((os.clock()-started)/3,0,1),0,1,0)
		else
			loadingBar.Size=UDim2.new(math.clamp((os.clock()-started)/10,0,.85),0,1,0)
		end
		if not loadingVideo.Playing and loaded then
			loadingVideo.Playing=true
		end
		task.wait(.05)
	end
	loadingBar.Size=UDim2.new(1,0,1,0)
	loadingStatus.Text=L("READY")
	task.wait(.12)
	local fadeInfo=TweenInfo.new(.35,Enum.EasingStyle.Quad,Enum.EasingDirection.Out)
	pcall(function() TS:Create(loadingVideo,fadeInfo,{ImageTransparency=1}):Play() end)
	local f1=TS:Create(loadingShade,fadeInfo,{BackgroundTransparency=1})
	local f2=TS:Create(loadingTitle,fadeInfo,{TextTransparency=1})
	local f3=TS:Create(loadingStatus,fadeInfo,{TextTransparency=1})
	f1:Play();f2:Play();f3:Play()
	TS:Create(loadingBarBG,fadeInfo,{BackgroundTransparency=1}):Play()
	TS:Create(loadingBar,fadeInfo,{BackgroundTransparency=1}):Play()
	task.wait(.4)
	loadingVideo.Playing=false
	loading.Visible=false
	main.Visible=true
	glow.Visible=uiGlow
end)

-- Safety fallback: if the intro task is interrupted by an unavailable video asset,
-- never leave the player stuck on a fullscreen black loading layer.
task.delay(11,function()
	if loading and loading.Parent and loading.Visible then
		loading.Visible=false
		main.Visible=true
		glow.Visible=uiGlow
	end
end)

