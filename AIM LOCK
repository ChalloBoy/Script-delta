local ready=true
local function doDash()
	if not C.Dash or not ready then return end
	local ch=LP.Character;local r=ch and ch:FindFirstChild("HumanoidRootPart");if not r then return end
	ready=false;local v=Cam.CFrame.LookVector;local flat=Vector3.new(v.X,0,v.Z)
	if flat.Magnitude<.01 then flat=r.CFrame.LookVector end
	r.AssemblyLinearVelocity=flat.Unit*C.DashDistance+Vector3.new(0,r.AssemblyLinearVelocity.Y,0);dash.Text=".."
	task.delay(C.DashCooldown,function()ready=true;dash.Text="DASH"end)
end
