end

local function tween(obj, props, duration, style, direction)
	if not uiAnimation then
		for k,v in pairs(props) do obj[k]=v end
		return
	end
	local info=TweenInfo.new(duration or .16,style or Enum.EasingStyle.Quad,direction or Enum.EasingDirection.Out)
	TS:Create(obj,info,props):Play()
end

local function buttonFX(btn,normal,hover,down)
	btn.MouseEnter:Connect(function()
		tween(btn,{BackgroundColor3=hover},.12)
	end)
	btn.MouseLeave:Connect(function()
		tween(btn,{BackgroundColor3=normal},.16)
	end)
	btn.MouseButton1Down:Connect(function()
		tween(btn,{BackgroundColor3=down},.07,Enum.EasingStyle.Quad,Enum.EasingDirection.Out)
	end)
	btn.MouseButton1Up:Connect(function()
		tween(btn,{BackgroundColor3=hover},.10)
	end)
end

local function dragWindow(targetFrame, glowFrame, headerHeight)
	-- Drag global: bekerja meski input dimulai di TextLabel/child header.
	local dragging=false
	local dragStart=Vector2.zero
	local startPos=targetFrame.Position
	local activeInput=nil
	local function insideHeader(pos)
		if not targetFrame.Visible then return false end
		local a=targetFrame.AbsolutePosition
		local s=targetFrame.AbsoluteSize
		return pos.X>=a.X and pos.X<=a.X+s.X and pos.Y>=a.Y and pos.Y<=a.Y+headerHeight
	end
	UIS.InputBegan:Connect(function(input,gameProcessed)
		-- UI drag harus tetap menerima input meski Roblox menandainya processed.
		if input.UserInputType==Enum.UserInputType.MouseButton1 or input.UserInputType==Enum.UserInputType.Touch then
			if input.UserInputType==Enum.UserInputType.Touch and not touchDragEnabled then return end
			if insideHeader(input.Position) then
				-- Jangan mengambil tombol minimize/close.
				local a=targetFrame.AbsolutePosition
				local x=input.Position.X-a.X
				if x<targetFrame.AbsoluteSize.X-315 then
					dragging=true
					activeInput=input
					dragStart=input.Position
					startPos=targetFrame.Position
				end
			end
		end
	end)
	UIS.InputChanged:Connect(function(input)
		if not dragging then return end
		if input.UserInputType==Enum.UserInputType.MouseMovement or input.UserInputType==Enum.UserInputType.Touch then
			local d=input.Position-dragStart
			targetFrame.Position=UDim2.new(startPos.X.Scale,startPos.X.Offset+d.X,startPos.Y.Scale,startPos.Y.Offset+d.Y)
			if glowFrame then glowFrame.Position=UDim2.new(startPos.X.Scale,startPos.X.Offset+d.X,startPos.Y.Scale,startPos.Y.Offset+d.Y) end
		end
	end)
	UIS.InputEnded:Connect(function(input)
		if input==activeInput or input.UserInputType==Enum.UserInputType.MouseButton1 or input.UserInputType==Enum.UserInputType.Touch then
			dragging=false
			activeInput=nil
		end
	end)
end

