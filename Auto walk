--------------------------------------------------
-- RECORD
--------------------------------------------------

local function StartRecord()

	if not Root then
		Status.Text = "Character belum siap"
		return
	end

	if RecordConnection then
		RecordConnection:Disconnect()
	end

	if ReplayConnection then
		ReplayConnection:Disconnect()
		ReplayConnection = nil
	end

	Frames = {}
	Checkpoints = {}

	Recording = true
	Replaying = false

	RecordStartTime = os.clock()
	RecordTime = 0

	Timer.Text = "00:00:00"
	Status.Text = "Recording..."

	RefreshList()

	local accumulator = 0

	RecordConnection = RunService.Heartbeat:Connect(function(dt)

		if not Recording then
			return
		end

		if not Root then
			return
		end

		RecordTime = os.clock() - RecordStartTime

		Timer.Text = FormatTime(RecordTime)
		UpdateMini()

		accumulator += dt

		if accumulator >= SAMPLE_RATE then
			accumulator = 0

			table.insert(Frames,{
				Time = RecordTime,
				CFrame = Root.CFrame
			})
		end
	end)
end

--------------------------------------------------
-- STOP
--------------------------------------------------

local function StopRecord()

	if not Recording then
		return
	end

	Recording = false

	if RecordConnection then
		RecordConnection:Disconnect()
		RecordConnection = nil
	end

	RecordTime = os.clock() - RecordStartTime

	Timer.Text = FormatTime(RecordTime)
	UpdateMini()

	Status.Text =
		"Done • "..#Checkpoints.." CP"

end

--------------------------------------------------
-- STOP REPLAY
--------------------------------------------------

local function StopReplay()

	Replaying = false

	if ReplayConnection then
		ReplayConnection:Disconnect()
		ReplayConnection = nil
	end

	Status.Text = "Replay stopped"

end

--------------------------------------------------
-- REPLAY
--------------------------------------------------

function StartReplay(cpIndex)

	if #Frames == 0 then
		Status.Text = "Belum ada record"
		return
	end

	if not cpIndex then
		cpIndex = 1
	end

	local cp = Checkpoints[cpIndex]

	if not cp then
		Status.Text = "CP tidak ditemukan"
		return
	end

	Replaying = true
	Recording = false

	CurrentReplayCheckpoint = cpIndex

	if RecordConnection then
		RecordConnection:Disconnect()
		RecordConnection = nil
	end

	if ReplayConnection then
		ReplayConnection:Disconnect()
	end

	local startFrame = cp.FrameIndex

	if startFrame < 1 then
		startFrame = 1
	end

	local firstFrame = Frames[startFrame]

	if not firstFrame then
		Status.Text = "Frame tidak ditemukan"
		return
	end

	if Root then
		Root.CFrame = cp.CFrame
	end

	local replayStart = os.clock()
	local baseTime = firstFrame.Time

	Status.Text = "▶ CP "..cpIndex

	ReplayConnection = RunService.Heartbeat:Connect(function()

		if not Replaying then
			return
		end

		if not Root then
			return
		end

		local elapsed = os.clock() - replayStart
		local targetTime = baseTime + elapsed

		local frame = Frames[startFrame]

		while startFrame < #Frames
			and Frames[startFrame + 1].Time <= targetTime do

			startFrame += 1
			frame = Frames[startFrame]
		end

		if frame then
			Root.CFrame = frame.CFrame
		end

		if startFrame >= #Frames then
			StopReplay()
			Status.Text = "Replay selesai"
		end

	end)

end

