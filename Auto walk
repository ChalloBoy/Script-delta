--==================================================
-- RAYCAST
--==================================================

local RayParams = RaycastParams.new()
RayParams.FilterType = Enum.RaycastFilterType.Exclude

local function Cast(Origin, Direction)

	RayParams.FilterDescendantsInstances = {
		Character
	}

	return workspace:Raycast(
		Origin,
		Direction,
		RayParams
	)

end

--==================================================
-- DETECT OBSTACLE
--==================================================

local function ObstacleAhead()

	if not Root then
		return false
	end

	local Forward = Root.CFrame.LookVector

	local Heights = {
		0.5,
		1.5,
		2.5
	}

	for _, Height in ipairs(Heights) do

		local Result = Cast(
			Root.Position +
				Vector3.new(0,Height,0),

			Forward * 4.5
		)

		if Result and Result.Instance then

			if Result.Instance:IsA("BasePart") then
				return true
			end

		end

	end

	return false

end

--==================================================
-- AUTO JUMP
--==================================================

local function AutoJump()

	if JumpCooldown then
		return
	end

	if not Humanoid then
		return
	end

	if Humanoid.FloorMaterial == Enum.Material.Air then
		return
	end

	JumpCooldown = true

	Humanoid.Jump = true

	task.delay(0.65,function()
		JumpCooldown = false
	end)

end

--==================================================
-- CREATE PATH
--==================================================

local function CreatePath(Target)

	if not Root then
		return false
	end

	local NewPath = PathfindingService:CreatePath({
		AgentRadius = 2,
		AgentHeight = 5,
		AgentCanJump = true,
		AgentCanClimb = true,

		WaypointSpacing = 3
	})

	local Success = pcall(function()

		NewPath:ComputeAsync(
			Root.Position,
			Target
		)

	end)

	if not Success then
		return false
	end

	if NewPath.Status ~= Enum.PathStatus.Success then
		return false
	end

	Path = NewPath
	Waypoints = NewPath:GetWaypoints()
	WaypointIndex = 1

	return #Waypoints > 0

end

--==================================================
-- FIND TARGET
--==================================================

local function FindTarget()

	if not Root then
		return nil
	end

	-- Mencoba mencari area di depan.
	-- Pathfinding akan memilih jalur yang tersedia.

	local Forward = Root.CFrame.LookVector

	local Distance = 40

	local Target =
		Root.Position +
		Forward * Distance

	return Target

end

--==================================================
-- FOLLOW PATH
--==================================================

local function FollowPath()

	if not Humanoid or not Root then
		return
	end

	if not Path or #Waypoints == 0 then

		local Target = FindTarget()

		if Target then
			CreatePath(Target)
		end

		return
	end

	local Waypoint = Waypoints[WaypointIndex]

	if not Waypoint then

		Path = nil
		Waypoints = {}
		WaypointIndex = 1

		return
	end

	-- Lompat jika waypoint membutuhkan jump
	if Waypoint.Action ==
		Enum.PathWaypointAction.Jump then

		AutoJump()

	end

	local Direction =
		Waypoint.Position -
		Root.Position

	local Horizontal =
		Vector3.new(
			Direction.X,
			0,
			Direction.Z
		)

	-- Sudah dekat waypoint
	if Horizontal.Magnitude < 3 then

		WaypointIndex += 1

		return
	end

	if Horizontal.Magnitude > 0 then

		Horizontal =
			Horizontal.Unit

		-- Gerakan Player sendiri
		Humanoid:Move(
			Horizontal,
			false
		)

	end

end

--==================================================
-- REBUILD PATH
--==================================================

local LastPathUpdate = 0

local function UpdatePath()

	if not Root then
		return
	end

	local Now = os.clock()

	if Now - LastPathUpdate < 1.2 then
		return
	end

	LastPathUpdate = Now

	local Target = FindTarget()

	if Target then
		CreatePath(Target)
	end

end

--==================================================
-- MAIN
--==================================================

RunService.Heartbeat:Connect(function()

	if not Enabled then
		return
	end

	if not Character
		or not Humanoid
		or not Root then
		return
	end

	if Humanoid.Health <= 0 then
		return
	end

	-- Perbarui jalur
	UpdatePath()

	-- Ikuti jalur
	FollowPath()

	-- Raycast rintangan
	if ObstacleAhead() then

		Status.Text = "Obstacle → JUMP"

		AutoJump()

	else

		Status.Text = "Auto Walking"

	end

end)

