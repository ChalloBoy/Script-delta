--==================================================
-- RAYCAST
--==================================================

local RayParams = RaycastParams.new()
RayParams.FilterType = Enum.RaycastFilterType.Exclude

local function Raycast(Origin, Direction)

	RayParams.FilterDescendantsInstances = {
		Character
	}

	return workspace:Raycast(
		Origin,
		Direction,
		RayParams
	)

end

--==================================================
-- CHECK OBSTACLE
--==================================================

local function ObstacleAhead()

	if not Root then
		return false
	end

	local Look = Root.CFrame.LookVector

	-- 3 raycast dengan ketinggian berbeda
	local Heights = {
		0.5,
		1.5,
		2.5
	}

	for _, Height in ipairs(Heights) do

		local Origin =
			Root.Position
			+ Vector3.new(0,Height,0)

		local Result = Raycast(
			Origin,
			Look * 5
		)

		if Result then

			local Part = Result.Instance

			if Part:IsA("BasePart") then
				return true
			end

		end

	end

	return false
end

--==================================================
-- CHECK GROUND
--==================================================

local function GroundAhead()

	if not Root then
		return true
	end

	local Look = Root.CFrame.LookVector

	local Origin =
		Root.Position
		+ Look * 4
		+ Vector3.new(0,2,0)

	local Result = Raycast(
		Origin,
		Vector3.new(0,-8,0)
	)

	return Result ~= nil
end

--==================================================
-- AUTO JUMP
--==================================================

local function AutoJump()

	if Jumping then
		return
	end

	if not Humanoid then
		return
	end

	if Humanoid.FloorMaterial == Enum.Material.Air then
		return
	end

	Jumping = true

	Humanoid.Jump = true

	task.delay(0.7,function()
		Jumping = false
	end)

end

--==================================================
-- WASD STYLE MOVEMENT
--==================================================

local function MoveForward()

	if not Humanoid or not Root then
		return
	end

	-- Arah depan karakter
	local Direction = Root.CFrame.LookVector

	-- Sama konsepnya dengan menekan W
	Humanoid:Move(Direction,false)
end

--==================================================
-- MAIN LOOP
--==================================================

RunService.Heartbeat:Connect(function()

	if not Enabled then
		return
	end

	if not Character
		or not Humanoid
		or not Root then
		return
	end

	if Humanoid.Health <= 0 then
		return
	end

	-- Jalan terus
	MoveForward()

	-- Rintangan
	if ObstacleAhead() then

		Status.Text = "Obstacle → Jump"

		AutoJump()

	else

		-- Lubang / tidak ada tanah
		if not GroundAhead() then

			Status.Text = "Gap → Jump"

			AutoJump()

		else

			Status.Text = "Walking..."

		end

	end

end)
