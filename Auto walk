--==================================================
-- RECORD FRAME
--==================================================

local function AddFrame()
	if not Root or not Humanoid then
		return
	end

	local now = os.clock()
	local currentPosition = Root.Position

	local state = Humanoid:GetState()

	local frame = {
		Time = RouteTime,
		CFrame = Root.CFrame,
		State = state,
		Jump = Humanoid.Jump
	}

	table.insert(Frames, frame)

	LastPosition = currentPosition
end

--==================================================
-- ADD CHECKPOINT
--==================================================

local function AddCheckpoint(part)
	if not Recording then
		return
	end

	if HasCheckpoint(part) then
		return
	end

	if not Root then
		return
	end

	local cp = {
		Part = part,
		Time = RouteTime,
		FrameIndex = #Frames,
		CFrame = Root.CFrame
	}

	table.insert(Checkpoints, cp)

	Status.Text = "CP " .. #Checkpoints .. " ✓"

	RefreshCPList()
end

--==================================================
-- FAILED ATTEMPT
--==================================================

local function HandleFailedAttempt(cp)
	if not cp then
		return
	end

	-- Buang semua frame setelah checkpoint terakhir
	if cp.FrameIndex and #Frames > cp.FrameIndex then
		for i = #Frames, cp.FrameIndex + 1, -1 do
			table.remove(Frames, i)
		end
	end

	-- Kembalikan route time ke waktu CP
	RouteTime = cp.Time

	-- Frame awal retry
	if Root and Humanoid then
		table.insert(Frames, {
			Time = RouteTime,
			CFrame = Root.CFrame,
			State = Humanoid:GetState(),
			Jump = false
		})
	end

	LastPosition = Root and Root.Position or nil

	Status.Text = "Retry CP " .. table.find(Checkpoints, cp)

end

