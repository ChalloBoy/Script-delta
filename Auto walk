--==================================================
-- REPLAY
--==================================================

function StartReplay(cpIndex)

	if Recording or Replaying then
		return
	end

	if #Frames < 2 then
		Status.Text = "No record"
		return
	end

	local cp = Checkpoints[cpIndex]

	if not cp then
		return
	end

	if not Root or not Humanoid then
		return
	end

	Replaying = true

	OldWalkSpeed = Humanoid.WalkSpeed
	OldAutoRotate = Humanoid.AutoRotate

	Humanoid.AutoRotate = true

	-- Teleport hanya sekali ke titik awal CP.
	-- Setelah itu gerakan menggunakan Humanoid:Move().
	Root.CFrame = cp.CFrame

	ReplayIndex = math.max(1, cp.FrameIndex)
	ReplayStartRouteTime = Frames[ReplayIndex].Time
	ReplayStartTime = os.clock()

	Status.Text = "Playing CP " .. cpIndex
end

--==================================================
-- STOP REPLAY
--==================================================

local function StopReplay()
	if not Replaying then
		return
	end

	Replaying = false

	if Humanoid then
		Humanoid:Move(Vector3.zero, false)

		if OldWalkSpeed then
			Humanoid.WalkSpeed = OldWalkSpeed
		end

		if OldAutoRotate ~= nil then
			Humanoid.AutoRotate = OldAutoRotate
		end
	end

	Status.Text = "Finished"
end

--==================================================
-- REPLAY MOVEMENT
--==================================================

local function ReplayStep()

	if not Replaying then
		return
	end

	if not Root or not Humanoid then
		StopReplay()
		return
	end

	local elapsed = os.clock() - ReplayStartTime
	local targetTime = ReplayStartRouteTime + elapsed

	-- Cari frame sesuai waktu
	while ReplayIndex < #Frames
		and Frames[ReplayIndex + 1].Time <= targetTime do

		ReplayIndex += 1
	end

	if ReplayIndex >= #Frames then
		StopReplay()
		return
	end

	local currentFrame = Frames[ReplayIndex]
	local nextFrame = Frames[ReplayIndex + 1]

	local currentPos = Root.Position
	local targetPos = nextFrame.CFrame.Position

	-- Arah horizontal
	local offset = targetPos - currentPos
	local horizontal = Vector3.new(
		offset.X,
		0,
		offset.Z
	)

	local distance = horizontal.Magnitude

	if distance > 0.15 then

		local direction = horizontal.Unit

		-- Hitung kecepatan dari record
		local recordedDistance = (
			nextFrame.CFrame.Position
			- currentFrame.CFrame.Position
		).Magnitude

		local recordedTime =
			math.max(
				nextFrame.Time - currentFrame.Time,
				1 / 60
			)

		local speed = recordedDistance / recordedTime

		speed = math.clamp(
			speed,
			MIN_SPEED,
			MAX_SPEED
		)

		Humanoid.WalkSpeed = speed

		-- INI YANG MEMBUAT KARAKTER BENAR-BENAR BERJALAN
		Humanoid:Move(direction, false)

	else
		Humanoid:Move(Vector3.zero, false)
	end

	--==================================================
	-- JUMP
	--==================================================

	local state = nextFrame.State

	if state == Enum.HumanoidStateType.Jumping
		or state == Enum.HumanoidStateType.Freefall then

		if Humanoid.FloorMaterial ~= Enum.Material.Air then
			Humanoid.Jump = true
		end
	end

	--==================================================
	-- FALL / TELEPORT DETECTION SAAT REPLAY
	--==================================================

	if LastPosition then

		local jumpDistance =
			(Root.Position - LastPosition).Magnitude

		if jumpDistance >= TELEPORT_DISTANCE then

			local nearCP = GetCheckpointNear(Root.Position)

			if nearCP then

				-- Cari frame CP tersebut
				for i, checkpoint in ipairs(Checkpoints) do

					if checkpoint.Part == nearCP then

						ReplayIndex =
							math.max(
								1,
								checkpoint.FrameIndex
							)

						ReplayStartRouteTime =
							Frames[ReplayIndex].Time

						ReplayStartTime = os.clock()

						Status.Text =
							"Retry CP " .. i

						break
					end
				end
			end
		end
	end

	LastPosition = Root.Position
end

--==================================================
-- MAIN LOOP
--==================================================

RunService.Heartbeat:Connect(function(dt)

	--================================================
	-- TIMER
	--================================================

	if Recording then

		local sessionTime =
			os.clock() - SessionStart

		Timer.Text = FormatTime(sessionTime)

		Mini.Text = FormatTime(sessionTime)

		RouteTime += dt

		-- Record sekitar 30 FPS
		if os.clock() - LastSample >= SAMPLE_RATE then

			LastSample = os.clock()

			if Root and Humanoid then

				local currentPosition = Root.Position

				--================================================
				-- TELEPORT / FALL DETECTION
				--================================================

				if LastPosition then

					local distance =
						(currentPosition - LastPosition).Magnitude

					if distance >= TELEPORT_DISTANCE then

						local nearestCP =
							GetCheckpointNear(currentPosition)

						if nearestCP then

							local lastCP =
								Checkpoints[#Checkpoints]

							-- Hanya anggap gagal jika teleport
							-- kembali ke CP terakhir.
							if lastCP
								and lastCP.Part == nearestCP then

								HandleFailedAttempt(lastCP)

								return
							end
						end
					end
				end

				AddFrame()
			end
		end
	else
		if not Replaying then
			Timer.Text = "--:--:--"
			Mini.Text = "--:--:--"
		end
	end

	--================================================
	-- REPLAY
	--================================================

	if Replaying then
		ReplayStep()
	end
end)

--==================================================
-- CHECKPOINT TOUCH LISTENER
--==================================================

local function ConnectCheckpoint(part)

	if not IsCheckpoint(part) then
		return
	end

	part.Touched:Connect(function(hit)

		if not Recording then
			return
		end

		if not Character then
			return
		end

		if hit:IsDescendantOf(Character) then
			AddCheckpoint(part)
		end
	end)
end

-- Checkpoint yang sudah ada
for _, obj in ipairs(workspace:GetDescendants()) do
	if obj:IsA("BasePart") then
		ConnectCheckpoint(obj)
	end
end

-- Checkpoint yang dibuat kemudian
workspace.DescendantAdded:Connect(function(obj)

	if obj:IsA("BasePart") then
		ConnectCheckpoint(obj)
	end
end)

