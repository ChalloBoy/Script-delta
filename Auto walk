--==================================================
-- RAYCAST
--==================================================

local rayParams = RaycastParams.new()
rayParams.FilterType = Enum.RaycastFilterType.Exclude

local function raycast(origin,direction)

	rayParams.FilterDescendantsInstances = {
		character
	}

	return workspace:Raycast(
		origin,
		direction,
		rayParams
	)

end

--==================================================
-- OBSTACLE DETECTION
--==================================================

local function detectObstacle()

	if not root or not humanoid then
		return false
	end

	-- Posisi depan karakter
	local origin =
		root.Position
		+ Vector3.new(0,1.5,0)

	-- Jarak deteksi
	local direction =
		root.CFrame.LookVector * 5

	local hit = raycast(
		origin,
		direction
	)

	if not hit then
		return false
	end

	local part = hit.Instance

	if not part:IsA("BasePart") then
		return false
	end

	-- Cek apakah objek cukup rendah untuk dilompati
	local topY = part.Position.Y + (part.Size.Y / 2)
	local characterFeet = root.Position.Y - 3

	local obstacleHeight = topY - characterFeet

	if obstacleHeight > 0 and obstacleHeight < 6 then
		return true
	end

	return false

end

--==================================================
-- CEK LUBANG DI DEPAN
--==================================================

local function detectGround()

	if not root then
		return true
	end

	local origin =
		root.Position
		+ root.CFrame.LookVector * 4
		+ Vector3.new(0,2,0)

	local direction =
		Vector3.new(0,-8,0)

	local hit = raycast(
		origin,
		direction
	)

	return hit ~= nil

end

--==================================================
-- AUTO JUMP
--==================================================

local function tryJump()

	if jumpCooldown then
		return
	end

	if not humanoid then
		return
	end

	if humanoid.FloorMaterial == Enum.Material.Air then
		return
	end

	jumpCooldown = true

	humanoid.Jump = true

	task.delay(0.75,function()
		jumpCooldown = false
	end)

end

--==================================================
-- MAIN AUTO SYSTEM
--==================================================

RunService.Heartbeat:Connect(function()

	if not enabled then
		return
	end

	if not character or not humanoid or not root then
		return
	end

	if humanoid.Health <= 0 then
		return
	end

	-- Jalan terus ke arah karakter menghadap
	humanoid:Move(
		root.CFrame.LookVector,
		false
	)

	-- Rintangan di depan
	if detectObstacle() then
		tryJump()
	end

	-- Lubang kecil / perubahan permukaan
	if not detectGround() then
		tryJump()
	end

end)
