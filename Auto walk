--==================================================
-- TIME FORMAT
--==================================================

local function FormatTime(seconds)
	seconds = math.max(0, seconds or 0)

	local hours = math.floor(seconds / 3600)
	local minutes = math.floor((seconds % 3600) / 60)
	local secs = math.floor(seconds % 60)

	return string.format("%02d:%02d:%02d", hours, minutes, secs)
end

--==================================================
-- CHECKPOINT DETECTION
--==================================================

local function IsCheckpoint(part)
	if not part or not part:IsA("BasePart") then
		return false
	end

	local name = string.lower(part.Name)

	return
		name:match("^cp%d+$")
		or name:match("^checkpoint%d+$")
		or name == "checkpoint"
end

local function GetCheckpointNear(position)
	local closest = nil
	local closestDistance = CHECKPOINT_RADIUS

	for _, obj in ipairs(workspace:GetDescendants()) do
		if IsCheckpoint(obj) then
			local distance = (obj.Position - position).Magnitude

			if distance <= closestDistance then
				closestDistance = distance
				closest = obj
			end
		end
	end

	return closest
end

local function HasCheckpoint(part)
	for _, cp in ipairs(Checkpoints) do
		if cp.Part == part then
			return true
		end
	end

	return false
end

