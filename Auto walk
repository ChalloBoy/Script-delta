--------------------------------------------------
-- CHECKPOINT DETECTION
--------------------------------------------------

local CheckpointTouched = {}

local function ConnectCheckpoint(part)

	if not part:IsA("BasePart") then
		return
	end

	local lower = string.lower(part.Name)

	if not (
		string.find(lower,"checkpoint")
		or string.match(lower,"^cp")
	) then
		return
	end

	if CheckpointTouched[part] then
		return
	end

	CheckpointTouched[part] = true

	part.Touched:Connect(function(hit)

		if not Recording then
			return
		end

		if not Character then
			return
		end

		if not hit:IsDescendantOf(Character) then
			return
		end

		-- CEK CP YANG SAMA
		for _, cp in ipairs(Checkpoints) do
			if cp.Part == part then
				return
			end
		end

		if not Root then
			return
		end

		table.insert(Checkpoints,{
			Part = part,
			CFrame = Root.CFrame,
			Time = RecordTime,
			FrameIndex = #Frames
		})

		Status.Text = "CP "..#Checkpoints.." saved"

		RefreshList()

	end)
end

for _, obj in ipairs(workspace:GetDescendants()) do
