--// RECORD + CHECKPOINT REPLAY
--// LocalScript
--// StarterPlayer > StarterPlayerScripts

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")

local Player = Players.LocalPlayer

local Character
local Humanoid
local Root

local Recording = false
local Replaying = false

local Frames = {}
local Checkpoints = {}
local CurrentCheckpoint = 0

local RecordConnection
local ReplayConnection

local SAMPLE_RATE = 0.05 -- semakin kecil = semakin halus
local lastSample = 0

--------------------------------------------------
-- CHARACTER
--------------------------------------------------

local function SetupCharacter(char)
	Character = char
	Humanoid = char:WaitForChild("Humanoid")
	Root = char:WaitForChild("HumanoidRootPart")

	-- Kalau sedang replay dan respawn,
	-- lanjut dari checkpoint terakhir.
	if Replaying and CurrentCheckpoint > 0 then
		task.wait(0.5)

		local cp = Checkpoints[CurrentCheckpoint]

		if cp then
			Root.CFrame = cp.CFrame
		end

		task.wait(0.2)

		-- lanjut replay dari checkpoint
		-- (dipanggil lagi setelah character siap)
	end
end

if Player.Character then
	SetupCharacter(Player.Character)
end

Player.CharacterAdded:Connect(SetupCharacter)

--------------------------------------------------
-- CHECKPOINT DETECTION
--------------------------------------------------

local function IsCheckpoint(part)
	if not part:IsA("BasePart") then
		return false
	end

	-- Bisa menggunakan nama:
	-- Checkpoint
	-- CP
	-- Checkpoint1
	-- CP1
	return string.find(string.lower(part.Name), "checkpoint")
		or string.match(string.lower(part.Name), "^cp")
end

local function SaveCheckpoint()
	if not Root then return end

	CurrentCheckpoint += 1

	Checkpoints[CurrentCheckpoint] = {
		CFrame = Root.CFrame,
		FrameIndex = #Frames + 1
	}

	print("Checkpoint tersimpan:", CurrentCheckpoint)

	Status.Text = "Checkpoint: " .. CurrentCheckpoint
end

--------------------------------------------------
-- DETECT CHECKPOINT
--------------------------------------------------

local CheckpointDebounce = {}

workspace.DescendantAdded:Connect(function(obj)
	if IsCheckpoint(obj) then
		obj.Touched:Connect(function(hit)
			if not Character then return end
			if hit:IsDescendantOf(Character) then

				if not CheckpointDebounce[obj] then
					CheckpointDebounce[obj] = true

					SaveCheckpoint()

					task.delay(1, function()
						CheckpointDebounce[obj] = nil
					end)
				end
			end
		end)
	end
end)

-- checkpoint yang sudah ada saat script mulai
for _, obj in ipairs(workspace:GetDescendants()) do
	if IsCheckpoint(obj) then

		obj.Touched:Connect(function(hit)
			if not Character then return end

			if hit:IsDescendantOf(Character) then
				if not CheckpointDebounce[obj] then
					CheckpointDebounce[obj] = true

					SaveCheckpoint()

					task.delay(1, function()
						CheckpointDebounce[obj] = nil
					end)
				end
			end
		end)

	end
end

--------------------------------------------------
-- RECORD
--------------------------------------------------

local function StartRecord()

	if not Root then return end

	Frames = {}
	Checkpoints = {}
	CurrentCheckpoint = 0

	Recording = true
	Replaying = false

	Status.Text = "Recording..."

	if ReplayConnection then
		ReplayConnection:Disconnect()
		ReplayConnection = nil
	end

	if RecordConnection then
		RecordConnection:Disconnect()
	end

	lastSample = 0

	RecordConnection = RunService.Heartbeat:Connect(function(dt)

		if not Recording then return end
		if not Character or not Root then return end

		lastSample += dt

		if lastSample >= SAMPLE_RATE then
			lastSample = 0

			table.insert(Frames, {
				Time = os.clock(),
				CFrame = Root.CFrame
			})
		end
	end)
end

local function StopRecord()

	Recording = false

	if RecordConnection then
		RecordConnection:Disconnect()
		RecordConnection = nil
	end

	Status.Text = "Recorded: " .. #Frames .. " frames"

	print("Record selesai:", #Frames)
	print("Checkpoint:", #Checkpoints)
end

--------------------------------------------------
-- FIND FRAME
--------------------------------------------------

local function GetStartFrame()

	if CurrentCheckpoint > 0 then
		local cp = Checkpoints[CurrentCheckpoint]

		if cp then
			return cp.FrameIndex
		end
	end

	return 1
end

--------------------------------------------------
-- REPLAY
--------------------------------------------------

local function StopReplay()

	Replaying = false

	if ReplayConnection then
		ReplayConnection:Disconnect()
		ReplayConnection = nil
	end

	Status.Text = "Replay stopped"
end

local function StartReplay()

	if #Frames == 0 then
		Status.Text = "Belum ada record!"
		return
	end

	Recording = false
	Replaying = true

	if RecordConnection then
		RecordConnection:Disconnect()
		RecordConnection = nil
	end

	if ReplayConnection then
		ReplayConnection:Disconnect()
	end

	local frameIndex = GetStartFrame()

	Status.Text = "Replay dari CP " .. CurrentCheckpoint

	local startTime = os.clock()
	local firstFrame = Frames[frameIndex]

	if not firstFrame then
		StopReplay()
		return
	end

	-- posisi awal
	if Root then
		Root.CFrame = firstFrame.CFrame
	end

	ReplayConnection = RunService.Heartbeat:Connect(function()

		if not Replaying then return end
		if not Character or not Root or not Humanoid then return end

		local elapsed = os.clock() - startTime

		local frame = Frames[frameIndex]

		if not frame then
			StopReplay()
			Status.Text = "Replay selesai!"
			return
		end

		-- cari frame berdasarkan waktu
		while frameIndex < #Frames do

			local nextFrame = Frames[frameIndex + 1]

			if nextFrame.Time - firstFrame.Time <= elapsed then
				frameIndex += 1
				frame = Frames[frameIndex]
			else
				break
			end
		end

		if frame then
			Root.CFrame = frame.CFrame
		end

		-- sudah selesai
		if frameIndex >= #Frames then
			StopReplay()
			Status.Text = "Replay selesai!"
		end
	end)
end

--------------------------------------------------
-- RESPAWN / JATUH
--------------------------------------------------

Player.CharacterAdded:Connect(function(char)

	Character = char
	Humanoid = char:WaitForChild("Humanoid")
	Root = char:WaitForChild("HumanoidRootPart")

	if Replaying and CurrentCheckpoint > 0 then

		task.wait(0.5)

		local cp = Checkpoints[CurrentCheckpoint]

		if cp then
			Root.CFrame = cp.CFrame

			Status.Text =
				"Respawn CP " .. CurrentCheckpoint
		end

		task.wait(0.3)

		-- replay ulang dari checkpoint terakhir
		StartReplay()
	end
end)

