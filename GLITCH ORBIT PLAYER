    orbitButton.Text = orbiting and "◎  ORBIT: ON" or "◎  ORBIT: OFF"
    orbitButton.BackgroundColor3 =
        orbiting
        and Color3.fromRGB(25, 70, 78)
        or Color3.fromRGB(13, 17, 23)

    orbitInfo.Text =
        orbiting
        and "Orbit is running around the selected target."
        or "Orbit stopped."
