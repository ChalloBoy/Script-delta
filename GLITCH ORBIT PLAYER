local function ClearPlayers()

	for _, object in ipairs(playerList:GetChildren()) do
		if object:IsA("GuiObject") then
			object:Destroy()
		end
	end
end

local function updateProfile(player)
    if not player then
        targetAvatar.Image = ""
        profileDisplay.Text = "No target selected"
        profileUsername.Text = "@username"
        targetLabel.Text = "🎯  TARGET: NONE"
        orbitStatus.Text = "◎  TARGET: NONE"
        orbitHint.Text = "Select a target in TARGET first."
        return
    end

    profileDisplay.Text = player.DisplayName
    profileUsername.Text = "@" .. player.Name
    targetLabel.Text =
        "🎯  TARGET: "
        .. player.DisplayName
        .. "  @"
        .. player.Name
    orbitStatus.Text =
        "◎  TARGET: "
        .. player.DisplayName
        .. "  @"
        .. player.Name
    orbitHint.Text = "Target selected. Open Orbit to control it."

    task.spawn(function()
        local ok, image = pcall(function()
            return Players:GetUserThumbnailAsync(
                player.UserId,
                Enum.ThumbnailType.HeadShot,
                Enum.ThumbnailSize.Size180x180
            )
        end)

        if ok and targetPlayer == player then
            targetAvatar.Image = image
        end
    end)
end

local function SelectTarget(player)

    targetPlayer = player
    updateProfile(player)

    -- Reset active state when changing target.
    stopOrbit()
    spectating = false
    spectateBtn.Text = "◉  SPECTATE: OFF"
    spectateBtn.BackgroundColor3 = Color3.fromRGB(13, 17, 23)
    applySpectate()
end

local function AddPlayer(player)

    local button = New("TextButton", {
        Size = UDim2.new(1, 0, 0, 58),
        BackgroundColor3 = Color3.fromRGB(13, 17, 23),
        BackgroundTransparency = 0.05,
        Text = "@" .. player.Name,
        TextColor3 = Color3.fromRGB(240, 248, 255),
        TextSize = 15,
        TextXAlignment = Enum.TextXAlignment.Left,
        Font = Enum.Font.GothamBold,
        AutoButtonColor = false,
        ZIndex = 34
    }, playerList)

    Corner(button, 10)
    Stroke(button, 1, 0.42)

    New("UIPadding", {
        PaddingLeft = UDim.new(0, 16),
        PaddingRight = UDim.new(0, 12)
    }, button)

    button.MouseButton1Click:Connect(function()
        Click()
        SelectTarget(player)

        for _, item in ipairs(playerList:GetChildren()) do
            if item:IsA("TextButton") then
                item.BackgroundColor3 = Color3.fromRGB(13, 17, 23)
            end
        end
        button.BackgroundColor3 = Color3.fromRGB(25, 40, 48)
    end)
end

local function RefreshPlayers()

	ClearPlayers()

	local query = string.lower(search.Text)

	for _, player in ipairs(Players:GetPlayers()) do

		if player ~= LocalPlayer then

			local username =
				string.lower(player.Name)

			local display =
				string.lower(player.DisplayName)

			local matches =
				query == ""
				or string.find(username, query, 1, true)
				or string.find(display, query, 1, true)

			if matches then
				AddPlayer(player)
			end
		end
	end
end

search:GetPropertyChangedSignal("Text"):Connect(
	RefreshPlayers
)

Players.PlayerAdded:Connect(
	RefreshPlayers
)

Players.PlayerRemoving:Connect(function(player)

    if targetPlayer == player then
        targetPlayer = nil
        stopOrbit()
        spectating = false

        spectateBtn.Text = "◉  SPECTATE: OFF"
        spectateBtn.BackgroundColor3 = Color3.fromRGB(13, 17, 23)

        updateProfile(nil)
        applySpectate()
    end

    RefreshPlayers()
end)

