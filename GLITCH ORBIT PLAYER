local trail

local function SetupTrail()

	local character = LocalPlayer.Character

	if not character then
		return
	end

	local root =
		character:FindFirstChild("HumanoidRootPart")

	if not root then
		return
	end

	if trail then
		trail:Destroy()
	end

	local attachment0 = New("Attachment", {
		Position = Vector3.new(0, 1.5, 0)
	}, root)

	local attachment1 = New("Attachment", {
		Position = Vector3.new(0, -1.5, 0)
	}, root)

	trail = New("Trail", {
		Attachment0 = attachment0,
		Attachment1 = attachment1,
		Lifetime = 0.2,
		MinLength = 0.05,
		FaceCamera = true,
		Enabled = trailEnabled
	}, root)
end

LocalPlayer.CharacterAdded:Connect(function()

	task.wait(1)

	SetupTrail()
end)

SetupTrail()

task.spawn(function()

	while gui.Parent do

		if trail then
			trail.Enabled = trailEnabled
		end

		task.wait(0.1)
	end
end)

--========================================================
-- ORBIT
--========================================================

local lastAfterimage = 0

RunService.RenderStepped:Connect(function(delta)

	if not orbitEnabled then
		return
	end

	if not targetPlayer then
		return
	end

	local character =
		LocalPlayer.Character

	local targetCharacter =
		targetPlayer.Character

	if not character or not targetCharacter then
		return
	end

	local root =
		character:FindFirstChild("HumanoidRootPart")

	local targetRoot =
		targetCharacter:FindFirstChild("HumanoidRootPart")

	if not root or not targetRoot then
		return
	end

	local multiplier =
		superTP and 5 or 1

	orbitAngle +=
		math.rad(orbitSpeed)
		* multiplier
		* delta

	local x =
		math.cos(orbitAngle)
		* orbitDistance

	local z =
		math.sin(orbitAngle)
		* orbitDistance

	local gx = 0
	local gy = 0
	local gz = 0

	if glitchFX then

		local t = os.clock()

		gx = math.sin(t * 43) * 0.15
		gy = math.sin(t * 67) * 0.10
		gz = math.cos(t * 51) * 0.15

	end

	local position =
		targetRoot.Position
		+ Vector3.new(
			x + gx,
			gy,
			z + gz
		)

	root.CFrame =
		CFrame.lookAt(
			position,
			targetRoot.Position
		)

	if afterimageEnabled
		and os.clock() - lastAfterimage > 0.055 then

		lastAfterimage = os.clock()

		Afterimage(character)
	end
end)

