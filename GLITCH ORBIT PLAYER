--[[
    Orbit Head GUI — Auto-Clean Target Disconnects
    Features:
    - Auto-removes target from UI on disconnect
    - Toast notification popups
    - Working search filter & smooth sliders
    - Press 'P' to toggle visibility
]]

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")
local TweenService = game:GetService("TweenService")
local CoreGui = game:GetService("CoreGui")
local lp = Players.LocalPlayer

local state = {
    orbiting = false,
    spectating = false,
    speed = 2,
    radius = 6,
    height = 0,
    angle = 0,
}

local C = {
    bg      = Color3.fromRGB(25, 27, 33),
    panel   = Color3.fromRGB(34, 37, 46),
    accent  = Color3.fromRGB(0, 180, 255),
    text    = Color3.fromRGB(220, 222, 228),
    dim     = Color3.fromRGB(140, 143, 153),
    ok      = Color3.fromRGB(80, 220, 120),
    danger  = Color3.fromRGB(255, 90, 90),
}

local function make(class, props, parent)
    local i = Instance.new(class)
    for k, v in pairs(props) do i[k] = v end
    if parent then i.Parent = parent end
    return i
end

-- ===== ORBIT LOOP =====
local orbitConn
orbitConn = RunService.RenderStepped:Connect(function(dt)
    if not state.orbiting then return end
    local target = state.target
    local char = lp.Character
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    if not target or not target.Character or not hrp then return end
    local head = target.Character:FindFirstChild("Head") or target.Character:FindFirstChild("HumanoidRootPart")
    if not head then return end

    state.angle = state.angle + dt * state.speed
    local a = state.angle
    local pos = head.Position + Vector3.new(math.cos(a) * state.radius, state.height, math.sin(a) * state.radius)
    hrp.CFrame = CFrame.new(pos, head.Position)
    hrp.AssemblyLinearVelocity = Vector3.zero
    hrp.Velocity = Vector3.zero
end)


