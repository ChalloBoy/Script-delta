local function getLocalHumanoid()
    local character = LocalPlayer.Character
    return character and character:FindFirstChildOfClass("Humanoid")
end

local function applySpectate()
    local camera = workspace.CurrentCamera

    if not camera then
        return
    end

    if spectating and targetPlayer and targetPlayer.Character then
        camera.CameraSubject =
            targetPlayer.Character:FindFirstChild("Head")
            or targetPlayer.Character:FindFirstChildOfClass("Humanoid")
    else
        local humanoid = getLocalHumanoid()
        if humanoid then
            camera.CameraSubject = humanoid
        end
    end
end

local function stopOrbit()
    orbiting = false
    orbitAngle = 0
    orbitBtn.Text = "◎  ORBIT: OFF"
    orbitBtn.BackgroundColor3 = Color3.fromRGB(13, 17, 23)
end

orbitBtn.Activated:Connect(function()
