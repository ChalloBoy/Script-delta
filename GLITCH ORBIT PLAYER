end)

orbitConnection = RunService.RenderStepped:Connect(function(dt)
    if not orbiting then
        return
    end

    local target = targetPlayer
    local character = LocalPlayer.Character
    local hrp = character and character:FindFirstChild("HumanoidRootPart")

    if not target or not target.Character or not hrp then
        return
    end

    local head =
        target.Character:FindFirstChild("Head")
        or target.Character:FindFirstChild("HumanoidRootPart")

    if not head then
        return
    end

    orbitAngle = orbitAngle + dt * orbitSpeed

    local position =
        head.Position
        + Vector3.new(
            math.cos(orbitAngle) * orbitRadius,
            orbitHeight,
            math.sin(orbitAngle) * orbitRadius
        )

    hrp.CFrame = CFrame.new(position, head.Position)
    hrp.AssemblyLinearVelocity = Vector3.zero
    hrp.AssemblyAngularVelocity = Vector3.zero

    orbitStatus.Text =
        "◎  ORBITING: " .. targetPlayer.DisplayName .. "  @" .. targetPlayer.Name
end

