local function CreateToggle(text, default, callback, order)
	local button = Create("TextButton", {
		Size = UDim2.new(1, -10, 0, 42),
		BackgroundColor3 = Color3.fromRGB(13, 15, 21),
		BackgroundTransparency = 0.08,
		Text = "",
		AutoButtonColor = false,
		LayoutOrder = order,
		ZIndex = 6
	}, scroll)

	AddCorner(button, 10)
	AddStroke(button, 1, 0.45)

	Create("TextLabel", {
		Position = UDim2.fromOffset(13, 0),
		Size = UDim2.new(0.7, 0, 1, 0),
		BackgroundTransparency = 1,
		Text = text,
		TextColor3 = Color3.fromRGB(235, 235, 240),
		TextSize = 14,
		TextXAlignment = Enum.TextXAlignment.Left,
		Font = Enum.Font.GothamBold,
		ZIndex = 7
	}, button)

	local state = default

	local stateLabel = Create("TextLabel", {
		AnchorPoint = Vector2.new(1, 0.5),
		Position = UDim2.new(1, -12, 0.5, 0),
		Size = UDim2.fromOffset(65, 27),
		BackgroundTransparency = 1,
		Text = state and "ON" or "OFF",
		TextColor3 = state
			and Color3.fromRGB(90, 255, 180)
			or Color3.fromRGB(255, 100, 110),
		TextSize = 12,
		Font = Enum.Font.GothamBlack,
		ZIndex = 7
	}, button)

	button.MouseButton1Click:Connect(function()
		PlayClick()

		state = not state

		stateLabel.Text = state and "ON" or "OFF"
		stateLabel.TextColor3 = state
			and Color3.fromRGB(90, 255, 180)
			or Color3.fromRGB(255, 100, 110)

		callback(state)
	end)

	return button
end

