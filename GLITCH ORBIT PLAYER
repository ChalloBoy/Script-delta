    if not targetPlayer then
        stopOrbit()
        orbitStatus.Text = "◎  TARGET: NONE"
        orbitHint.Text = "Select a target in TARGET first."
        return
    end

    orbiting = not orbiting

    if orbiting then
        orbitAngle = 0
        orbitBtn.Text = "◎  ORBIT: ON"
        orbitBtn.BackgroundColor3 = Color3.fromRGB(25, 70, 78)
        orbitHint.Text = "Orbiting around the selected target."
    else
