local function Toggle(text, default, callback, order)

	local button = New("TextButton", {
		Size = UDim2.new(1, 0, 0, 52),
		BackgroundColor3 = Color3.fromRGB(13, 17, 23),
		BackgroundTransparency = 0.08,
		Text = "",
		AutoButtonColor = false,
		LayoutOrder = order,
		ZIndex = 33
	}, systemScroll)

	Corner(button, 10)
	Stroke(button, 1, 0.4)

	New("TextLabel", {
		Position = UDim2.fromOffset(15, 0),
		Size = UDim2.new(0.7, 0, 1, 0),
		BackgroundTransparency = 1,
		Text = text,
		TextColor3 = Color3.fromRGB(240, 240, 245),
		TextSize = 14,
		TextXAlignment = Enum.TextXAlignment.Left,
		Font = Enum.Font.GothamBold,
		ZIndex = 34
	}, button)

	local state = default

	local status = New("TextLabel", {
		AnchorPoint = Vector2.new(1, 0.5),
		Position = UDim2.new(1, -14, 0.5, 0),
		Size = UDim2.fromOffset(65, 30),
		BackgroundTransparency = 1,
		Text = state and "ON" or "OFF",
		TextColor3 = state
			and Color3.fromRGB(80, 255, 175)
			or Color3.fromRGB(255, 100, 115),
		TextSize = 12,
		Font = Enum.Font.GothamBlack,
		ZIndex = 34
	}, button)

	button.MouseButton1Click:Connect(function()

		Click()

		state = not state

		status.Text = state and "ON" or "OFF"
		status.TextColor3 = state
			and Color3.fromRGB(80, 255, 175)
			or Color3.fromRGB(255, 100, 115)

		callback(state)
	end)
end

--========================================================
-- SLIDER
--========================================================

local function Slider(text, minValue, maxValue, defaultValue, callback, order)

	local holder = New("Frame", {
		Size = UDim2.new(1, 0, 0, 68),
		BackgroundColor3 = Color3.fromRGB(13, 17, 23),
		BackgroundTransparency = 0.08,
		LayoutOrder = order,
		ZIndex = 33
	}, systemScroll)

	Corner(holder, 10)
	Stroke(holder, 1, 0.4)

	New("TextLabel", {
		Position = UDim2.fromOffset(14, 5),
		Size = UDim2.new(0.7, 0, 0, 25),
		BackgroundTransparency = 1,
		Text = text,
		TextColor3 = Color3.fromRGB(240, 240, 245),
		TextSize = 14,
		TextXAlignment = Enum.TextXAlignment.Left,
		Font = Enum.Font.GothamBold,
		ZIndex = 34
	}, holder)

	local valueText = New("TextLabel", {
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.new(1, -14, 0, 5),
		Size = UDim2.fromOffset(75, 25),
		BackgroundTransparency = 1,
		Text = tostring(defaultValue),
		TextColor3 = Color3.fromRGB(100, 240, 255),
		TextSize = 13,
		Font = Enum.Font.GothamBlack,
		ZIndex = 34
	}, holder)

	local bar = New("Frame", {
		Position = UDim2.new(0, 14, 1, -22),
		Size = UDim2.new(1, -28, 0, 8),
		BackgroundColor3 = Color3.fromRGB(42, 45, 53),
		BorderSizePixel = 0,
		ZIndex = 34
	}, holder)

	Corner(bar, 8)

	local percent =
		(defaultValue - minValue) /
		(maxValue - minValue)

	local fill = New("Frame", {
		Size = UDim2.new(percent, 0, 1, 0),
		BackgroundColor3 = Color3.fromRGB(95, 235, 255),
		BorderSizePixel = 0,
		ZIndex = 35
	}, bar)

	Corner(fill, 8)

	local dragging = false

	local function SetValue(x)

		local pct = math.clamp(
			(x - bar.AbsolutePosition.X) /
			bar.AbsoluteSize.X,
			0,
			1
		)

		local value =
			minValue +
			(maxValue - minValue) * pct

		value = math.floor(value * 10 + 0.5) / 10

		fill.Size = UDim2.new(pct, 0, 1, 0)
		valueText.Text = tostring(value)

		callback(value)
	end

	bar.InputBegan:Connect(function(input)

		if input.UserInputType == Enum.UserInputType.MouseButton1
			or input.UserInputType == Enum.UserInputType.Touch then

			dragging = true
			SetValue(input.Position.X)
		end
	end)

	UserInputService.InputChanged:Connect(function(input)

		if dragging and (
			input.UserInputType == Enum.UserInputType.MouseMovement
			or input.UserInputType == Enum.UserInputType.Touch
		) then

			SetValue(input.Position.X)
		end
	end)

	UserInputService.InputEnded:Connect(function(input)

		if input.UserInputType == Enum.UserInputType.MouseButton1
			or input.UserInputType == Enum.UserInputType.Touch then

			dragging = false
		end
	end)
end

