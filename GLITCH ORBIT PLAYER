spectateButton.Activated:Connect(function()
    Click()

    local camera = workspace.CurrentCamera

    if not targetPlayer then
        spectating = false
        spectateButton.Text = "◉  SPECTATE: OFF"
        spectateButton.BackgroundColor3 = Color3.fromRGB(13, 17, 23)

        local humanoid = LocalPlayer.Character
            and LocalPlayer.Character:FindFirstChildOfClass("Humanoid")

        if camera and humanoid then
            camera.CameraSubject = humanoid
        end

        orbitInfo.Text = "Select a player in TARGET first."
        return
    end

    spectating = not spectating
    spectateButton.Text =
        "◉  SPECTATE: " .. (spectating and "ON" or "OFF")

    spectateButton.BackgroundColor3 =
        spectating
        and Color3.fromRGB(25, 60, 78)
        or Color3.fromRGB(13, 17, 23)

    if camera then
        if spectating and targetPlayer.Character then
            camera.CameraSubject =
                targetPlayer.Character:FindFirstChild("Head")
                or targetPlayer.Character:FindFirstChildOfClass("Humanoid")
        else
            local humanoid = LocalPlayer.Character
                and LocalPlayer.Character:FindFirstChildOfClass("Humanoid")

            if humanoid then
                camera.CameraSubject = humanoid
            end
        end
    end
end)

RunService.RenderStepped:Connect(function(dt)
    if not orbiting or not targetPlayer then
        return
    end

    local character = LocalPlayer.Character
    local targetCharacter = targetPlayer.Character

    if not character or not targetCharacter then
        return
    end

    local root = character:FindFirstChild("HumanoidRootPart")
    local targetRoot =
        targetCharacter:FindFirstChild("HumanoidRootPart")
        or targetCharacter:FindFirstChild("Head")

    if not root or not targetRoot then
        return
    end

    orbitAngle += dt * orbitSpeed

    local position =
        targetRoot.Position
        + Vector3.new(
            math.cos(orbitAngle) * orbitRadius,
            orbitHeight,
            math.sin(orbitAngle) * orbitRadius
        )

    root.CFrame = CFrame.lookAt(position, targetRoot.Position)
    root.AssemblyLinearVelocity = Vector3.zero
    root.AssemblyAngularVelocity = Vector3.zero

    orbitTargetLabel.Text =
        "◎  ORBITING: "
        .. targetPlayer.DisplayName
        .. "  @"
        .. targetPlayer.Name
end)

