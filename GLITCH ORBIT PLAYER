local function CreateSlider(text, minValue, maxValue, defaultValue, callback, order)
	local holder = Create("Frame", {
		Size = UDim2.new(1, -10, 0, 58),
		BackgroundColor3 = Color3.fromRGB(13, 15, 21),
		BackgroundTransparency = 0.08,
		LayoutOrder = order,
		ZIndex = 6
	}, scroll)

	AddCorner(holder, 10)
	AddStroke(holder, 1, 0.45)

	Create("TextLabel", {
		Position = UDim2.fromOffset(12, 4),
		Size = UDim2.new(0.65, 0, 0, 23),
		BackgroundTransparency = 1,
		Text = text,
		TextColor3 = Color3.fromRGB(235, 235, 240),
		TextSize = 13,
		TextXAlignment = Enum.TextXAlignment.Left,
		Font = Enum.Font.GothamBold,
		ZIndex = 7
	}, holder)

	local valueLabel = Create("TextLabel", {
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.new(1, -12, 0, 4),
		Size = UDim2.fromOffset(65, 23),
		BackgroundTransparency = 1,
		Text = tostring(defaultValue),
		TextColor3 = Color3.fromRGB(165, 255, 255),
		TextSize = 13,
		Font = Enum.Font.GothamBold,
		ZIndex = 7
	}, holder)

	local bar = Create("Frame", {
		Position = UDim2.new(0, 12, 1, -18),
		Size = UDim2.new(1, -24, 0, 7),
		BackgroundColor3 = Color3.fromRGB(43, 45, 54),
		BorderSizePixel = 0,
		ZIndex = 7
	}, holder)

	AddCorner(bar, 5)

	local fill = Create("Frame", {
		Size = UDim2.new(
			(defaultValue - minValue) / (maxValue - minValue),
			0, 1, 0
		),
		BackgroundColor3 = Color3.fromRGB(120, 240, 255),
		BorderSizePixel = 0,
		ZIndex = 8
	}, bar)

	AddCorner(fill, 5)

	local draggingSlider = false

	local function setValue(x)
		local percentage = math.clamp(
			(x - bar.AbsolutePosition.X) / bar.AbsoluteSize.X,
			0,
			1
		)

		local value = minValue + (maxValue - minValue) * percentage
		value = math.floor(value * 10 + 0.5) / 10

		fill.Size = UDim2.new(percentage, 0, 1, 0)
		valueLabel.Text = tostring(value)

		callback(value)
	end

	bar.InputBegan:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1
			or input.UserInputType == Enum.UserInputType.Touch then

			draggingSlider = true
			setValue(input.Position.X)
		end
	end)

	UserInputService.InputChanged:Connect(function(input)
		if draggingSlider and (
			input.UserInputType == Enum.UserInputType.MouseMovement
			or input.UserInputType == Enum.UserInputType.Touch
		) then
			setValue(input.Position.X)
		end
	end)

	UserInputService.InputEnded:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1
			or input.UserInputType == Enum.UserInputType.Touch then
			draggingSlider = false
		end
	end)
end

