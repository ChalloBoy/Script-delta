local function refresh()
    for _,v in ipairs(list:GetChildren()) do if v:IsA("TextButton") then v:Destroy() end end
    local q=string.lower(search.Text or "")
    for _,p in ipairs(Players:GetPlayers()) do
        if p~=LP then
            local f=string.lower(p.DisplayName.." "..p.Name)
            if q=="" or string.find(f,q,1,true) then
                local b=Instance.new("TextButton",list)
                b.Size=UDim2.new(1,-4,0,44); b.BackgroundColor3=Color3.fromRGB(17,21,30)
                b.BorderSizePixel=0; b.Text=p.DisplayName.."  @"..p.Name; b.Font=Enum.Font.GothamMedium
                b.TextColor3=Color3.fromRGB(225,232,242); b.TextScaled=true; b.TextXAlignment=Enum.TextXAlignment.Left
                b.AutoButtonColor=false; C(b,12); S(b,1,.34)
                local bp=Instance.new("UIPadding",b); bp.PaddingLeft=UDim.new(0,14)
                b.MouseButton1Click:Connect(function()
                    currentTarget=p
                    selected.Text="Target: "..p.DisplayName.."  @"..p.Name
                    for _,x in ipairs(list:GetChildren()) do
                        if x:IsA("TextButton") then T(x,.12,{BackgroundColor3=Color3.fromRGB(17,21,30)}) end
                    end
                    T(b,.12,{BackgroundColor3=Color3.fromRGB(29,76,97)})
                end)
            end
        end
    end
end

search:GetPropertyChangedSignal("Text"):Connect(refresh)
Players.PlayerAdded:Connect(refresh)
Players.PlayerRemoving:Connect(function(p)
    if currentTarget==p then currentTarget=nil; selected.Text="Target: None" end
    refresh()
end)
