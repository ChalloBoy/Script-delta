--========================================================
-- AFTERIMAGE
--========================================================

local function CreateAfterimage(character)
	if not character or not character.Parent then
		return
	end

	local clone = character:Clone()

	for _, object in ipairs(clone:GetDescendants()) do

		if object:IsA("Script")
			or object:IsA("LocalScript")
			or object:IsA("ModuleScript") then

			object:Destroy()

		elseif object:IsA("BasePart") then

			object.Anchored = true
			object.CanCollide = false
			object.CanTouch = false
			object.CanQuery = false
			object.Transparency = 0.75

		elseif object:IsA("Decal") then
			object.Transparency = 0.75
		end
	end

	clone.Parent = workspace

	task.delay(0.22, function()
		if clone and clone.Parent then
			clone:Destroy()
		end
	end)
end

--========================================================
-- TRAIL
--========================================================

local trail
local trailA
local trailB

local function SetupTrail()
	local character = LocalPlayer.Character

	if not character then
		return
	end

	local root = character:FindFirstChild("HumanoidRootPart")

	if not root then
		return
	end

	if trail then
		trail:Destroy()
	end

	if trailA then
		trailA:Destroy()
	end

	if trailB then
		trailB:Destroy()
	end

	trailA = Create("Attachment", {
		Position = Vector3.new(0, 1.4, 0)
	}, root)

	trailB = Create("Attachment", {
		Position = Vector3.new(0, -1.4, 0)
	}, root)

	trail = Create("Trail", {
		Attachment0 = trailA,
		Attachment1 = trailB,
		Lifetime = 0.18,
		MinLength = 0.05,
		FaceCamera = true,
		Enabled = trailEnabled
	}, root)
end

LocalPlayer.CharacterAdded:Connect(function()
	task.wait(1)
	SetupTrail()
end)

SetupTrail()

task.spawn(function()
	while gui.Parent do
		if trail then
			trail.Enabled = trailEnabled
		end

		task.wait(0.1)
	end
end)

--========================================================
-- ORBIT SYSTEM
--========================================================

local lastAfterimage = 0

RunService.RenderStepped:Connect(function(deltaTime)

	if not orbitEnabled then
		return
	end

	if not targetPlayer then
		return
	end

	local character = LocalPlayer.Character
	local targetCharacter = targetPlayer.Character

	if not character or not targetCharacter then
		return
	end

	local root = character:FindFirstChild("HumanoidRootPart")
	local targetRoot = targetCharacter:FindFirstChild("HumanoidRootPart")

	if not root or not targetRoot then
		return
	end

	local multiplier = superTP and 5 or 1

	orbitAngle +=
		math.rad(orbitSpeed)
		* multiplier
		* deltaTime

	-- Orbit circle
	local x = math.cos(orbitAngle) * orbitDistance
	local z = math.sin(orbitAngle) * orbitDistance

	-- Glitch movement
	local glitchX = 0
	local glitchY = 0
	local glitchZ = 0

	if glitchFX then
		local time = os.clock()

		glitchX = math.sin(time * 43) * 0.13
		glitchY = math.sin(time * 61) * 0.09
		glitchZ = math.cos(time * 47) * 0.13
	end

	local position =
		targetRoot.Position
		+ Vector3.new(
			x + glitchX,
			glitchY,
			z + glitchZ
		)

	root.CFrame = CFrame.lookAt(
		position,
		targetRoot.Position
	)

	-- Afterimage
	if afterimageEnabled and os.clock() - lastAfterimage > 0.055 then
		lastAfterimage = os.clock()
		CreateAfterimage(character)
	end
end)

