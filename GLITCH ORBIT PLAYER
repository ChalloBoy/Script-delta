task.spawn(function()
    local startedAt = os.clock()

    for i = 0, 100, 1 do
        loadingText.Text = "LOADING " .. i .. "%"

        local elapsed = os.clock() - startedAt
        local targetTime = (i / 100) * 8
        local waitTime = targetTime - elapsed

        if waitTime > 0 then
            task.wait(waitTime)
        else
            task.wait()
        end
    end

    loadingText.Text = "LOADING 100%"

    local remaining = 8 - (os.clock() - startedAt)
    if remaining > 0 then
        task.wait(remaining)
    end

    Tween(loadingGui, 0.25, {
        BackgroundTransparency = 1
    })

    Tween(loadingText, 0.25, {
        TextTransparency = 1
    })

    task.wait(0.28)
    loadingGui:Destroy()
end)

