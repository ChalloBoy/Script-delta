        Position = UDim2.new(1, -12, 0, 8),
        Size = UDim2.new(0.30, 0, 0, 20),
        BackgroundTransparency = 1,
        Text = tostring(startValue),
        TextColor3 = Color3.fromRGB(125, 235, 255),
        TextSize = 13,
        TextXAlignment = Enum.TextXAlignment.Right,
        Font = Enum.Font.GothamBlack,
        ZIndex = 34
    }, card)

    local bar = New("TextButton", {
        Position = UDim2.fromOffset(12, 42),
        Size = UDim2.new(1, -24, 0, 10),
        BackgroundColor3 = Color3.fromRGB(40, 47, 57),
        Text = "",
        AutoButtonColor = false,
        ZIndex = 34
    }, card)
    Corner(bar, 5)

    local fill = New("Frame", {
        Size = UDim2.new((startValue - minValue) / (maxValue - minValue), 0, 1, 0),
        BackgroundColor3 = Color3.fromRGB(90, 215, 245),
        BorderSizePixel = 0,
        ZIndex = 35
    }, bar)
    Corner(fill, 5)

    local knob = New("Frame", {
        AnchorPoint = Vector2.new(0.5, 0.5),
        Position = UDim2.new((startValue - minValue) / (maxValue - minValue), 0, 0.5, 0),
        Size = UDim2.fromOffset(18, 18),
        BackgroundColor3 = Color3.fromRGB(240, 248, 255),
        BorderSizePixel = 0,
        ZIndex = 36
    }, bar)
    Corner(knob, 9)

    local dragging = false

    local function setValueFromX(x)
        if bar.AbsoluteSize.X <= 0 then
            return
        end

        local ratio = math.clamp(
            (x - bar.AbsolutePosition.X) / bar.AbsoluteSize.X,
            0,
            1
        )

        local raw = minValue + ratio * (maxValue - minValue)
        local value = tonumber(string.format("%." .. decimals .. "f", raw))

        fill.Size = UDim2.new(ratio, 0, 1, 0)
        knob.Position = UDim2.new(ratio, 0, 0.5, 0)
        valueLabel.Text = tostring(value)
        callback(value)
    end

    bar.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1
            or input.UserInputType == Enum.UserInputType.Touch then
            dragging = true
            setValueFromX(input.Position.X)
        end
    end)

    UserInputService.InputChanged:Connect(function(input)
        if dragging and (
            input.UserInputType == Enum.UserInputType.MouseMovement
            or input.UserInputType == Enum.UserInputType.Touch
        ) then
            setValueFromX(input.Position.X)
        end
    end)

    UserInputService.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1
            or input.UserInputType == Enum.UserInputType.Touch then
            dragging = false
        end
    end)

    return valueLabel
end

