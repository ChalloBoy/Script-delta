--==================================================
-- ANIMATION
--==================================================

local FLY_ANIMATION = "125722696765151"
local HOVER_ANIMATION = "88138077358201"

local function stopAnimations()
	if currentFlyTrack then
		pcall(function()
			currentFlyTrack:Stop(0.15)
		end)
		currentFlyTrack = nil
	end

	if currentHoverTrack then
		pcall(function()
			currentHoverTrack:Stop(0.15)
		end)
		currentHoverTrack = nil
	end
end

local function playAnimation(humanoid, id, isHover)
	local anim = Instance.new("Animation")
	anim.AnimationId = "rbxassetid://" .. id

	local track

	pcall(function()
		track = humanoid:LoadAnimation(anim)
	end)

	anim:Destroy()

	if not track then
		return nil
	end

	track.Priority = Enum.AnimationPriority.Action
	track.Looped = true
	track:Play(0.15)

	if isHover then
		currentHoverTrack = track
	else
		currentFlyTrack = track
	end

	return track
end

--==================================================
-- GET MOVEMENT
--==================================================

local function getMovement(humanoid)
	-- MOBILE JOYSTICK
	local move = humanoid.MoveDirection

	if move.Magnitude > 0.05 then
		local flat = Vector3.new(move.X, 0, move.Z)

		if flat.Magnitude > 0 then
			return flat.Unit
		end
	end

	-- PC KEYBOARD
	local camera = workspace.CurrentCamera
	if not camera then
		return Vector3.zero
	end

	local direction = Vector3.zero

	local look = camera.CFrame.LookVector
	local right = camera.CFrame.RightVector

	look = Vector3.new(look.X, 0, look.Z)
	right = Vector3.new(right.X, 0, right.Z)

	if look.Magnitude > 0 then
		look = look.Unit
	end

	if right.Magnitude > 0 then
		right = right.Unit
	end

	if userInputService:IsKeyDown(Enum.KeyCode.W) then
		direction += look
	end

	if userInputService:IsKeyDown(Enum.KeyCode.S) then
		direction -= look
	end

	if userInputService:IsKeyDown(Enum.KeyCode.A) then
		direction -= right
	end

	if userInputService:IsKeyDown(Enum.KeyCode.D) then
		direction += right
	end

	if direction.Magnitude > 0 then
		return direction.Unit
	end

	return Vector3.zero
end

--==================================================
-- STOP FLY
--==================================================

local function stopFly()
	flying = false

	if flyConnection then
		flyConnection:Disconnect()
		flyConnection = nil
	end

	if bv then
		bv:Destroy()
		bv = nil
	end

	if bg then
		bg:Destroy()
		bg = nil
	end

	stopAnimations()

	local character = player.Character
	if character then
		local humanoid = character:FindFirstChildOfClass("Humanoid")

		if humanoid then
			humanoid.AutoRotate = true
			humanoid.PlatformStand = false
		end
	end

	flyBtn.Text = "FLY: OFF"
	flyBtn.BackgroundColor3 = Color3.fromRGB(45, 45, 45)
end

--==================================================
-- START FLY
--==================================================

local function startFly()
	local character = player.Character
	if not character then return end

	local humanoid = character:FindFirstChildOfClass("Humanoid")
	local root = character:FindFirstChild("HumanoidRootPart")

	if not humanoid or not root then
		return
	end

	flying = true

	flyBtn.Text = "FLY: ON"
	flyBtn.BackgroundColor3 = Color3.fromRGB(0, 200, 100)

	-- PENTING:
	-- Tidak memakai PlatformStand agar joystick HP tetap bekerja
	humanoid.PlatformStand = false
	humanoid.AutoRotate = false

	bg = Instance.new("BodyGyro")
	bg.Name = "FlyGyro"
	bg.P = 90000
	bg.D = 500
	bg.MaxTorque = Vector3.new(9e9, 9e9, 9e9)
	bg.CFrame = root.CFrame
	bg.Parent = root

	bv = Instance.new("BodyVelocity")
	bv.Name = "FlyVelocity"
	bv.MaxForce = Vector3.new(9e9, 9e9, 9e9)
	bv.Velocity = Vector3.zero
	bv.Parent = root

	flyConnection = runService.RenderStepped:Connect(function()
		if not flying then
			return
		end

		if not character.Parent or not root.Parent then
			stopFly()
			return
		end

		local direction = getMovement(humanoid)

		-- GERAK
		if direction.Magnitude > 0 then

			-- Matikan hover
			local velocity = direction * speed
			bv.Velocity = velocity

			-- Animasi terbang
			if not currentFlyTrack then
				stopAnimations()
				playAnimation(humanoid, FLY_ANIMATION, false)
			end

			-- Arah karakter mengikuti gerakan
			local target = root.Position + direction

			bg.CFrame = CFrame.lookAt(
				root.Position,
				target
			)

		else

			-- HOVER SAAT DIAM
			local hover = math.sin(os.clock() * 2.5) * 1.8

			bv.Velocity = Vector3.new(
				0,
				hover,
				0
			)

			-- Animasi hover
			if not currentHoverTrack then
				stopAnimations()
				playAnimation(humanoid, HOVER_ANIMATION, true)
			end

			-- Tetap menghadap kamera
			local camera = workspace.CurrentCamera

			if camera then
				local look = camera.CFrame.LookVector
				local flatLook = Vector3.new(
					look.X,
					0,
					look.Z
				)

				if flatLook.Magnitude > 0 then
					bg.CFrame = CFrame.lookAt(
						root.Position,
						root.Position + flatLook.Unit
					)
				end
			end
		end
	end)
end

--==================================================
-- TOGGLE
--==================================================

local function toggleFly()
	if flying then
		stopFly()
	else
		startFly()
	end
end

flyBtn.MouseButton1Click:Connect(toggleFly)

-- SPEED +
speedUp.MouseButton1Click:Connect(function()
	speed = math.clamp(speed + 20, 10, 500)
	speedLabel.Text = "Velocidad: " .. speed
end)

-- SPEED -
speedDown.MouseButton1Click:Connect(function()
	speed = math.clamp(speed - 20, 10, 500)
	speedLabel.Text = "Velocidad: " .. speed
end)

-- F = TOGGLE
userInputService.InputBegan:Connect(function(input, gpe)
	if gpe then return end

	if input.KeyCode == Enum.KeyCode.F then
		toggleFly()
	end
end)

