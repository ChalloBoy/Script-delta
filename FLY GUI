--==================================================
-- ANIMATION SYSTEM
--==================================================

local function stopAnimation()
	if currentTrack then
		pcall(function()
			currentTrack:Stop(0.15)
		end)

		currentTrack = nil
	end
end

local function playAnimation(id)
	stopAnimation()

	local char = player.Character
	if not char then return end

	local hum = char:FindFirstChildOfClass("Humanoid")
	if not hum then return end

	local animator = hum:FindFirstChildOfClass("Animator")

	if not animator then
		animator = Instance.new("Animator")
		animator.Parent = hum
	end

	local anim = Instance.new("Animation")
	anim.AnimationId = "rbxassetid://" .. id

	local success, track = pcall(function()
		return animator:LoadAnimation(anim)
	end)

	if success and track then
		track.Looped = true
		track.Priority = Enum.AnimationPriority.Action
		track:Play(0.15)

		currentTrack = track
	end
end

local function playFlyAnimation()
	if not currentTrack then
		playAnimation(FLY_ANIMATION_ID)
	end
end

local function playHoverAnimation()
	if not currentTrack then
		playAnimation(HOVER_ANIMATION_ID)
	end
end

--==================================================
-- MOVEMENT
--==================================================

local function getDirection()
	local direction = Vector3.new(0, 0, 0)

	local camera = workspace.CurrentCamera
	if not camera then
		return direction
	end

	if userInputService:IsKeyDown(Enum.KeyCode.W) then
		direction += camera.CFrame.LookVector
	end

	if userInputService:IsKeyDown(Enum.KeyCode.S) then
		direction -= camera.CFrame.LookVector
	end

	if userInputService:IsKeyDown(Enum.KeyCode.A) then
		direction -= camera.CFrame.RightVector
	end

	if userInputService:IsKeyDown(Enum.KeyCode.D) then
		direction += camera.CFrame.RightVector
	end

	return direction
end

--==================================================
-- STOP FLY
--==================================================

local function stopFly()

	flying = false
	hoverTime = 0

	stopAnimation()

	if bg then
		bg:Destroy()
		bg = nil
	end

	if bv then
		bv:Destroy()
		bv = nil
	end

	local char = player.Character

	if char then
		local hum = char:FindFirstChildOfClass("Humanoid")

		if hum then
			hum.PlatformStand = false
			hum.AutoRotate = true

			-- Pastikan animasi default Roblox kembali aktif
			local animate = char:FindFirstChild("Animate")

			if animate then
				animate.Disabled = false
			end
		end
	end

	flyBtn.Text = "FLY: OFF"
	flyBtn.BackgroundColor3 = Color3.fromRGB(45, 45, 45)
end

--==================================================
-- START FLY
--==================================================

local function startFly()

	local char = player.Character

	if not char then
		return
	end

	local root = char:FindFirstChild("HumanoidRootPart")
	local hum = char:FindFirstChildOfClass("Humanoid")

	if not root or not hum then
		return
	end

	flying = true
	hoverTime = 0

	flyBtn.Text = "FLY: ON"
	flyBtn.BackgroundColor3 = Color3.fromRGB(0, 200, 100)

	hum.PlatformStand = true

	-- BodyGyro
	bg = Instance.new("BodyGyro")
	bg.P = 9e4
	bg.MaxTorque = Vector3.new(9e9, 9e9, 9e9)
	bg.CFrame = workspace.CurrentCamera.CFrame
	bg.Parent = root

	-- BodyVelocity
	bv = Instance.new("BodyVelocity")
	bv.MaxForce = Vector3.new(9e9, 9e9, 9e9)
	bv.P = 9e4
	bv.Velocity = Vector3.zero
	bv.Parent = root

	-- Matikan animasi default sementara Fly aktif
	local animate = char:FindFirstChild("Animate")

	if animate then
		animate.Disabled = true
	end

	-- Mulai Hover saat pertama aktif
	playHoverAnimation()
end

--==================================================
-- FLY LOOP
--==================================================

runService.RenderStepped:Connect(function(dt)

	if not flying then
		return
	end

	local char = player.Character

	if not char then
		stopFly()
		return
	end

	local root = char:FindFirstChild("HumanoidRootPart")
	local hum = char:FindFirstChildOfClass("Humanoid")

	if not root or not hum or not bv or not bg then
		stopFly()
		return
	end

	local camera = workspace.CurrentCamera

	if not camera then
		return
	end

	local direction = getDirection()
	local moving = direction.Magnitude > 0.01

	--==================================================
	-- GERAK FLY
	--==================================================

	local velocity = direction * speed

	--==================================================
	-- HOVER NAIK-TURUN
	--==================================================

	if not moving then

		hoverTime += dt

		-- Gerakan naik turun smooth
		local hoverY = math.sin(hoverTime * 2.5) * 2

		velocity += Vector3.new(0, hoverY, 0)

		-- Pastikan Hover animation
		if not currentTrack then
			playHoverAnimation()
		end

	else

		-- Reset waktu hover
		hoverTime = 0

		-- Pastikan Fly animation
		if not currentTrack then
			playFlyAnimation()
		end
	end

	bv.Velocity = velocity

	--==================================================
	-- ARAH KARAKTER
	--==================================================

	bg.CFrame = camera.CFrame

end)

--==================================================
-- TOGGLE
--==================================================

local function toggleFly()

	if flying then
		stopFly()
	else
		startFly()
	end

end

flyBtn.MouseButton1Click:Connect(toggleFly)

--==================================================
-- SPEED UP
--==================================================

speedUp.MouseButton1Click:Connect(function()

	speed = math.clamp(speed + 20, 10, 500)

	speedLabel.Text = "Velocidad: " .. speed

end)

--==================================================
-- SPEED DOWN
--==================================================

speedDown.MouseButton1Click:Connect(function()

	speed = math.clamp(speed - 20, 10, 500)

	speedLabel.Text = "Velocidad: " .. speed

end)

--==================================================
-- F KEY
--==================================================

userInputService.InputBegan:Connect(function(input, gpe)

	if gpe then
		return
	end

	if input.KeyCode == Enum.KeyCode.F then
		toggleFly()
	end

end)

--==================================================
-- RESPAWN SAFETY
--==================================================

player.CharacterAdded:Connect(function()

	if flying then
		stopFly()
	end

end)
