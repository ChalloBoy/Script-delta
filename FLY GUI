local Players = game:GetService("Players")
local UIS = game:GetService("UserInputService")
local RunService = game:GetService("RunService")

local Player = Players.LocalPlayer

--==================================================
-- SETTINGS
--==================================================

local FLY_SPEED = 60
local VERTICAL_SPEED = 45

-- Animation IDs
local FLY_ANIMATION_ID = "rbxassetid://139612150175034"
local IDLE_ANIMATION_ID = "rbxassetid://99496791481602"

--==================================================
-- VARIABLES
--==================================================

local Character
local Humanoid
local Root

local Flying = false
local Up = false
local Down = false

local BodyVelocity
local BodyGyro

local FlyTrack
local IdleTrack

--==================================================
-- CHARACTER SETUP
--==================================================

local function SetupCharacter(Char)
	Character = Char
	Humanoid = Char:WaitForChild("Humanoid")
	Root = Char:WaitForChild("HumanoidRootPart")

	FlyTrack = nil
	IdleTrack = nil
end

SetupCharacter(Player.Character or Player.CharacterAdded:Wait())

Player.CharacterAdded:Connect(function(Char)
	if Flying then
		Flying = false
	end

	SetupCharacter(Char)
end)

--==================================================
-- ANIMATION
--==================================================

local function LoadAnimations()
	if not Humanoid then
		return
	end

	local Animator = Humanoid:FindFirstChildOfClass("Animator")

	if not Animator then
		Animator = Instance.new("Animator")
		Animator.Parent = Humanoid
	end

	-- Fly animation
	local FlyAnimation = Instance.new("Animation")
	FlyAnimation.AnimationId = FLY_ANIMATION_ID

	local Success1, Result1 = pcall(function()
		return Animator:LoadAnimation(FlyAnimation)
	end)

	if Success1 and Result1 then
		FlyTrack = Result1
		FlyTrack.Looped = true
		FlyTrack.Priority = Enum.AnimationPriority.Action
	end

	-- Hover / Idle animation
	local IdleAnimation = Instance.new("Animation")
	IdleAnimation.AnimationId = IDLE_ANIMATION_ID

	local Success2, Result2 = pcall(function()
		return Animator:LoadAnimation(IdleAnimation)
	end)

	if Success2 and Result2 then
		IdleTrack = Result2
		IdleTrack.Looped = true
		IdleTrack.Priority = Enum.AnimationPriority.Action
	end
end

local function StopAnimations()
	if FlyTrack then
		FlyTrack:Stop(0.15)
	end

	if IdleTrack then
		IdleTrack:Stop(0.15)
	end
end

local function UpdateAnimation(IsMoving)
	if not Flying then
		return
	end

	if IsMoving then

		if IdleTrack and IdleTrack.IsPlaying then
			IdleTrack:Stop(0.15)
		end

		if FlyTrack and not FlyTrack.IsPlaying then
			FlyTrack:Play(0.15)
		end

	else

		if FlyTrack and FlyTrack.IsPlaying then
			FlyTrack:Stop(0.15)
		end

		if IdleTrack and not IdleTrack.IsPlaying then
			IdleTrack:Play(0.15)
		end
	end
end

--==================================================
-- STOP FLY
--==================================================

local function StopFly()
	Flying = false

	if BodyVelocity then
		BodyVelocity:Destroy()
		BodyVelocity = nil
	end

	if BodyGyro then
		BodyGyro:Destroy()
		BodyGyro = nil
	end

	StopAnimations()

	if Humanoid then
		Humanoid.AutoRotate = true
	end
end

--==================================================
-- START FLY
--==================================================

local function StartFly()
	if not Character or not Humanoid or not Root then
		return
	end

	LoadAnimations()

	Flying = true

	Humanoid.AutoRotate = false

	BodyVelocity = Instance.new("BodyVelocity")
	BodyVelocity.MaxForce = Vector3.new(1e6, 1e6, 1e6)
	BodyVelocity.P = 5000
	BodyVelocity.Velocity = Vector3.zero
	BodyVelocity.Parent = Root

	BodyGyro = Instance.new("BodyGyro")
	BodyGyro.MaxTorque = Vector3.new(1e6, 1e6, 1e6)
	BodyGyro.P = 10000
	BodyGyro.CFrame = Root.CFrame
	BodyGyro.Parent = Root
end

