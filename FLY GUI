	if Flying then

		StopFly()

		FlyButton.Text = "✈  FLY : OFF"
		Status.Text = "● READY"

	else

		StartFly()

		FlyButton.Text = "✈  FLY : ON"
		Status.Text = "● FLYING"

	end
end)

--==================================================
-- KEYBOARD
--==================================================

UIS.InputBegan:Connect(function(Input, Processed)

	if Processed then
		return
	end

	if Input.KeyCode == Enum.KeyCode.Space then

		Up = true

	elseif Input.KeyCode == Enum.KeyCode.LeftControl then

		Down = true

	end
end)

UIS.InputEnded:Connect(function(Input)

	if Input.KeyCode == Enum.KeyCode.Space then

		Up = false

	elseif Input.KeyCode == Enum.KeyCode.LeftControl then

		Down = false

	end
end)

--==================================================
-- FLY MOVEMENT
--==================================================

RunService.RenderStepped:Connect(function()

	if not Flying then
		return
	end

	if not Root or not BodyVelocity or not BodyGyro then
		return
	end

	local Camera = workspace.CurrentCamera

	if not Camera then
		return
	end

	local MoveDirection = Humanoid.MoveDirection

	local IsMoving =
		MoveDirection.Magnitude > 0.05
		or Up
		or Down

	local Velocity = MoveDirection * FLY_SPEED

	-- Naik
	if Up then
		Velocity += Vector3.new(0, VERTICAL_SPEED, 0)
	end

	-- Turun
	if Down then
		Velocity -= Vector3.new(0, VERTICAL_SPEED, 0)
	end

	BodyVelocity.Velocity = Velocity

	-- Menghadap arah kamera
	local Look = Camera.CFrame.LookVector

	BodyGyro.CFrame = CFrame.lookAt(
		Root.Position,
		Root.Position + Vector3.new(
			Look.X,
			0,
			Look.Z
		)
	)

	UpdateAnimation(IsMoving)
end)

--==================================================
-- RGB EFFECT
--==================================================

local Hue = 0

RunService.RenderStepped:Connect(function(DeltaTime)

	Hue = (Hue + DeltaTime * 0.15) % 1

	local RGB = Color3.fromHSV(
		Hue,
		1,
		1
	)

	MainStroke.Color = RGB
	FlyStroke.Color = RGB

	Title.TextColor3 = RGB
	Minimize.TextColor3 = RGB
	FlyButton.TextColor3 = RGB
	Status.TextColor3 = RGB
end)
