-- =========================================================
-- 2. ANIMATION SYSTEM
-- =========================================================

local function getCharacter()
	local char = player.Character or player.CharacterAdded:Wait()
	local hum = char:WaitForChild("Humanoid")
	local root = char:WaitForChild("HumanoidRootPart")

	return char, hum, root
end

local function stopFlyAnimations()
	if flyTrack then
		pcall(function()
			flyTrack:Stop(0.15)
		end)
		flyTrack = nil
	end

	if hoverTrack then
		pcall(function()
			hoverTrack:Stop(0.15)
		end)
		hoverTrack = nil
	end
end

local function loadAnimation(humanoid, id)
	local animation = Instance.new("Animation")
	animation.AnimationId = "rbxassetid://" .. id

	local track

	pcall(function()
		track = humanoid:LoadAnimation(animation)
	end)

	animation:Destroy()

	if track then
		track.Looped = true
		track.Priority = Enum.AnimationPriority.Action
	end

	return track
end

local function playFlyAnimation()
	local char, hum = getCharacter()

	if not flying then
		return
	end

	if not flyTrack then
		flyTrack = loadAnimation(hum, FLY_ANIMATION_ID)
	end

	if flyTrack and not flyTrack.IsPlaying then
		flyTrack:Play(0.15)
	end

	if hoverTrack then
		hoverTrack:Stop(0.15)
		hoverTrack = nil
	end
end

local function playHoverAnimation()
	local char, hum = getCharacter()

	if not flying then
		return
	end

	if not hoverTrack then
		hoverTrack = loadAnimation(hum, HOVER_ANIMATION_ID)
	end

	if hoverTrack and not hoverTrack.IsPlaying then
		hoverTrack:Play(0.15)
	end

	if flyTrack then
		flyTrack:Stop(0.15)
	end
end

-- =========================================================
-- 3. LÓGICA DE MOVIMIENTO
-- =========================================================

local function getDirection()
	local direction = Vector3.new(0, 0, 0)

	local camera = workspace.CurrentCamera
	if not camera then
		return direction
	end

	if userInputService:IsKeyDown(Enum.KeyCode.W) then
		direction += camera.CFrame.LookVector
	end

	if userInputService:IsKeyDown(Enum.KeyCode.S) then
		direction -= camera.CFrame.LookVector
	end

	if userInputService:IsKeyDown(Enum.KeyCode.A) then
		direction -= camera.CFrame.RightVector
	end

	if userInputService:IsKeyDown(Enum.KeyCode.D) then
		direction += camera.CFrame.RightVector
	end

	-- Hilangkan gerakan Y dari kamera supaya W/S tidak
	-- membuat karakter naik/turun secara tidak sengaja.
	direction = Vector3.new(direction.X, 0, direction.Z)

	if direction.Magnitude > 0 then
		direction = direction.Unit
	end

	return direction
end

-- =========================================================
-- 4. TOGGLE FLY
-- =========================================================

local function toggleFly()
	local char = player.Character
	if not char then
		return
	end

	local root = char:FindFirstChild("HumanoidRootPart")
	local hum = char:FindFirstChildOfClass("Humanoid")

	if not root or not hum then
		return
	end

	flying = not flying

	if flying then

		flyBtn.Text = "FLY: ON"
		flyBtn.BackgroundColor3 = Color3.fromRGB(0, 200, 100)

		hum.PlatformStand = true

		-- BodyGyro
		bg = Instance.new("BodyGyro")
		bg.P = 9e4
		bg.maxTorque = Vector3.new(9e9, 9e9, 9e9)
		bg.cframe = workspace.CurrentCamera.CFrame
		bg.Parent = root

		-- BodyVelocity
		bv = Instance.new("BodyVelocity")
		bv.maxForce = Vector3.new(9e9, 9e9, 9e9)
		bv.velocity = Vector3.new(0, 0, 0)
		bv.Parent = root

		-- Mulai hover ketika diam
		playHoverAnimation()

		task.spawn(function()

			while flying and root.Parent and bv and bg do

				local dir = getDirection()

				if dir.Magnitude > 0 then

					-- GERAK FLY
					bv.velocity = dir * speed

					-- Fly animation
					playFlyAnimation()

				else

					-- IDLE / HOVER
					-- sedikit naik-turun supaya terlihat melayang
					local t = os.clock()
					local hoverVelocity = math.sin(t * 2.5) * 1.8

					bv.velocity = Vector3.new(
						0,
						hoverVelocity,
						0
					)

					playHoverAnimation()
				end

				-- Arah karakter mengikuti kamera
				if bg and workspace.CurrentCamera then
					bg.cframe = workspace.CurrentCamera.CFrame
				end

				runService.RenderStepped:Wait()
			end

			if bg then
				bg:Destroy()
				bg = nil
			end

			if bv then
				bv:Destroy()
				bv = nil
			end

			if hum and hum.Parent then
				hum.PlatformStand = false
			end

		end)

	else

		flyBtn.Text = "FLY: OFF"
		flyBtn.BackgroundColor3 = Color3.fromRGB(45, 45, 45)

		-- Matikan physics Fly
		if bg then
			bg:Destroy()
			bg = nil
		end

		if bv then
			bv:Destroy()
			bv = nil
		end

		-- Matikan animasi custom
		stopFlyAnimations()

		-- Kembalikan karakter normal
		hum.PlatformStand = false
		hum:ChangeState(Enum.HumanoidStateType.GettingUp)
	end
end

-- =========================================================
-- 5. EVENT BUTTON
-- =========================================================

