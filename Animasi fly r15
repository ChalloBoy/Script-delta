--// ANIMATION ONLY - LOCAL SCRIPT
--// No GUI / No Mode / No ServerScript

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")

local Player = Players.LocalPlayer

local Character
local Humanoid
local RootPart
local RootJoint

local Connection
local DeathConnection

local function setupCharacter(char)
	Character = char
	Humanoid = char:WaitForChild("Humanoid")
	RootPart = char:WaitForChild("HumanoidRootPart")

	RootJoint = RootPart:FindFirstChild("RootJoint")

	if not RootJoint then
		RootJoint = RootPart:FindFirstChildWhichIsA("Motor6D")
	end

	if not RootJoint then
		return
	end

	-- Hapus koneksi lama
	if Connection then
		Connection:Disconnect()
		Connection = nil
	end

	if DeathConnection then
		DeathConnection:Disconnect()
		DeathConnection = nil
	end

	local startTime = tick()
	local dead = false
	local deathStart = 0

	-- Simpan transform asli
	local baseTransform = RootJoint.Transform

	--// DEATH
	DeathConnection = Humanoid.Died:Connect(function()
		dead = true
		deathStart = tick()
	end)

	--// MAIN ANIMATION LOOP
	Connection = RunService.RenderStepped:Connect(function()
		if not Character
			or not Character.Parent
			or not Humanoid
			or Humanoid.Health <= 0 and not dead
			or not RootJoint
			or not RootPart then
			return
		end

		local time = tick() - startTime

		-- Kecepatan karakter
		local velocity = RootPart.AssemblyLinearVelocity
		local horizontalVelocity = Vector3.new(
			velocity.X,
			0,
			velocity.Z
		).Magnitude

		local verticalVelocity = velocity.Y

		local state = Humanoid:GetState()

		local offsetY = 0
		local tiltX = 0
		local tiltZ = 0

		--==================================================
		-- IDLE
		--==================================================
		if horizontalVelocity < 1 and
			state ~= Enum.HumanoidStateType.Jumping and
			state ~= Enum.HumanoidStateType.Freefall then

			-- Naik turun lembut
			offsetY = math.sin(time * 2.2) * 0.055

			-- Sedikit sway supaya tidak kaku
			tiltZ = math.sin(time * 1.4) * math.rad(0.7)

		--==================================================
		-- WALK / RUN
		--==================================================
		elseif horizontalVelocity >= 1 and
			state ~= Enum.HumanoidStateType.Jumping and
			state ~= Enum.HumanoidStateType.Freefall then

			-- Gerakan sangat kecil agar animasi
			-- berjalan bawaan Roblox tetap natural
			offsetY = math.sin(time * 8) * 0.018

			tiltZ = math.sin(time * 4) * math.rad(0.35)

		--==================================================
		-- JUMP
		--==================================================
		elseif state == Enum.HumanoidStateType.Jumping then

			-- Naik sedikit saat lompat
			offsetY = math.sin(time * 7) * 0.025

			tiltX = math.rad(-2)

		--==================================================
		-- FALL
		--==================================================
		elseif state == Enum.HumanoidStateType.Freefall then

			-- Saat jatuh, badan sedikit melayang
			offsetY = math.sin(time * 4) * 0.035

			-- Semakin cepat jatuh, sedikit condong
			local fallAmount = math.clamp(
				math.abs(verticalVelocity) / 70,
				0,
				1
			)

			tiltX = math.rad(4) * fallAmount

		end

		--==================================================
		-- DEATH ANIMATION
		--==================================================
		if dead then
			local elapsed = tick() - deathStart

			-- Durasi animasi mati
			local progress = math.clamp(elapsed / 0.65, 0, 1)

			-- Ease-out
			local eased = 1 - (1 - progress)^3

			-- Badan perlahan jatuh ke depan
			tiltX = math.rad(65) * eased

			-- Sedikit miring ke samping
			tiltZ = math.rad(10) * math.sin(progress * math.pi)

			-- Sedikit turun
			offsetY = -0.18 * eased

			-- Setelah selesai jangan terus bergerak
			if progress >= 1 then
				offsetY = -0.18
				tiltX = math.rad(65)
				tiltZ = 0
			end
		end

		--==================================================
		-- APPLY
		--==================================================
		local targetTransform =
			baseTransform
			* CFrame.new(0, offsetY, 0)
			* CFrame.Angles(tiltX, 0, tiltZ)

		-- Smooth agar tidak patah-patah
		RootJoint.Transform = RootJoint.Transform:Lerp(
			targetTransform,
			0.12
		)
	end)
end

-- Karakter pertama
if Player.Character then
	setupCharacter(Player.Character)
end

-- Otomatis aktif lagi setelah respawn
Player.CharacterAdded:Connect(function(char)
	task.wait(0.15)
	setupCharacter(char)
end)
