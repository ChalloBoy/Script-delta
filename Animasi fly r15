--==================================================
-- CHARACTER SETUP
--==================================================

local function setupCharacter(char)
	character = char
	humanoid = character:WaitForChild("Humanoid")
	hrp = character:WaitForChild("HumanoidRootPart")

	currentTrack = nil

	-- Hapus koneksi lama
	if bobConnection then
		bobConnection:Disconnect()
		bobConnection = nil
	end

	--================================================
	-- BOB / IDLE ANIMATION
	--================================================

	local rootJoint = hrp:FindFirstChild("RootJoint")

	if not rootJoint then
		for _, obj in ipairs(hrp:GetChildren()) do
			if obj:IsA("Motor6D") then
				rootJoint = obj
				break
			end
		end
	end

	if rootJoint then
		local startTime = os.clock()

		bobConnection = RunService.RenderStepped:Connect(function()
			if not character
				or not character.Parent
				or not humanoid
				or humanoid.Health <= 0
				or not rootJoint.Parent then
				return
			end

			local t = os.clock() - startTime
			local state = humanoid:GetState()
			local moving = humanoid.MoveDirection.Magnitude > 0.05

			local y = 0
			local pitch = 0

			-- IDLE
			if not moving
				and state ~= Enum.HumanoidStateType.Jumping
				and state ~= Enum.HumanoidStateType.Freefall then

				y = math.sin(t * 2.2) * 0.055

			-- WALK / RUN
			elseif moving
				and state == Enum.HumanoidStateType.Running then

				y = math.sin(t * 7) * 0.035
				pitch = math.sin(t * 7) * math.rad(1.2)

			-- JUMP
			elseif state == Enum.HumanoidStateType.Jumping then

				y = math.sin(t * 3) * 0.045
				pitch = math.sin(t * 2.5) * math.rad(2)

			-- FALL
			elseif state == Enum.HumanoidStateType.Freefall then

				y = math.sin(t * 2.8) * 0.05
				pitch = math.sin(t * 2.2) * math.rad(2.5)
			end

			rootJoint.Transform =
				CFrame.new(0, y, 0)
				* CFrame.Angles(pitch, 0, 0)
		end)
	end

	--================================================
	-- DEATH
	--================================================

	humanoid.Died:Connect(function()
		if bobConnection then
			bobConnection:Disconnect()
			bobConnection = nil
		end

		if rootJoint then
			rootJoint.Transform =
				CFrame.Angles(math.rad(-12), 0, math.rad(8))
		end
	end)
end

--==================================================
-- EFFECT CLEANUP
--==================================================

local function clearEffects()
	for _, v in pairs(effects) do
		if v and v.Parent then
			v:Destroy()
		end
	end

	effects = {}

	if currentConnection then
		currentConnection:Disconnect()
		currentConnection = nil
	end

	if currentTrack then
		pcall(function()
			currentTrack:Stop()
		end)
		currentTrack = nil
	end
end

--==================================================
-- TEXT
--==================================================

local function showText(text, color)
	TextLabel.Text = text
	TextLabel.TextColor3 = color

	local tweenIn = TweenService:Create(
		TextLabel,
		TweenInfo.new(
			0.3,
			Enum.EasingStyle.Quad,
			Enum.EasingDirection.Out
		),
		{TextTransparency = 0}
	)

	local tweenOut = TweenService:Create(
		TextLabel,
		TweenInfo.new(
			0.5,
			Enum.EasingStyle.Quad,
			Enum.EasingDirection.In
		),
		{TextTransparency = 1}
	)

	tweenIn:Play()

	tweenIn.Completed:Connect(function()
		task.delay(0.8, function()
			if TextLabel then
				tweenOut:Play()
			end
		end)
	end)
end

--==================================================
-- ANIMATION
--==================================================

local function playAnim(id)
	if not humanoid then
		return nil
	end

	if currentTrack then
		pcall(function()
			currentTrack:Stop()
		end)
	end

	local anim = Instance.new("Animation")
	anim.AnimationId = "rbxassetid://" .. id

	local success, track = pcall(function()
		return humanoid:LoadAnimation(anim)
	end)

	if not success or not track then
		anim:Destroy()
		return nil
	end

	track:Play()
	currentTrack = track

	anim:Destroy()

	return track
end

