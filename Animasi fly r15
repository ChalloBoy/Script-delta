--========================================================
-- BUTTON
--========================================================

local function UpdateToggle()
	if AnimationEnabled then
		Toggle.Text = "●  ANIMATION ON"
		Toggle.TextColor3 = Color3.fromRGB(20, 145, 75)
		Toggle.BackgroundColor3 = Color3.fromRGB(225, 250, 235)
	else
		Toggle.Text = "○  ANIMATION OFF"
		Toggle.TextColor3 = Color3.fromRGB(190, 55, 55)
		Toggle.BackgroundColor3 = Color3.fromRGB(255, 230, 230)
	end
end

UpdateToggle()

Toggle.MouseButton1Click:Connect(function()
	AnimationEnabled = not AnimationEnabled
	UpdateToggle()

	if not AnimationEnabled then
		if RootJoint and OriginalRootC0 then
			RootJoint.C0 = OriginalRootC0
		end

		if Waist and OriginalWaistC0 then
			Waist.C0 = OriginalWaistC0
		end

		if Neck and OriginalNeckC0 then
			Neck.C0 = OriginalNeckC0
		end
	end
end)

--========================================================
-- MINIMIZE
--========================================================

local function Minimize()
	Main.Visible = false
	Mini.Visible = true
end

local function Restore()
	Mini.Visible = false
	Main.Visible = true
end

Title.InputBegan:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.MouseButton1
		or input.UserInputType == Enum.UserInputType.Touch then

		Minimize()
	end
end)

Mini.MouseButton1Click:Connect(function()
	Restore()
end)

--========================================================
-- FIND JOINT
--========================================================

local function FindJoint()
	RootJoint = nil
	Waist = nil
	Neck = nil

	if not Character then
		return
	end

	if RigType == Enum.HumanoidRigType.R6 then

		local Torso = Character:FindFirstChild("Torso")

		if Torso then
			RootJoint = Torso:FindFirstChild("RootJoint")
			Neck = Torso:FindFirstChild("Neck")
		end

	else

		local LowerTorso = Character:FindFirstChild("LowerTorso")
		local UpperTorso = Character:FindFirstChild("UpperTorso")

		if LowerTorso then
			RootJoint = LowerTorso:FindFirstChild("Root")
		end

		if UpperTorso then
			Waist = UpperTorso:FindFirstChild("Waist")
			Neck = UpperTorso:FindFirstChild("Neck")
		end

	end

	-- Simpan C0 asli
	if RootJoint then
		OriginalRootC0 = RootJoint.C0
	end

	if Waist then
		OriginalWaistC0 = Waist.C0
	end

	if Neck then
		OriginalNeckC0 = Neck.C0
	end
end

--========================================================
-- PLAY REAL ANIMATION
--========================================================

local function StopAnimation()
	if AnimationTrack then
		pcall(function()
			AnimationTrack:Stop(0.15)
			AnimationTrack:Destroy()
		end)

		AnimationTrack = nil
	end
end

local function PlayCustomAnimation()
	StopAnimation()

	if not Animator then
		return
	end

	local Animation = Instance.new("Animation")
	Animation.AnimationId = "rbxassetid://" .. CUSTOM_ANIMATION_ID

	local success, track = pcall(function()
		return Animator:LoadAnimation(Animation)
	end)

	if success and track then
		AnimationTrack = track

		AnimationTrack.Priority = Enum.AnimationPriority.Action
		AnimationTrack.Looped = true

		pcall(function()
			AnimationTrack:Play(0.2, 1, 1)
		end)
	end

	Animation:Destroy()
end

--========================================================
-- CHARACTER SETUP
--========================================================

local function SetupCharacter(NewCharacter)

	CharacterToken += 1
	local MyToken = CharacterToken

	Alive = false

	StopAnimation()

	Character = NewCharacter

	Humanoid = Character:WaitForChild("Humanoid", 10)
	HRP = Character:WaitForChild("HumanoidRootPart", 10)

	if not Humanoid or not HRP then
		return
	end

	RigType = Humanoid.RigType

	-- Animator
	Animator = Humanoid:FindFirstChildOfClass("Animator")

	if not Animator then
		Animator = Instance.new("Animator")
		Animator.Parent = Humanoid
	end

	FindJoint()

	Alive = true

	-- Coba jalankan AnimationTrack asli
	PlayCustomAnimation()

	-- Death
	Humanoid.Died:Connect(function()

		if MyToken ~= CharacterToken then
			return
		end

		Alive = false

		StopAnimation()

		-- Pose jatuh ringan
		if RootJoint and OriginalRootC0 then
			RootJoint.C0 =
				OriginalRootC0 *
				CFrame.Angles(math.rad(12), 0, 0)
		end

		if Waist and OriginalWaistC0 then
			Waist.C0 =
				OriginalWaistC0 *
				CFrame.Angles(math.rad(10), 0, 0)
		end
	end)
end

--========================================================
-- RESPAWN
--========================================================

Player.CharacterAdded:Connect(function(NewCharacter)

	task.wait(0.15)

	SetupCharacter(NewCharacter)

end)

if Player.Character then
	SetupCharacter(Player.Character)
end

--========================================================
-- REAL PROCEDURAL BACKUP ANIMATION
--========================================================
-- Ini adalah backup agar tetap ada gerakan visual
-- walaupun Animation ID tidak dapat dimainkan.
-- Tidak mengubah HRP sehingga karakter tetap bisa bergerak.
--========================================================

local AnimationTime = 0

RunService:BindToRenderStep(
	"RealAnimationSystem",
	Enum.RenderPriority.Character.Value + 10,
	function(dt)

		if not AnimationEnabled then
			return
		end

		if not Alive then
			return
		end

		if not Character
			or not Humanoid
			or Humanoid.Health <= 0 then
			return
		end

		AnimationTime += dt

		local State = Humanoid:GetState()
		local Moving = Humanoid.MoveDirection.Magnitude > 0.05

		--================================================
		-- IDLE
		--================================================

		if not Moving
			and State ~= Enum.HumanoidStateType.Jumping
			and State ~= Enum.HumanoidStateType.Freefall then

			local Wave =
				math.sin(AnimationTime * IDLE_SPEED)

			local Bob =
				Wave * IDLE_BOB

			local Tilt =
				math.sin(AnimationTime * IDLE_SPEED) * IDLE_TILT

			if RigType == Enum.HumanoidRigType.R6 then

				if RootJoint and OriginalRootC0 then
					RootJoint.C0 =
						OriginalRootC0 *
						CFrame.new(0, Bob, 0) *
						CFrame.Angles(Tilt, 0, 0)
				end

			else

				if RootJoint and OriginalRootC0 then
					RootJoint.C0 =
						OriginalRootC0 *
						CFrame.new(0, Bob * 0.35, 0)
				end

				if Waist and OriginalWaistC0 then
					Waist.C0 =
						OriginalWaistC0 *
						CFrame.new(0, Bob * 0.65, 0) *
						CFrame.Angles(Tilt, 0, 0)
				end
			end

		--================================================
		-- JUMP
		--================================================

		elseif State == Enum.HumanoidStateType.Jumping then

			if RigType == Enum.HumanoidRigType.R6 then

				if RootJoint and OriginalRootC0 then
					RootJoint.C0 =
						OriginalRootC0 *
						CFrame.Angles(-JUMP_TILT, 0, 0)
				end

			else

				if Waist and OriginalWaistC0 then
					Waist.C0 =
						OriginalWaistC0 *
						CFrame.Angles(JUMP_TILT, 0, 0)
				end
			end

		--================================================
		-- FALL
		--================================================

		elseif State == Enum.HumanoidStateType.Freefall then

			if RigType == Enum.HumanoidRigType.R6 then

				if RootJoint and OriginalRootC0 then
					RootJoint.C0 =
						OriginalRootC0 *
						CFrame.Angles(FALL_TILT, 0, 0)
				end

			else

				if Waist and OriginalWaistC0 then
					Waist.C0 =
						OriginalWaistC0 *
						CFrame.Angles(FALL_TILT, 0, 0)
				end
			end

		--================================================
		-- WALK / OTHER
		--================================================

		else

			if RootJoint and OriginalRootC0 then
				RootJoint.C0 = OriginalRootC0
			end

			if Waist and OriginalWaistC0 then
				Waist.C0 = OriginalWaistC0
			end
		end
	end
)

--========================================================
-- FPS
--========================================================

local FPS = 0
local Frames = 0
local FPSTimer = 0

RunService.RenderStepped:Connect(function(dt)

	Frames += 1
	FPSTimer += dt

	if FPSTimer >= 0.5 then
		FPS = math.floor(Frames / FPSTimer + 0.5)

		Frames = 0
		FPSTimer = 0

		Mini.Text = "FPS: " .. FPS
	end
end)

--========================================================
-- RGB BORDER
--========================================================

local Hue = 0

RunService.RenderStepped:Connect(function(dt)

	Hue = (Hue + dt * 0.18) % 1

	local RGB = Color3.fromHSV(Hue, 0.9, 1)

	Stroke.Color = RGB
	MiniStroke.Color = RGB
end)
