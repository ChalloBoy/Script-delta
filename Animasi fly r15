		p.RotSpeed = NumberRange.new(-90,90)
		p.Transparency = NumberSequence.new(0,1)
		p.Color = ColorSequence.new(
			Color3.fromRGB(255,255,255)
		)
	end

	table.insert(effects, attach1)
	table.insert(effects, attach2)
end

