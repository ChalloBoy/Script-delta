	FPS.Visible = false
	Main.Visible = true

end)

--========================================================
-- CHARACTER VARIABLES
--========================================================

local Character
local Humanoid
local Root

local RootJoint
local Waist
local Neck

local originalRootTransform = CFrame.identity
local originalWaistTransform = CFrame.identity
local originalNeckTransform = CFrame.identity

local deathPlaying = false
local idleTime = 0

--========================================================
-- FIND MOTOR
--========================================================

local function getMotor(parent, name)

	if not parent then
		return nil
	end

	local motor = parent:FindFirstChild(name)

	if motor and motor:IsA("Motor6D") then
		return motor
	end

	return nil
end

--========================================================
-- RESET JOINTS
--========================================================

local function resetJoints()

	if RootJoint then
		RootJoint.Transform = originalRootTransform
	end

	if Waist then
		Waist.Transform = originalWaistTransform
	end

	if Neck then
		Neck.Transform = originalNeckTransform
	end

end

--========================================================
-- SETUP CHARACTER
--========================================================

local function setupCharacter(character)

	Character = character

	Humanoid = character:WaitForChild("Humanoid")
	Root = character:WaitForChild("HumanoidRootPart")

	RootJoint = nil
	Waist = nil
	Neck = nil

	-- Jangan biarkan Roblox langsung mematahkan joint
	Humanoid.BreakJointsOnDeath = false

	if Humanoid.RigType == Enum.HumanoidRigType.R15 then

		local LowerTorso = character:FindFirstChild("LowerTorso")
		local UpperTorso = character:FindFirstChild("UpperTorso")
		local Head = character:FindFirstChild("Head")

		if LowerTorso then
			RootJoint = getMotor(LowerTorso, "Root")
		end

		if UpperTorso then
			Waist = getMotor(UpperTorso, "Waist")
		end

		if Head then
			Neck = getMotor(Head, "Neck")
		end

	else

		local Torso = character:FindFirstChild("Torso")

		if Torso then
			RootJoint = getMotor(Root, "RootJoint")
			Neck = getMotor(Torso, "Neck")
		end

	end

	if RootJoint then
		originalRootTransform = RootJoint.Transform
	end

	if Waist then
		originalWaistTransform = Waist.Transform
	end

	if Neck then
		originalNeckTransform = Neck.Transform
	end

	idleTime = 0
	deathPlaying = false

	--====================================================
	-- DEATH
	--====================================================

	Humanoid.Died:Connect(function()

		if not ENABLED then
			return
		end

		if deathPlaying then
			return
		end

		deathPlaying = true

		local startTime = os.clock()

		while os.clock() - startTime < DEATH_TIME do

			local alpha = (os.clock() - startTime) / DEATH_TIME

			local fall = math.clamp(alpha, 0, 1)

			if RootJoint then
				RootJoint.Transform =
					CFrame.Angles(
						math.rad(80) * fall,
						0,
						math.rad(12) * fall
					)
			end

			if Waist then
				Waist.Transform =
					CFrame.Angles(
						math.rad(-35) * fall,
						0,
						0
					)
			end

			if Neck then
				Neck.Transform =
					CFrame.Angles(
						math.rad(25) * fall,
						0,
						0
					)
			end

			RunService.RenderStepped:Wait()

		end

	end)

end

--========================================================
-- CHARACTER ADDED
--========================================================

Player.CharacterAdded:Connect(function(character)

	task.wait(0.2)

	setupCharacter(character)

end)

if Player.Character then
	setupCharacter(Player.Character)
end

--========================================================
-- ANIMATION
--========================================================

RunService.RenderStepped:Connect(function(dt)

	if not Character
		or not Character.Parent
		or not Humanoid
		or Humanoid.Health <= 0 then
		return
	end

	if not ENABLED then

		resetJoints()

		return

	end

	if deathPlaying then
		return
	end

	local state = Humanoid:GetState()

	--====================================================
	-- JUMP
	--====================================================

	if state == Enum.HumanoidStateType.Jumping then

		if RootJoint then
			RootJoint.Transform =
				CFrame.Angles(JUMP_TILT, 0, 0)
		end

		if Waist then
			Waist.Transform =
				CFrame.Angles(math.rad(8), 0, 0)
		end

		if Neck then
			Neck.Transform =
				CFrame.Angles(math.rad(-5), 0, 0)
		end

		return
	end

	--====================================================
	-- FALL
	--====================================================

	if state == Enum.HumanoidStateType.Freefall then

		if RootJoint then
			RootJoint.Transform =
				CFrame.Angles(FALL_TILT, 0, 0)
		end

		if Waist then
			Waist.Transform =
				CFrame.Angles(math.rad(-6), 0, 0)
		end

		if Neck then
			Neck.Transform =
				CFrame.Angles(math.rad(4), 0, 0)
		end

		return
	end

	--====================================================
	-- IDLE
	--====================================================

	local moving =
		Humanoid.MoveDirection.Magnitude > 0.05

	if not moving then

		idleTime += dt * IDLE_SPEED

		local bob =
			math.sin(idleTime) * IDLE_BOB

		local tilt =
			math.sin(idleTime * 0.5) * IDLE_TILT

		if RootJoint then

			RootJoint.Transform =
				CFrame.new(0, bob, 0)
				* CFrame.Angles(0, 0, tilt)

		end

		if Waist then

			Waist.Transform =
				CFrame.new(0, bob * 0.35, 0)
				* CFrame.Angles(0, 0, -tilt)

		end

		if Neck then

			Neck.Transform =
				CFrame.Angles(0, 0, tilt * 0.5)

		end

		return
	end

	--====================================================
	-- WALK / RUN
	--====================================================

	-- Tidak mengubah animasi berjalan Roblox.
	-- Roblox tetap memainkan walk/run default.

	resetJoints()

end)

