--==================================================
-- CHARACTER / ANIMATION
--==================================================

local Character
local Humanoid
local RootPart
local RootJoint

local AnimationConnection
local DeathConnection

local function findRootJoint()
	if not Character or not RootPart then
		return nil
	end

	local joint = RootPart:FindFirstChild("RootJoint")

	if joint and joint:IsA("Motor6D") then
		return joint
	end

	for _, obj in ipairs(Character:GetDescendants()) do
		if obj:IsA("Motor6D") then
			if obj.Name == "RootJoint"
				or obj.Part0 == RootPart then
				return obj
			end
		end
	end

	return nil
end

local function setupCharacter(char)
	Character = char
	Humanoid = char:WaitForChild("Humanoid")
	RootPart = char:WaitForChild("HumanoidRootPart")

	if AnimationConnection then
		AnimationConnection:Disconnect()
		AnimationConnection = nil
	end

	if DeathConnection then
		DeathConnection:Disconnect()
		DeathConnection = nil
	end

	RootJoint = findRootJoint()

	if not RootJoint then
		return
	end

	local BaseTransform = RootJoint.Transform
	local StartTime = tick()

	-- Tetap ON setelah mati
	DeathConnection = Humanoid.Died:Connect(function()
		-- Jangan matikan AnimationEnabled
		-- Efek kematian akan tetap dijalankan
	end)

	AnimationConnection = RunService.RenderStepped:Connect(function()
		if not Character
			or not Character.Parent
			or not RootJoint
			or not RootJoint.Parent then
			return
		end

		if not AnimationEnabled then
			RootJoint.Transform = RootJoint.Transform:Lerp(
				BaseTransform,
				0.15
			)
			return
		end

		local Time = tick() - StartTime
		local State = Humanoid:GetState()

		local Velocity = RootPart.AssemblyLinearVelocity
		local HorizontalSpeed = Vector3.new(
			Velocity.X,
			0,
			Velocity.Z
		).Magnitude

		local VerticalSpeed = Velocity.Y

		local Y = 0
		local XRot = 0
		local ZRot = 0

		--==============================
		-- DEAD
		--==============================

		if Humanoid.Health <= 0 then
			local DeathTime = math.clamp(
				Time,
				0,
				0.8
			)

			local Smooth = 1 - (1 - DeathTime / 0.8)^3

			XRot = math.rad(55) * Smooth
			Y = -0.16 * Smooth
			ZRot = math.rad(7) * Smooth

		--==============================
		-- IDLE
		--==============================

		elseif HorizontalSpeed < 1
			and State ~= Enum.HumanoidStateType.Jumping
			and State ~= Enum.HumanoidStateType.Freefall then

			Y = math.sin(Time * 2.2) * 0.045
			ZRot = math.sin(Time * 1.4) * math.rad(0.5)

		--==============================
		-- WALK
		--==============================

		elseif HorizontalSpeed >= 1
			and State ~= Enum.HumanoidStateType.Jumping
			and State ~= Enum.HumanoidStateType.Freefall then

			-- Sangat kecil agar animasi
			-- jalan bawaan Roblox tetap normal
			Y = math.sin(Time * 8) * 0.012
			ZRot = math.sin(Time * 4) * math.rad(0.25)

		--==============================
		-- JUMP
		--==============================

		elseif State == Enum.HumanoidStateType.Jumping then

			Y = math.sin(Time * 7) * 0.025
			XRot = math.rad(-2)

		--==============================
		-- FALL
		--==============================

		elseif State == Enum.HumanoidStateType.Freefall then

			Y = math.sin(Time * 4) * 0.025

			local FallAmount = math.clamp(
				math.abs(VerticalSpeed) / 70,
				0,
				1
			)

			XRot = math.rad(4) * FallAmount
		end

		local Target =
			BaseTransform
			* CFrame.new(0, Y, 0)
			* CFrame.Angles(XRot, 0, ZRot)

		RootJoint.Transform = RootJoint.Transform:Lerp(
			Target,
			0.12
		)
	end)
end

--==================================================
-- FPS COUNTER
--==================================================

RunService.RenderStepped:Connect(function()
	Frames += 1

	local Now = tick()

	if Now - LastFPSUpdate >= 0.5 then
		FPS = math.floor(
			Frames / (Now - LastFPSUpdate) + 0.5
		)

		Frames = 0
		LastFPSUpdate = Now

		FPSLabel.Text = "FPS: " .. tostring(FPS)
	end
end)

