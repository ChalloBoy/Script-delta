--==================================================
-- LEVITATION
--==================================================

local function modeLevitation()
	clearEffects()

	if not hrp then
		return
	end

	showText(
		"LEVITATION",
		Color3.fromRGB(255,255,100)
	)

	playAnim("88138077358201")

	local stars = {}
	local numStars = 10
	local radius = 3

	for i = 1, numStars do
		local part = Instance.new("Part")

		part.Size = Vector3.new(
			0.2,
			0.2,
			0.2
		)

		part.Anchored = true
		part.CanCollide = false
		part.Material = Enum.Material.Neon
		part.Color = Color3.fromRGB(255,255,255)
		part.Parent = workspace

		table.insert(stars, part)
		table.insert(effects, part)
	end

	local angle = 0

	currentConnection = RunService.RenderStepped:Connect(function()
		if not hrp or not hrp.Parent then
			return
		end

		angle += 0.02

		for i, star in ipairs(stars) do
			if star and star.Parent then
				local offsetAngle =
					(i / numStars) * math.pi * 2

				local x =
					math.cos(angle + offsetAngle) * radius

				local z =
					math.sin(angle + offsetAngle) * radius

				star.Position =
					hrp.Position
					+ Vector3.new(x,2,z)
			end
		end
	end)
end

--==================================================
-- MODE SWITCH
--==================================================

local function switchMode()
	mode += 1

	if mode > 4 then
		mode = 1
	end

	if mode == 1 then
		modeExotic()

	elseif mode == 2 then
		modeChromatic()

	elseif mode == 3 then
		modeAura()

	else
		modeLevitation()
	end
end

--==================================================
-- INITIAL CHARACTER
--==================================================

setupCharacter(
	player.Character or player.CharacterAdded:Wait()
)

--==================================================
-- START MODE
--==================================================

modeExotic()

--==================================================
-- F KEY
--==================================================

UserInputService.InputBegan:Connect(function(input, gpe)
	if gpe then
		return
	end

	if input.KeyCode == Enum.KeyCode.F then
		switchMode()
	end
end)

--==================================================
-- RESPAWN SYSTEM
--==================================================

player.CharacterAdded:Connect(function(char)
	-- Tunggu character benar-benar siap
	task.wait(0.2)

	-- Bersihkan efek character lama
	clearEffects()

	-- Pasang ulang sistem animation
	setupCharacter(char)

	-- Mode aktif otomatis lagi
	task.wait(0.1)

	if mode == 1 then
		modeExotic()
	elseif mode == 2 then
		modeChromatic()
	elseif mode == 3 then
		modeAura()
	else
		modeLevitation()
	end
end)

--==================================================
-- TILT SYSTEM
--==================================================

getgenv().tilt = true

local cfg = {
	ptime = 0.25,
	smooth = 5,
	pred = 0.4,
	base = 0.1,
	dead = 0.05,
	side = 25,
	sideSmooth = 5
}

local px, py = 0, 0

if tiltConnection then
	tiltConnection:Disconnect()
end

tiltConnection = RunService.RenderStepped:Connect(function(dt)

	if not getgenv().tilt then
		return
	end

	if not character
		or not character.Parent
		or not humanoid
		or not hrp
		or humanoid.Health <= 0 then
		return
	end

	local mv = humanoid.MoveDirection

	local sx = 0
	local sp = 0

	if mv.Magnitude > 0 then

		local rel =
			hrp.CFrame:VectorToObjectSpace(mv)

		sx = -rel.X * cfg.side

		local pos = hrp.Position
		local vel = hrp.Velocity

		local fut =
			pos + vel * cfg.ptime

		local dy =
			fut.Y - pos.Y

		if math.abs(dy) > cfg.dead then

			local look =
				Vector3.new(
					hrp.CFrame.LookVector.X,
					0,
					hrp.CFrame.LookVector.Z
				)

			if look.Magnitude > 0 then
				look = look.Unit
			end

			local dist =
				(
					Vector3.new(
						fut.X,
						pos.Y,
						fut.Z
					) - pos
				).Magnitude

			if dist > 0 then
				sp +=
					math.atan2(dy, dist)
					* cfg.pred
			end
		end

		sp += rel.Z * cfg.base
	end

	py +=
		(sx - py)
		* math.min(dt * cfg.sideSmooth, 1)

	px +=
		(sp - px)
		* math.clamp(dt * cfg.smooth, 0, 1)

	local yaw =
		CFrame.Angles(
			0,
			math.rad(hrp.Orientation.Y),
			0
		)

	-- Tilt tanpa mengubah posisi karakter
	hrp.CFrame =
		CFrame.new(hrp.Position)
		* yaw
		* CFrame.Angles(
			px,
			0,
			math.rad(py)
		)
end)
