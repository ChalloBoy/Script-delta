--========================================================
-- FPS
--========================================================

local frameCount = 0
local fpsTime = 0
local currentFPS = 0

RunService.RenderStepped:Connect(function(dt)

	frameCount += 1
	fpsTime += dt

	if fpsTime >= 0.5 then
		currentFPS = math.floor(frameCount / fpsTime + 0.5)
		frameCount = 0
		fpsTime = 0

		FPS.Text = "FPS: " .. currentFPS
	end
end)

