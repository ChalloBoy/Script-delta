--// ANIMATION SYSTEM R6 + R15
--// LocalScript
--// No ServerScript required

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")

local Player = Players.LocalPlayer

--==================================================
-- SETTINGS
--==================================================

local Enabled = true

local IDLE_SPEED = 2.2
local IDLE_AMOUNT = 0.045

local JUMP_TILT = 0.12
local FALL_TILT = -0.10

--==================================================
-- VARIABLES
--==================================================

local Character
local Humanoid
local RootPart

local RigType = nil

local RootJoint
local Waist
local Neck

local Alive = false
local Time = 0

--==================================================
-- FIND JOINT
--==================================================

local function FindMotor(parent, name)
	if not parent then
		return nil
	end

	local obj = parent:FindFirstChild(name)
	if obj and obj:IsA("Motor6D") then
		return obj
	end

	return nil
end

local function FindMotorConnectedTo(part, names)
	if not part then
		return nil
	end

	for _, name in ipairs(names) do
		local motor = part:FindFirstChild(name)

		if motor and motor:IsA("Motor6D") then
			return motor
		end
	end

	for _, obj in ipairs(part:GetDescendants()) do
		if obj:IsA("Motor6D") then
			for _, name in ipairs(names) do
				if obj.Name == name then
					return obj
				end
			end
		end
	end

	return nil
end

--==================================================
-- SETUP R6
--==================================================

local function SetupR6()
	RigType = "R6"

	local torso = Character:FindFirstChild("Torso")

	if not torso then
		return
	end

	RootJoint =
		torso:FindFirstChild("RootJoint")
		or RootPart:FindFirstChild("RootJoint")

	Neck = torso:FindFirstChild("Neck")

	if not RootJoint then
		for _, obj in ipairs(Character:GetDescendants()) do
			if obj:IsA("Motor6D") then
				if obj.Part0 == RootPart and obj.Part1 == torso then
					RootJoint = obj
					break
				end
			end
		end
	end
end

--==================================================
-- SETUP R15
--==================================================

local function SetupR15()
	RigType = "R15"

	local lowerTorso = Character:FindFirstChild("LowerTorso")
	local upperTorso = Character:FindFirstChild("UpperTorso")

	if not lowerTorso or not upperTorso then
		return
	end

	RootJoint =
		lowerTorso:FindFirstChild("Root")
		or RootPart:FindFirstChild("Root")

	Waist = upperTorso:FindFirstChild("Waist")
		or lowerTorso:FindFirstChild("Waist")

	Neck = upperTorso:FindFirstChild("Neck")

	-- Fallback jika nama joint berbeda
	if not RootJoint then
		for _, obj in ipairs(Character:GetDescendants()) do
			if obj:IsA("Motor6D") then
				if obj.Part0 == RootPart and obj.Part1 == lowerTorso then
					RootJoint = obj
					break
				end
			end
		end
	end

	if not Waist then
		for _, obj in ipairs(Character:GetDescendants()) do
			if obj:IsA("Motor6D") then
				if obj.Part0 == lowerTorso and obj.Part1 == upperTorso then
					Waist = obj
					break
				end
			end
		end
	end
end

--==================================================
-- CHARACTER SETUP
--==================================================

local function SetupCharacter(char)
	Character = char
	Alive = false

	Humanoid = char:WaitForChild("Humanoid", 10)
	RootPart = char:WaitForChild("HumanoidRootPart", 10)

	if not Humanoid or not RootPart then
		return
	end

	RootJoint = nil
	Waist = nil
	Neck = nil

	if Humanoid.RigType == Enum.HumanoidRigType.R6 then
		SetupR6()
	else
		SetupR15()
	end

	Time = 0
	Alive = true
end

--==================================================
-- ANIMATION
--==================================================

local function ApplyAnimation(dt)
	if not Enabled then
		return
	end

	if not Alive then
		return
	end

	if not Character or not Character.Parent then
		return
	end

	if not Humanoid or Humanoid.Health <= 0 then
		return
	end

	Time += dt

	local state = Humanoid:GetState()
	local moving = Humanoid.MoveDirection.Magnitude > 0.05

	--==============================================
	-- IDLE
	--==============================================

	if not moving
		and state ~= Enum.HumanoidStateType.Jumping
		and state ~= Enum.HumanoidStateType.Freefall then

		local wave = math.sin(Time * IDLE_SPEED) * IDLE_AMOUNT

		if RootJoint then
			RootJoint.Transform =
				CFrame.Angles(wave, 0, 0)
		end

		if Waist then
			Waist.Transform =
				CFrame.Angles(-wave * 0.7, 0, 0)
		end

	--==============================================
	-- JUMP
	--==============================================

	elseif state == Enum.HumanoidStateType.Jumping then

		if RootJoint then
			RootJoint.Transform =
				CFrame.Angles(-JUMP_TILT, 0, 0)
		end

		if Waist then
			Waist.Transform =
				CFrame.Angles(JUMP_TILT * 0.5, 0, 0)
		end

	--==============================================
	-- FALL
	--==============================================

	elseif state == Enum.HumanoidStateType.Freefall then

		local fallWave =
			FALL_TILT + math.sin(Time * 4) * 0.025

		if RootJoint then
			RootJoint.Transform =
				CFrame.Angles(fallWave, 0, 0)
		end

		if Waist then
			Waist.Transform =
				CFrame.Angles(-fallWave * 0.5, 0, 0)
		end

	--==============================================
	-- WALKING
	--==============================================

	else
		-- Tidak mengganti animasi jalan Roblox.
		-- Hanya reset transform tambahan.
		if RootJoint then
			RootJoint.Transform = CFrame.new()
		end

		if Waist then
			Waist.Transform = CFrame.new()
		end
	end
end

--==================================================
-- DEATH
--==================================================

local function SetupDeath()
	if not Humanoid then
		return
	end

	Humanoid.Died:Connect(function()
		Alive = false

		-- Efek kematian kecil
		if RootJoint then
			RootJoint.Transform =
				CFrame.Angles(math.rad(18), 0, 0)
		end

		if Waist then
			Waist.Transform =
				CFrame.Angles(math.rad(10), 0, 0)
		end
	end)
end

--==================================================
-- CHARACTER
--==================================================

Player.CharacterAdded:Connect(function(char)
	SetupCharacter(char)
	SetupDeath()
end)

if Player.Character then
	SetupCharacter(Player.Character)
	SetupDeath()
end

--==================================================
-- RENDER
--==================================================

RunService:BindToRenderStep(
	"CustomCharacterAnimation",
	Enum.RenderPriority.Character.Value + 1,
	function(dt)
		ApplyAnimation(dt)
	end
)

--==================================================
-- UI
--==================================================

