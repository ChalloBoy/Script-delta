--// VERIFIED BADGE - CLIENT ONLY
--// Tidak memakai ServerScript / RemoteEvent
--// Badge visual menggunakan karakter: 

local Players = game:GetService("Players")
local TextChatService = game:GetService("TextChatService")

local player = Players.LocalPlayer

--==================================================
-- SETTINGS
--==================================================

-- true = hanya akun ini yang dianggap verified
local VERIFIED_USER_ID = player.UserId

local BADGE = " "

local function isVerified(targetPlayer)
	return targetPlayer.UserId == VERIFIED_USER_ID
end

--==================================================
-- CHAT
--==================================================

if TextChatService.ChatVersion == Enum.ChatVersion.TextChatService then

	TextChatService.OnIncomingMessage = function(message)
		local properties = Instance.new("TextChatMessageProperties")

		if not message.TextSource then
			return properties
		end

		local sender = Players:GetPlayerByUserId(
			message.TextSource.UserId
		)

		if sender and isVerified(sender) then
			properties.PrefixText = sender.Name .. BADGE .. ":"
		end

		return properties
	end

end

--==================================================
-- CUSTOM PLAYER LIST
--==================================================

local playerGui = player:WaitForChild("PlayerGui")

local screenGui = Instance.new("ScreenGui")
screenGui.Name = "VerifiedBadgeUI"
screenGui.ResetOnSpawn = false
screenGui.Parent = playerGui

local playerList = Instance.new("Frame")
playerList.Name = "PlayerList"
playerList.Size = UDim2.fromOffset(260, 300)
playerList.Position = UDim2.new(1, -280, 0, 20)
playerList.BackgroundTransparency = 0.15
playerList.Parent = screenGui

local corner = Instance.new("UICorner")
corner.CornerRadius = UDim.new(0, 8)
corner.Parent = playerList

local layout = Instance.new("UIListLayout")
layout.Padding = UDim.new(0, 3)
layout.SortOrder = Enum.SortOrder.Name
layout.Parent = playerList

local playerLabels = {}

local function createPlayerEntry(targetPlayer)

	if playerLabels[targetPlayer] then
		return
	end

	local label = Instance.new("TextLabel")
	label.Name = targetPlayer.Name
	label.Size = UDim2.new(1, -10, 0, 35)
	label.BackgroundTransparency = 1
	label.TextXAlignment = Enum.TextXAlignment.Left
	label.Font = Enum.Font.GothamBold
	label.TextSize = 16
	label.TextColor3 = Color3.new(1, 1, 1)
	label.Parent = playerList

	local function update()
		if isVerified(targetPlayer) then
			label.Text = targetPlayer.Name .. BADGE
		else
			label.Text = targetPlayer.Name
		end
	end

	update()

	playerLabels[targetPlayer] = label
end

local function removePlayerEntry(targetPlayer)

	local label = playerLabels[targetPlayer]

	if label then
		label:Destroy()
		playerLabels[targetPlayer] = nil
	end

end

for _, targetPlayer in ipairs(Players:GetPlayers()) do
	createPlayerEntry(targetPlayer)
end

Players.PlayerAdded:Connect(function(targetPlayer)
	createPlayerEntry(targetPlayer)
end)

Players.PlayerRemoving:Connect(function(targetPlayer)
	removePlayerEntry(targetPlayer)
end)

--==================================================
-- CUSTOM PROFILE
--==================================================

local profileFrame = Instance.new("Frame")
profileFrame.Name = "MyProfile"
profileFrame.Size = UDim2.fromOffset(300, 80)
profileFrame.Position = UDim2.new(0.5, -150, 1, -110)
profileFrame.BackgroundTransparency = 0.1
profileFrame.Visible = false
profileFrame.Parent = screenGui

local profileCorner = Instance.new("UICorner")
profileCorner.CornerRadius = UDim.new(0, 8)
profileCorner.Parent = profileFrame

local profileName = Instance.new("TextLabel")
profileName.Size = UDim2.fromScale(1, 1)
profileName.BackgroundTransparency = 1
profileName.Font = Enum.Font.GothamBold
profileName.TextSize = 20
profileName.TextColor3 = Color3.new(1, 1, 1)
profileName.Text = player.Name .. BADGE
profileName.Parent = profileFrame

--==================================================
-- DONE
--==================================================

print("Verified Badge loaded for:", player.Name)
